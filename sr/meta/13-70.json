1\u0430 \u0447\u0435\u0442\u0438\u0440\u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0435 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0435 \u041f\u0440\u0438\u043d\u0446\u0438\u043f\u0430 \u0437\u0435\u043b\u0435\u043d\u0438\u0445 \u043e\u0431\u0432\u0435\u0437\u043d\u0438\u0446\u0430 \u041c\u0435\u0452\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0433 \u0443\u0434\u0440\u0443\u0436\u0435\u045a\u0430 \u0442\u0440\u0436\u0438\u0448\u0442\u0430 \u043a\u0430\u043f\u0438\u0442\u0430\u043b\u0430 (ICMA) \u0438\u043b\u0438 \u0441\u0443 \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u043a\u043e\u0432\u0430\u043d\u0435 \u043e\u0434 \u0441\u0442\u0440\u0430\u043d\u0435 \u0418\u043d\u0438\u0446\u0438\u0458\u0430\u0442\u0438\u0432\u0435 \u0437\u0430 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0435 \u043e\u0431\u0432\u0435\u0437\u043d\u0438\u0446\u0435 (CBI). \u0418\u0437\u0434\u0430\u0432\u0430\u043e\u0446\u0438 \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443 \u043a\u043e\u0440\u043f\u043e\u0440\u0430\u0446\u0438\u0458\u0435 \u043a\u0430\u043e \u0448\u0442\u043e \u0441\u0443 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0458\u0435 \u0438\u043b\u0438 \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0458\u0441\u043a\u0435 \u043a\u043e\u0440\u043f\u043e\u0440\u0430\u0446\u0438\u0458\u0435 \u0438 \u0438\u0437\u0434\u0430\u0432\u0430\u043e\u0446\u0435 \u0441\u0443\u0432\u0435\u0440\u0435\u043d\u0438\u0445 \u043e\u0431\u0432\u0435\u0437\u043d\u0438\u0446\u0430 \u043a\u043e\u0458\u0435 \u0441\u0443 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0435 \u0432\u043b\u0430\u0434\u0435. \u0421\u0443\u0432\u0435\u0440\u0435\u043d\u0435 \u043e\u0431\u0432\u0435\u0437\u043d\u0438\u0446\u0435 \u043a\u043e\u0458\u0435 \u0438\u0437\u0434\u0430\u0458\u0443 \u0432\u043b\u0430\u0434\u0435 \u0443\u043a\u0459\u0443\u0447\u0435\u043d\u0435 \u0441\u0443 \u0441\u0430\u043c\u043e \u0430\u043a\u043e \u0438\u043c\u0430\u0458\u0443 \u0440\u043e\u043a \u0434\u043e\u0441\u043f\u0435\u045b\u0