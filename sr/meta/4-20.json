{"indicator_number":4.2,"reporting_status":"complete","published":true,"sdg_goal":"4","data_non_statistical":false,"graph_type":"line","indicator_sort_order":"04-20","indicator_name":"\u0412\u0438\u0441\u043e\u043a\u043e \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0435 \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u043b\u0443","source_active_1":true,"source_organisation_1":"ESS (EU-LFS)","source_url_1":"https://ec.europa.eu/eurostat/databrowser/view/sdg_04_20/default/table","footer_fields":[{"label":"\u0420\u0435\u0444\u0435\u0440\u0435\u043d\u0442\u043d\u0438 \u043c\u0435\u0442\u0430\u043f\u043e\u0434\u0430\u0446\u0438","value":"<a href=\"https://ec.europa.eu/eurostat/cache/metadata/en/sdg_04_20_esmsip2.htm\" target=\"_blank\">Eurostat Metadata Report (sdg_04_20)</a>"}],"graph_titles":[{"series":"\u0412\u0438\u0441\u043e\u043a\u043e \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0435 \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u043b\u0443, \u043e\u0441\u043e\u0431\u0435 \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u0438 \u043e\u0434 25 \u0434\u043e 34 \u0433\u043e\u0434\u0438\u043d\u0435 \u0441\u0430 \u0432\u0438\u0441\u043e\u043a\u043e\u0448\u043a\u043e\u043b\u0441\u043a\u043e\u043c \u0434\u0438\u043f\u043b\u043e\u043c\u043e\u043c","title":"\u0412\u0438\u0441\u043e\u043a\u043e \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0435 \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u043b\u0443, \u043e\u0441\u043e\u0431\u0435 \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u0438 \u043e\u0434 25 \u0434\u043e 34 \u0433\u043e\u0434\u0438\u043d\u0435 \u0441\u0430 \u0432\u0438\u0441\u043e\u043a\u043e\u0448\u043a\u043e\u043b\u0441\u043a\u043e\u043c \u0434\u0438\u043f\u043b\u043e\u043c\u043e\u043c"}],"indicator_definition":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043c\u0458\u0435\u0440\u0438 \u0443\u0434\u0438\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u0430 \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u0438 25-34 \u0433\u043e\u0434\u0438\u043d\u0435 \u043a\u043e\u0458\u0435 \u0458\u0435 \u0443\u0441\u043f\u0458\u0435\u0448\u043d\u043e \u0437\u0430\u0432\u0440\u0448\u0438\u043b\u043e \u0442\u0435\u0440\u0446\u0438\u0458\u0430\u0440\u043d\u0435 \u0441\u0442\u0443\u0434\u0438\u0458\u0435 (\u043d\u043f\u0440. \u043d\u0430 \u0443\u043d\u0438\u0432\u0435\u0440\u0437\u0438\u0442\u0435\u0442\u0443 \u0438\u043b\u0438 \u0432\u0438\u0448\u043e\u0458 \u0442\u0435\u0445\u043d\u0438\u0447\u043a\u043e\u0458 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438). \u041f\u043e\u0441\u0442\u0438\u0433\u043d\u0443\u045b\u0435 \u0443 \u0442\u0435\u0440\u0446\u0438\u0458\u0430\u0440\u043d\u043e\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u043e\u0434\u043d\u043e\u0441\u0438 \u0441\u0435 \u043d\u0430 \u0418\u0421\u0426\u0415\u0414 (\u041c\u0435\u0452\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0430 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0434\u043d\u0430 \u043a\u043b\u0430\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0458\u0430 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0430) \u043d\u0438\u0432\u043e\u0435 5\u20138 \u0438\u0437 2011. \u0433\u043e\u0434\u0438\u043d\u0435 \u0437\u0430 \u043f\u043e\u0434\u0430\u0442\u043a\u0435 \u043e\u0434 2014. \u0433\u043e\u0434\u0438\u043d\u0435 \u043d\u0430\u0434\u0430\u0459\u0435 \u0438 \u043d\u0430 \u0418\u0421\u0426\u0415\u0414 \u043d\u0438\u0432\u043e\u0435 5\u20136 \u0438\u0437 1997. \u0433\u043e\u0434\u0438\u043d\u0435 \u0437\u0430 \u043f\u043e\u0434\u0430\u0442\u043a\u0435 \u0434\u043e 2013. \u0433\u043e\u0434\u0438\u043d\u0435. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u0437\u0430\u0441\u043d\u0438\u0432\u0430 \u043d\u0430 \u0410\u043d\u043a\u0435\u0442\u0438 \u043e \u0440\u0430\u0434\u043d\u043e\u0458 \u0441\u043d\u0430\u0437\u0438 \u0415\u0423 (\u0415\u0423-\u041b\u0424\u0421).","rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u0430 \u0446\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 4 \u043e \u043a\u0432\u0430\u043b\u0438\u0442\u0435\u0442\u043d\u043e\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438 \u0446\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 5 \u043e \u0440\u043e\u0434\u043d\u043e\u0458 \u0440\u0430\u0432\u043d\u043e\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0438, \u043a\u043e\u0458\u0438 \u0441\u0443 \u0443\u0433\u0440\u0430\u0452\u0435\u043d\u0438 \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u0443 \u043e\u043a\u0432\u0438\u0440\u0443 \u201e\u041f\u043e\u0434\u0440\u0448\u043a\u0430 \u0459\u0443\u0434\u0438\u043c\u0430, \u0458\u0430\u0447\u0430\u045a\u0435 \u043d\u0430\u0448\u0438\u0445 \u0434\u0440\u0443\u0448\u0442\u0430\u0432\u0430 \u0438 \u043d\u0430\u0448\u0435\u0433 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u043e\u0433 \u043c\u043e\u0434\u0435\u043b\u0430\u201c \u0438 \u201e\u041d\u043e\u0432\u0438 \u043f\u043b\u0430\u043d \u0437\u0430 \u043e\u0434\u0440\u0436\u0438\u0432\u0438 \u043f\u0440\u043e\u0441\u043f\u0435\u0440\u0438\u0442\u0435\u0442 \u0438 \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u043d\u043e\u0441\u0442 \u0415\u0432\u0440\u043e\u043f\u0435\u201c. \u0421\u0430\u0432\u0458\u0435\u0442 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u0443\u043d\u0438\u0458\u0435 \u0458\u0435 26. \u0444\u0435\u0431\u0440\u0443\u0430\u0440\u0430 2021. \u0433\u043e\u0434\u0438\u043d\u0435 \u0443\u0441\u0432\u043e\u0458\u0438\u043e \u0420\u0435\u0437\u043e\u043b\u0443\u0446\u0438\u0458\u0443 \u043e \u0441\u0442\u0440\u0430\u0442\u0435\u0448\u043a\u043e\u043c \u043e\u043a\u0432\u0438\u0440\u0443 \u0437\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0443 \u0441\u0430\u0440\u0430\u0434\u045a\u0443 \u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438 \u043e\u0431\u0443\u0446\u0438 \u043a\u0430 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u043e\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u043d\u043e\u043c \u043f\u0440\u043e\u0441\u0442\u043e\u0440\u0443 \u0438 \u0448\u0438\u0440\u0435 (2021\u20132030),\u043e\u043a\u0432\u0438\u0440 \u043a\u043e\u0458\u0438 \u0441\u0435 \u0431\u0430\u0432\u0438 \u043f\u0435\u0442 \u0441\u0442\u0440\u0430\u0442\u0435\u0448\u043a\u0438\u0445 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0430: (1) \u041f\u043e\u0431\u043e\u0459\u0448\u0430\u045a\u0435 \u043a\u0432\u0430\u043b\u0438\u0442\u0435\u0442\u0430, \u0440\u0430\u0432\u043d\u043e\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0438, \u0438\u043d\u043a\u043b\u0443\u0437\u0438\u0458\u0435 \u0438 \u0443\u0441\u043f\u0458\u0435\u0445\u0430 \u0437\u0430 \u0441\u0432\u0435 \u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438 \u043e\u0431\u0443\u0446\u0438; (2) \u041e\u0441\u0442\u0432\u0430\u0440\u0438\u0432\u0430\u045a\u0435 \u0446\u0438\u0458\u0435\u043b\u043e\u0436\u0438\u0432\u043e\u0442\u043d\u043e\u0433 \u0443\u0447\u0435\u045a\u0430 \u0438 \u043c\u043e\u0431\u0438\u043b\u043d\u043e\u0441\u0442\u0438 \u0437\u0430 \u0441\u0432\u0435; (3) \u0423\u043d\u0430\u043f\u0440\u0435\u0452\u0435\u045a\u0435 \u043a\u043e\u043c\u043f\u0435\u0442\u0435\u043d\u0446\u0438\u0458\u0430 \u0438 \u043c\u043e\u0442\u0438\u0432\u0430\u0446\u0438\u0458\u0435 \u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u043d\u043e\u0458 \u043f\u0440\u043e\u0444\u0435\u0441\u0438\u0458\u0438; (4) \u0408\u0430\u0447\u0430\u045a\u0435 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u043e\u0433 \u0432\u0438\u0441\u043e\u043a\u043e\u0433 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0430; \u0438 (5) \u041f\u043e\u0434\u0440\u0436\u0430\u0432\u0430\u045a\u0435 \u0437\u0435\u043b\u0435\u043d\u0435 \u0438 \u0434\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u0435 \u0442\u0440\u0430\u043d\u0437\u0438\u0446\u0438\u0458\u0435 \u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438 \u043e\u0431\u0443\u0446\u0438 \u0438 \u043a\u0440\u043e\u0437 \u045a\u0438\u0445.","methodology_characteristics":"\u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0435 \u0438 \u043e\u0431\u0443\u043a\u0430 \u0441\u0443 \u043a\u0459\u0443\u0447\u043d\u0438 \u043f\u043e\u043a\u0440\u0435\u0442\u0430\u0447\u0438 \u0440\u0430\u0441\u0442\u0430 \u0438 \u0437\u0430\u043f\u043e\u0448\u0459\u0430\u0432\u0430\u045a\u0430 \u0458\u0435\u0440 \u043f\u043e\u043c\u0430\u0436\u0443 \u0443 \u043f\u043e\u0431\u043e\u0459\u0448\u0430\u045a\u0443 \u0437\u0430\u043f\u043e\u0441\u043b\u0435\u043d\u043e\u0441\u0442\u0438, \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438, \u0438\u043d\u043e\u0432\u0430\u0446\u0438\u0458\u0430 \u0438 \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u0438. \u041d\u0430\u0441\u0442\u0430\u0432\u0430\u043a \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0430 \u043d\u0430\u043a\u043e\u043d \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0433 \u043d\u0438\u0432\u043e\u0430 \u0458\u0435 \u0432\u0430\u0436\u0430\u043d \u0458\u0435\u0440 \u0458\u0435 \u0432\u0458\u0435\u0440\u043e\u0432\u0430\u0442\u043d\u0438\u0458\u0435 \u0434\u0430 \u045b\u0435 \u0459\u0443\u0434\u0438 \u0441\u0430 \u0432\u0438\u0448\u0438\u043c \u043a\u0432\u0430\u043b\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0458\u0430\u043c\u0430 \u0431\u0438\u0442\u0438 \u0437\u0430\u043f\u043e\u0441\u043b\u0435\u043d\u0438 \u0438 \u043c\u0430\u045a\u0435 \u0458\u0435 \u0432\u0458\u0435\u0440\u043e\u0432\u0430\u0442\u043d\u043e \u0434\u0430 \u045b\u0435 \u0441\u0435 \u0441\u0443\u043e\u0447\u0438\u0442\u0438 \u0441\u0430 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u043e\u043c \u0443 \u0435\u043a\u043e\u043d\u043e\u043c\u0438\u0458\u0438 \u0437\u0430\u0441\u043d\u043e\u0432\u0430\u043d\u043e\u0458 \u043d\u0430 \u0437\u043d\u0430\u045a\u0443. \u041e\u0441\u043e\u0431\u0435 \u0441\u0430 \u043d\u0438\u0441\u043a\u0438\u043c \u043d\u0438\u0432\u043e\u043e\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0430 \u043d\u0435 \u0441\u0430\u043c\u043e \u0434\u0430 \u0441\u0435 \u043c\u043e\u0433\u0443 \u0441\u0443\u043e\u0447\u0438\u0442\u0438 \u0441\u0430 \u0432\u0435\u045b\u0438\u043c \u043f\u043e\u0442\u0435\u0448\u043a\u043e\u045b\u0430\u043c\u0430 \u043d\u0430 \u0442\u0440\u0436\u0438\u0448\u0442\u0443 \u0440\u0430\u0434\u0430, \u0432\u0435\u045b \u0438\u043c\u0430\u0458\u0443 \u0438 \u0432\u0435\u045b\u0438 \u0440\u0438\u0437\u0438\u043a \u043e\u0434 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u0438 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u0435 \u0438\u0441\u043a\u0459\u0443\u0447\u0435\u043d\u043e\u0441\u0442\u0438. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0458\u0435 \u0443\u043a\u0459\u0443\u0447\u0435\u043d \u043a\u0430\u043e \u0433\u043b\u0430\u0432\u043d\u0438 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0443 \u0422\u0430\u0431\u0435\u043b\u0443 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u0438\u0445 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u0437\u0430 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0438 \u0441\u0442\u0443\u0431 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u0438\u0445 \u043f\u0440\u0430\u0432\u0430.","long_objective":"\u0414\u0443\u0433\u043e\u0440\u043e\u0447\u043d\u0438 \u0446\u0438\u0459 \u0437\u0430 \u043e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0458\u0435 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442 \u043e\u0434 52.","eu_indicator_definition":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043c\u0458\u0435\u0440\u0438 \u0443\u0434\u0438\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u0430 \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u0438 25-34 \u0433\u043e\u0434\u0438\u043d\u0435 \u043a\u043e\u0458\u0435 \u0458\u0435 \u0443\u0441\u043f\u0458\u0435\u0448\u043d\u043e \u0437\u0430\u0432\u0440\u0448\u0438\u043b\u043e \u0442\u0435\u0440\u0446\u0438\u0458\u0430\u0440\u043d\u0435 \u0441\u0442\u0443\u0434\u0438\u0458\u0435 (\u043d\u043f\u0440. \u043d\u0430 \u0443\u043d\u0438\u0432\u0435\u0440\u0437\u0438\u0442\u0435\u0442\u0443 \u0438\u043b\u0438 \u0432\u0438\u0448\u043e\u0458 \u0442\u0435\u0445\u043d\u0438\u0447\u043a\u043e\u0458 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438). \u041f\u043e\u0441\u0442\u0438\u0433\u043d\u0443\u045b\u0435 \u0443 \u0442\u0435\u0440\u0446\u0438\u0458\u0430\u0440\u043d\u043e\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u043e\u0434\u043d\u043e\u0441\u0438 \u0441\u0435 \u043d\u0430 \u0418\u0421\u0426\u0415\u0414 (\u041c\u0435\u0452\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0430 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0434\u043d\u0430 \u043a\u043b\u0430\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0458\u0430 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0430) \u043d\u0438\u0432\u043e\u0435 5\u20138 \u0438\u0437 2011. \u0433\u043e\u0434\u0438\u043d\u0435 \u0437\u0430 \u043f\u043e\u0434\u0430\u0442\u043a\u0435 \u043e\u0434 2014. \u0433\u043e\u0434\u0438\u043d\u0435 \u043d\u0430\u0434\u0430\u0459\u0435 \u0438 \u043d\u0430 \u0418\u0421\u0426\u0415\u0414 \u043d\u0438\u0432\u043e\u0435 5\u20136 \u0438\u0437 1997. \u0433\u043e\u0434\u0438\u043d\u0435 \u0437\u0430 \u043f\u043e\u0434\u0430\u0442\u043a\u0435 \u0434\u043e 2013. \u0433\u043e\u0434\u0438\u043d\u0435. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u0437\u0430\u0441\u043d\u0438\u0432\u0430 \u043d\u0430 \u0410\u043d\u043a\u0435\u0442\u0438 \u043e \u0440\u0430\u0434\u043d\u043e\u0458 \u0441\u043d\u0430\u0437\u0438 \u0415\u0423 (\u0415\u0423-\u041b\u0424\u0421).","eu_rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u0430 \u0446\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 4 \u043e \u043a\u0432\u0430\u043b\u0438\u0442\u0435\u0442\u043d\u043e\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438 \u0446\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 5 \u043e \u0440\u043e\u0434\u043d\u043e\u0458 \u0440\u0430\u0432\u043d\u043e\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0438, \u043a\u043e\u0458\u0438 \u0441\u0443 \u0443\u0433\u0440\u0430\u0452\u0435\u043d\u0438 \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u0443 \u043e\u043a\u0432\u0438\u0440\u0443 \u201e\u041f\u043e\u0434\u0440\u0448\u043a\u0430 \u0459\u0443\u0434\u0438\u043c\u0430, \u0458\u0430\u0447\u0430\u045a\u0435 \u043d\u0430\u0448\u0438\u0445 \u0434\u0440\u0443\u0448\u0442\u0430\u0432\u0430 \u0438 \u043d\u0430\u0448\u0435\u0433 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u043e\u0433 \u043c\u043e\u0434\u0435\u043b\u0430\u201c \u0438 \u201e\u041d\u043e\u0432\u0438 \u043f\u043b\u0430\u043d \u0437\u0430 \u043e\u0434\u0440\u0436\u0438\u0432\u0438 \u043f\u0440\u043e\u0441\u043f\u0435\u0440\u0438\u0442\u0435\u0442 \u0438 \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u043d\u043e\u0441\u0442 \u0415\u0432\u0440\u043e\u043f\u0435\u201c. \u0421\u0430\u0432\u0458\u0435\u0442 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u0443\u043d\u0438\u0458\u0435 \u0458\u0435 26. \u0444\u0435\u0431\u0440\u0443\u0430\u0440\u0430 2021. \u0433\u043e\u0434\u0438\u043d\u0435 \u0443\u0441\u0432\u043e\u0458\u0438\u043e \u0420\u0435\u0437\u043e\u043b\u0443\u0446\u0438\u0458\u0443 \u043e \u0441\u0442\u0440\u0430\u0442\u0435\u0448\u043a\u043e\u043c \u043e\u043a\u0432\u0438\u0440\u0443 \u0437\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0443 \u0441\u0430\u0440\u0430\u0434\u045a\u0443 \u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438 \u043e\u0431\u0443\u0446\u0438 \u043a\u0430 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u043e\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u043d\u043e\u043c \u043f\u0440\u043e\u0441\u0442\u043e\u0440\u0443 \u0438 \u0448\u0438\u0440\u0435 (2021\u20132030),\u043e\u043a\u0432\u0438\u0440 \u043a\u043e\u0458\u0438 \u0441\u0435 \u0431\u0430\u0432\u0438 \u043f\u0435\u0442 \u0441\u0442\u0440\u0430\u0442\u0435\u0448\u043a\u0438\u0445 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0430: (1) \u041f\u043e\u0431\u043e\u0459\u0448\u0430\u045a\u0435 \u043a\u0432\u0430\u043b\u0438\u0442\u0435\u0442\u0430, \u0440\u0430\u0432\u043d\u043e\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0438, \u0438\u043d\u043a\u043b\u0443\u0437\u0438\u0458\u0435 \u0438 \u0443\u0441\u043f\u0458\u0435\u0445\u0430 \u0437\u0430 \u0441\u0432\u0435 \u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438 \u043e\u0431\u0443\u0446\u0438; (2) \u041e\u0441\u0442\u0432\u0430\u0440\u0438\u0432\u0430\u045a\u0435 \u0446\u0438\u0458\u0435\u043b\u043e\u0436\u0438\u0432\u043e\u0442\u043d\u043e\u0433 \u0443\u0447\u0435\u045a\u0430 \u0438 \u043c\u043e\u0431\u0438\u043b\u043d\u043e\u0441\u0442\u0438 \u0437\u0430 \u0441\u0432\u0435; (3) \u0423\u043d\u0430\u043f\u0440\u0435\u0452\u0435\u045a\u0435 \u043a\u043e\u043c\u043f\u0435\u0442\u0435\u043d\u0446\u0438\u0458\u0430 \u0438 \u043c\u043e\u0442\u0438\u0432\u0430\u0446\u0438\u0458\u0435 \u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u043d\u043e\u0458 \u043f\u0440\u043e\u0444\u0435\u0441\u0438\u0458\u0438; (4) \u0408\u0430\u0447\u0430\u045a\u0435 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u043e\u0433 \u0432\u0438\u0441\u043e\u043a\u043e\u0433 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0430; \u0438 (5) \u041f\u043e\u0434\u0440\u0436\u0430\u0432\u0430\u045a\u0435 \u0437\u0435\u043b\u0435\u043d\u0435 \u0438 \u0434\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u0435 \u0442\u0440\u0430\u043d\u0437\u0438\u0446\u0438\u0458\u0435 \u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438 \u043e\u0431\u0443\u0446\u0438 \u0438 \u043a\u0440\u043e\u0437 \u045a\u0438\u0445.","eu_methodology_characteristics":"\u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0435 \u0438 \u043e\u0431\u0443\u043a\u0430 \u0441\u0443 \u043a\u0459\u0443\u0447\u043d\u0438 \u043f\u043e\u043a\u0440\u0435\u0442\u0430\u0447\u0438 \u0440\u0430\u0441\u0442\u0430 \u0438 \u0437\u0430\u043f\u043e\u0448\u0459\u0430\u0432\u0430\u045a\u0430 \u0458\u0435\u0440 \u043f\u043e\u043c\u0430\u0436\u0443 \u0443 \u043f\u043e\u0431\u043e\u0459\u0448\u0430\u045a\u0443 \u0437\u0430\u043f\u043e\u0441\u043b\u0435\u043d\u043e\u0441\u0442\u0438, \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438, \u0438\u043d\u043e\u0432\u0430\u0446\u0438\u0458\u0430 \u0438 \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u0438. \u041d\u0430\u0441\u0442\u0430\u0432\u0430\u043a \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0430 \u043d\u0430\u043a\u043e\u043d \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0433 \u043d\u0438\u0432\u043e\u0430 \u0458\u0435 \u0432\u0430\u0436\u0430\u043d \u0458\u0435\u0440 \u0458\u0435 \u0432\u0458\u0435\u0440\u043e\u0432\u0430\u0442\u043d\u0438\u0458\u0435 \u0434\u0430 \u045b\u0435 \u0459\u0443\u0434\u0438 \u0441\u0430 \u0432\u0438\u0448\u0438\u043c \u043a\u0432\u0430\u043b\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0458\u0430\u043c\u0430 \u0431\u0438\u0442\u0438 \u0437\u0430\u043f\u043e\u0441\u043b\u0435\u043d\u0438 \u0438 \u043c\u0430\u045a\u0435 \u0458\u0435 \u0432\u0458\u0435\u0440\u043e\u0432\u0430\