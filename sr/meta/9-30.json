u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0430 (HES) \u0438 \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u0438 \u043d\u0435\u043f\u0440\u043e\u0444\u0438\u0442\u043d\u0438 \u0441\u0435\u043a\u0442\u043e\u0440 (PNP). \u041f\u043e\u0434\u0430\u0446\u0438 \u0441\u0443 \u0438\u0437\u0440\u0430\u0436\u0435\u043d\u0438 \u0443 \u0435\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442\u0438\u043c\u0430 \u043f\u0443\u043d\u043e\u0433 \u0440\u0430\u0434\u043d\u043e\u0433 \u0432\u0440\u0435\u043c\u0435\u043d\u0430 (FTE) \u043a\u0430\u043e \u0443\u0434\u0438\u043e \u0440\u0430\u0434\u043d\u0435 \u0441\u043d\u0430\u0433\u0435.","eu_rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0458\u0435 \u0434\u0438\u043e \u0441\u043a\u0443\u043f\u0430 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u0415\u0423 \u0437\u0430 \u0446\u0438\u0459\u0435\u0432\u0435 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 \u0438 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0441\u0435 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043f\u0440\u0435\u043c\u0430 \u0446\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 9 \u043e \u0438\u0437\u0433\u0440\u0430\u0434\u045a\u0438 \u043e\u0442\u043f\u043e\u0440\u043d\u0435 \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0435, \u043f\u0440\u043e\u043c\u043e\u0432\u0438\u0441\u0430\u045a\u0443 \u0438\u043d\u043a\u043b\u0443\u0437\u0438\u0432\u043d\u0435 \u0438 \u043e\u0434\u0440\u0436\u0438\u0432\u0435 \u0438\u043d\u0434\u0443\u0441\u0442\u0440\u0438\u0458\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0458\u0435 \u0438 \u043f\u043e\u0434\u0441\u0442\u0438\u0446\u0430\u045a\u0443 \u0438\u043d\u043e\u0432\u0430\u0446\u0438\u0458\u0430. \u0418\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0435 \u0438 \u0440\u0430\u0437\u0432\