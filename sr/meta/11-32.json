u0459\u0430\u045a\u0435 \u043a\u0440\u0447\u0435\u045a\u0430 \u0448\u0443\u043c\u0430, \u0431\u043e\u0440\u0431\u0443 \u043f\u0440\u043e\u0442\u0438\u0432 \u0434\u0435\u0437\u0435\u0440\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0458\u0435, \u043e\u0431\u043d\u0430\u0432\u0459\u0430\u045a\u0435 \u0434\u0435\u0433\u0440\u0430\u0434\u0438\u0440\u0430\u043d\u043e\u0433 \u0437\u0435\u043c\u0459\u0438\u0448\u0442\u0430 \u0438 \u0442\u043b\u0430, \u0437\u0430\u0443\u0441\u0442\u0430\u0432\u0459\u0430\u045a\u0435 \u0433\u0443\u0431\u0438\u0442\u043a\u0430 \u0431\u0438\u043e\u0434\u0438\u0432\u0435\u0440\u0437\u0438\u0442\u0435\u0442\u0430 \u0438 \u0437\u0430\u0448\u0442\u0438\u0442\u0443 \u0443\u0433\u0440\u043e\u0436\u0435\u043d\u0438\u0445 \u0432\u0440\u0441\u0442\u0430.\u201c","eu_indicator_definition":"\u041e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043c\u0435\u0440\u0438 \u043f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u043e\u0441\u0442 \u043f\u043e\u0432\u0440\u0448\u0438\u043d\u0435 \u0442\u043b\u0430 \u043d\u0435\u043f\u0440\u043e\u043f\u0443\u0441\u043d\u0438\u043c \u043c\u0430\u0442\u0435\u0440\u0438\u0458\u0430\u043b\u0438\u043c\u0430, \u0448\u0442\u043e \u0443\u043a\u0430\u0437\u0443\u0458\u0435 \u043d\u0430 \u043d\u0435\u043f\u0440\u043e\u043f\u0443\u0441\u043d\u043e\u0441\u0442. \u0410\u0433\u0440\u0435\u0433\u0430\u0446\u0438\u0458\u0430 \u0432\u0440\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u043d\u0435\u043f\u0440\u043e\u043f\u0443\u0441\u043d\u043e\u0441\u0442\u0438 \u0441\u0430 \u0440\u0435\u0444\u0435\u0440\u0435\u043d\u0442\u043d\u0438\u043c \u0458\u0435\u0434\u0438\u043d\u0438\u0446\u0430\u043c\u0430, \u043a\u0430\u043e \u0448\u0442\u043e \u0441\u0443 \u0443\u0440\u0431\u0430\u043d\u0430 \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0430, \u043f\u043e\u043f\u043b\u0430\u0432\u043d\u0430 \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0430, \u043f\u0440\u0438\u043e\u0431\u0430\u043b\u043d\u0435 \u0437\u043e\u043d\u0435 \u0438\u043b\u0438 \u0437\u0430\u0448\u0442\u0438\u045b\u0435\u043d\u0430 \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0430, \u0432\u0440\u0448\u0438 \u0441\u0435 \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u045a\u0435\u043c \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0441\u0430\u043d\u0435 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0435 \u043f\u0440\u043e\u0441\u0442\u043e\u0440\u043d\u0438\u0445 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u0415\u0415\u0410.","eu_rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u0430 \u0426\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 11 \u043e \u0442\u043e\u043c\u0435 \u0434\u0430 \u0433\u0440\u0430\u0434\u043e\u0432\u0438 \u0438 \u0459\u0443\u0434\u0441\u043a\u0430 \u043d\u0430\u0441\u0435\u0459\u0430 \u0431\u0443\u0434\u0443 \u0438\u043d\u043a\u043b\u0443\u0437\u0438\u0432\u043d\u0438, \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u0438, \u043e\u0442\u043f\u043e\u0440\u043d\u0438 \u0438 \u043e\u0434\u0440\u0436\u0438\u0432\u0438, \u0438 \u043a\u0430 \u0426\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 15 \u043e \u0437\u0430\u0448\u0442\u0438\u0442\u0438, \u043e\u0431\u043d\u043e\u0432\u0438 \u0438 \u043f\u0440\u043e\u043c\u043e\u0446\u0438\u0458\u0438 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u045a\u0430 \u0437\u0435\u043c\u0459\u0438\u0448\u0442\u0430. \u0426\u0438\u0459 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 11 \u0458\u0435 \u0443\u0433\u0440\u0430\u0452\u0435\u043d \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u0443 \u043e\u043a\u0432\u0438\u0440\u0443 \u201e\u041d\u043e\u0432\u0430 \u0435\u0440\u0430 \u0437\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0443 \u043e\u0434\u0431\u0440\u0430\u043d\u0443 \u0438 \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442\u201c, \u201e\u041f\u043e\u0434\u0440\u0448\u043a\u0430 \u0459\u0443\u0434\u0438\u043c\u0430, \u0458\u0430\u0447\u0430\u045a\u0435 \u043d\u0430\u0448\u0438\u0445 \u0434\u0440\u0443\u0448\u0442\u0430\u0432\u0430 \u0438 \u043d\u0430\u0448\u0435\u0433 \u0434\u0440\u0443\u0448\u0442\u0432\u0435\u043d\u043e\u0433 \u043c\u043e\u0434\u0435\u043b\u0430\u201c, \u201e\u041e\u0434\u0440\u0436\u0430\u0432\u0430\u045a\u0435 \u043a\u0432\u0430\u043b\u0438\u0442\u0435\u0442\u0430 \u0436\u0438\u0432\u043e\u0442\u0430: \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442 \u0445\u0440\u0430\u043d\u0435, \u0432\u043e\u0434\u0430 \u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u0430\u201c \u0438 \u201e\u0417\u0430\u0448\u0442\u0438\u0442\u0430 \u043d\u0430\u0448\u0435 \u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u0458\u0435, \u043e\u0434\u0440\u0436\u0430\u0432\u0430\u045a\u0435 \u043d\u0430\u0448\u0438\u0445 \u0432\u0440\u0435\u0434\u043d\u043e\u0441\u0442\u0438\u201c. \u0426\u0438\u0459 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 15 \u0458\u0435 \u0443\u0433\u0440\u0430\u0452\u0435\u043d \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u0443 \u043e\u043a\u0432\u0438\u0440\u0443 \u201e\u041e\u0434\u0440\u0436\u0430\u0432\u0430\u045a\u0435 \u043a\u0432\u0430\u043b\u0438\u0442\u0435\u0442\u0430 \u0436\u0438\u0432\u043e\u0442\u0430: \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442 \u0445\u0440\u0430\u043d\u0435, \u0432\u043e\u0434\u0430 \u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u0430\u201c.","eu_methodology_characteristics":"\u201e\u0426\u0438\u0459 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 11 \u0438\u043c\u0430 \u0437\u0430 \u0446\u0438\u0459 \u043e\u0431\u043d\u043e\u0432\u0443 \u0438 \u043f\u043b\u0430\u043d\u0438\u0440\u0430\u045a\u0435 \u0433\u0440\u0430\u0434\u043e\u0432\u0430 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0459\u0443\u0434\u0441\u043a\u0438\u0445 \u043d\u0430\u0441\u0435\u0459\u0430 \u0442\u0430\u043a\u043e \u0434\u0430 \u043d\u0443\u0434\u0435 \u043c\u043e\u0433\u0443\u045b\u043d\u043e\u0441\u0442\u0438 \u0437\u0430 \u0441\u0432\u0435, \u0441\u0430 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u043e\u043c \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0443\u0441\u043b\u0443\u0433\u0430\u043c\u0430, \u0435\u043d\u0435\u0440\u0433\u0438\u0458\u0438, \u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045a\u0443, \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0443, \u0437\u0435\u043b\u0435\u043d\u0438\u043c \u0458\u0430\u0432\u043d\u0438\u043c \u043f\u043e\u0432\u0440\u0448\u0438\u043d\u0430\u043c\u0430 \u0438 \u0458\u043e\u0448 \u043c\u043d\u043e\u0433\u043e \u0442\u043e\u0433\u0430, \u0443\u0437 \u043f\u043e\u0431\u043e\u0459\u0448\u0430\u045a\u0435 \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u045a\u0430 \u0440\u0435\u0441\u0443\u0440\u0441\u0430 \u0438 \u0441\u043c\u0430\u045a\u0435\u045a\u0435 \u0443\u0442\u0438\u0446\u0430\u0458\u0430 \u043d\u0430 \u0436\u0438\u0432\u043e\u0442\u043d\u0443 \u0441\u0440\u0435\u0434\u0438\u043d\u0443. \u0426\u0438\u0459 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 15 \u0442\u0435\u0436\u0438 \u0437\u0430\u0448\u0442\u0438\u0442\u0438, \u043e\u0431\u043d\u043e\u0432\u0438 \u0438 \u043f\u0440\u043e\u043c\u043e\u0446\u0438\u0458\u0438 \u043e\u0447\u0443\u0432\u0430\u045a\u0430 \u0438 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u045a\u0430 \u043a\u043e\u043f\u043d\u0435\u043d\u0438\u0445, \u0443\u043d\u0443\u0442\u0440\u0430\u0448\u045a\u0438\u0445 \u0432\u043e\u0434\u043d\u0438\u0445 \u0438 \u043f\u043b\u0430\u043d\u0438\u043d\u0441\u043a\u0438\u0445 \u0435\u043a\u043e\u0441\u0438\u0441\u0442\u0435\u043c\u0430. \u0422\u043e \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0435 \u043d\u0430\u043f\u043e\u0440\u0435 \u0437\u0430 \u043e\u0434\u0440\u0436\u0438\u0432\u043e \u0443\u043f\u0440\u0430\u0432\u0459\u0430\u045a\u0435 \u0448\u0443\u043c\u0430\u043c\u0430 \u0438 \u0437\u0430\u0443\u0441\u0442\u0430\u0432\u0459\u0430\u045a\u0435 \u043a\u0440\u0447\u0435\u045a\u0430 \u0448\u0443\u043c\u0430, \u0431\u043e\u0440\u0431\u0443 \u043f\u0440\u043e\u0442\u0438\u0432 \u0434\u0435\u0437\u0435\u0440\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0458\u0435, \u043e\u0431\u043d\u0430\u0432\u0459\u0430\u045a\u0435 \u0434\u0435\u0433\u0440\u0430\u0434\u0438\u0440\u0430\u043d\u043e\u0433 \u0437\u0435\u043c\u0459\u0438\u0448\u0442\u0430 \u0438 \u0442\u043b\u0430, \u0437\u0430\u0443\u0441\u0442\u0430\u0432\u0459\u0430\u045a\u0435 \u0433\u0443\u0431\u0438\u0442\u043a\u0430 \u0431\u0438\u043e\u0434\u0438\u0432\u0435\u0440\u0437\u0438\u0442\u0435\u0442\u0430 \u0438 \u0437\u0430\u0448\u0442\u0438\u0442\u0443 \u0443\u0433\u0440\u043e\u0436\u0435\u043d\u0438\u0445 \u0432\u0440\u0441\u0442\u0430.\u201c","target_number":"11.32","goal_number":"11","indicator_name":"\u0418\u043d\u0434\u0435\u043a\u0441 \u043f\u0440\u0435\u043a\u0440\u0438\u0432\u0430\u045a\u0430 \u0442\u043b\u0430","graph_title":"\u0418\u043d\u0434\u0435\u043a\u0441 \u043f\u0440\u0435\u043a\u0440\u0438\u0432\u0430\u045a\u0430 \u0442\u043b\u0430"}