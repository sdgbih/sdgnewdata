u0438 \u0443\u0431\u0438\u0458\u0435 \u043d\u0430 \u0431\u0438\u043b\u043e \u043a\u043e\u0458\u0438 \u043d\u0430\u0447\u0438\u043d, \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443\u045b\u0438 \u201e\u043a\u0430\u0441\u043d\u0435 \u043f\u043e\u0441\u043b\u0435\u0434\u0438\u0446\u0435\u201c \u043d\u0430\u043f\u0430\u0434\u0430 (\u043a\u043e\u0434\u043e\u0432\u0438 \u041c\u0435\u0452\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0435 \u043a\u043b\u0430\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0458\u0435 \u0431\u043e\u043b\u0435\u0441\u0442\u0438 (\u041c\u041a\u0411) X85 \u0434\u043e Y09 \u0438 Y87.1). \u041d\u0435 \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0435 \u0441\u043c\u0440\u0442\u043d\u0435 \u0441\u043b\u0443\u0447\u0430\u0458\u0435\u0432\u0435 \u0443\u0437\u0440\u043e\u043a\u043e\u0432\u0430\u043d\u0435 \u043f\u0440\u0430\u0432\u043d\u0438\u043c \u0438\u043d\u0442\u0435\u0440\u0432\u0435\u043d\u0446\u0438\u0458\u0430\u043c\u0430 \u0438\u043b\u0438 \u0440\u0430\u0442\u043e\u043c (\u043a\u043e\u0434\u043e\u0432\u0438 \u041c\u041a\u0411 Y35 \u0438 Y36). \u041f\u043e\u0434\u0430\u0446\u0438 \u043e \u0443\u0437\u0440\u043e\u043a\u0443 \u0441\u043c\u0440\u0442\u0438 (\u0423\u0421\u0421) \u043e\u0434\u043d\u043e\u0441\u0435 \u0441\u0435 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u043d\u0438 \u0443\u0437\u0440\u043e\u043a, \u043a\u043e\u0458\u0438 \u0458\u0435 - \u043f\u0440\u0435\u043c\u0430 \u0421\u0432\u0435\u0442\u0441\u043a\u043e\u0458 \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u043e\u0458 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0458\u0438 (\u0421\u0417\u041e) - \u201e\u0431\u043e\u043b\u0435\u0441\u0442 \u0438\u043b\u0438 \u043f\u043e\u0432\u0440\u0435\u0434\u0430 \u043a\u043e\u0458\u0430 \u0458\u0435 \u043f\u043e\u043a\u0440\u0435\u043d\u0443\u043b\u0430 \u043d\u0438\u0437 \u043c\u043e\u0440\u0431\u0438\u0434\u043d\u0438\u0445 \u0434\u043e\u0433\u0430\u0452\u0430\u0458\u0430 \u043a\u043e\u0458\u0438 \u0441\u0443 \u0434\u0438\u0440\u0435\u043a\u0442\u043d\u043e \u0434\u043e\u0432\u0435\u043b\u0438 \u0434\u043e \u0441\u043c\u0440\u0442\u0438 \u0438\u043b\u0438 \u043e\u043a\u043e\u043b\u043d\u043e\u0441\u0442\u0438 \u043d\u0435\u0441\u0440\u0435\u045b\u0435 \u0438\u043b\u0438 \u043d\u0430\u0441\u0438\u0459\u0430 \u043a\u043e\u0458\u0435 \u0458\u0435 \u0438\u0437\u0430\u0437\u0432\u0430\u043b\u043e \u0441\u043c\u0440\u0442\u043e\u043d\u043e\u0441\u043d\u0443 \u043f\u043e\u0432\u0440\u0435\u0434\u0443\u201c. \u041f\u043e\u0434\u0430\u0446\u0438 \u043e \u0423\u0421\u0421-\u0443 \u0441\u0435 \u0438\u0437\u0432\u043e\u0434\u0435 \u0438\u0437 \u0438\u0437\u0432\u043e\u0434\u0430 \u0438\u0437 \u043c\u0430\u0442\u0438\u0447\u043d\u0435 \u043a\u045a\u0438\u0433\u0435 \u0443\u043c\u0440\u043b\u0438\u0445.","rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u0430 \u0426\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 16 \u043e \u043c\u0438\u0440\u0443, \u043f\u0440\u0430\u0432\u0434\u0438 \u0438 \u0458\u0430\u043a\u0438\u043c \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0446\u0438\u0458\u0430\u043c\u0430, \u0448\u0442\u043e \u0458\u0435 \u0443\u0433\u0440\u0430\u0452\u0435\u043d\u043e \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u0443 \u043e\u043a\u0432\u0438\u0440\u0443 \u201e\u041d\u043e\u0432\u0430 \u0435\u0440\u0430 \u0437\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0443 \u043e\u0434\u0431\u0440\u0430\u043d\u0443 \u0438 \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442\u201c \u0438 \u201e\u0417\u0430\u0448\u0442\u0438\u0442\u0430 \u043d\u0430\u0448\u0438\u0445 \u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u0458\u0430, \u043f\u043e\u0448\u0442\u043e\u0432\u0430\u045a\u0435 \u043d\u0430\u0448\u0438\u0445 \u0432\u0440\u0435\u0434\u043d\u043e\u0441\u0442\u0438\u201c. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043c\u043e\u0436\u0435 \u0441\u043c\u0430\u0442\u0440\u0430\u0442\u0438 \u0434\u0435\u043b\u043e\u043c \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e\u0433 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u0426\u0438\u0459\u0430 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 16.1.2 \u201e\u0421\u043c\u0440\u0442\u0438 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u0435 \u0441\u0430 \u0441\u0443\u043a\u043e\u0431\u0438\u043c\u0430 \u043d\u0430 100.000 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0430, \u043f\u043e \u043f\u043e\u043b\u0443, \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u0438 \u0438 \u0443\u0437\u0440\u043e\u043a\u0443\u201c.","methodology_characteristics":"\u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0430 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0430 \u0458\u0435 24. \u0458\u0443\u043b\u0430 2020. \u0433\u043e\u0434\u0438\u043d\u0435 \u0443\u0441\u0432\u043e\u0458\u0438\u043b\u0430 \u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0443 \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u043d\u0435 \u0443\u043d\u0438\u0458\u0435 \u0415\u0423 \u0437\u0430 \u043f\u0435\u0440\u0438\u043e\u0434 2020\u20132025. \u041a\u0430\u043e \u043a\u0459\u0443\u0447\u043d\u0443 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0443 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0435, \u041a\u043e\u043c\u0438\u0441\u0438\u0458\u0430 \u0458\u0435 \u0434\u0435\u0444\u0438\u043d\u0438\u0441\u0430\u043b\u0430 \u043d\u043e\u0432\u0438 \u043f\u0443\u0442 \u043d\u0430\u043f\u0440\u0435\u0434 \u0443 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0443\u043d\u0443\u0442\u0440\u0430\u0448\u045a\u0435 \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u0441\u0430 \u0430\u043a\u0446\u0438\u0458\u0430\u043c\u0430 \u0443 \u043a\u0459\u0443\u0447\u043d\u0438\u043c \u043e\u0431\u043b\u0430\u0441\u0442\u0438\u043c\u0430: \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u0438 \u043a\u0440\u0438\u043c\u0438\u043d\u0430\u043b; \u0442\u0435\u0440\u043e\u0440\u0438\u0437\u0430\u043c \u0438 \u0441\u043f\u0440\u0435\u0447\u0430\u0432\u0430\u045a\u0435 \u043d\u0430\u0441\u0438\u043b\u043d\u0435 \u0440\u0430\u0434\u0438\u043a\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0458\u0435; \u043e\u0442\u043f\u043e\u0440\u043d\u043e\u0441\u0442 \u043d\u0430\u0448\u0435 \u043a\u0440\u0438\u0442\u0438\u0447\u043d\u0435 \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0435 \u0438 \u0458\u0430\u0432\u043d\u0438\u0445 \u043f\u0440\u043e\u0441\u0442\u043e\u0440\u0430; \u0441\u0430\u0458\u0431\u0435\u0440 \u043a\u0440\u0438\u043c\u0438\u043d\u0430\u043b, \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443\u045b\u0438 \u0431\u043e\u0440\u0431\u0443 \u043f\u0440\u043e\u0442\u0438\u0432 \u0441\u0435\u043a\u0441\u0443\u0430\u043b\u043d\u043e\u0433 \u0437\u043b\u043e\u0441\u0442\u0430\u0432\u0459\u0430\u045a\u0430 \u0434\u0435\u0446\u0435; \u0441\u0430\u0440\u0430\u0434\u045a\u0430 \u0443 \u0441\u043f\u0440\u043e\u0432\u043e\u0452\u0435\u045a\u0443 \u0437\u0430\u043a\u043e\u043d\u0430 \u0438 \u0440\u0430\u0437\u043c\u0435\u043d\u0430 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0458\u0430; \u0438 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0435 \u0438 \u0438\u043d\u043e\u0432\u0430\u0446\u0438\u0458\u0435. \u0411\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442 \u0458\u0435 \u043a\u0459\u0443\u0447\u043d\u0438 \u0430\u0441\u043f\u0435\u043a\u0442 \u0436\u0438\u0432\u043e\u0442\u0430 \u0459\u0443\u0434\u0438. \u041d\u0435\u0441\u0438\u0433\u0443\u0440\u043d\u043e\u0441\u0442 \u0431\u0438\u043b\u043e \u043a\u043e\u0458\u0435 \u0432\u0440\u0441\u0442\u0435 \u0458\u0435 \u0438\u0437\u0432\u043e\u0440 \u0441\u0442\u0440\u0430\u0445\u0430 \u0438 \u0431\u0440\u0438\u0433\u0435, \u0448\u0442\u043e \u043d\u0435\u0433\u0430\u0442\u0438\u0432\u043d\u043e \u0443\u0442\u0438\u0447\u0435 \u043d\u0430 \u043a\u0432\u0430\u043b\u0438\u0442\u0435\u0442 \u0436\u0438\u0432\u043e\u0442\u0430. \u0424\u0438\u0437\u0438\u0447\u043a\u0430 \u043d\u0435\u0441\u0438\u0433\u0443\u0440\u043d\u043e\u0441\u0442 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430 \u0441\u0432\u0435 \u0441\u043f\u043e\u0459\u043d\u0435 \u0444\u0430\u043a\u0442\u043e\u0440\u0435 \u043a\u043e\u0458\u0438 \u0431\u0438 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0458\u0430\u043b\u043d\u043e \u043c\u043e\u0433\u043b\u0438 \u0434\u0430 \u0443\u0433\u0440\u043e\u0437\u0435 \u0444\u0438\u0437\u0438\u0447\u043a\u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0442\u0435\u0442 \u043f\u043e\u0458\u0435\u0434\u0438\u043d\u0446\u0430. \u041a\u0440\u0438\u0432\u0438\u0447\u043d\u0430 \u0434\u0435\u043b\u0430 \u0441\u0443 \u0458\u0435\u0434\u043d\u0430 \u043e\u0434 \u043d\u0430\u0458\u043e\u0447\u0438\u0433\u043b\u0435\u0434\u043d\u0438\u0458\u0438\u0445 \u0437\u043b\u043e\u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0430 \u043d\u0435\u0441\u0438\u0433\u0443\u0440\u043d\u043e\u0441\u0442\u0438. \u0410\u043d\u0430\u043b\u0438\u0437\u0435 \u0444\u0438\u0437\u0438\u0447\u043a\u0435 \u043d\u0435\u0441\u0438\u0433\u0443\u0440\u043d\u043e\u0441\u0442\u0438 \u043e\u0431\u0438\u0447\u043d\u043e \u043a\u043e\u043c\u0431\u0438\u043d\u0443\u0458\u0443 \u0438 \u0441\u0443\u0431\u0458\u0435\u043a\u0442\u0438\u0432\u043d\u0435 \u0438 \u043e\u0431\u0458\u0435\u043a\u0442\u0438\u0432\u043d\u0435 \u0430\u0441\u043f\u0435\u043a\u0442\u0435 \u2013 \u0441\u0443\u0431\u0458\u0435\u043a\u0442\u0438\u0432\u043d\u0443 \u043f\u0435\u0440\u0446\u0435\u043f\u0446\u0438\u0458\u0443 \u043d\u0435\u0441\u0438\u0433\u0443\u0440\u043d\u043e\u0441\u0442\u0438 \u0438 \u043e\u0431\u0458\u0435\u043a\u0442\u0438\u0432\u043d\u0438 \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u0430\u043a \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u043c\u0435\u0440\u0435\u043d \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u043e\u043c \u043a\u0440\u0438\u043c\u0438\u043d\u0430\u043b\u0430. \u041a\u0430\u043e \u0442\u0430\u043a\u0430\u0432, \u043e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0434\u043e\u043f\u0440\u0438\u043d\u043e\u0441\u0438 \u0440\u0430\u0437\u0443\u043c\u0435\u0432\u0430\u045a\u0443 \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u0434\u0440\u0443\u0448\u0442\u0432\u0430.","target_number":"16.10","goal_number":"16"}