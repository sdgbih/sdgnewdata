445 \u0438 \u043c\u043e\u0440\u0441\u043a\u0438\u0445 \u0435\u043a\u043e\u0441\u0438\u0441\u0442\u0435\u043c\u0430.","eu_indicator_definition":"\u041e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043c\u0458\u0435\u0440\u0438 \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u0458\u0443 \u0444\u043e\u0441\u0444\u0430\u0442\u0430 (\u041f\u041e4) \u043f\u043e \u043b\u0438\u0442\u0440\u0443 \u0443 \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043e\u0458 \u0444\u0430\u0437\u0438 \u0438\u0437 \u0443\u0437\u043e\u0440\u0430\u043a\u0430 \u0432\u043e\u0434\u0435 \u0438\u0437 \u0440\u0438\u0458\u0435\u0447\u043d\u0438\u0445 \u0441\u0442\u0430\u043d\u0438\u0446\u0430 \u0438 \u0430\u0433\u0440\u0435\u0433\u0438\u0440\u0430\u043d\u043e \u043d\u0430 \u0433\u043e\u0434\u0438\u0448\u045a\u0435 \u043f\u0440\u043e\u0441\u0458\u0435\u0447\u043d\u0435 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442\u0438. \u0423 \u0432\u0438\u0441\u043e\u043a\u0438\u043c \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u0458\u0430\u043c\u0430 \u0444\u043e\u0441\u0444\u0430\u0442 \u043c\u043e\u0436\u0435 \u0438\u0437\u0430\u0437\u0432\u0430\u0442\u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0435 \u0441\u0430 \u043a\u0432\u0430\u043b\u0438\u0442\u0435\u0442\u043e\u043c \u0432\u043e\u0434\u0435, \u043a\u0430\u043e \u0448\u0442\u043e \u0458\u0435 \u0435\u0443\u0442\u0440\u043e\u0444\u0438\u043a\u0430\u0446\u0438\u0458\u0430, \u043f\u043e\u043a\u0440\u0435\u0442\u0430\u045a\u0435\u043c \u0440\u0430\u0441\u0442\u0430 \u0432\u043e\u0434\u0435\u043d\u0438\u0445 \u0431\u0438\u0459\u0430\u043a\u0430, \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443\u045b\u0438 \u0430\u043b\u0433\u0435. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043c\u043e\u0436\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438\u0442\u0438 \u0437\u0430 \u0438\u043b\u0443\u0441\u0442\u0440\u0430\u0446\u0438\u0458\u0443 \u0433\u043