8\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 6.3.2 \u201e\u0423\u0434\u0438\u043e \u0432\u043e\u0434\u043d\u0438\u0445 \u0442\u0458\u0435\u043b\u0430 \u0441\u0430 \u0434\u043e\u0431\u0440\u0438\u043c \u043a\u0432\u0430\u043b\u0438\u0442\u0435\u0442\u043e\u043c \u0430\u043c\u0431\u0438\u0458\u0435\u043d\u0442\u0430\u043b\u043d\u0435 \u0432\u043e\u0434\u0435\u201c. \u0417\u0430\u0448\u0442\u0438\u0442\u0430 \u0432\u043e\u0434\u043d\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0430, \u0432\u043e\u0434\u043d\u0438\u0445 \u0435\u043a\u043e\u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0438 \u0432\u043e\u0434\u0435 \u0437\u0430 \u043f\u0438\u045b\u0435 \u0438 \u043a\u0443\u043f\u0430\u045a\u0435 \u0458\u0435 \u043a\u0430\u043c\u0435\u043d \u0442\u0435\u043c\u0435\u0459\u0430\u0446 \u0435\u043a\u043e\u043b\u043e\u0448\u043a\u0435 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0435 \u0415\u0423. \u0412\u043e\u0434\u043d\u0430 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0430 \u0415\u0423 \u043f\u0440\u0443\u0436\u0430 \u043e\u043a\u0432\u0438\u0440 \u0437\u0430 \u0441\u0432\u0435\u043e\u0431\u0443\u0445\u0432\u0430\u0442\u043d\u043e \u0440\u0435\u0448\u0430\u0432\u0430\u045a\u0435 \u0437\u0430\u0448\u0442\u0438\u0442\u0435 \u0432\u043e\u0434\u0430 \u0438 \u0437\u0430 \u043f\u043e\u0441\u0442\u0438\u0437\u0430\u045a\u0435 \u0434\u043e\u0431\u0440\u043e\u0433 \u0441\u0442\u0430\u045a\u0430 \u0443\u043d\u0443\u0442\u0440\u0430\u0448\u045a\u0438\u0445 \u043f\u043e\u0432\u0440\u0448\u0438\u043d\u0441\u043a\u0438\u0445 \u0432\u043e\u0434\u0430, \u043f\u0440\u0435\u043b\u0430\u0437\u043d\u0438\u0445 \u0432\u043e\u0434\u0430, \u043f\u0440\u0438\u043e\u0431\u0430\u043b\u043d\u0438\u0445 \u0432\u043e\u0434\u0430 \u0438 \u043f\u043e\u0434\u0437\u0435\u043c\u043d\u0438\u0445 \u0432\u043e\u0434\u0430. \u041e\u043a\u0432\u0438\u0440\u043d\u0430 \u0434\u0438\u0440\u0435\u043a\u0442\u0438\u0432\u0430 \u043e \u0432\u043e\u0434\u0430\u043c\u0430 \u0458\u0435 \u0433\u043b\u0430\u0432\u043d\u043e \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u043e \u0437\u0430\u043a\u043e\u043d\u043e\u0434\u0430\u0432\u0441\u0442\u0432\u043e \u043a\u043e\u0458\u0435 \u0438\u043c\u0430 \u0437\u0430 \u0446\u0438\u0459 \u0441\u043f\u0440\u0435\u0447\u0430\u0432\u0430\u045a\u0435 \u0437\u0430\u0433\u0430\u0452\u0435\u045a\u0430 \u0432\u043e\u0434\u0435. \u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0430 \u0415\u0423 \u0437\u0430 \u0431\u0438\u043e\u0434\u0438\u0432\u0435\u0440\u0437\u0438\u0442\u0435\u0442 \u0434\u043e 2030. \u0433\u043e\u0434\u0438\u043d\u0435 \u043f\u043e\u0434\u0440\u0436\u0430\u0432\u0430 \u0441\u043f\u0440\u043e\u0432\u043e\u0452\u0435\u045a\u0435 \u0446\u0438\u0459\u0430 \u041e\u043a\u0432\u0438\u0440\u043d\u0435 \u0434\u0438\u0440\u0435\u043a\u0442\u0438\u0432\u0435 \u043e \u0432\u043e\u0434\u0430\u043c\u0430 \u0437\u0430\u0445\u0442\u0435\u0432\u0430\u0458\u0443\u045b\u0438 \u043e\u0434 \u0434\u0440\u0436\u0430\u0432\u0430 \u0447\u043b\u0430\u043d\u0438\u0446\u0430 \u0434\u0430 \u043e\u0431\u043d\u043e\u0432\u0435 \u0441\u043b\u0430\u0442\u043a\u043e\u0432\u043e\u0434\u043d\u0435 \u0435\u043a\u043e\u0441\u0438\u0441\u0442\u0435\u043c\u0435.","methodology_characteristics":"\u041e\u0441\u043c\u0438 \u0430\u043a\u0446\u0438\u043e\u043d\u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u043c \u0437\u0430 \u0436\u0438\u0432\u043e\u0442\u043d\u0443 \u0441\u0440\u0435\u0434\u0438\u043d\u0443 \u043f\u043e\u0441\u0442\u0430\u0432\u0459\u0430 \u0430\u0433\u0435\u043d\u0434\u0443 \u0435\u043a\u043e\u043b\u043e\u0448\u043a\u0435 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0435 \u0437\u0430 \u0433\u043e\u0434\u0438\u043d\u0435 \u043e\u0434 2021. \u0434\u043e 2030. \u0433\u043e\u0434\u0438\u043d\u0435 \u0438 \u0438\u0437\u0440\u0438\u0447\u0438\u0442\u043e \u043f\u043e\u043c\u0438\u045a\u0435 \u043f\u0438\u0442\u0430\u045a\u0430 \u0432\u0435\u0437\u0430\u043d\u0430 \u0437\u0430 \u0432\u043e\u0434\u0443 \u0443 \u0434\u0432\u0430 \u043e\u0434 \u0441\u0432\