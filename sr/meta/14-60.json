{"indicator_number":14.6,"reporting_status":"notapplicable","published":false,"sdg_goal":"14","data_non_statistical":false,"graph_type":"line","indicator_sort_order":"14-60","source_active_1":true,"source_organisation_1":null,"source_url_1":"","indicator_definition":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043f\u043e\u043a\u0430\u0437\u0443\u0458\u0435 \u0443\u0434\u0435\u043e \u0435\u0443\u0442\u0440\u043e\u0444\u0438\u0447\u043d\u0438\u0445 \u043c\u043e\u0440\u0441\u043a\u0438\u0445 \u0432\u043e\u0434\u0430 \u0443 \u0435\u043a\u0441\u043a\u043b\u0443\u0437\u0438\u0432\u043d\u043e\u0458 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u043e\u0458 \u0437\u043e\u043d\u0438 (\u0418\u0415\u0417). \u041f\u043e\u0434\u0440\u0443\u0447\u0458\u0435 \u0441\u0435 \u043a\u043b\u0430\u0441\u0438\u0444\u0438\u043a\u0443\u0458\u0435 \u043a\u0430\u043e \u0435\u0443\u0442\u0440\u043e\u0444\u0438\u0447\u043d\u043e \u0430\u043a\u043e \u0441\u0443, \u0442\u043e\u043a\u043e\u043c \u0432\u0438\u0448\u0435 \u043e\u0434 25% \u0434\u0430\u043d\u0430 \u043f\u043e\u0441\u043c\u0430\u0442\u0440\u0430\u045a\u0430 \u0443 \u0434\u0430\u0442\u043e\u0458 \u0433\u043e\u0434\u0438\u043d\u0438, \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u0458\u0435 \u0445\u043b\u043e\u0440\u043e\u0444\u0438\u043b\u0430 \u0430, \u043a\u0430\u043e \u0437\u0430\u043c\u0435\u043d\u0430 \u0437\u0430 \u0435\u0443\u0442\u0440\u043e\u0444\u0438\u043a\u0430\u0446\u0438\u0458\u0443, \u0438\u0437\u043d\u0430\u0434 90. \u043f\u0435\u0440\u0446\u0435\u043d\u0442\u0438\u043b\u0430 \u0440\u0435\u0444\u0435\u0440\u0435\u043d\u0442\u043d\u0435 \u043e\u0441\u043d\u043e\u0432\u043d\u0435 \u0432\u0440\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u0438\u0437 \u043f\u0435\u0440\u0438\u043e\u0434\u0430 1998\u20132017. \u0415\u0443\u0442\u0440\u043e\u0444\u0438\u043a\u0430\u0446\u0438\u0458\u0430 \u0458\u0435 \u043f\u0440\u043e\u0446\u0435\u0441 \u043a\u043e\u0458\u0438\u043c \u0432\u0438\u0448\u0430\u043a \u0445\u0440\u0430\u043d\u0459\u0438\u0432\u0438\u0445 \u043c\u0430\u0442\u0435\u0440\u0438\u0458\u0430 \u2013 \u0443\u0433\u043b\u0430\u0432\u043d\u043e\u043c \u0444\u043e\u0441\u0444\u043e\u0440\u0430 \u0438 \u0430\u0437\u043e\u0442\u0430 \u2013 \u0434\u043e\u0432\u043e\u0434\u0438 \u0434\u043e \u043f\u043e\u0432\u0435\u045b\u0430\u043d\u043e\u0433 \u0440\u0430\u0441\u0442\u0430 \u0431\u0438\u0459\u043d\u043e\u0433 \u043c\u0430\u0442\u0435\u0440\u0438\u0458\u0430\u043b\u0430, \u043f\u043e\u0441\u0435\u0431\u043d\u043e \u0446\u0432\u0435\u0442\u0430\u045a\u0430 \u0430\u043b\u0433\u0438, \u0443 \u0432\u043e\u0434\u0435\u043d\u043e\u043c \u0442\u0435\u043b\u0443, \u0448\u0442\u043e \u0440\u0435\u0437\u0443\u043b\u0442\u0438\u0440\u0430 \u0441\u043c\u0430\u045a\u0435\u045a\u0435\u043c \u043a\u0432\u0430\u043b\u0438\u0442\u0435\u0442\u0430 \u0432\u043e\u0434\u0435. \u0422\u043e, \u0437\u0430\u0443\u0437\u0432\u0440\u0430\u0442, \u043c\u043e\u0436\u0435 \u0438\u0437\u0430\u0437\u0432\u0430\u0442\u0438 \u0441\u043c\u0440\u0442 \u0432\u043e\u0434\u0435\u043d\u0438\u0445 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u043c\u0430 \u0443\u0441\u043b\u0435\u0434 \u0445\u0438\u043f\u043e\u043a\u0441\u0438\u0458\u0435. \u0410\u043d\u0442\u0440\u043e\u043f\u043e\u0433\u0435\u043d\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438, \u043a\u0430\u043e \u0448\u0442\u043e \u0441\u0443 \u043f\u043e\u0459\u043e\u043f\u0440\u0438\u0432\u0440\u0435\u0434\u0430, \u0430\u043a\u0432\u0430\u043a\u0443\u043b\u0442\u0443\u0440\u0430, \u0438\u043d\u0434\u0443\u0441\u0442\u0440\u0438\u0458\u0430 \u0438 \u043a\u0430\u043d\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0458\u0430, \u0433\u043b\u0430\u0432\u043d\u0438 \u0441\u0443 \u0438\u0437\u0432\u043e\u0440\u0438 \u0443\u043d\u043e\u0441\u0430 \u0445\u0440\u0430\u043d\u0459\u0438\u0432\u0438\u0445 \u043c\u0430\u0442\u0435\u0440\u0438\u0458\u0430 \u0443 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430\u0442\u0438\u0447\u043d\u0430 \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0430.","rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u0430 \u0426\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 14 \u043e \u043e\u0447\u0443\u0432\u0430\u045a\u0443 \u0438 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u043c \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u045a\u0443 \u043e\u043a\u0435\u0430\u043d\u0430, \u043c\u043e\u0440\u0430 \u0438 \u043c\u043e\u0440\u0441\u043a\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0430 \u0437\u0430 \u043e\u0434\u0440\u0436\u0438\u0432\u0438 \u0440\u0430\u0437\u0432\u043e\u0458, \u0448\u0442\u043e \u0458\u0435 \u0443\u0433\u0440\u0430\u0452\u0435\u043d\u043e \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u0443 \u043e\u043a\u0432\u0438\u0440\u0443 \u201e\u041e\u0434\u0440\u0436\u0430\u0432\u0430\u045a\u0435 \u043a\u0432\u0430\u043b\u0438\u0442\u0435\u0442\u0430 \u0436\u0438\u0432\u043e\u0442\u0430: \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442 \u0445\u0440\u0430\u043d\u0435, \u0432\u043e\u0434\u0430 \u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u0430\u201c. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043c\u043e\u0436\u0435 \u0441\u043c\u0430\u0442\u0440\u0430\u0442\u0438 \u0441\u043b\u0438\u0447\u043d\u0438\u043c \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e\u043c \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0443 \u0437\u0430 \u0426\u0438\u0459 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 14.1.1: (\u0430) \u201e\u0418\u043d\u0434\u0435\u043a\u0441 \u0435\u0443\u0442\u0440\u043e\u0444\u0438\u043a\u0430\u0446\u0438\u0458\u0435 \u043e\u0431\u0430\u043b\u0435\u201c.","methodology_characteristics":"\u0426\u0438\u0459 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 14 \u0438\u043c\u0430 \u0437\u0430 \u0446\u0438\u0459 \u043e\u0447\u0443\u0432\u0430\u045a\u0435 \u0438 \u043e\u0434\u0440\u0436\u0438\u0432\u043e \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u045a\u0435 \u043e\u043a\u0435\u0430\u043d\u0430, \u043c\u043e\u0440\u0430 \u0438 \u043c\u043e\u0440\u0441\u043a\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0430, \u0448\u0442\u043e \u0437\u0430\u0445\u0442\u0435\u0432\u0430, \u0438\u0437\u043c\u0435\u0452\u0443 \u043e\u0441\u0442\u0430\u043b\u043e\u0433, \u0441\u043f\u0440\u0435\u0447\u0430\u0432\u0430\u045a\u0435 \u0438 \u0441\u043c\u0430\u045a\u0435\u045a\u0435 \u0437\u0430\u0433\u0430\u0452\u0435\u045a\u0430 \u043c\u043e\u0440\u0430 \u0438 \u0443\u0442\u0438\u0446\u0430\u0458\u0430 \u0437\u0430\u043a\u0438\u0441\u0435\u0459\u0430\u0432\u0430\u045a\u0430 \u043e\u043a\u0435\u0430\u043d\u0430. \u041e\u043a\u0432\u0438\u0440\u043d\u0430 \u0434\u0438\u0440\u0435\u043a\u0442\u0438\u0432\u0430 \u043e \u043c\u043e\u0440\u0441\u043a\u043e\u0458 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0438 (MSFD) \u0437\u0430\u0445\u0442\u0435\u0432\u0430 \u043e\u0434 \u0434\u0440\u0436\u0430\u0432\u0430 \u0447\u043b\u0430\u043d\u0438\u0446\u0430 \u0434\u0430 \u0438\u0437\u0432\u0435\u0448\u0442\u0430\u0432\u0430\u0458\u0443 \u043e \u0435\u0443\u0442\u0440\u043e\u0444\u0438\u043a\u0430\u0446\u0438\u0458\u0438 \u0437\u0430 \u0441\u0432\u043e\u0458\u0430 \u0440\u0435\u0433\u0438\u043e\u043d\u0430\u043b\u043d\u0430 \u043c\u043e\u0440\u0430 \u0441\u0432\u0430\u043a\u0438\u0445 6 \u0433\u043e\u0434\u0438\u043d\u0430.","eu_indicator_definition":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043f\u043e\u043a\u0430\u0437\u0443\u0458\u0435 \u0443\u0434\u0435\u043e \u0435\u0443\u0442\u0440\u043e\u0444\u0438\u0447\u043d\u0438\u0445 \u043c\u043e\u0440\u0441\u043a\u0438\u0445 \u0432\u043e\u0434\u0430 \u0443 \u0435\u043a\u0441\u043a\u043b\u0443\u0437\u0438\u0432\u043d\u043e\u0458 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u043e\u0458 \u0437\u043e\u043d\u0438 (\u0418\u0415\u0417). \u041f\u043e\u0434\u0440\u0443\u0447\u0458\u0435 \u0441\u0435 \u043a\u043b\u0430\u0441\u0438\u0444\u0438\u043a\u0443\u0458\u0435 \u043a\u0430\u043e \u0435\u0443\u0442\u0440\u043e\u0444\u0438\u0447\u043d\u043e \u0430\u043a\u043e \u0441\u0443, \u0442\u043e\u043a\u043e\u043c \u0432\u0438\u0448\u0435 \u043e\u0434 25% \u0434\u0430\u043d\u0430 \u043f\u043e\u0441\u043c\u0430\u0442\u0440\u0430\u045a\u0430 \u0443 \u0434\u0430\u0442\u043e\u0458 \u0433\u043e\u0434\u0438\u043d\u0438, \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u0458\u0435 \u0445\u043b\u043e\u0440\u043e\u0444\u0438\u043b\u0430 \u0430, \u043a\u0430\u043e \u0437\u0430\u043c\u0435\u043d\u0430 \u0437\u0430 \u0435\u0443\u0442\u0440\u043e\u0444\u0438\u043a\u0430\u0446\u0438\u0458\u0443, \u0438\u0437\u043d\u0430\u0434 90. \u043f\u0435\u0440\u0446\u0435\u043d\u0442\u0438\u043b\u0430 \u0440\u0435\u0444\u0435\u0440\u0435\u043d\u0442\u043d\u0435 \u043e\u0441\u043d\u043e\u0432\u043d\u0435 \u0432\u0440\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u0438\u0437 \u043f\u0435\u0440\u0438\u043e\u0434\u0430 1998\u20132017. \u0415\u0443\u0442\u0440\u043e\u0444\u0438\u043a\u0430\u0446\u0438\u0458\u0430 \u0458\u0435 \u043f\u0440\u043e\u0446\u0435\u0441 \u043a\u043e\u0458\u0438\u043c \u0432\u0438\u0448\u0430\u043a \u0445\u0440\u0430\u043d\u0459\u0438\u0432\u0438\u0445 \u043c\u0430\u0442\u0435\u0440\u0438\u0458\u0430 \u2013 \u0443\u0433\u043b\u0430\u0432\u043d\u043e\u043c \u0444\u043e\u0441\u0444\u043e\u0440\u0430 \u0438 \u0430\u0437\u043e\u0442\u0430 \u2013 \u0434\u043e\u0432\u043e\u0434\u0438 \u0434\u043e \u043f\u043e\u0432\u0435\u045b\u0430\u043d\u043e\u0433 \u0440\u0430\u0441\u0442\u0430 \u0431\u0438\u0459\u043d\u043e\u0433 \u043c\u0430\u0442\u0435\u0440\u0438\u0458\u0430\u043b\u0430, \u043f\u043e\u0441\u0435\u0431\u043d\u043e \u0446\u0432\u0435\u0442\u0430\u045a\u0430 \u0430\u043b\u0433\u0438, \u0443 \u0432\u043e\u0434\u0435\u043d\u043e\u043c \u0442\u0435\u043b\u0443, \u0448\u0442\u043e \u0440\u0435\u0437\u0443\u043b\u0442\u0438\u0440\u0430 \u0441\u043c\u0430\u045a\u0435\u045a\u0435\u043c \u043a\u0432\u0430\u043b\u0438\u0442\u0435\u0442\u0430 \u0432\u043e\u0434\u0435. \u0422\u043e, \u0437\u0430\u0443\u0437\u0432\u0440\u0430\u0442, \u043c\u043e\u0436\u0435 \u0438\u0437\u0430\u0437\u0432\u0430\u0442\u0438 \u0441\u043c\u0440\u0442 \u0432\u043e\u0434\u0435\u043d\u0438\u0445 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u043c\u0430 \u0443\u0441\u043b\u0435\u0434 \u0445\u0438\u043f\u043e\u043a\u0441\u0438\u0458\u0435. \u0410\u043d\u0442\u0440\u043e\u043f\u043e\u0433\u0435\u043d\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438, \u043a\u0430\u043e \u0448\u0442\u043e \u0441\u0443 \u043f\u043e\u0459\u043e\u043f\u0440\u0438\u0432\u0440\u0435\u0434\u0430, \u0430\u043a\u0432\u0430\u043a\u0443\u043b\u0442\u0443\u0440\u0430, \u0438\u043d\u0434\u0443\u0441\u0442\u0440\u0438\u0458\u0430 \u0438 \u043a\u0430\u043d\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0458\u0430, \u0433\u043b\u0430\u0432\u043d\u0438 \u0441\u0443 \u0438\u0437\u0432\u043e\u0440\u0438 \u0443\u043d\u043e\u0441\u0430 \u0445\u0440\u0430\u043d\u0459\u0438\u0432\u0438\u0445 \u043c\u0430\u0442\u0435\u0440\u0438\u0458\u0430 \u0443 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430\u0442\u0438\u0447\u043d\u0430 \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0430.","eu_rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u0430 \u0426\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 14 \u043e \u043e\u0447\u0443\u0432\u0430\u045a\u0443 \u0438 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u043c \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u045a\u0443 \u043e\u043a\u0435\u0430\u043d\u0430, \u043c\u043e\u0440\u0430 \u0438 \u043c\u043e\u0440\u0441\u043a\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0430 \u0437\u0430 \u043e\u0434\u0440\u0436\u0438\u0432\u0438 \u0440\u0430\u0437\u0432\u043e\u0458, \u0448\u0442\u043e \u0458\u0435 \u0443\u0433\u0440\u0430\u0452\u0435\u043d\u043e \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u0443 \u043e\u043a\u0432\u0438\u0440\u0443 \u201e\u041e\u0434\u0440\u0436\u0430\u0432\u0430\u045a\u0435 \u043a\u0432\u0430\u043b\u0438\u0442\u0435\u0442\u0430 \u0436\u0438\u0432\u043e\u0442\u0430: \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442 \u0445\u0440\u0430\u043d\u0435, \u0432\u043e\u0434\u0430 \u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u0430\u201c. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043c\u043e\u0436\u0435 \u0441\u043c\u0430\u0442\u0440\u0430\u0442\u0438 \u0441\u043b\u0438\u0447\u043d\u0438\u043c \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e\u043c \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0443 \u0437\u0430 \u0426\u0438\u0459 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 14.1.1: (\u0430) \u201e\u0418\u043d\u0434\u0435\u043a\u0441 \u0435\u0443\u0442\u0440\u043e\u0444\u0438\u043a\u0430\u0446\u0438\u0458\u0435 \u043e\u0431\u0430\u043b\u0435\u201c.","eu_methodology_characteristics":"\u0426\u0438\u0459 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 14 \u0438\u043c\u0430 \u0437\u0430 \u0446\u0438\u0459 \u043e\u0447\u0443\u0432\u0430\u045a\u0435 \u0438 \u043e\u0434\u0440\u0436\u0438\u0432\u043e \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u045a\u0435 \u043e\u043a\u0435\u0430\u043d\u0430, \u043c\u043e\u0440\u0430 \u0438 \u043c\u043e\u0440\u0441\u043a\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0430, \u0448\u0442\u043e \u0437\u0430\u0445\u0442\u0435\u0432\u0430, \u0438\u0437\u043c\u0435\u0452\u0443 \u043e\u0441\u0442\u0430\u043b\u043e\u0433, \u0441\u043f\u0440\u0435\u0447\u0430\u0432\u0430\u045a\u0435 \u0438 \u0441\u043c\u0430\u045a\u0435\u045a\u0435 \u0437\u0430\u0433\u0430\u0452\u0435\u045a\u0430 \u043c\u043e\u0440\u0430 \u0438 \u0443\u0442\u0438\u0446\u0430\u0458\u0430 \u0437\u0430\u043a\u0438\u0441\u0435\u0459\u0430\u0432\u0430\u045a\u0430 \u043e\u043a\u0435\u0430\u043d\u0430. \u041e\u043a\u0432\u0438\u0440\u043d\u0430 \u0434\u0438\u0440\u0435\u043a\u0442\u0438\u0432\u0430 \u043e \u043c\u043e\u0440\u0441\u043a\u043e\u0458 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0438 (MSFD) \u0437\u0430\u0445\u0442\u0435\u0432\u0430 \u043e\u0434 \u0434\u0440\u0436\u0430\u0432\u0430 \u0447\u043b\u0430\u043d\u0438\u0446\u0430 \u0434\u0430 \u0438\u0437\u0432\u0435\u0448\u0442\u0430\u0432\u0430\u0458\u0443 \u043e \u0435\u0443\u0442\u0440\u043e\u0444\u0438\u043a\u0430\u0446\u0438\u0458\u0438 \u0437\u0430 \u0441\u0432\u043e\u0458\u0430 \u0440\u0435\u0433\u0438\u043e\u043d\u0430\u043b\u043d\u0430 \u043c\u043e\u0440\u0430 \u0441\u0432\u0430\u043a\u0438\u0445 6 \u0433\u043e\u0434\u0438\u043d\u0430.","target_number":"14.60","goal_number":"14","indicator_name":"Marine waters affected by eutrophication","graph_title":"Marine waters affected by eutrophication"}