{"indicator_number":1.4,"reporting_status":"notstarted","published":true,"sdg_goal":"1","data_non_statistical":false,"graph_type":"line","indicator_sort_order":"01-40","source_active_1":true,"source_organisation_1":"ESS (SILC)","source_url_1":"https://ec.europa.eu/eurostat/databrowser/view/sdg_01_40/default/table","footer_fields":[{"label":"\u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u0440\u0435\u0444\u0435\u0440\u0435\u043d\u0442\u043d\u0438 \u043c\u0435\u0442\u0430\u043f\u043e\u0434\u0430\u0446\u0438","value":"<a href=\"https://ec.europa.eu/eurostat/cache/metadata/en/sdg_01_40_esmsip2.htm\" target=\"_blank\">Eurostat Metadata Report (sdg_01_40)</a>"}],"indicator_definition":"\u0421\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u043e \u0438 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u0430 \u0438\u0441\u043a\u0459\u0443\u0447\u0435\u043d\u043e\u0441\u0442 \u0448\u0442\u0435\u0442\u0435 \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u043d\u0438\u043c \u0436\u0438\u0432\u043e\u0442\u0438\u043c\u0430 \u0438 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0430\u0432\u0430\u0458\u0443 \u043c\u043e\u0433\u0443\u045b\u043d\u043e\u0441\u0442\u0438 \u0459\u0443\u0434\u0438 \u0434\u0430 \u043e\u0441\u0442\u0432\u0430\u0440\u0435 \u0441\u0432\u043e\u0458 \u043f\u0443\u043d\u0438 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0458\u0430\u043b \u0442\u0430\u043a\u043e \u0448\u0442\u043e \u0443\u0442\u0438\u0447\u0443 \u043d\u0430 \u045a\u0438\u0445\u043e\u0432\u043e \u0437\u0434\u0440\u0430\u0432\u0459\u0435 \u0438 \u0431\u043b\u0430\u0433\u043e\u0441\u0442\u0430\u045a\u0435 \u0438 \u0441\u043c\u0430\u045a\u0443\u0458\u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u043d\u0435 \u0438\u0441\u0445\u043e\u0434\u0435. \u0422\u043e \u0437\u0430\u0443\u0437\u0432\u0440\u0430\u0442 \u0441\u043c\u0430\u045a\u0443\u0458\u0435 \u043c\u043e\u0433\u0443\u045b\u043d\u043e\u0441\u0442\u0438 \u0437\u0430 \u0443\u0441\u043f\u0458\u0435\u0448\u0430\u043d \u0436\u0438\u0432\u043e\u0442 \u0438 \u0434\u043e\u0434\u0430\u0442\u043d\u043e \u043f\u043e\u0432\u0435\u045b\u0430\u0432\u0430 \u0440\u0438\u0437\u0438\u043a \u043e\u0434 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430. \u0411\u0435\u0437 \u0435\u0444\u0438\u043a\u0430\u0441\u043d\u043e\u0433 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0430, \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u0445, \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u0438\u0445, \u043f\u043e\u0440\u0435\u0441\u043a\u0438\u0445 \u043e\u043b\u0430\u043a\u0448\u0438\u0446\u0430 \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0437\u0430\u043f\u043e\u0448\u0459\u0430\u0432\u0430\u045a\u0430, \u0440\u0438\u0437\u0438\u043a \u043e\u0434 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u0441\u0435 \u043f\u0440\u0435\u043d\u043e\u0441\u0438 \u0441\u0430 \u0458\u0435\u0434\u043d\u0435 \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0458\u0435 \u043d\u0430 \u0434\u0440\u0443\u0433\u0443. \u0422\u043e \u0443\u0437\u0440\u043e\u043a\u0443\u0458\u0435 \u043e\u043f\u0441\u0442\u0430\u043d\u0430\u043a \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u0438 \u0441\u0442\u043e\u0433\u0430 \u0441\u0442\u0432\u0430\u0440\u0430 \u0432\u0438\u0448\u0435 \u043d\u0435\u0458\u0435\u0434\u043d\u0430\u043a\u043e\u0441\u0442\u0438, \u0448\u0442\u043e \u043c\u043e\u0436\u0435 \u0434\u043e\u0432\u0435\u0441\u0442\u0438 \u0434\u043e \u0434\u0443\u0433\u043e\u0440\u043e\u0447\u043d\u043e\u0433 \u0433\u0443\u0431\u0438\u0442\u043a\u0430 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043e\u0434 \u0441\u0442\u0440\u0430\u043d\u0435 \u0447\u0438\u0442\u0430\u0432\u0438\u0445 \u0433\u0440\u0443\u043f\u0430 \u0434\u0440\u0443\u0448\u0442\u0432\u0430 \u0438 \u043e\u043c\u0435\u0442\u0430\u0442\u0438 \u0438\u043d\u043a\u043b\u0443\u0437\u0438\u0432\u043d\u0438 \u0438 \u043e\u0434\u0440\u0436\u0438\u0432\u0438 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0438 \u0440\u0430\u0441\u0442.","rationale":"\u0409\u0443\u0434\u0438 \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u0438 \u043e\u0434 0 \u0434\u043e 64 \u0433\u043e\u0434\u0438\u043d\u0435 \u043a\u043e\u0458\u0438 \u0436\u0438\u0432\u0435 \u0443 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0432\u0438\u043c\u0430 \u0443 \u043a\u043e\u0458\u0438\u043c\u0430 \u0441\u0443 \u043e\u0434\u0440\u0430\u0441\u043b\u0438 \u0440\u0430\u0434\u0438\u043b\u0438 \u0440\u0430\u0434\u043d\u043e \u0432\u0440\u0435\u043c\u0435 \u0458\u0435\u0434\u043d\u0430\u043a\u043e \u0438\u043b\u0438 \u043c\u0430\u045a\u0435 \u043e\u0434 20% \u045a\u0438\u0445\u043e\u0432\u043e\u0433 \u0443\u043a\u0443\u043f\u043d\u043e\u0433 \u043a\u043e\u043c\u0431\u0438\u043d\u043e\u0432\u0430\u043d\u043e\u0433 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0458\u0430\u043b\u0430 \u0440\u0430\u0434\u043d\u043e\u0433 \u0432\u0440\u0435\u043c\u0435\u043d\u0430 \u0442\u043e\u043a\u043e\u043c \u043f\u0440\u0435\u0442\u0445\u043e\u0434\u043d\u0435 \u0433\u043e\u0434\u0438\u043d\u0435. \u041e\u0434\u0440\u0430\u0441\u043b\u0438 \u0431\u0440\u043e\u0458 \u0459\u0443\u0434\u0438 \u0443 \u0434\u043e\u0431\u0438 \u043e\u0434 18 \u0434\u043e 64 \u0433\u043e\u0434\u0438\u043d\u0435. \u0421\u0442\u0443\u0434\u0435\u043d\u0442\u0438 \u0443\u0437\u0440\u0430\u0441\u0442\u0430 \u043e\u0434 18 \u0434\u043e 24 \u0433\u043e\u0434\u0438\u043d\u0435; \u0459\u0443\u0434\u0438 \u043a\u043e\u0458\u0438 \u0441\u0443 \u043f\u0435\u043d\u0437\u0438\u043e\u043d\u0438\u0441\u0430\u043d\u0438 \u0443 \u0441\u043a\u043b\u0430\u0434\u0443 \u0441\u0430 \u0441\u0432\u043e\u0458\u0438\u043c \u0441\u0430\u043c\u043e-\u0434\u0435\u0444\u0438\u043d\u0438\u0441\u0430\u043d\u0438\u043c \u0442\u0440\u0435\u043d\u0443\u0442\u043d\u0438\u043c \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0438\u043c \u0441\u0442\u0430\u0442\u0443\u0441\u043e\u043c \u0438\u043b\u0438 \u043a\u043e\u0458\u0438 \u043f\u0440\u0438\u043c\u0430\u0458\u0443 \u0431\u0438\u043b\u043e \u043a\u043e\u0458\u0443 \u043f\u0435\u043d\u0437\u0438\u0458\u0443 (\u043e\u0441\u0438\u043c \u043f\u043e\u0440\u043e\u0434\u0438\u0447\u043d\u0435 \u043f\u0435\u043d\u0437\u0438\u0458\u0435); \u0438 \u0459\u0443\u0434\u0438 \u0443 \u0441\u0442\u0430\u0440\u043e\u0441\u043d\u043e\u0458 \u0433\u0440\u0443\u043f\u0438 \u043e\u0434 60 \u0434\u043e 64 \u0433\u043e\u0434\u0438\u043d\u0435 \u043a\u043e\u0458\u0438 \u0441\u0443 \u043d\u0435\u0430\u043a\u0442\u0438\u0432\u043d\u0438 \u0438 \u0436\u0438\u0432\u0435 \u0443 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0432\u0443 \u0433\u0434\u0435 \u0441\u0443 \u0433\u043b\u0430\u0432\u043d\u0438 \u043f\u0440\u0438\u0445\u043e\u0434\u0438 \u043f\u0435\u043d\u0437\u0438\u0458\u0435, \u043d\u0435 \u0443\u0437\u0438\u043c\u0430\u0458\u0443 \u0441\u0435 \u0443 \u043e\u0431\u0437\u0438\u0440. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0458\u0435 \u0434\u0435\u043e \u043c\u0443\u043b\u0442\u0438\u0434\u0438\u043c\u0435\u043d\u0437\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u0433 \u0438\u043d\u0434\u0435\u043a\u0441\u0430 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430.","methodology_characteristics":"\u0420\u0435\u0444\u0435\u0440\u0435\u043d\u0442\u043d\u0438 \u043f\u0435\u0440\u0438\u043e\u0434 \u0458\u0435 \u0433\u043e\u0434\u0438\u043d\u0430 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0430. \u0417\u0430 \u0441\u0432\u0435 \u0437\u0435\u043c\u0459\u0435, \u0440\u0435\u0444\u0435\u0440\u0435\u043d\u0442\u043d\u0438 \u043f\u0435\u0440\u0438\u043e\u0434 \u0437\u0430 \u0432\u0430\u0440\u0438\u0458\u0430\u0431\u043b\u0435 \u043f\u0440\u0438\u0445\u043e\u0434\u0430 \u0443 \u0415\u0423-\u0421\u0418\u041b\u0426 \u0458\u0435 \u043f\u0440\u0435\u0442\u0445\u043e\u0434\u043d\u0430 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u0441\u043a\u0430 \u0433\u043e\u0434\u0438\u043d\u0430. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0458\u0435 \u0443\u043a\u0459\u0443\u0447\u0435\u043d \u043a\u0430\u043e \u0441\u0435\u043a\u0443\u043d\u0434\u0430\u0440\u043d\u0438 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0443 \u041f\u0440\u0435\u0433\u043b\u0435\u0434 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u0438\u0445 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u0437\u0430 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0438 \u0441\u0442\u0443\u0431 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u0438\u0445 \u043f\u0440\u0430\u0432\u0430 \u0438 \u0410\u043a\u0446\u0438\u043e\u043d\u0438 \u043f\u043b\u0430\u043d \u0415\u041f\u0421\u0420-\u0430, \u0430 \u0434\u0438\u043e \u0458\u0435 \u0432\u0438\u0448\u0435\u0434\u0438\u043c\u0435\u043d\u0437\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u0433 \u0438\u043d\u0434\u0435\u043a\u0441\u0430 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430. \u041c\u043e\u0436\u0435 \u0441\u0435 \u0441\u043c\u0430\u0442\u0440\u0430\u0442\u0438 \u0434\u0458\u0435\u043b\u043e\u043c \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e\u0433 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u0421\u0414\u0413 1.2.2 \u201e\u0423\u0434\u0438\u043e \u043c\u0443\u0448\u043a\u0430\u0440\u0430\u0446\u0430, \u0436\u0435\u043d\u0430 \u0438 \u0434\u0435\u0446\u0435 \u0441\u0432\u0438\u0445 \u0443\u0437\u0440\u0430\u0441\u0442\u0430 \u043a\u043e\u0458\u0438 \u0436\u0438\u0432\u0435 \u0443 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0443 \u0443 \u0441\u0432\u0438\u043c \u045a\u0435\u0433\u043e\u0432\u0438\u043c \u0434\u0438\u043c\u0435\u043d\u0437\u0438\u0458\u0430\u043c\u0430 \u043f\u0440\u0435\u043c\u0430 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438\u043c \u0434\u0435\u0444\u0438\u043d\u0438\u0446\u0438\u0458\u0430\u043c\u0430\u201c \u041e\u0434 2021. \u0433\u043e\u0434\u0438\u043d\u0435 \u0423\u0440\u0435\u0434\u0431\u0430 (\u0415\u0423) 2019/1700 \u043f\u0440\u0435\u0434\u0432\u0438\u0452\u0430 \u0437\u0430\u0445\u0442\u0435\u0432\u0435 \u043a\u043e\u0458\u0438 \u0441\u0435 \u043e\u0434\u043d\u043e\u0441\u0435 \u043d\u0430 \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0441\u043a\u0443 \u043f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u043e\u0441\u0442, \u0434\u0435\u0442\u0430\u0459\u043d\u0435 \u043a\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0435 \u0443\u0437\u043e\u0440\u043a\u0430, \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443\u045b\u0438 \u043f\u043e\u0434\u0443\u0437\u043e\u0440\u043a\u043e\u0432\u0430\u045a\u0435, \u0443 \u0441\u043a\u043b\u0430\u0434\u0443 \u0441\u0430 \u0410\u043d\u0435\u043a\u0441\u043e\u043c III, \u0437\u0430\u0458\u0435\u0434\u043d\u0438\u0447\u043a\u0435 \u043f\u0435\u0440\u0438\u043e\u0434\u0435 \u043f\u0440\u0438\u043a\u0443\u043f\u0459\u0430\u045a\u0430 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430, \u0437\u0430\u0458\u0435\u0434\u043d\u0438\u0447\u043a\u0435 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0434\u0435 \u0437\u0430 \u0443\u0440\u0435\u0452\u0438\u0432\u0430\u045a\u0435 \u0438 \u0438\u043c\u043f\u0443\u0442\u0430\u0446\u0438\u0458\u0443, \u043f\u043e\u043d\u0434\u0435\u0440\u0438\u0441\u0430\u045a\u0435, \u043f\u0440\u043e\u0446\u0458\u0435\u043d\u0443 \u0438 \u043f\u0440\u043e\u0446\u0458\u0435\u043d\u0443 \u0432\u0430\u0440\u0438\u0458\u0430\u043d\u0446\u0435.","long_term_objective":"\u0414\u0443\u0433\u043e\u0440\u043e\u0447\u043d\u0438 \u0446\u0438\u0459 \u0437\u0430 \u043e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0458\u0435 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442 \u043e\u0434 0","eu_indicator_definition":"\u0421\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u043e \u0438 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u0430 \u0438\u0441\u043a\u0459\u0443\u0447\u0435\u043d\u043e\u0441\u0442 \u0448\u0442\u0435\u0442\u0435 \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u043d\u0438\u043c \u0436\u0438\u0432\u043e\u0442\u0438\u043c\u0430 \u0438 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0430\u0432\u0430\u0458\u0443 \u043c\u043e\u0433\u0443\u045b\u043d\u043e\u0441\u0442\u0438 \u0459\u0443\u0434\u0438 \u0434\u0430 \u043e\u0441\u0442\u0432\u0430\u0440\u0435 \u0441\u0432\u043e\u0458 \u043f\u0443\u043d\u0438 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0458\u0430\u043b \u0442\u0430\u043a\u043e \u0448\u0442\u043e \u0443\u0442\u0438\u0447\u0443 \u043d\u0430 \u045a\u0438\u0445\u043e\u0432\u043e \u0437\u0434\u0440\u0430\u0432\u0459\u0435 \u0438 \u0431\u043b\u0430\u0433\u043e\u0441\u0442\u0430\u045a\u0435 \u0438 \u0441\u043c\u0430\u045a\u0443\u0458\u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u043d\u0435 \u0438\u0441\u0445\u043e\u0434\u0435. \u0422\u043e \u0437\u0430\u0443\u0437\u0432\u0440\u0430\u0442 \u0441\u043c\u0430\u045a\u0443\u0458\u0435 \u043c\u043e\u0433\u0443\u045b\u043d\u043e\u0441\u0442\u0438 \u0437\u0430 \u0443\u0441\u043f\u0458\u0435\u0448\u0430\u043d \u0436\u0438\u0432\u043e\u0442 \u0438 \u0434\u043e\u0434\u0430\u0442\u043d\u043e \u043f\u043e\u0432\u0435\u045b\u0430\u0432\u0430 \u0440\u0438\u0437\u0438\u043a \u043e\u0434 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430. \u0411\u0435\u0437 \u0435\u0444\u0438\u043a\u0430\u0441\u043d\u043e\u0433 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0430, \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u0445, \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u0438\u0445, \u043f\u043e\u0440\u0435\u0441\u043a\u0438\u0445 \u043e\u043b\u0430\u043a\u0448\u0438\u0446\u0430 \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0437\u0430\u043f\u043e\u0448\u0459\u0430\u0432\u0430\u045a\u0430, \u0440\u0438\u0437\u0438\u043a \u043e\u0434 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u0441\u0435 \u043f\u0440\u0435\u043d\u043e\u0441\u0438 \u0441\u0430 \u0458\u0435\u0434\u043d\u0435 \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0458\u0435 \u043d\u0430 \u0434\u0440\u0443\u0433\u0443. \u0422\u043e \u0443\u0437\u0440\u043e\u043a\u0443\u0458\u0435 \u043e\u043f\u0441\u0442\u0430\u043d\u0430\u043a \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u0438 \u0441\u0442\u043e\u0433\u0430 \u0441\u0442\u0432\u0430\u0440\u0430 \u0432\u0438\u0448\u0435 \u043d\u0435\u0458\u0435\u0434\u043d\u0430\u043a\u043e\u0441\u0442\u0438, \u0448\u0442\u043e \u043c\u043e\u0436\u0435 \u0434\u043e\u0432\u0435\u0441\u0442\u0438 \u0434\u043e \u0434\u0443\u0433\u043e\u0440\u043e\u0447\u043d\u043e\u0433 \u0433\u0443\u0431\u0438\u0442\u043a\u0430 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043e\u0434 \u0441\u0442\u0440\u0430\u043d\u0435 \u0447\u0438\u0442\u0430\u0432\u0438\u0445 \u0433\u0440\u0443\u043f\u0430 \u0434\u0440\u0443\u0448\u0442\u0432\u0430 \u0438 \u043e\u043c\u0435\u0442\u0430\u0442\u0438 \u0438\u043d\u043a\u043b\u0443\u0437\u0438\u0432\u043d\u0438 \u0438 \u043e\u0434\u0440\u0436\u0438\u0432\u0438 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0438 \u0440\u0430\u0441\u0442.","eu_rationale":"\u0409\u0443\u0434\u0438 \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u0438 \u043e\u0434 0 \u0434\u043e 64 \u0433\u043e\u0434\u0438\u043d\u0435 \u043a\u043e\u0458\u0438 \u0436\u0438\u0432\u0435 \u0443 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0432\u0438\u043c\u0430 \u0443 \u043a\u043e\u0458\u0438\u043c\u0430 \u0441\u0443 \u043e\u0434\u0440\u0430\u0441\u043b\u0438 \u0440\u0430\u0434\u0438\u043b\u0438 \u0440\u0430\u0434\u043d\u043e \u0432\u0440\u0435\u043c\u0435 \u0458\u0435\u0434\u043d\u0430\u043a\u043e \u0438\u043b\u0438 \u043c\u0430\u045a\u0435 \u043e\u0434 20% \u045a\u0438\u0445\u043e\u0432\u043e\u0433 \u0443\u043a\u0443\u043f\u043d\u043e\u0433 \u043a\u043e\u043c\u0431\u0438\u043d\u043e\u0432\u0430\u043d\u043e\u0433 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0458\u0430\u043b\u0430 \u0440\u0430\u0434\u043d\u043e\u0433 \u0432\u0440\u0435\u043c\u0435\u043d\u0430 \u0442\u043e\u043a\u043e\u043c \u043f\u0440\u0435\u0442\u0445\u043e\u0434\u043d\u0435 \u0433\u043e\u0434\u0438\u043d\u0435. \u041e\u0434\u0440\u0430\u0441\u043b\u0438 \u0431\u0440\u043e\u0458 \u0459\u0443\u0434\u0438 \u0443 \u0434\u043e\u0431\u0438 \u043e\u0434 18 \u0434\u043e 64 \u0433\u043e\u0434\u0438\u043d\u0435. \u0421\u0442\u0443\u0434\u0435\u043d\u0442\u0438 \u0443\u0437\u0440\u0430\u0441\u0442\u0430 \u043e\u0434 18 \u0434\u043e 24 \u0433\u043e\u0434\u0438\u043d\u0435; \u0459\u0443\u0434\u0438 \u043a\u043e\u0458\u0438 \u0441\u0443 \u043f\u0435\u043d\u0437\u0438\u043e\u043d\u0438\u0441\u0430\u043d\u0438 \u0443 \u0441\u043a\u043b\u0430\u0434\u0443 \u0441\u0430 \u0441\u0432\u043e\u0458\u0438\u043c \u0441\u0430\u043c\u043e-\u0434\u0435\u0444\u0438\u043d\u0438\u0441\u0430\u043d\u0438\u043c \u0442\u0440\u0435\u043d\u0443\u0442\u043d\u0438\u043c \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0438\u043c \u0441\u0442\u0430\u0442\u0443\u0441\u043e\u043c \u0438\u043b\u0438 \u043a\u043e\u0458\u0438 \u043f\u0440\u0438\u043c\u0430\u0458\u0443 \u0431\u0438\u043b\u043e \u043a\u043e\u0458\u0443 \u043f\u0435\u043d\u0437\u0438\u0458\u0443 (\u043e\u0441\u0438\u043c \u043f\u043e\u0440\u043e\u0434\u0438\u0447\u043d\u0435 \u043f\u0435\u043d\u0437\u0438\u0458\u0435); \u0438 \u0459\u0443\u0434\u0438 \u0443 \u0441\u0442\u0430\u0440\u043e\u0441\u043d\u043e\u0458 \u0433\u0440\u0443\u043f\u0438 \u043e\u0434 60 \u0434\u043e 64 \u0433\u043e\u0434\u0438\u043d\u0435 \u043a\u043e\u0458\u0438 \u0441\u0443 \u043d\u0435\u0430\u043a\u0442\u0438\u0432\u043d\u0438 \u0438 \u0436\u0438\u0432\u0435 \u0443 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0432\u0443 \u0433\u0434\u0435 \u0441\u0443 \u0433\u043b\u0430\u0432\u043d\u0438 \u043f\u0440\u0438\u0445\u043e\u0434\u0438 \u043f\u0435\u043d\u0437\u0438\u0458\u0435, \u043d\u0435 \u0443\u0437\u0438\u043c\u0430\u0458\u0443 \u0441\u0435 \u0443 \u043e\u0431\u0437\u0438\u0440. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0458\u0435 \u0434\u0435\u043e \u043c\u0443\u043b\u0442\u0438\u0434\u0438\u043c\u0435\u043d\u0437\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u0433 \u0438\u043d\u0434\u0435\u043a\u0441\u0430 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430.","eu_methodology_characteristics":"\u0420\u0435\u0444\u0435\u0440\u0435\u043d\u0442\u043d\u0438 \u043f\u0435\u0440\u0438\u043e\u0434 \u0458\u0435 \u0433\u043e\u0434\u0438\u043d\u0430 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0430. \u0417\u0430 \u0441\u0432\u0435 \u0437\u0435\u043c\u0459\u0435, \u0440\u0435\u0444\u0435\u0440\u0435\u043d\u0442\u043d\u0438 \u043f\u0435\u0440\u0438\u043e\u0434 \u0437\u0430 \u0432\u0430\u0440\u0438\u0458\u0430\u0431\u043b\u0435 \u043f\u0440\u0438\u0445\u043e\u0434\u0430 \u0443 \u0415\u0423-\u0421\u0418\u041b\u0426 \u0458\u0435 \u043f\u0440\u0435\u0442\u0445\u043e\u0434\u043d\u0430 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u0441\u043a\u0430 \u0433\u043e\u0434\u0438\u043d\u0430. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0458\u0435 \u0443\u043a\u0459\u0443\u0447\u0435\u043d \u043a\u0430\u043e \u0441\u0435\u043a\u0443\u043d\u0434\u0430\u0440\u043d\u0438 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0443 \u041f\u0440\u0435\u0433\u043b\u0435\u0434 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u0438\u0445 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u0437\u0430 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0438 \u0441\u0442\u0443\u0431 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u0438\u0445 \u043f\u0440\u0430\u0432\u0430 \u0438 \u0410\u043a\u0446\u0438\u043e\u043d\u0438 \u043f\u043b\u0430\u043d \u0415\u041f\u0421\u0420-\u0430, \u0430 \u0434\u0438\u043e \u0458\u0435 \u0432\u0438\u0448\u0435\u0434\u0438\u043c\u0435\u043d\u0437\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u0433 \u0438\u043d\u0434\u0435\u043a\u0441\u0430 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430. \u041c\u043e\u0436\u0435 \u0441\u0435 \u0441\u043c\u0430\u0442\u0440\u0430\u0442\u0438 \u0434\u0458\u0435\u043b\u043e\u043c \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e\u0433 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u0421\u0414\u0413 1.2.2 \u201e\u0423\u0434\u0438\u043e \u043c\u0443\u0448\u043a\u0430\u0440\u0430\u0446\u0430, \u0436\u0435\u043d\u0430 \u0438 \u0434\u0435\u0446\u0435 \u0441\u0432\u0438\u0445 \u0443\u0437\u0440\u0430\u0441\u0442\u0430 \u043a\u043e\u0458\u0438 \u0436\u0438\u0432\u0435 \u0443 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0443 \u0443 \u0441\u0432\u0438\u043c \u045a\u0435\u0433\u043e\u0432\u0438\u043c \u0434\u0438\u043c\u0435\u043d\u0437\u0438\u0458\u0430\u043c\u0430 \u043f\u0440\u0435\u043c\u0430 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438\u043c \u0434\u0435\u0444\u0438\u043d\u0438\u0446\u0438\u0458\u0430\u043c\u0430\u201c \u041e\u0434 2021. \u0433\u043e\u0434\u0438\u043d\u0435 \u0423\u0440\u0435\u0434\u0431\u0430 (\u0415\u0423) 2019/1700 \u043f\u0440\u0435\u0434\u0432\u0438\u0452\u0430 \u0437\u0430\u0445\u0442\u0435\u0432\u0435 \u043a\u043e\u0458\u0438 \u0441\u0435 \u043e\u0434\u043d\u043e\u0441\u0435 \u043d\u0430 \u0433\u0435\u043e\u0433\u0440\u0430\u0444\u0441\u043a\u0443 \u043f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u043e\u0441\u0442, \u0434\u0435\u0442\u0430\u0459\u043d\u0435 \u043a\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0435 \u0443\u0437\u043e\u0440\u043a\u0430, \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443\u045b\u0438 \u043f\u043e\u0434\u0443\u0437\u043e\u0440\u043a\u043e\u0432\u0430\u045a\u0435, \u0443 \u0441\u043a\u043b\u0430\u0434\u0443 \u0441\u0430 \u0410\u043d\u0435\u043a\u0441\u043e\u043c III, \u0437\u0430\u0458\u0435\u0434\u043d\u0438\u0447\u043a\u0435 \u043f\u0435\u0440\u0438\u043e\u0434\u0435 \u043f\u0440\u0438\u043a\u0443\u043f\u0459\u0430\u045a\u0430 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430, \u0437\u0430\u0458\u0435\u0434\u043d\u0438\u0447\u043a\u0435 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0434\u0435 \u0437\u0430 \u0443\u0440\u0435\u0452\u0438\u0432\u0430\u045a\u0435 \u0438 \u0438\u043c\u043f\u0443\u0442\u0430\u0446\u0438\u0458\u0443, \u043f\u043e\u043d\u0434\u0435\u0440\u0438\u0441\u0430\u045a\u0435, \u043f\u0440\u043e\u0446\u0458\u0435\u043d\u0443 \u0438 \u043f\u0440\u043e\u0446\u0458\u0435\u043d\u0443 \u0432\u0430\u0440\u0438\u0458\u0430\u043d\u0446\u0435.","eu_long_term_objective":"\u0414\u0443\u0433\u043e\u0440\u043e\u0447\u043d\u0438 \u0446\u0438\u0459 \u0437\u0430 \u043e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0458\u0435 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442 \u043e\u0434 0","target_number":"1.40","goal_number":"1","indicator_name":"\u041b\u0438\u0446\u0430 \u043a\u043e\u0458\u0430 \u0436\u0438\u0432\u0435 \u0443 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0432\u0438\u043c\u0430 \u0441\u0430 \u0432\u0435\u043e\u043c\u0430 \u043d\u0438\u0441\u043a\u0438\u043c \u0438\u043d\u0442\u0435\u043d\u0437\u0438\u0442\u0435\u0442\u043e\u043c \u0440\u0430\u0434\u0430, \u043f\u043e \u0441\u0442\u0430\u0440\u043e\u0441\u043d\u0438\u043c \u0433\u0440\u0443\u043f\u0430\u043c\u0430","graph_title":"\u041b\u0438\u0446\u0430 \u043a\u043e\u0458\u0430 \u0436\u0438\u0432\u0435 \u0443 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0432\u0438\u043c\u0430 \u0441\u0430 \u0432\u0435\u043e\u043c\u0430 \u043d\u0438\u0441\u043a\u0438\u043c \u0438\u043d\u0442\u0435\u043d\u0437\u0438\u0442\u0435\u0442\u043e\u043c \u0440\u0430\u0434\u0430, \u043f\u043e \u0441\u0442\u0430\u0440\u043e\u0441\u043d\u0438\u043c \u0433\u0440\u0443\u043f\u0430\u043c\u0430"}