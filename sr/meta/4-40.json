045a\u0435\u043c \u0432\u0458\u0435\u0448\u0442\u0438\u043d\u0430 \u0438 \u0437\u043d\u0430\u045a\u0430 15-\u0433\u043e\u0434\u0438\u0448\u045a\u0438\u0445 \u0443\u0447\u0435\u043d\u0438\u043a\u0430.","eu_rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0438 \u043a\u043e\u0458\u0438 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0435 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u0430 \u0446\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 4 \u043e \u043a\u0432\u0430\u043b\u0438\u0442\u0435\u0442\u043d\u043e\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443, \u043a\u043e\u0458\u0438 \u0458\u0435 \u0443\u0433\u0440\u0430\u0452\u0435\u043d \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u043f\u043e\u0434 \u201e\u041d\u043e\u0432\u0438 \u043f\u043b\u0430\u043d \u0437\u0430 \u043e\u0434\u0440\u0436\u0438\u0432\u0438 \u043f\u0440\u043e\u0441\u043f\u0435\u0440\u0438\u0442\u0435\u0442 \u0438 \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u043d\u043e\u0441\u0442 \u0415\u0432\u0440\u043e\u043f\u0435\u201c, \u201e\u041f\u043e\u0434\u0440\u0448\u043a\u0430 \u0459\u0443\u0434\u0438\u043c\u0430, \u0458\u0430\u0447\u0430\u045a\u0435 \u043d\u0430\u0448\u0438\u0445 \u0434\u0440\u0443\u0448\u0442\u0430\u0432\u0430 \u0438 \u043d\u0430\u0448\u0435\u0433 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u043e\u0433 \u043c\u043e\u0434\u0435\u043b\u0430\u201c \u0438 \u201e\u0417\u0430\u0448\u0442\u0438\u0442\u0430 \u043d\u0430\u0448\u0435 \u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u0458\u0435, \u043e\u0447\u0443\u0432\u0430\u045a\u0435 \u043d\u0430\u0448\u0438\u0445 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442\u0438\u201c. \u0421\u0430\u0432\u0458\u0435\u0442 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u0443\u043d\u0438\u0458\u0435 \u0458\u0435 26. \u0444\u0435\u0431\u0440\u0443\u0430\u0440\u0430 2021. \u0433\u043e\u0434\u0438\u043d\u0435 \u0443\u0441\u0432\u043e\u0458\u0438\u043e \u0420\u0435\u0437\u043e\u043b\u0443\u0446\u0438\u0458\u0443 \u043e \u0441\u0442\u0440\u0430\u0442\u0435\u0448\u043a\u043e\u043c \u043e\u043a\u0432\u0438\u0440\u0443 \u0437\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0443 \u0441\u0430\u0440\u0430\u0434\u045a\u0443 \u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438 \u043e\u0431\u0443\u0446\u0438 \u043a\u0430 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u043e\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u043d\u043e\u043c \u043f\u0440\u043e\u0441\u0442\u043e\u0440\u0443 \u0438 \u0448\u0438\u0440\u0435 (2021\u20132030),\u043e\u043a\u0432\u0438\u0440 \u043a\u043e\u0458\u0438 \u0441\u0435 \u0431\u0430\u0432\u0438 \u043f\u0435\u0442 \u0441\u0442\u0440\u0430\u0442\u0435\u0448\u043a\u0438\u0445 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0430: (1) \u041f\u043e\u0431\u043e\u0459\u0448\u0430\u045a\u0435 \u043a\u0432\u0430\u043b\u0438\u0442\u0435\u0442\u0430, \u0440\u0430\u0432\u043d\u043e\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0438, \u0438\u043d\u043a\u043b\u0443\u0437\u0438\u0458\u0435 \u0438 \u0443\u0441\u043f\u0458\u0435\u0445\u0430 \u0437\u0430 \u0441\u0432\u0435 \u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438 \u043e\u0431\u0443\u0446\u0438; (2) \u041e\u0441\u0442\u0432\u0430\u0440\u0438\u0432\u0430\u045a\u0435 \u0446\u0438\u0458\u0435\u043b\u043e\u0436\u0438\u0432\u043e\u0442\u043d\u043e\u0433 \u0443\u0447\u0435\u045a\u0430 \u0438 \u043c\u043e\u0431\u0438\u043b\u043d\u043e\u0441\u0442\u0438 \u0437\u0430 \u0441\u0432\u0435; (3) \u0423\u043d\u0430\u043f\u0440\u0435\u0452\u0435\u045a\u0435 \u043a\u043e\u043c\u043f\u0435\u0442\u0435\u043d\u0446\u0438\u0458\u0430 \u0438 \u043c\u043e\u0442\u0438\u0432\u0430\u0446\u0438\u0458\u0435 \u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u043d\u043e\u0458 \u043f\u0440\u043e\u0444\u0435\u0441\u0438\u0458\u0438; (4) \u0408\u0430\u0447\u0430\u045a\u0435 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u043e\u0433 \u0432\u0438\u0441\u043e\u043a\u043e\u0433 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0430; \u0438 (5) \u041f\u043e\u0434\u0440\u0436\u0430\u0432\u0430\u045a\u0435 \u0437\u0435\u043b\u0435\u043d\u0435 \u0438 \u0434\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u0435 \u0442\u0440\u0430\u043d\u0437\u0438\u0446\u0438\u0458\u0435 \u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438 \u043e\u0431\u0443\u0446\u0438 \u0438 \u043a\u0440\u043e\u0437 \u045a\u0438\u0445.","eu_methodology_characteristics":"\u0420\u0435\u0437\u043e\u043b\u0443\u0446\u0438\u0458\u0430 \u0421\u0430\u0432\u0458\u0435\u0442\u0430 \u043f\u043e\u0441\u0442\u0430\u0432\u0459\u0430 \u0446\u0438\u0459 \u0415\u0423 \u0434\u0430 \u0443\u0434\u0438\u043e 15-\u0433\u043e\u0434\u0438\u0448\u045a\u0430\u043a\u0430 \u0441\u0430 \u043d\u0438\u0441\u043a\u0438\u043c \u0443\u0441\u043f\u0435\u0445\u043e\u043c \u0443 \u0447\u0438\u0442\u0430\u045a\u0443, \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u0446\u0438 \u0438 \u043d\u0430\u0443\u0446\u0438, \u043c\u0458\u0435\u0440\u0435\u043d \u043e\u0432\u0438\u043c \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u043e\u043c \u0446\u0438\u0459\u0435\u0432\u0430 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430, \u0431\u0443\u0434\u0435 \u043c\u0430\u045a\u0438 \u043e\u0434 15% \u0434\u043e 2030. \u0433\u043e\u0434\u0438\u043d\u0435.","eu_long_objective":"\u0414\u0443\u0433\u043e\u0440\u043e\u0447\u043d\u0438 \u0446\u0438\u0459 \u0437\u0430 \u043e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0458\u0435 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442 \u043e\u0434 525,6","target_number":"4.40","goal_number":"4","graph_title":"\u041f\u043