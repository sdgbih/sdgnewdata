al_indicator_definition":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0437\u0430 \u0411\u043e\u0441\u043d\u0443 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0443 \u0437\u0430\u0441\u043d\u0438\u0432\u0430 \u0441\u0435 \u043d\u0430 \u043f\u043e\u0434\u0430\u0446\u0438\u043c\u0430 \u0438\u0437 \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u0433 \u0438\u043d\u0432\u0435\u043d\u0442\u0430\u0440\u0441\u043a\u043e\u0433 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430 (NID) \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435, \u043a\u043e\u0458\u0438 \u0441\u0435 \u043f\u0440\u0438\u043f\u0440\u0435\u043c\u0430 \u0438 \u0434\u043e\u0441\u0442\u0430\u0432\u0459\u0430 \u041e\u043a\u0432\u0438\u0440\u043d\u043e\u0458 \u043a\u043e\u043d\u0432\u0435\u043d\u0446\u0438\u0458\u0438 \u0423\u0458\u0435\u0434\u0438\u045a\u0435\u043d\u0438\u0445 \u043d\u0430\u0446\u0438\u0458\u0430 \u043e \u043f\u0440\u043e\u043c\u0458\u0435\u043d\u0438 \u043a\u043b\u0438\u043c\u0435 (UNFCCC). \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u043f\u043e\u0434\u0430\u0446\u0438 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430\u0458\u0443 \u0435\u043c\u0438\u0441\u0438\u0458\u0435 \u0433\u0430\u0441\u043e\u0432\u0430 \u0441\u0430 \u0435\u0444\u0435\u043a\u0442\u043e\u043c \u0441\u0442\u0430\u043a\u043b\u0435\u043d\u0435 \u0431\u0430\u0448\u0442\u0435 \u0438\u0437\u0440\u0430\u0436\u0435\u043d\u0435 \u0443 \u0442\u043e\u043d\u0430\u043c\u0430 CO\u2082 \u0435\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442\u0430, \u0443 \u0441\u043a\u043b\u0430\u0434\u0443 \u0441\u0430 \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u0458\u043e\u043c \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u0433 \u0438\u043d\u0432\u0435\u043d\u0442\u0430\u0440\u0430 \u0435\u043c\u0438\u0441\u0438\u0458\u0430. \u0417\u0430 \u043f\u0440\u0438\u043a\u0430\u0437 \u043d\u0430 \u043e\u0432\u043e\u043c \u043f\u043e\u0440\u0442\u0430\u043b\u0443 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0441\u0435 \u0441\u0435\u0440\u0438\u0458\u0430 \u0443\u043a\u0443\u043f\u043d\u0438\u0445 \u0435\u043c\u0438\u0441\u0438\u0458\u0430 \u0431\u0435\u0437 \u043f\u043e\u043d\u043e\u0440\u0430 \u0438\u0437 \u0441\u0435\u043a\u0442\u043e\u0440\u0430 \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u045a\u0430 \u0437\u0435\u043c\u0459\u0438\u0448\u0442\u0430, \u043f\u0440\u043e\u043c\u0458\u0435\u043d\u0435 \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u045a\u0430 \u0437\u0435\u043c\u0459\u0438\u0448\u0442\u0430 \u0438 \u0448\u0443\u043c\u0430\u0440\u0441\u0442\u0432\u0430 (LULUCF).","national_rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043e\u043c\u043e\u0433\u0443\u045b\u0430\u0432\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043f\u0440\u043e\u043c\u0458\u0435\u043d\u0430 \u0443\u043a\u0443\u043f\u043d\u0438\u0445 \u0435\u043c\u0438\u0441\u0438\u0458\u0430 \u0433\u0430\u0441\u043e\u0432\u0430 \u0441\u0430 \u0435\u0444\u0435\u043a\u0442\u043e\u043c \u0441\u0442\u0430\u043a\u043b\u0435\u043d\u0435 \u0431\u0430\u0448\u0442\u0435 \u0443 \u0411\u043e\u0441\u043d\u0438 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0438 \u043a\u0440\u043e\u0437 \u0432\u0440\u0438\u0458\u0435\u043c\u0435 \u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u043f\u0440\u0438\u043a\u0430\u0437 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 EU SDG 13.10. \u041f\u043e\u0434\u0430\u0446\u0438 \u0441\u0435 \u0437\u0430\u0441\u043d\u0438\u0432\u0430\u0458\u0443 \u043d\u0430 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u043e\u043c \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u043c \u0438\u043d\u0432\u0435\u043d\u0442\u0430\u0440\u0443 \u0435\u043c\u0438\u0441\u0438\u0458\u0430 \u043a\u043e\u0458\u0438 \u0411\u043e\u0441\u043d\u0430 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0430 \u0434\u043e\u0441\u0442\u0430\u0432\u0459\u0430 UNFCCC-\u0443. \u041f\u043e\u0441\u0459\u0435\u0434\u045a\u0438 \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u043d\u0438 \u0438\u0437\u0432\u043e\u0440 \u0458\u0435 2024 National Inventory Document (NID) \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435, \u0434\u043e\u0441\u0442\u0430\u0432\u0459\u0435\u043d UNFCCC-\u0443 13. \u0430\u0432\u0433\u0443\u0441\u0442\u0430 2026. \u0433\u043e\u0434\u0438\u043d\u0435.","national_methodology_characteristics":"\u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u043f\u043e\u0434\u0430\u0446\u0438 \u043f\u0440\u0435\u0443\u0437\u0435\u0442\u0438 \u0441\u0443 \u0438\u0437 \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u0433 \u0438\u043d\u0432\u0435\u043d\u0442\u0430\u0440\u0441\u043a\u043e\u0433 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435 (NID) \u0438 \u0438\u0437\u0440\u0430\u0436\u0435\u043d\u0438 \u0443 \u0442\u043e\u043d\u0430\u043c\u0430 CO\u2082 \u0435\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442\u0430. \u0417\u0430 \u043f\u043e\u0442\u0440\u0435\u0431\u0435 \u043f\u0440\u0430\u045b\u0435\u045a\u0430 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043d\u0430 \u043f\u043e\u0440\u0442\u0430\u043b\u0443 \u0438\u0437\u0440\u0430\u0447\u0443\u043d\u0430\u0442 \u0458\u0435 \u0438\u043d\u0434\u0435\u043a\u0441 \u0435\u043c\u0438\u0441\u0438\u0458\u0430 \u0441\u0430 \u0431\u0430\u0437\u043d\u043e\u043c 1990. \u0433\u043e\u0434\u0438\u043d\u043e\u043c, \u043f\u0440\u0438 \u0447\u0435\u043c\u0443 \u0458\u0435 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442 \u0437\u0430 1990. \u0433\u043e\u0434\u0438\u043d\u0443 \u043f\u043e\u0441\u0442\u0430\u0432\u0459\u0435\u043d\u0430 \u043d\u0430 100. \u0418\u043d\u0434\u0435\u043a\u0441 \u0441\u0435 \u0438\u0437\u0440\u0430\u0447\u0443\u043d\u0430\u0432\u0430 \u043a\u0430\u043e \u043e\u0434\u043d\u043e\u0441 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u0435\u043c\u0438\u0441\u0438\u0458\u0430 \u0443 \u043f\u043e\u0441\u043c\u0430\u0442\u0440\u0430\u043d\u043e\u0458 \u0433\u043e\u0434\u0438\u043d\u0438 \u0438 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u0435\u043c\u0438\u0441\u0438\u0458\u0430 \u0443 1990. \u0433\u043e\u0434\u0438\u043d\u0438, \u043f\u043e\u043c\u043d\u043e\u0436\u0435\u043d \u0441\u0430 100. \u0417\u0430 \u043f\u0440\u043e\u0446\u0458\u0435\u043d\u0443 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0441\u0435 \u0441\u0435\u0440\u0438\u0458\u0430 I90 (1990=100). \u0411\u0443\u0434\u0443\u045b\u0438 \u0434\u0430 \u0458\u0435 \u043a\u043e\u0434 \u043e\u0432\u043e\u0433 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u043f\u043e\u0436\u0435\u0459\u0430\u043d \u0441\u043c\u0458\u0435\u0440 \u0441\u043c\u0430\u045a\u0435\u045a\u0435 \u0435\u043c\u0438\u0441\u0438\u0458\u0430, \u043f\u0440\u043e\u0433\u0440\u0435\u0441 \u0458\u0435 \u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0438\u0441\u0430\u043d \u0441\u0430 \u043d\u0435\u0433\u0430\u0442\u0438\u0432\u043d\u0438\u043c \u0441\u043c\u0458\u0435\u0440\u043e\u043c. \u041d\u0430 \u043f\u043e\u0440\u0442\u0430\u043b\u0443 \u0458\u0435 \u043a\u0430\u043e \u043f\u043e\u0447\u0435\u0442\u043d\u0430 \u0433\u043e\u0434\u0438\u043d\u0430 \u0437\u0430 \u043e\u0431\u0440\u0430\u0447\u0443\u043d \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0430 \u043f\u043e\u0441\u0442\u0430\u0432\u0459\u0435\u043d\u0430 2015. \u0433\u043e\u0434\u0438\u043d\u0430, \u0430 2030. \u0433\u043e\u0434\u0438\u043d\u0430 \u043a\u0430\u043e \u0446\u0438\u0459\u043d\u0430 \u0433\u043e\u0434\u0438\u043d\u0430 \u0443 \u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u0458\u0438 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430. \u0421\u043c\u0430\u045a\u0435\u045a\u0435 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u0438\u043d\u0434\u0435\u043a\u0441\u0430 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430 \u043f\u043e\u0432\u043e\u0459\u0430\u043d \u0441\u043c\u0458\u0435\u0440 \u043a\u0440\u0435\u0442\u0430\u045a\u0430 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430. \u041e\u0432\u0430\u0458 \u043d\u0430\u0447\u0438\u043d \u043e\u0431\u0440\u0430\u0447\u0443\u043d\u0430 \u043f\u0440\u043e\u0433\u0440\u0435\u0441\u0430 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430 \u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u0458\u0443 \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u043d\u0443 \u0437\u0430 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u043f\u0440\u0438\u043a\u0430\u0437 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u043d\u0430 BHAS \u043f\u043e\u0440\u0442\u0430\u043b\u0443 \u0438 \u043d\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430 \u043f\u043e\u0441\u0435\u0431\u043d\u0443 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0443 \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u0458\u0443 Eurostata \u0437\u0430 \u0411\u043e\u0441\u043d\u0443 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0443.","national_long_objective":"\u0421\u043c\u0430\u045a\u0435\u045a\u0435 \u0435\u043c\u0438\u0441\u0438\u0458\u0430 \u0433\u0430\u0441\u043e\u0432\u0430 \u0441\u0430 \u0435\u0444\u0435\u043a\u0442\u043e\u043c \u0441\u0442\u0430\u043a\u043b\u0435\u043d\u0435 \u0431\u0430\u0448\u0442\u0435 \u0443 \u043e\u0434\u043d\u043e\u0441\u0443 \u043d\u0430 \u043d\u0438\u0432\u043e \u0438\u0437 1990. \u0433\u043e\u0434\u0438\u043d\u0435, \u0443 \u0441\u043a\u043b\u0430\u0434\u0443 \u0441\u0430 \u043e\u0431\u0430\u0432\u0435\u0437\u0430\u043c\u0430 \u0438 \u0446\u0438\u0459\u0435\u0432\u0438\u043c\u0430 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435 \u0443 \u043e\u043a\u0432\u0438\u0440\u0443 UNFCCC-\u0430 \u0438 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438\u0445 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0438\u0445 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0430.","eu_indicator_definition":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043c\u0458\u0435\u0440\u0438 \u0443\u043a\u0443\u043f\u043d\u0435 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0435 \u0435\u043c\u0438\u0441\u0438\u0458\u0435, \u043e\u0434\u043d\u043e\u0441\u043d\u043e \u0435\u043c\u0438\u0441\u0438\u0458\u0435 \u0438\u0437 \u0441\u0435\u043a\u0442\u043e\u0440\u0430 \u043e\u0431\u0443\u0445\u0432\u0430\u045b\u0435\u043d\u0438\u0445 \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u043c \u0415\u0423 \u0437\u0430 \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0443 \u0435\u043c\u0438\u0441\u0438\u0458\u0430\u043c\u0430 (ETS) \u0438 \u0441\u0435\u043a\u0442\u043e\u0440\u0430 \u0438\u0437\u0432\u0430\u043d ETS-\u0430 (ESD), \u0442\u0430\u043a\u043e\u0437\u0432\u0430\u043d\u0435 \u201e\u041a\u0458\u043e\u0442\u043e \u043a\u043e\u0440\u043f\u0435\u201c \u0433\u0430\u0441\u043e\u0432\u0430 \u0441\u0430 \u0435\u0444\u0435\u043a\u0442\u043e\u043c \u0441\u0442\u0430\u043a\u043b\u0435\u043d\u0435 \u0431\u0430\u0448\u0442\u0435. \u041e\u043d\u0430 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430 \u0443\u0433\u0459\u0435\u043d-\u0434\u0438\u043e\u043a\u0441\u0438\u0434 (CO\u2082), \u043c\u0435\u0442\u0430\u043d (CH\u2084), \u0430\u0437\u043e\u0442-\u0441\u0443\u0431\u043e\u043a\u0441\u0438\u0434 (N\u2082O) \u0438 F-\u0433\u0430\u0441\u043e\u0432\u0435, \u043e\u0434\u043d\u043e\u0441\u043d\u043e \u0445\u0438\u0434\u0440\u043e\u0444\u043b\u0443\u043e\u0440\u043e\u0443\u0433\u0459\u0435\u043d\u0438\u043a\u0435 (HFC), \u043f\u0435\u0440\u0444\u043b\u0443\u043e\u0440\u043e\u0443\u0433\u0459\u0435\u043d\u0438\u043a\u0435 (PFC), \u0430\u0437\u043e\u0442-\u0442\u0440\u0438\u0444\u043b\u0443\u043e\u0440\u0438\u0434 (NF\u2083) \u0438 \u0441\u0443\u043c\u043f\u043e\u0440-\u0445\u0435\u043a\u0441\u0430\u0444\u043b\u0443\u043e\u0440\u0438\u0434 (SF\u2086), \u0438\u0437 \u0441\u0432\u0438\u0445 \u0441\u0435\u043a\u0442\u043e\u0440\u0430 \u0438\u043d\u0432\u0435\u043d\u0442\u0430\u0440\u0430 \u0435\u043c\u0438\u0441\u0438\u0458\u0430 \u0433\u0430\u0441\u043e\u0432\u0430 \u0441\u0430 \u0435\u0444\u0435\u043a\u0442\u043e\u043c \u0441\u0442\u0430\u043a\u043b\u0435\u043d\u0435 \u0431\u0430\u0448\u0442\u0435. \u041f\u0440\u043e\u0446\u0438\u0458\u0435\u045a\u0435\u043d\u0435 \u0435\u043c\u0438\u0441\u0438\u0458\u0435 \u0438\u0437 \u043c\u0435\u0452\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0433 \u0432\u0430\u0437\u0434\u0443\u0448\u043d\u043e\u0433 \u0438 \u043f\u043e\u043c\u043e\u0440\u0441\u043a\u043e\u0433 \u0441\u0430\u043e\u0431\u0440\u0430\u045b\u0430\u0458\u0430 \u0438\u0441\u043a\u0459\u0443\u0447\u0435\u043d\u0435 \u0441\u0443 \u0437\u0430 \u043f\u043e\u0458\u0435\u0434\u0438\u043d\u0430\u0447\u043d\u0435 \u0437\u0435\u043c\u0459\u0435. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043f\u0440\u0438\u043a\u0430\u0437\u0443\u0458\u0435 \u043a\u0430\u043e \u043d\u0435\u0442\u043e \u0435\u043c\u0438\u0441\u0438\u0458\u0435 \u0441\u0430 \u0443\u043a\u0459\u0443\u0447\u0435\u043d\u0438\u043c \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u045a\u0435\u043c \u0437\u0435\u043c\u0459\u0438\u0448\u0442\u0430, \u043f\u0440\u043e\u043c\u0458\u0435\u043d\u043e\u043c \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u045a\u0430 \u0437\u0435\u043c\u0459\u0438\u0448\u0442\u0430 \u0438 \u0448\u0443\u043c\u0430\u0440\u0441\u0442\u0432\u043e\u043c (LULUCF), \u043a\u0430\u043e \u0438 \u0431\u0435\u0437 LULUCF-\u0430. \u041f\u0440\u0438\u043c\u0458\u0435\u043d\u043e\u043c \u043f\u043e\u0458\u0435\u0434\u0438\u043d\u0430\u0447\u043d\u0438\u0445 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0458\u0430\u043b\u0430 \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e\u0433 \u0437\u0430\u0433\u0440\u0438\u0458\u0430\u0432\u0430\u045a\u0430 (GWP) \u0437\u0430 \u0441\u0432\u0430\u043a\u0438 \u0433\u0430\u0441, \u0435\u043c\u0438\u0441\u0438\u0458\u0435 \u0441\u0435 \u043e\u0431\u0458\u0435\u0434\u0438\u045a\u0443\u0458\u0443 \u0443 \u0458\u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u0438 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0438\u0437\u0440\u0430\u0436\u0435\u043d \u0443 \u0435\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442\u0443 CO\u2082. \u041f\u043e\u0434\u0430\u0446\u0438 \u0441\u0435 \u0437\u0430\u0441\u043d\u0438\u0432\u0430\u0458\u0443 \u043d\u0430 \u0433\u043e\u0434\u0438\u0448\u045a\u0435\u043c \u0438\u0437\u0432\u0458\u0435\u0448\u0442\u0430\u0432\u0430\u045a\u0443 \u043e \u0438\u043d\u0432\u0435\u043d\u0442\u0430\u0440\u0438\u043c\u0430 \u0435\u043c\u0438\u0441\u0438\u0458\u0430 \u0433\u0430\u0441\u043e\u0432\u0430 \u0441\u0430 \u0435\u0444\u0435\u043a\u0442\u043e\u043c \u0441\u0442\u0430\u043a\u043b\u0435\u043d\u0435 \u0431\u0430\u0448\u0442\u0435 \u0443 \u043e\u043a\u0432\u0438\u0440\u0443 UNFCCC-\u0430, \u0430 \u0437\u0430 Eurostat \u0438\u0445 \u043e\u0431\u0435\u0437\u0431\u0458\u0435\u0452\u0443\u0458\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0430 \u0430\u0433\u0435\u043d\u0446\u0438\u0458\u0430 \u0437\u0430 \u0436\u0438\u0432\u043e\u0442\u043d\u0443 \u0441\u0440\u0435\u0434\u0438\u043d\u0443 (EEA).","eu_rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043f\u0440\u0435\u043c\u0430 \u0426\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 13 \u043e \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u043e\u043c \u0434\u0458\u0435\u043b\u043e\u0432\u0430\u045a\u0443. \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0438 \u0437\u0430\u043a\u043e\u043d \u043e \u043a\u043b\u0438\u043c\u0438 \u0443\u0442\u0432\u0440\u0452\u0443\u0458\u0435 \u0446\u0438\u0459 \u0441\u043c\u0430\u045a\u0435\u045a\u0430 \u043d\u0435\u0442\u043e \u0435\u043c\u0438\u0441\u0438\u0458\u0430 \u0433\u0430\u0441\u043e\u0432\u0430 \u0441\u0430 \u0435\u0444\u0435\u043a\u0442\u043e\u043c \u0441\u0442\u0430\u043a\u043b\u0435\u043d\u0435 \u0431\u0430\u0448\u0442\u0435 \u0437\u0430 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 55% \u0434\u043e 2030. \u0433\u043e\u0434\u0438\u043d\u0435 \u0443 \u043e\u0434\u043d\u043e\u0441\u0443 \u043d\u0430 1990. \u0433\u043e\u0434\u0438\u043d\u0443 \u0438 \u043f\u043e\u0441\u0442\u0438\u0437\u0430\u045a\u0435 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0435 \u043d\u0435\u0443\u0442\u0440\u0430\u043b\u043d\u043e\u0441\u0442\u0438 \u0434\u043e 2050. \u0433\u043e\u0434\u0438\u043d\u0435. \u041f\u0430\u043a\u0435\u0442 \u201eFit for 55\u201c \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u0435 \u043c\u0458\u0435\u0440\u0435 \u0443 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0435\u043d\u0435\u0440\u0433\u0435\u0442\u0438\u043a\u0435, \u0441\u0430\u043e\u0431\u0440\u0430\u045b\u0430\u0458\u0430, \u043e\u043f\u043e\u0440\u0435\u0437\u0438\u0432\u0430\u045a\u0430 \u0438 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0435 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0435.","eu_methodology_characteristics":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u0430\u0436\u0443\u0440\u0438\u0440\u0430 \u0458\u0435\u0434\u043d\u043e\u043c \u0433\u043e\u0434\u0438\u0448\u045a\u0435. Eurostat \u043d\u0430\u0432\u043e\u0434\u0438 \u0434\u0430 \u0441\u0435 \u043f\u043e\u0434\u0430\u0446\u0438 \u0437\u0430 \u043f\u043e\u0458\u0435\u0434\u0438\u043d\u0430\u0447\u043d\u0435 \u0437\u0435\u043c\u0459\u0435 \u0437\u0430\u0441\u043d\u0438\u0432\u0430\u0458\u0443 \u043d\u0430 \u0438\u0437\u0432\u0458\u0435\u0448\u0442\u0430\u0432\u0430\u045a\u0443 \u043e \u0438\u043d\u0432\u0435\u043d\u0442\u0430\u0440\u0438\u043c\u0430 \u0433\u0430\u0441\u043e\u0432\u0430 \u0441\u0430 \u0435\u0444\u0435\u043a\u0442\u043e\u043c \u0441\u0442\u0430\u043a\u043b\u0435\u043d\u0435 \u0431\u0430\u0448\u0442\u0435 \u0443 \u043e\u043a\u0432\u0438\u0440\u0443 UNFCCC-\u0430, \u043a\u043e\u0458\u0435 \u0437\u0430 Eurostat \u043e\u0431\u0435\u0437\u0431\u0458\u0435\u0452\u0443\u0458\u0435 EEA. \u0412\u0440\u0435\u043c\u0435\u043d\u0441\u043a\u0430 \u0441\u0435\u0440\u0438\u0458\u0430 \u043f\u043e\u0447\u0438\u045a\u0435 1990. \u0433\u043e\u0434\u0438\u043d\u043e\u043c, \u0430 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0458\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u0430\u043d \u0443 \u0442\u0440\u0438 \u043e\u0431\u043b\u0438\u043a\u0430: \u043c\u0438\u043b\u0438\u043e\u043d \u0442\u043e\u043d\u0430 CO\u2082 \u0435\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442\u0430, \u0442\u043e\u043d\u0430 CO\u2082 \u0435\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442\u0430 \u043f\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0443 \u0438 \u0438\u043d\u0434\u0435\u043a\u0441 1990=100.","eu_long_objective":"\u0421\u043c\u0430\u045a\u0435\u045a\u0435 \u043d\u0435\u0442\u043e \u0435\u043c\u0438\u0441\u0438\u0458\u0430 \u0433\u0430\u0441\u043e\u0432\u0430 \u0441\u0430 \u0435\u0444\u0435\u043a\u0442\u043e\u043c \u0441\u0442\u0430\u043a\u043b\u0435\u043d\u0435 \u0431\u0430\u0448\u0442\u0435 \u0437\u0430 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 55% \u0443 \u043e\u0434\u043d\u043e\u0441\u0443 \u043d\u0430 \u043d\u0438\u0432\u043e \u0438\u0437 1990. \u0433\u043e\u0434\u0438\u043d\u0435 \u0434\u043e 2030. \u0433\u043e\u0434\u0438\u043d\u0435 \u0438 \u043f\u043e\u0441\u0442\u0438\u0437\u0430\u045a\u0435 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0435 \u043d\u0435\u0443\u0442\u0440\u0430\u043b\u043d\u043e\u0441\u0442\u0438 \u0434\u043e 2050. \u0433\u043e\