{"indicator_number":13.21,"reporting_status":"complete","published":true,"sdg_goal":"13","data_non_statistical":false,"graph_type":"line","indicator_sort_order":"13-21","source_active_1":true,"source_organisation_1":"UNFCCC/EEA","source_url_1":"","indicator_definition":"\u041e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043c\u0435\u0440\u0438 \u043d\u0435\u0442\u043e \u0443\u043a\u043b\u0430\u045a\u0430\u045a\u0435 \u0443\u0433\u0459\u0435\u043d\u0438\u043a\u0430 \u0438\u0437 \u0441\u0435\u043a\u0442\u043e\u0440\u0430 \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u045a\u0430 \u0437\u0435\u043c\u0459\u0438\u0448\u0442\u0430, \u043f\u0440\u043e\u043c\u0435\u043d\u0430 \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u045a\u0430 \u0437\u0435\u043c\u0459\u0438\u0448\u0442\u0430 \u0438 \u0448\u0443\u043c\u0430\u0440\u0441\u0442\u0432\u0430 (LULUCF), \u0443\u0437\u0438\u043c\u0430\u0458\u0443\u045b\u0438 \u0443 \u043e\u0431\u0437\u0438\u0440 \u0438 \u0435\u043c\u0438\u0441\u0438\u0458\u0435 \u0438 \u0443\u043a\u043b\u0430\u045a\u0430\u045a\u0435 \u0438\u0437 \u0441\u0435\u043a\u0442\u043e\u0440\u0430. \u041f\u043e\u0434\u0430\u0446\u0438 \u043e LULUCF-\u0443 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430\u0458\u0443 \u0433\u043e\u0434\u0438\u0448\u045a\u0435 \u0442\u043e\u043a\u043e\u0432\u0435 CO2, CH4 \u0438 N2O \u0441\u0430 \u0441\u0432\u0438\u0445 \u0443\u043f\u0440\u0430\u0432\u0459\u0430\u043d\u0438\u0445 \u0437\u0435\u043c\u0459\u0438\u0448\u0442\u0430 \u0443 \u0415\u0423. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u0438\u0437\u0440\u0430\u0436\u0430\u0432\u0430 \u043a\u0430\u043e \u0435\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442 CO2 \u043a\u043e\u0440\u0438\u0441\u0442\u0435\u045b\u0438 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0458\u0430\u043b \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e\u0433 \u0437\u0430\u0433\u0440\u0435\u0432\u0430\u045a\u0430 (GWP) \u0441\u0432\u0430\u043a\u043e\u0433 \u0433\u0430\u0441\u0430. \u041f\u043e\u0434\u0430\u0446\u0438 \u043e \u0435\u043c\u0438\u0441\u0438\u0458\u0430\u043c\u0430 \u0438 \u0443\u043a\u043b\u0430\u045a\u0430\u045a\u0443, \u043f\u043e\u0437\u043d\u0430\u0442\u0438 \u043a\u0430\u043e \u0438\u043d\u0432\u0435\u043d\u0442\u0430\u0440\u0438 \u0433\u0430\u0441\u043e\u0432\u0430 \u0441\u0442\u0430\u043a\u043b\u0435\u043d\u0435 \u0431\u0430\u0448\u0442\u0435, \u0433\u043e\u0434\u0438\u0448\u045a\u0435 \u0441\u0435 \u0438\u0437\u0432\u0435\u0448\u0442\u0430\u0432\u0430\u0458\u0443 \u043e\u0434 \u0441\u0442\u0440\u0430\u043d\u0435 \u0437\u0435\u043c\u0430\u0459\u0430 \u0447\u043b\u0430\u043d\u0438\u0446\u0430 \u0415\u0423 \u0438 \u041e\u043a\u0432\u0438\u0440\u043d\u0435 \u043a\u043e\u043d\u0432\u0435\u043d\u0446\u0438\u0458\u0435 \u0423\u0458\u0435\u0434\u0438\u045a\u0435\u043d\u0438\u0445 \u043d\u0430\u0446\u0438\u0458\u0430 \u043e \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0438\u043c \u043f\u0440\u043e\u043c\u0435\u043d\u0430\u043c\u0430 (UNFCCC). \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0430 \u0430\u0433\u0435\u043d\u0446\u0438\u0458\u0430 \u0437\u0430 \u0436\u0438\u0432\u043e\u0442\u043d\u0443 \u0441\u0440\u0435\u0434\u0438\u043d\u0443 (EEA) \u043f\u0440\u0438\u043a\u0443\u043f\u0459\u0430 \u0430\u0433\u0440\u0435\u0433\u0438\u0440\u0430\u043d\u0435 \u043f\u043e\u0434\u0430\u0442\u043a\u0435 \u0415\u0423 \u0438 \u043e\u0431\u0458\u0430\u0432\u0459\u0443\u0458\u0435 \u043f\u043e\u0434\u0430\u0442\u043a\u0435 \u0437\u0430 \u0415\u0423 \u0438 \u0441\u0432\u0435 \u0434\u0440\u0436\u0430\u0432\u0435 \u0447\u043b\u0430\u043d\u0438\u0446\u0435. \u0415\u0432\u0440\u043e\u0441\u0442\u0430\u0442 \u043f\u043e\u043d\u043e\u0432\u043e \u043e\u0431\u0458\u0430\u0432\u0459\u0443\u0458\u0435 \u043f\u043e\u0434\u0430\u0442\u043a\u0435 EEA.","rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u0430 \u043e\u0441\u0442\u0432\u0430\u0440\u0438\u0432\u0430\u045a\u0443 \u0426\u0438\u0459\u0430 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 13 \u043e \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0438\u043c \u0430\u043a\u0446\u0438\u0458\u0430\u043c\u0430, \u043a\u043e\u0458\u0438 \u0458\u0435 \u0443\u043a\u0459\u0443\u0447\u0435\u043d \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u0443 \u043e\u043a\u0432\u0438\u0440\u0443 \u201e\u041e\u0434\u0440\u0436\u0430\u0432\u0430\u045a\u0430 \u043a\u0432\u0430\u043b\u0438\u0442\u0435\u0442\u0430 \u0436\u0438\u0432\u043e\u0442\u0430: \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442 \u0445\u0440\u0430\u043d\u0435, \u0432\u043e\u0434\u0430 \u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u0430\u201c. \u0426\u0438\u0459 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 13 \u0438\u043c\u0430 \u0437\u0430 \u0446\u0438\u0459 \u0441\u043f\u0440\u043e\u0432\u043e\u0452\u0435\u045a\u0435 \u043e\u0431\u0430\u0432\u0435\u0437\u0435 \u043f\u0440\u0435\u043c\u0430 \u041e\u043a\u0432\u0438\u0440\u043d\u043e\u0458 \u043a\u043e\u043d\u0432\u0435\u043d\u0446\u0438\u0458\u0438 \u0423\u0458\u0435\u0434\u0438\u045a\u0435\u043d\u0438\u0445 \u043d\u0430\u0446\u0438\u0458\u0430 \u043e \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0438\u043c \u043f\u0440\u043e\u043c\u0435\u043d\u0430\u043c\u0430 \u0434\u0430 \u0441\u0435 \u0434\u043e \u0441\u0440\u0435\u0434\u0438\u043d\u0435 \u0432\u0435\u043a\u0430 \u043f\u043e\u0441\u0442\u0438\u0433\u043d\u0435 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0438 \u043d\u0435\u0443\u0442\u0440\u0430\u043b\u0430\u043d \u0441\u0432\u0435\u0442 \u043a\u0430\u043a\u043e \u0431\u0438 \u0441\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u043b\u043e \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e \u0437\u0430\u0433\u0440\u0435\u0432\u0430\u045a\u0435 \u043d\u0430 \u0437\u043d\u0430\u0442\u043d\u043e \u0438\u0441\u043f\u043e\u0434 2\u00b0C, \u0441\u0430 \u0446\u0438\u0459\u0435\u043c \u0434\u0430 \u0441\u0435 \u0434\u043e\u0441\u0442\u0438\u0433\u043d\u0435 1,5\u00b0C (\u0443 \u043f\u043e\u0440\u0435\u0452\u0435\u045a\u0443 \u0441\u0430 \u043f\u0440\u0435\u0434\u0438\u043d\u0434\u0443\u0441\u0442\u0440\u0438\u0458\u0441\u043a\u0438\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u043e\u043c). \u0422\u0430\u043a\u043e\u0452\u0435 \u0438\u043c\u0430 \u0437\u0430 \u0446\u0438\u0459 \u0458\u0430\u0447\u0430\u045a\u0435 \u043e\u0442\u043f\u043e\u0440\u043d\u043e\u0441\u0442\u0438 \u0438 \u0430\u0434\u0430\u043f\u0442\u0438\u0432\u043d\u043e\u0433 \u043a\u0430\u043f\u0430\u0446\u0438\u0442\u0435\u0442\u0430 \u0437\u0435\u043c\u0430\u0459\u0430 \u043d\u0430 \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u0435 \u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u0435 \u0441\u0430 \u043a\u043b\u0438\u043c\u043e\u043c \u0438 \u043a\u0430\u0442\u0430\u0441\u0442\u0440\u043e\u0444\u0435 \u043a\u043e\u0458\u0435 \u0438\u0437 \u0442\u043e\u0433\u0430 \u043f\u0440\u043e\u0438\u0437\u0438\u043b\u0430\u0437\u0435.","methodology_characteristics":"\u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0438 \u0437\u0430\u043a\u043e\u043d \u043e \u043a\u043b\u0438\u043c\u0438 \u0443\u0442\u0432\u0440\u0452\u0443\u0458\u0435 \u043e\u043a\u0432\u0438\u0440 \u0437\u0430 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0435 \u0430\u043a\u0446\u0438\u0458\u0435 \u0438 \u043f\u043e\u0432\u0435\u045b\u0430\u0432\u0430 \u0430\u043c\u0431\u0438\u0446\u0438\u0458\u0435 \u0415\u0423 \u0437\u0430 2030. \u0433\u043e\u0434\u0438\u043d\u0443, \u0441\u0430 \u043d\u043e\u0432\u0438\u043c \u0446\u0438\u0459\u0435\u043c \u0441\u043c\u0430\u045a\u0435\u045a\u0430 \u043d\u0435\u0442\u043e \u0435\u043c\u0438\u0441\u0438\u0458\u0430 \u0433\u0430\u0441\u043e\u0432\u0430 \u0441\u0442\u0430\u043a\u043b\u0435\u043d\u0435 \u0431\u0430\u0448\u0442\u0435 (\u0413\u0421\u0413) \u0437\u0430 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 55% \u0434\u043e \u0442\u0435 \u0433\u043e\u0434\u0438\u043d\u0435 (\u0443 \u043f\u043e\u0440\u0435\u0452\u0435\u045a\u0443 \u0441\u0430 1990. \u0433\u043e\u0434\u0438\u043d\u043e\u043c) \u0438 \u043f\u043e\u0441\u0442\u0438\u0437\u0430\u045a\u0430 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0435 \u043d\u0435\u0443\u0442\u0440\u0430\u043b\u043d\u043e\u0441\u0442\u0438 \u0434\u043e 2050. \u0433\u043e\u0434\u0438\u043d\u0435. \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0430 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0430 \u0458\u0435 \u0442\u0430\u043a\u043e\u0452\u0435 \u0443\u0432\u0435\u043b\u0430 \u043f\u0430\u043a\u0435\u0442 \u043d\u043e\u0432\u043e\u0433 \u0438 \u0440\u0435\u0432\u0438\u0434\u0438\u0440\u0430\u043d\u043e\u0433 \u0437\u0430\u043a\u043e\u043d\u043e\u0434\u0430\u0432\u0441\u0442\u0432\u0430 \u0415\u0423 \u043e \u043a\u043b\u0438\u043c\u0438 \u0438 \u0435\u043d\u0435\u0440\u0433\u0435\u0442\u0438\u0446\u0438 \u2013 \u0442\u0430\u043a\u043e\u0437\u0432\u0430\u043d\u0438 \u043f\u0430\u043a\u0435\u0442 \u201e\u0421\u043f\u0440\u0435\u043c\u043d\u0438 \u0437\u0430 55\u201c \u2013 \u043a\u0430\u043a\u043e \u0431\u0438 \u043f\u043e\u0432\u0435\u045b\u0430\u043b\u0430 \u0441\u0432\u043e\u0458\u0435 \u0430\u043c\u0431\u0438\u0446\u0438\u0458\u0435 \u0437\u0430 \u0443\u0431\u043b\u0430\u0436\u0430\u0432\u0430\u045a\u0435 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0438\u0445 \u043f\u0440\u043e\u043c\u0435\u043d\u0430. \u041f\u0430\u043a\u0435\u0442 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430 \u043c\u0435\u0452\u0443\u0441\u043e\u0431\u043d\u043e \u043f\u043e\u0432\u0435\u0437\u0430\u043d \u0441\u043a\u0443\u043f \u043c\u0435\u0440\u0430 \u0443 \u043e\u0431\u043b\u0430\u0441\u0442\u0438\u043c\u0430 \u0435\u043d\u0435\u0440\u0433\u0435\u0442\u0438\u043a\u0435, \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442\u0430, \u043e\u043f\u043e\u0440\u0435\u0437\u0438\u0432\u0430\u045a\u0430 \u0438 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0438\u0445 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0430, \u0438 \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0435 \u043f\u043e\u0458\u0430\u0447\u0430\u043d\u043e \u0438 \u043f\u0440\u043e\u0448\u0438\u0440\u0435\u043d\u043e \u043e\u0434\u0440\u0435\u0452\u0438\u0432\u0430\u045a\u0435 \u0446\u0435\u043d\u0430 \u0443\u0433\u0459\u0435\u043d\u0438\u043a\u0430, \u0446\u0438\u0459\u0435\u0432\u0435, \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0434\u0435 \u0438 \u043c\u0435\u0440\u0435 \u043f\u043e\u0434\u0440\u0448\u043a\u0435. \u0422\u0430\u043a\u043e\u0452\u0435 \u043f\u043e\u0441\u0442\u0430\u0432\u0459\u0430 \u0446\u0438\u0459 \u0437\u0430 \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u0435 \u043f\u043e\u043d\u043e\u0440\u0435 \u0443\u0433\u0459\u0435\u043d\u0438\u043a\u0430 \u043e\u0434 310 \u043c\u0438\u043b\u0438\u043e\u043d\u0430 \u0442\u043e\u043d\u0430 \u0435\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442\u0430 CO2.","eu_indicator_definition":"\u041e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043c\u0435\u0440\u0438 \u043d\u0435\u0442\u043e \u0443\u043a\u043b\u0430\u045a\u0430\u045a\u0435 \u0443\u0433\u0459\u0435\u043d\u0438\u043a\u0430 \u0438\u0437 \u0441\u0435\u043a\u0442\u043e\u0440\u0430 \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u045a\u0430 \u0437\u0435\u043c\u0459\u0438\u0448\u0442\u0430, \u043f\u0440\u043e\u043c\u0435\u043d\u0430 \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u045a\u0430 \u0437\u0435\u043c\u0459\u0438\u0448\u0442\u0430 \u0438 \u0448\u0443\u043c\u0430\u0440\u0441\u0442\u0432\u0430 (LULUCF), \u0443\u0437\u0438\u043c\u0430\u0458\u0443\u045b\u0438 \u0443 \u043e\u0431\u0437\u0438\u0440 \u0438 \u0435\u043c\u0438\u0441\u0438\u0458\u0435 \u0438 \u0443\u043a\u043b\u0430\u045a\u0430\u045a\u0435 \u0438\u0437 \u0441\u0435\u043a\u0442\u043e\u0440\u0430. \u041f\u043e\u0434\u0430\u0446\u0438 \u043e LULUCF-\u0443 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430\u0458\u0443 \u0433\u043e\u0434\u0438\u0448\u045a\u0435 \u0442\u043e\u043a\u043e\u0432\u0435 CO2, CH4 \u0438 N2O \u0441\u0430 \u0441\u0432\u0438\u0445 \u0443\u043f\u0440\u0430\u0432\u0459\u0430\u043d\u0438\u0445 \u0437\u0435\u043c\u0459\u0438\u0448\u0442\u0430 \u0443 \u0415\u0423. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u0438\u0437\u0440\u0430\u0436\u0430\u0432\u0430 \u043a\u0430\u043e \u0435\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442 CO2 \u043a\u043e\u0440\u0438\u0441\u0442\u0435\u045b\u0438 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0458\u0430\u043b \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e\u0433 \u0437\u0430\u0433\u0440\u0435\u0432\u0430\u045a\u0430 (GWP) \u0441\u0432\u0430\u043a\u043e\u0433 \u0433\u0430\u0441\u0430. \u041f\u043e\u0434\u0430\u0446\u0438 \u043e \u0435\u043c\u0438\u0441\u0438\u0458\u0430\u043c\u0430 \u0438 \u0443\u043a\u043b\u0430\u045a\u0430\u045a\u0443, \u043f\u043e\u0437\u043d\u0430\u0442\u0438 \u043a\u0430\u043e \u0438\u043d\u0432\u0435\u043d\u0442\u0430\u0440\u0438 \u0433\u0430\u0441\u043e\u0432\u0430 \u0441\u0442\u0430\u043a\u043b\u0435\u043d\u0435 \u0431\u0430\u0448\u0442\u0435, \u0433\u043e\u0434\u0438\u0448\u045a\u0435 \u0441\u0435 \u0438\u0437\u0432\u0435\u0448\u0442\u0430\u0432\u0430\u0458\u0443 \u043e\u0434 \u0441\u0442\u0440\u0430\u043d\u0435 \u0437\u0435\u043c\u0430\u0459\u0430 \u0447\u043b\u0430\u043d\u0438\u0446\u0430 \u0415\u0423 \u0438 \u041e\u043a\u0432\u0438\u0440\u043d\u0435 \u043a\u043e\u043d\u0432\u0435\u043d\u0446\u0438\u0458\u0435 \u0423\u0458\u0435\u0434\u0438\u045a\u0435\u043d\u0438\u0445 \u043d\u0430\u0446\u0438\u0458\u0430 \u043e \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0438\u043c \u043f\u0440\u043e\u043c\u0435\u043d\u0430\u043c\u0430 (UNFCCC). \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0430 \u0430\u0433\u0435\u043d\u0446\u0438\u0458\u0430 \u0437\u0430 \u0436\u0438\u0432\u043e\u0442\u043d\u0443 \u0441\u0440\u0435\u0434\u0438\u043d\u0443 (EEA) \u043f\u0440\u0438\u043a\u0443\u043f\u0459\u0430 \u0430\u0433\u0440\u0435\u0433\u0438\u0440\u0430\u043d\u0435 \u043f\u043e\u0434\u0430\u0442\u043a\u0435 \u0415\u0423 \u0438 \u043e\u0431\u0458\u0430\u0432\u0459\u0443\u0458\u0435 \u043f\u043e\u0434\u0430\u0442\u043a\u0435 \u0437\u0430 \u0415\u0423 \u0438 \u0441\u0432\u0435 \u0434\u0440\u0436\u0430\u0432\u0435 \u0447\u043b\u0430\u043d\u0438\u0446\u0435. \u0415\u0432\u0440\u043e\u0441\u0442\u0430\u0442 \u043f\u043e\u043d\u043e\u0432\u043e \u043e\u0431\u0458\u0430\u0432\u0459\u0443\u0458\u0435 \u043f\u043e\u0434\u0430\u0442\u043a\u0435 EEA.","eu_rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u0430 \u043e\u0441\u0442\u0432\u0430\u0440\u0438\u0432\u0430\u045a\u0443 \u0426\u0438\u0459\u0430 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 13 \u043e \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0438\u043c \u0430\u043a\u0446\u0438\u0458\u0430\u043c\u0430, \u043a\u043e\u0458\u0438 \u0458\u0435 \u0443\u043a\u0459\u0443\u0447\u0435\u043d \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u0443 \u043e\u043a\u0432\u0438\u0440\u0443 \u201e\u041e\u0434\u0440\u0436\u0430\u0432\u0430\u045a\u0430 \u043a\u0432\u0430\u043b\u0438\u0442\u0435\u0442\u0430 \u0436\u0438\u0432\u043e\u0442\u0430: \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442 \u0445\u0440\u0430\u043d\u0435, \u0432\u043e\u0434\u0430 \u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u0430\u201c. \u0426\u0438\u0459 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 13 \u0438\u043c\u0430 \u0437\u0430 \u0446\u0438\u0459 \u0441\u043f\u0440\u043e\u0432\u043e\u0452\u0435\u045a\u0435 \u043e\u0431\u0430\u0432\u0435\u0437\u0435 \u043f\u0440\u0435\u043c\u0430 \u041e\u043a\u0432\u0438\u0440\u043d\u043e\u0458 \u043a\u043e\u043d\u0432\u0435\u043d\u0446\u0438\u0458\u0438 \u0423\u0458\u0435\u0434\u0438\u045a\u0435\u043d\u0438\u0445 \u043d\u0430\u0446\u0438\u0458\u0430 \u043e \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0438\u043c \u043f\u0440\u043e\u043c\u0435\u043d\u0430\u043c\u0430 \u0434\u0430 \u0441\u0435 \u0434\u043e \u0441\u0440\u0435\u0434\u0438\u043d\u0435 \u0432\u0435\u043a\u0430 \u043f\u043e\u0441\u0442\u0438\u0433\u043d\u0435 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0438 \u043d\u0435\u0443\u0442\u0440\u0430\u043b\u0430\u043d \u0441\u0432\u0435\u0442 \u043a\u0430\u043a\u043e \u0431\u0438 \u0441\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u043b\u043e \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e \u0437\u0430\u0433\u0440\u0435\u0432\u0430\u045a\u0435 \u043d\u0430 \u0437\u043d\u0430\u0442\u043d\u043e \u0438\u0441\u043f\u043e\u0434 2\u00b0C, \u0441\u0430 \u0446\u0438\u0459\u0435\u043c \u0434\u0430 \u0441\u0435 \u0434\u043e\u0441\u0442\u0438\u0433\u043d\u0435 1,5\u00b0C (\u0443 \u043f\u043e\u0440\u0435\u0452\u0435\u045a\u0443 \u0441\u0430 \u043f\u0440\u0435\u0434\u0438\u043d\u0434\u0443\u0441\u0442\u0440\u0438\u0458\u0441\u043a\u0438\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u043e\u043c). \u0422\u0430\u043a\u043e\u0452\u0435 \u0438\u043c\u0430 \u0437\u0430 \u0446\u0438\u0459 \u0458\u0430\u0447\u0430\u045a\u0435 \u043e\u0442\u043f\u043e\u0440\u043d\u043e\u0441\u0442\u0438 \u0438 \u0430\u0434\u0430\u043f\u0442\u0438\u0432\u043d\u043e\u0433 \u043a\u0430\u043f\u0430\u0446\u0438\u0442\u0435\u0442\u0430 \u0437\u0435\u043c\u0430\u0459\u0430 \u043d\u0430 \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u0435 \u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u0435 \u0441\u0430 \u043a\u043b\u0438\u043c\u043e\u043c \u0438 \u043a\u0430\u0442\u0430\u0441\u0442\u0440\u043e\u0444\u0435 \u043a\u043e\u0458\u0435 \u0438\u0437 \u0442\u043e\u0433\u0430 \u043f\u0440\u043e\u0438\u0437\u0438\u043b\u0430\u0437\u0435.","eu_methodology_characteristics":"\u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0438 \u0437\u0430\u043a\u043e\u043d \u043e \u043a\u043b\u0438\u043c\u0438 \u0443\u0442\u0432\u0440\u0452\u0443\u0458\u0435 \u043e\u043a\u0432\u0438\u0440 \u0437\u0430 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0435 \u0430\u043a\u0446\u0438\u0458\u0435 \u0438 \u043f\u043e\u0432\u0435\u045b\u0430\u0432\u0430 \u0430\u043c\u0431\u0438\u0446\u0438\u0458\u0435 \u0415\u0423 \u0437\u0430 2030. \u0433\u043e\u0434\u0438\u043d\u0443, \u0441\u0430 \u043d\u043e\u0432\u0438\u043c \u0446\u0438\u0459\u0435\u043c \u0441\u043c\u0430\u045a\u0435\u045a\u0430 \u043d\u0435\u0442\u043e \u0435\u043c\u0438\u0441\u0438\u0458\u0430 \u0433\u0430\u0441\u043e\u0432\u0430 \u0441\u0442\u0430\u043a\u043b\u0435\u043d\u0435 \u0431\u0430\u0448\u0442\u0435 (\u0413\u0421\u0413) \u0437\u0430 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 55% \u0434\u043e \u0442\u0435 \u0433\u043e\u0434\u0438\u043d\u0435 (\u0443 \u043f\u043e\u0440\u0435\u0452\u0435\u045a\u0443 \u0441\u0430 1990. \u0433\u043e\u0434\u0438\u043d\u043e\u043c) \u0438 \u043f\u043e\u0441\u0442\u0438\u0437\u0430\u045a\u0430 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0435 \u043d\u0435\u0443\u0442\u0440\u0430\u043b\u043d\u043e\u0441\u0442\u0438 \u0434\u043e 2050. \u0433\u043e\u0434\u0438\u043d\u0435. \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0430 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0430 \u0458\u0435 \u0442\u0430\u043a\u043e\u0452\u0435 \u0443\u0432\u0435\u043b\u0430 \u043f\u0430\u043a\u0435\u0442 \u043d\u043e\u0432\u043e\u0433 \u0438 \u0440\u0435\u0432\u0438\u0434\u0438\u0440\u0430\u043d\u043e\u0433 \u0437\u0430\u043a\u043e\u043d\u043e\u0434\u0430\u0432\u0441\u0442\u0432\u0430 \u0415\u0423 \u043e \u043a\u043b