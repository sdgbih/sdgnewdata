\u0458 \u0438 \u0425\u043e\u043b\u0430\u043d\u0434\u0438\u0458\u0438. \u041c\u0435\u0452\u0443 \u0438\u0441\u043f\u0438\u0442\u0430\u043d\u0438\u0446\u0438\u043c\u0430 \u0441\u0443 \u0431\u0438\u043b\u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043d\u0438\u0446\u0438 \u043a\u0430\u043d\u0442\u043e\u043d\u0430\u043b\u043d\u0438\u0445 \u043c\u0438\u043d\u0438\u0441\u0442\u0430\u0440\u0441\u0442\u0430\u0432\u0430, \u043e\u043f\u0448\u0442\u0438\u043d\u0441\u043a\u0438\u0445 \u0432\u043b\u0430\u0441\u0442\u0438, \u043d\u0435\u0432\u043b\u0430\u0434\u0438\u043d\u0438\u0445 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0458\u0430 \u043a\u043e\u0458\u0435 \u0440\u0430\u0434\u0435 \u043d\u0430 \u043f\u0440\u0430\u0432\u0438\u043c\u0430 \u0441\u0442\u0430\u043d\u0430\u0440\u0430 \u0438 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\u0447\u043d\u043e\u0441\u0442\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045a\u0430, \u043a\u0430\u043e \u0438 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u0447\u0438 \u0441\u043f\u0435\u0446\u0438\u0458\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u0438 \u0437\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045a\u0430. \u041e\u0432\u0438 \u0438\u043d\u0442\u0435\u0440\u0432\u0458\u0443\u0438 \u043f\u0440\u0443\u0436\u0438\u043b\u0438 \u0441\u0443 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u043d\u0435 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u0435 \u043e \u0438\u0437\u0430\u0437\u043e\u0432\u0438\u043c\u0430 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u043e\u0433 \u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045a\u0430, \u043d\u0435\u0444\u043e\u0440\u043c\u0430\u043b\u043d\u0438\u0445 \u0442\u0440\u0436\u0438\u0448\u0442\u0430 \u0438\u0437\u043d\u0430\u0458\u043c\u0459\u0438\u0432\u0430\u045a\u0430, \u043f\u0440\u0430\u0437\u043d\u0438\u0445 \u043d\u0435\u043a\u0440\u0435\u0442\u043d\u0438\u043d\u0430 \u0438 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\u0447\u043d\u043e\u0441\u0442\u0438. ","long_objective":"\u0411\u043e\u0441\u043d\u0430 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0430 \u0441\u0435 \u0441\u0432\u0440\u0441\u0442\u0430\u0432\u0430 \u043c\u0435\u0452\u0443 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\u0447\u043d\u0435 \u0437\u0435\u043c\u0459\u0435 \u0443 \u0415\u0432\u0440\u043e\u043f\u0438 \u0437\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045a\u0435, \u0441\u0430 \u043f\u0440\u043e\u0441\u0458\u0435\u0447\u043d\u0438\u043c \u043e\u043c\u0458\u0435\u0440\u043e\u043c \u0446\u0438\u0458\u0435\u043d\u0435 \u0438 \u043f\u0440\u0438\u0445\u043e\u0434\u0430 \u043a\u043e\u0458\u0438 \u043f\u0440\u0435\u043b\u0430\u0437\u0438 13, \u0448\u0442\u043e \u0458\u0435 \u0434\u0430\u043b\u0435\u043a\u043e \u0438\u0437\u043d\u0430\u0434, \u043d\u0430 \u043f\u0440\u0438\u043c\u0458\u0435\u0440, \u0425\u043e\u043b\u0430\u043d\u0434\u0438\u0458\u0435 \u0441\u0430 7,7 \u0438 \u0414\u0430\u043d\u0441\u043a\u0435 \u0441\u0430 6,6.","eu_indicator_definition":"\u041f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\u0447\u043d\u043e\u0441\u0442 \u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045a\u0430 \u0443 \u0411\u0438\u0425 \u0434\u043e\u0441\u0442\u0438\u0433\u043b\u0430 \u0458\u0435 \u043a\u0440\u0438\u0442\u0438\u0447\u043d\u0443 \u0442\u0430\u0447\u043a\u0443, \u0433\u0434\u0458\u0435 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u043d\u0430 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0432\u0430 \u0442\u0440\u043e\u0448\u0435 \u043f\u0440\u0435\u043a\u043e 40% \u0441\u0432\u043e\u0458\u0438\u0445 \u043f\u0440\u0438\u0445\u043e\u0434\u0430 \u043d\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045a\u0435. \u041c\u043d\u043e\u0433\u0438 \u0444\u0430\u043a\u0442\u043e\u0440\u0438, \u043f\u043e\u043f\u0443\u0442 \u043f\u043e\u0442\u0440\u0430\u0436\u045a\u0435 \u0434\u0438\u0458\u0430\u0441\u043f\u043e\u0440\u0435 \u0438 \u0441\u0442\u0440\u0430\u043d\u0438\u0445 \u0438\u043d\u0432\u0435\u0441\u0442\u0438\u0442\u043e\u0440\u0430, \u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442\u0438\u0440\u0430\u043d\u0435 \u0438 \u043b\u043e\u0448\u0435 \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0438\u0441\u0430\u043d\u0435 \u0441\u0442\u0430\u043c\u0431\u0435\u043d\u0435 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0435, \u0434\u043e\u0432\u0435\u043b\u0438 \u0441\u0443 \u0434\u043e \u0442\u043e\u0433\u0430 \u0434\u0430 \u0446\u0438\u0458\u0435\u043d\u0435 \u0431\u0443\u0434\u0443 \u0432\u0430\u043d \u0434\u043e\u043c\u0430\u0448\u0430\u0458\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0430. \u0421\u0438\u0441\u0442\u0435\u043c\u0438 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u043e\u0433 \u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045a\u0430 \u043e\u0441\u0442\u0430\u0458\u0443 \u043d\u0435\u0440\u0430\u0437\u0432\u0438\u0458\u0435\u043d\u0438, \u0434\u043e\u043a \u043d\u0435\u0444\u043e\u0440\u043c\u0430\u043b\u043d\u0430 \u0442\u0440\u0436\u0438\u0448\u0442\u0430 \u0437\u0430\u043a\u0443\u043f\u0430 \u043f\u043e\u0434\u0441\u0442\u0438\u0447\u0443 \u0440\u0430\u045a\u0438\u0432\u043e\u0441\u0442 \u0441\u0442\u0430\u043d\u0430\u0440\u0430 \u0438 \u043b\u0438\u0448\u0430\u0432\u0430\u0458\u0443 \u0432\u043b\u0430\u0434\u0435 \u043f\u043e\u0440\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u0438\u0445\u043e\u0434\u0430.","eu_rationale":"\u0421\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u043e \u0438 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u0430 \u0438\u0441\u043a\u0459\u0443\u0447\u0435\u043d\u043e\u0441\u0442 \u0448\u0442\u0435\u0442\u0435 \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u043d\u0438\u043c \u0436\u0438\u0432\u043e\u0442\u0438\u043c\u0430 \u0438 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0430\u0432\u0430\u0458\u0443 \u043c\u043e\u0433\u0443\u045b\u043d\u043e\u0441\u0442\u0438 \u0459\u0443\u0434\u0438 \u0434\u0430 \u043e\u0441\u0442\u0432\u0430\u0440\u0435 \u0441\u0432\u043e\u0458 \u043f\u0443\u043d\u0438 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0458\u0430\u043b \u0442\u0430\u043a\u043e \u0448\u0442\u043e \u0443\u0442\u0438\u0447\u0443 \u043d\u0430 \u045a\u0438\u0445\u043e\u0432\u043e \u0437\u0434\u0440\u0430\u0432\u0459\u0435 \u0438 \u0431\u043b\u0430\u0433\u043e\u0441\u0442\u0430\u045a\u0435 \u0438 \u0441\u043c\u0430\u045a\u0443\u0458\u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u043d\u0435 \u0438\u0441\u0445\u043e\u0434\u0435. \u0422\u043e \u0437\u0430\u0443\u0437\u0432\u0440\u0430\u0442 \u0441\u043c\u0430\u045a\u0443\u0458\u0435 \u043c\u043e\u0433\u0443\u045b\u043d\u043e\u0441\u0442\u0438 \u0437\u0430 \u0443\u0441\u043f\u0458\u0435\u0448\u0430\u043d \u0436\u0438\u0432\u043e\u0442 \u0438 \u0434\u043e\u0434\u0430\u0442\u043d\u043e \u043f\u043e\u0432\u0435\u045b\u0430\u0432\u0430 \u0440\u0438\u0437\u0438\u043a \u043e\u0434 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430. \u0411\u0435\u0437 \u0435\u0444\u0438\u043a\u0430\u0441\u043d\u043e\u0433 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0430, \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u0445, \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u0438\u0445, \u043f\u043e\u0440\u0435\u0441\u043a\u0438\u0445 \u043e\u043b\u0430\u043a\u0448\u0438\u0446\u0430 \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0437\u0430\u043f\u043e\u0448\u0459\u0430\u0432\u0430\u045a\u0430, \u0440\u0438\u0437\u0438\u043a \u043e\u0434 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u0441\u0435 \u043f\u0440\u0435\u043d\u043e\u0441\u0438 \u0441\u0430 \u0458\u0435\u0434\u043d\u0435 \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0458\u0435 \u043d\u0430 \u0434\u0440\u0443\u0433\u0443. \u0422\u043e \u0443\u0437\u0440\u043e\u043a\u0443\u0458\u0435 \u043e\u043f\u0441\u0442\u0430\u043d\u0430\u043a \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u0438 \u0441\u0442\u043e\u0433\u0430 \u0441\u0442\u0432\u0430\u0440\u0430 \u0432\u0438\u0448\u0435 \u043d\u0435\u0458\u0435\u0434\u043d\u0430\u043a\u043e\u0441\u0442\u0438, \u0448\u0442\u043e \u043c\u043e\u0436\u0435 \u0434\u043e\u0432\u0435\u0441\u0442\u0438 \u0434\u043e \u0434\u0443\u0433\u043e\u0440\u043e\u0447\u043d\u043e\u0433 \u0433\u0443\u0431\u0438\u0442\u043a\u0430 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0435 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043e\u0434 \u0441\u0442\u0440\u0430\u043d\u0435 \u0447\u0438\u0442\u0430\u0432\u0438\u0445 \u0433\u0440\u0443\u043f\u0430 \u0434\u0440\u0443\u0448\u0442\u0432\u0430 \u0438 \u043e\u043c\u0435\u0442\u0430\u0442\u0438 \u0438\u043d\u043a\u043b\u0443\u0437\u0438\u0432\u043d\u0438 \u0438 \u043e\u0434\u0440\u0436\u0438\u0432\u0438 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0438 \u0440\u0430\u0441\u0442.","eu_methodology_characteristics":"\u041f\u043e\u0440\u0435\u0434 \u0430\u043d\u0430\u043b\u0438\u0437\u0435 \u043f\u043e\u0441\u0442\u043e\u0458\u0435\u045b\u0438\u0445 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430/\u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0430\u0442\u0430, \u043e\u0432\u0430\u0458 \u0440\u0430\u0434 \u0441\u0435 \u043e\u0441\u043b\u0430\u045a\u0430 \u043d\u0430 \u0443\u0432\u0438\u0434\u0435 \u0438\u0437 \u043e\u0441\u0430\u043c \u043f\u043e\u043b\u0443\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0438\u0440\u0430\u043d\u0438\u0445 \u0438\u043d\u0442\u0435\u0440\u0432\u0458\u0443\u0430 \u0441\u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0445 \u0441\u0430 \u0437\u0430\u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043d\u0438\u043c \u0441\u0442\u0440\u0430\u043d\u0430\u043c\u0430 \u0443 \u0411\u043e\u0441\u043d\u0438 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0438, \u0426\u0440\u043d\u043e\u0458 \u0413\u043e\u0440\u0438, \u0414\u0430\u043d\u0441\u043a\u043e\u0458 \u0438 \u0425\u043e\u043b\u0430\u043d\u0434\u0438\u0458\u0438. \u041c\u0435\u0452\u0443 \u0438\u0441\u043f\u0438\u0442\u0430\u043d\u0438\u0446\u0438\u043c\u0430 \u0441\u0443 \u0431\u0438\u043b\u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043d\u0438\u0446\u0438 \u043a\u0430\u043d\u0442\u043e\u043d\u0430\u043b\u043d\u0438\u0445 \u043c\u0438\u043d\u0438\u0441\u0442\u0430\u0440\u0441\u0442\u0430\u0432\u0430, \u043e\u043f\u0448\u0442\u0438\u043d\u0441\u043a\u0438\u0445 \u0432\u043b\u0430\u0441\u0442\u0438, \u043d\u0435\u0432\u043b\u0430\u0434\u0438\u043d\u0438\u0445 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0458\u0430 \u043a\u043e\u0458\u0435 \u0440\u0430\u0434\u0435 \u043d\u0430 \u043f\u0440\u0430\u0432\u0438\u043c\u0430 \u0441\u0442\u0430\u043d\u0430\u0440\u0430 \u0438 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\u0447\u043d\u043e\u0441\u0442\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045a\u0430, \u043a\u0430\u043e \u0438 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u0447\u0438 \u0441\u043f\u0435\u0446\u0438\u0458\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u0438 \u0437\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045a\u0430. \u041e\u0432\u0438 \u0438\u043d\u0442\u0435\u0440\u0432\u0458\u0443\u0438 \u043f\u0440\u0443\u0436\u0438\u043b\u0438 \u0441\u0443 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u043d\u0435 \u043f\u0435\u0440\u0441\u043f\u0435\u043a\u0442\u0438\u0432\u0435 \u043e \u0438\u0437\u0430\u0437\u043e\u0432\u0438\u043c\u0430 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u043e\u0433 \u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045a\u0430, \u043d\u0435\u0444\u043e\u0440\u043c\u0430\u043b\u043d\u0438\u0445 \u0442\u0440\u0436\u0438\u0448\u0442\u0430 \u0438\u0437\u043d\u0430\u0458\u043c\u0459\u0438\u0432\u0430\u045a\u0430, \u043f\u0440\u0430\u0437\u043d\u0438\u0445 \u043d\u0435\u043a\u0440\u0435\u0442\u043d\u0438\u043d\u0430 \u0438 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\u0447\u043d\u043e\u0441\u0442\u0438. ","eu_lon