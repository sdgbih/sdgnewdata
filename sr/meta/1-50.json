{"indicator_number":1.5,"reporting_status":"complete","published":true,"sdg_goal":"1","data_non_statistical":false,"graph_type":"bar","indicator_sort_order":"01-50","indicator_name":"\u041f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\u0447\u043d\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045a\u0435 - \u0437\u0430\u043c\u0458\u0435\u043d\u0441\u043a\u0438 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440","source_active_1":true,"source_organisation_1":"Comparative Analysis of Housing Policies in Selected WB Cities and EU Cities, 2025.","source_url_1":"https://osfwb.org/wp-content/uploads/2025/07/Housing-Policy-Paper-to-increase-affordability_AF_final.pdf","graph_titles":[{"series":"\u041f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\u0447\u043d\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045a\u0435 - \u0437\u0430\u043c\u0458\u0435\u043d\u0441\u043a\u0438 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440","title":"\u041f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\u0447\u043d\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045a\u0435 - \u0437\u0430\u043c\u0458\u0435\u043d\u0441\u043a\u0438 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440"}],"national_indicator_definition":"\u041f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\u0447\u043d\u043e\u0441\u0442 \u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045a\u0430 \u0443 \u0411\u043e\u0441\u043d\u0438 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0438 \u0441\u0430\u0433\u043b\u0435\u0434\u0430\u0432\u0430 \u0441\u0435 \u043a\u0440\u043e\u0437 \u043e\u0434\u043d\u043e\u0441 \u0446\u0438\u0458\u0435\u043d\u0435 \u0438 \u043f\u0440\u0438\u0445\u043e\u0434\u0430 \u0438 \u0438\u043d\u0434\u0435\u043a\u0441 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\u0447\u043d\u043e\u0441\u0442\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045a\u0430. \u041f\u0440\u0435\u043c\u0430 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0443 Comparative Analysis of Housing Policies in Selected WB Cities and EU Cities \u0438\u0437 2025. \u0433\u043e\u0434\u0438\u043d\u0435, \u043e\u0434\u043d\u043e\u0441 \u0446\u0438\u0458\u0435\u043d\u0435 \u0438 \u043f\u0440\u0438\u0445\u043e\u0434\u0430 \u0443 \u0411\u043e\u0441\u043d\u0438 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0438 \u0438\u0437\u043d\u043e\u0441\u0438 13,5, \u0434\u043e\u043a \u0438\u043d\u0434\u0435\u043a\u0441 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\u0447\u043d\u043e\u0441\u0442\u0438 \u0438\u0437\u043d\u043e\u0441\u0438 1,0. \u041e\u0432\u0435 \u043c\u0458\u0435\u0440\u0435 \u043f\u0440\u0443\u0436\u0430\u0458\u0443 \u0443\u0432\u0438\u0434 \u0443 \u043e\u0434\u043d\u043e\u0441 \u0446\u0438\u0458\u0435\u043d\u0430 \u043d\u0435\u043a\u0440\u0435\u0442\u043d\u0438\u043d\u0430 \u0438 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0438\u0445 \u043c\u043e\u0433\u0443\u045b\u043d\u043e\u0441\u0442\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u0430.","national_rationale":"\u041f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\u0447\u043d\u043e\u0441\u0442 \u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045a\u0430 \u0432\u0430\u0436\u043d\u0430 \u0458\u0435 \u0437\u0430 \u0436\u0438\u0432\u043e\u0442\u043d\u0438 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0434 \u0438 \u0441\u043c\u0430\u045a\u0435\u045a\u0435 \u0440\u0438\u0437\u0438\u043a\u0430 \u043e\u0434 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u0438 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u0435 \u0438\u0441\u043a\u0459\u0443\u0447\u0435\u043d\u043e\u0441\u0442\u0438. \u0412\u0438\u0441\u043e\u043a\u0435 \u0446\u0438\u0458\u0435\u043d\u0435 \u043d\u0435\u043a\u0440\u0435\u0442\u043d\u0438\u043d\u0430 \u0443 \u043e\u0434\u043d\u043e\u0441\u0443 \u043d\u0430 \u043f\u0440\u0438\u0445\u043e\u0434\u0435 \u043c\u043e\u0433\u0443 \u043e\u0442\u0435\u0436\u0430\u0442\u0438 \u0441\u0442\u0438\u0446\u0430\u045a\u0435 \u0432\u043b\u0430\u0441\u0442\u0438\u0442\u043e\u0433 \u0441\u0442\u0430\u043d\u0430 \u0438 \u043f\u043e\u0432\u0435\u045b\u0430\u0442\u0438 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0443 \u043d\u0435\u0441\u0438\u0433\u0443\u0440\u043d\u043e\u0441\u0442 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0430\u0432\u0430. \u041e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u043d\u0438 \u0415\u0423 SDG \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 1.50, \u201e\u0421\u0442\u043e\u043f\u0430 \u043f\u0440\u0435\u043e\u043f\u0442\u0435\u0440\u0435\u045b\u0435\u043d\u043e\u0441\u0442\u0438 \u0442\u0440\u043e\u0448\u043a\u043e\u0432\u0438\u043c\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045a\u0430 \u043f\u0440\u0435\u043c\u0430 \u0441\u0442\u0430\u0442\u0443\u0441\u0443 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430\u201c (Housing cost overburden rate by poverty status), \u0437\u0430\u0441\u043d\u0438\u0432\u0430 \u0441\u0435 \u043d\u0430 \u043f\u043e\u0434\u0430\u0446\u0438\u043c\u0430 \u0438\u0437 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0430 \u043e \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u043c\u0430 \u0438 \u0436\u0438\u0432\u043e\u0442\u043d\u0438\u043c \u0443\u0441\u043b\u043e\u0432\u0438\u043c\u0430 (SILC). \u0411\u0443\u0434\u0443\u045b\u0438 \u0434\u0430 \u043f\u043e\u0434\u0430\u0446\u0438 \u0437\u0430 \u0411\u043e\u0441\u043d\u0443 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0443 \u043d\u0438\u0441\u0443 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438 \u0443 \u0431\u0430\u0437\u0438 \u0415\u0432\u0440\u043e\u0441\u0442\u0430\u0442\u0430 \u0437\u0430 \u043f\u0440\u0438\u043a\u0430\u0437 \u043e\u0432\u043e\u0433 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u043f\u0440\u0435\u043c\u0430 \u0445\u0430\u0440\u043c\u043e\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u043e\u0458 \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u0458\u0438 \u0415\u0423, \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0441\u0435 \u0437\u0430\u043c\u0458\u0435\u043d\u0441\u043a\u0438 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0437\u0430\u0441\u043d\u043e\u0432\u0430\u043d \u043d\u0430 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0458 \u0430\u043d\u0430\u043b\u0438\u0437\u0438 \u0441\u0442\u0430\u043c\u0431\u0435\u043d\u0438\u0445 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0430. \u041e\u043d \u043f\u0440\u0443\u0436\u0430 \u0434\u043e\u0434\u0430\u0442\u043d\u0435 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0458\u0435 \u043e \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\u0447\u043d\u043e\u0441\u0442\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045a\u0430, \u0430\u043b\u0438 \u043d\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430 \u043d\u0435\u043f\u043e\u0441\u0440\u0435\u0434\u043d\u0443 \u043c\u0458\u0435\u0440\u0443 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u043d\u043e\u0433 \u0415\u0423 SDG \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430.","national_methodology_characteristics":"\u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u043f\u0440\u0438\u043a\u0430\u0437 \u0437\u0430\u0441\u043d\u0438\u0432\u0430 \u0441\u0435 \u043d\u0430 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0443 Comparative Analysis of Housing Policies in Selected WB Cities and EU Cities (2025). \u041f\u0440\u0435\u043c\u0430 \u0443\u043f\u043e\u0440\u0435\u0434\u043d\u043e\u043c \u043f\u0440\u0438\u043a\u0430\u0437\u0443 \u0443 \u043e\u0432\u043e\u043c \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0443, \u043e\u0434\u043d\u043e\u0441 \u0446\u0438\u0458\u0435\u043d\u0435 \u0438 \u043f\u0440\u0438\u0445\u043e\u0434\u0430 \u0443 \u0411\u043e\u0441\u043d\u0438 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0438 \u0438\u0437\u043d\u043e\u0441\u0438 13,5, \u0430 \u0438\u043d\u0434\u0435\u043a\u0441 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\u0447\u043d\u043e\u0441\u0442\u0438 1,0. \u0418\u0437\u0432\u043e\u0440 \u0441\u0435 \u043f\u043e\u0437\u0438\u0432\u0430 \u043d\u0430 Numbeo \u0438\u043d\u0434\u0435\u043a\u0441 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\u0447\u043d\u043e\u0441\u0442\u0438, \u0430\u043b\u0438 \u043d\u0435 \u043d\u0430\u0432\u043e\u0434\u0438 \u0458\u0430\u0441\u043d\u043e \u0440\u0435\u0444\u0435\u0440\u0435\u043d\u0442\u043d\u0443 \u0433\u043e\u0434\u0438\u043d\u0443 \u0437\u0430 \u043f\u0440\u0438\u043a\u0430\u0437\u0430\u043d\u0435 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442\u0438. \u0410\u043d\u0430\u043b\u0438\u0437\u0430 \u0441\u0435, \u043f\u043e\u0440\u0435\u0434 \u043f\u0440\u0435\u0433\u043b\u0435\u0434\u0430 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0445 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u0438 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0430\u0442\u0430, \u043e\u0441\u043b\u0430\u045a\u0430 \u043d\u0430 \u043e\u0441\u0430\u043c \u043f\u043e\u043b\u0443\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0438\u0440\u0430\u043d\u0438\u0445 \u0438\u043d\u0442\u0435\u0440\u0432\u0458\u0443\u0430 \u0441\u0430 \u0437\u0430\u0438\u043d\u0442\u0435\u0440\u0435\u0441\u043e\u0432\u0430\u043d\u0438\u043c \u0441\u0442\u0440\u0430\u043d\u0430\u043c\u0430 \u0438\u0437 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435, \u0426\u0440\u043d\u0435 \u0413\u043e\u0440\u0435, \u0414\u0430\u043d\u0441\u043a\u0435 \u0438 \u041d\u0438\u0437\u043e\u0437\u0435\u043c\u0441\u043a\u0435. \u041c\u0435\u0452\u0443 \u0441\u0430\u0433\u043e\u0432\u043e\u0440\u043d\u0438\u0446\u0438\u043c\u0430 \u0441\u0443 \u0431\u0438\u043b\u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043d\u0438\u0446\u0438 \u043a\u0430\u043d\u0442\u043e\u043d\u0430\u043b\u043d\u0438\u0445 \u043c\u0438\u043d\u0438\u0441\u0442\u0430\u0440\u0441\u0442\u0430\u0432\u0430 \u0438 \u043e\u043f\u0448\u0442\u0438\u043d\u0441\u043a\u0438\u0445 \u0432\u043b\u0430\u0441\u0442\u0438, \u043d\u0435\u0432\u043b\u0430\u0434\u0438\u043d\u0438\u0445 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0458\u0430 \u043a\u043e\u0458\u0435 \u0441\u0435 \u0431\u0430\u0432\u0435 \u043f\u0440\u0430\u0432\u0438\u043c\u0430 \u0441\u0442\u0430\u043d\u0430\u0440\u0430 \u0438 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\u0447\u043d\u043e\u0448\u045b\u0443 \u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045a\u0430, \u0442\u0435 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u0447\u0438 \u0441\u043f\u0435\u0446\u0438\u0458\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u0438 \u0437\u0430 \u0441\u0442\u0430\u043c\u0431\u0435\u043d\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u0435. \u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442 \u0440\u0430\u0437\u043c\u0430\u0442\u0440\u0430 \u0438 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u043e\u043a\u0432\u0438\u0440 \u0437\u0430 \u0441\u043f\u0440\u043e\u0432\u043e\u0452\u0435\u045a\u0435 \u0441\u0442\u0430\u043c\u0431\u0435\u043d\u0438\u0445 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0430 \u0443 \u0411\u043e\u0441\u043d\u0438 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0438. \u0423 \u0442\u043e\u043c \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0443 \u0441\u043f\u043e\u043c\u0438\u045a\u0443 \u0441\u0435 \u043f\u043e\u0458\u0435\u0434\u0438\u043d\u0430 \u0444\u0435\u0434\u0435\u0440\u0430\u043b\u043d\u0430 \u043c\u0438\u043d\u0438\u0441\u0442\u0430\u0440\u0441\u0442\u0432\u0430, \u0412\u043b\u0430\u0434\u0430 \u0420\u0435\u043f\u0443\u0431\u043b\u0438\u043a\u0435 \u0421\u0440\u043f\u0441\u043a\u0435, \u0420\u0435\u043f\u0443\u0431\u043b\u0438\u0447\u043a\u0438 \u0441\u0435\u043a\u0440\u0435\u0442\u0430\u0440\u0438\u0458\u0430\u0442 \u0437\u0430 \u0438\u0437\u0431\u0458\u0435\u0433\u043b\u0438\u0446\u0435 \u0438 \u043c\u0438\u0433\u0440\u0430\u0446\u0438\u0458\u0435 \u0438 \u043e\u043f\u0448\u0442\u0438\u043d\u0441\u043a\u0435 \u0432\u043b\u0430\u0441\u0442\u0438, \u043f\u043e\u0441\u0435\u0431\u043d\u043e \u0443 \u0432\u0435\u0437\u0438 \u0441\u0430 \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0446\u0438\u0458\u043e\u043c \u0438 \u0441\u043f\u0440\u043e\u0432\u043e\u0452\u0435\u045a\u0435\u043c \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0430 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u043e\u0433 \u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045a\u0430. \u0410\u043d\u0430\u043b\u0438\u0437\u0430 \u0443\u043a\u0430\u0437\u0443\u0458\u0435 \u043d\u0430 \u0438\u0437\u0430\u0437\u043e\u0432\u0435 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u0435 \u0441\u0430 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\u0447\u043d\u043e\u0448\u045b\u0443 \u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045a\u0430, \u043d\u0435\u0434\u043e\u0432\u043e\u0459\u043d\u043e\u043c \u0440\u0430\u0437\u0432\u0438\u0458\u0435\u043d\u043e\u0448\u045b\u0443 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u043e\u0433 \u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045a\u0430, \u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442\u0438\u0440\u0430\u043d\u043e\u0448\u045b\u0443 \u043d\u0430\u0434\u043b\u0435\u0436\u043d\u043e\u0441\u0442\u0438 \u0438 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043e\u043c \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0446\u0438\u0458\u043e\u043c \u0438\u0437\u043c\u0435\u0452\u0443 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0446\u0438\u0458\u0430. \u0411\u0443\u0434\u0443\u045b\u0438 \u0434\u0430 \u0441\u0435 \u0437\u0430\u043c\u0458\u0435\u043d\u0441\u043a\u0438 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0437\u0430\u0441\u043d\u0438\u0432\u0430 \u043d\u0430 \u0443\u043f\u043e\u0440\u0435\u0434\u043d\u043e\u0458 \u0430\u043d\u0430\u043b\u0438\u0437\u0438 \u0441\u0442\u0430\u043c\u0431\u0435\u043d\u0438\u0445 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0430, \u0430 \u043d\u0435 \u043d\u0430 \u0445\u0430\u0440\u043c\u043e\u043d\u0438\u0437\u043e\u0432\u0430\u043d\u0438\u043c \u043f\u043e\u043