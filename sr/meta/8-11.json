a\u043e\u043d\u043e\u043c\u0441\u043a\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0438 \u043e\u0431\u0438\u0447\u043d\u043e \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u043a\u0430\u043e \u0437\u0430\u043c\u0458\u0435\u043d\u0430 \u0437\u0430 \u0440\u0430\u0437\u0432\u043e\u0458 \u043c\u0430\u0442\u0435\u0440\u0438\u0458\u0430\u043b\u043d\u043e\u0433 \u0436\u0438\u0432\u043e\u0442\u043d\u043e\u0433 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0434\u0430 \u0437\u0435\u043c\u0459\u0435. \u041c\u0435\u0452\u0443\u0442\u0438\u043c, \u0442\u043e \u043d\u0438\u0458\u0435 \u043f\u043e\u0442\u043f\u0443\u043d\u0430 \u043c\u0458\u0435\u0440\u0430 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u043e\u0433 \u0431\u043b\u0430\u0433\u043e\u0441\u0442\u0430\u045a\u0430. \u041d\u0430 \u043f\u0440\u0438\u043c\u0435\u0440, \u0411\u0414\u041f \u043d\u0435 \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0435 \u0432\u0435\u045b\u0438\u043d\u0443 \u043d\u0435\u043f\u043b\u0430\u045b\u0435\u043d\u0438\u0445 \u043f\u043e\u0441\u043b\u043e\u0432\u0430 \u0443 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0432\u0443. \u0411\u0414\u041f \u0442\u0430\u043a\u043e\u0452\u0435 \u043d\u0435 \u0443\u0437\u0438\u043c\u0430 \u0443 \u043e\u0431\u0437\u0438\u0440 \u043d\u0435\u0433\u0430\u0442\u0438\u0432\u043d\u0435 \u0435\u0444\u0435\u043a\u0442\u0435 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438, \u043a\u0430\u043e \u0448\u0442\u043e \u0458\u0435 \u0434\u0435\u0433\u0440\u0430\u0434\u0430\u0446\u0438\u0458\u0430 \u0436\u0438\u0432\u043e\u0442\u043d\u0435 \u0441\u0440\u0435\u0434\u0438\u043d\u0435.","target_number":"8.11","goal_number":"8"}