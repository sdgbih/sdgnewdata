u043e\u0434 25 \u0434\u043e 64 \u0433\u043e\u0434\u0438\u043d\u0435 \u043a\u043e\u0458\u0435 \u0458\u0435 \u0443\u0447\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e \u0443 \u0444\u043e\u0440\u043c\u0430\u043b\u043d\u043e\u043c \u0438\u043b\u0438 \u043d\u0435\u0444\u043e\u0440\u043c\u0430\u043b\u043d\u043e\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438 \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0443 \u0442\u043e\u043a\u043e\u043c \u0447\u0435\u0442\u0438\u0440\u0438 \u0441\u0435\u0434\u043c\u0438\u0446\u0435 \u043a\u043e\u0458\u0435 \u0441\u0443 \u043f\u0440\u0435\u0442\u0445\u043e\u0434\u0438\u043b\u0435 \u0430\u043d\u043a\u0435\u0442\u0438\u0440\u0430\u045a\u0443. \u041e\u0431\u0443\u0445\u0432\u0430\u045b\u0435\u043d\u0435 \u0441\u0443 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0443\u0447\u0435\u045a\u0430 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u0435 \u0441 \u043f\u043e\u0441\u043b\u043e\u043c \u0438 \u043e\u043d\u0435 \u043a\u043e\u0458\u0435 \u043d\u0438\u0441\u0443 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u0435 \u0441 \u043f\u043e\u0441\u043b\u043e\u043c. \u0412\u0438\u0448\u0435 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u0443\u043a\u0430\u0437\u0443\u0458\u0443 \u043d\u0430 \u0432\u0435\u045b\u0435 \u0443\u0447\u0435\u0448\u045b\u0435 \u043e\u0434\u0440\u0430\u0441\u043b\u0438\u0445 \u0443 \u0446\u0458\u0435\u043b\u043e\u0436\u0438\u0432\u043e\u0442\u043d\u043e\u043c \u0443\u0447\u0435\u045a\u0443.","national_rationale":"\u041f\u043e\u0434\u0430\u0446\u0438 \u0441\u0435 \u043f\u0440\u0438\u043a\u0443\u043f\u0459\u0430\u0458\u0443 \u043f\u0443\u0442\u0435\u043c \u0410\u043d\u043a\u0435\u0442\u0435 \u043e \u0440\u0430\u0434\u043d\u043e\u0458 \u0441\u043d\u0430\u0437\u0438 \u043a\u043e\u0458\u0443 \u0441\u043f\u0440\u043e\u0432\u043e\u0434\u0438 \u0410\u0433\u0435\u043d\u0446\u0438\u0458\u0430 \u0437\u0430 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435 (BHAS), \u0443 \u0441\u043a\u043b\u0430\u0434\u0443 \u0441 \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0448\u043a\u0438\u043c \u0437\u0430\u0445\u0442\u0458\u0435\u0432\u0438\u043c\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0435 \u0440\u0430\u0434\u043d\u0435 \u0441\u043d\u0430\u0433\u0435. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u0438\u0437\u0440\u0430\u0447\u0443\u043d\u0430\u0432\u0430 \u043a\u0430\u043e \u0443\u0434\u0438\u043e \u043b\u0438\u0446\u0430 \u0443 \u0434\u043e\u0431\u0438 \u043e\u0434 25 \u0434\u043e 64 \u0433\u043e\u0434\u0438\u043d\u0435 \u043a\u043e\u0458\u0430 \u0441\u0443 \u0442\u043e\u043a\u043e\u043c \u0447\u0435\u0442\u0438\u0440\u0438 \u0441\u0435\u0434\u043c\u0438\u0446\u0435 \u043a\u043e\u0458\u0435 \u0441\u0443 \u043f\u0440\u0435\u0442\u0445\u043e\u0434\u0438\u043b\u0435 \u0430\u043d\u043a\u0435\u0442\u0438\u0440\u0430\u045a\u0443 \u0443\u0447\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0430 \u0443 \u0444\u043e\u0440\u043c\u0430\u043b\u043d\u043e\u043c \u0438\u043b\u0438 \u043d\u0435\u0444\u043e\u0440\u043c\u0430\u043b\u043d\u043e\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438 \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0443, \u0443 \u0443\u043a\u0443\u043f\u043d\u043e\u043c \u0431\u0440\u043e\u0458\u0443 \u043b\u0438\u0446\u0430 \u0438\u0441\u0442\u0435 \u0441\u0442\u0430\u0440\u043e\u0441\u043d\u0435 \u0433\u0440\u0443\u043f\u0435 \u043a\u043e\u0458\u0430 \u0441\u0443 \u043e\u0434\u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0430 \u043d\u0430 \u043f\u0438\u0442\u0430\u045a\u0435 \u043e \u0443\u0447\u0435\u0448\u045b\u0443 \u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438 \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0443. \u041f\u043e\u0434\u0430\u0446\u0438 \u0441\u0435 \u043f\u0440\u0438\u043a\u0443\u043f\u0459\u0430\u0458\u0443 \u0438 \u043e\u0431\u0458\u0430\u0432\u0459\u0443\u0458\u0443 \u043d\u0430 \u0433\u043e\u0434\u0438\u0448\u045a\u0435\u043c \u043d\u0438\u0432\u043e\u0443. \u041d\u0430\u043f\u0440\u0435\u0434\u0430\u043a \u0441\u0435 \u043f\u0440\u043e\u0446\u0458\u0435\u045a\u0443\u0458\u0435 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0443 \u043f\u0440\u043e\u043c\u0458\u0435\u043d\u0435 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u0442\u043e\u043a\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0430. \u041f\u043e\u0432\u0435\u045b\u0430\u045a\u0435 \u0443\u0434\u0458\u0435\u043b\u0430 \u043e\u0434\u0440\u0430\u0441\u043b\u0438\u0445 \u043a\u043e\u0458\u0438 \u0443\u0447\u0435\u0441\u0442\u0432\u0443\u0458\u0443 \u0443 \u0444\u043e\u0440\u043c\u0430\u043b\u043d\u043e\u043c \u0438\u043b\u0438 \u043d\u0435\u0444\u043e\u0440\u043c\u0430\u043b\u043d\u043e\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438 \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0443 \u0443\u043a\u0430\u0437\u0443\u0458\u0435 \u043d\u0430 \u043f\u043e\u0437\u0438\u0442\u0438\u0432\u0430\u043d \u043d\u0430\u043f\u0440\u0435\u0434\u0430\u043a \u0443 \u0440\u0430\u0437\u0432\u043e\u0458\u0443 \u0446\u0458\u0435\u043b\u043e\u0436\u0438\u0432\u043e\u0442\u043d\u043e\u0433 \u0443\u0447\u0435\u045a\u0430. \u041f\u0440\u0438\u043a\u0430\u0437\u0430\u043d\u0438 \u043d\u0430\u043f\u0440\u0435\u0434\u0430\u043a \u043e\u0434\u0440\u0430\u0436\u0430\u0432\u0430 \u043a\u0440\u0435\u0442\u0430\u045a\u0435 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u0443 \u043e\u0434\u043d\u043e\u0441\u0443 \u043d\u0430 \u0434\u0443\u0433\u043e\u0440\u043e\u0447\u043d\u0438 \u0440\u0435\u0444\u0435\u0440\u0435\u043d\u0442\u043d\u0438 \u043d\u0438\u0432\u043e \u043e\u0434 28%, \u043a\u043e\u0458\u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430 \u043f\u0440\u043e\u0441\u0458\u0435\u043a \u043d\u0430\u0458\u0431\u043e\u0459\u0438\u0445 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0438\u0445 \u0440\u0435\u0437\u0443\u043b\u0442\u0430\u0442\u0430, \u0430 \u043d\u0435 \u0444\u043e\u0440\u043c\u0430\u043b\u043d\u043e \u0443\u0442\u0432\u0440\u0452\u0435\u043d\u0438 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u0446\u0438\u0459 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435.","national_methodology_characteristics":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u043e \u0443 \u0434\u043e\u0431\u0438 \u043e\u0434 25 \u0434\u043e 64 \u0433\u043e\u0434\u0438\u043d\u0435 \u0438 \u043e\u0434\u043d\u043e\u0441\u0438 \u0441\u0435 \u043d\u0430 \u0443\u0447\u0435\u0448\u045b\u0435 \u0443 \u0444\u043e\u0440\u043c\u0430\u043b\u043d\u043e\u043c \u0438 \u043d\u0435\u0444\u043e\u0440\u043c\u0430\u043b\u043d\u043e\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438 \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0443 \u0442\u043e\u043a\u043e\u043c \u0447\u0435\u0442\u0438\u0440\u0438 \u0441\u0435\u0434\u043c\u0438\u0446\u0435 \u043a\u043e\u0458\u0435 \u0441\u0443 \u043f\u0440\u0435\u0442\u0445\u043e\u0434\u0438\u043b\u0435 \u0430\u043d\u043a\u0435\u0442\u0438\u0440\u0430\u045a\u0443. \u041f\u0440\u0438\u043c\u0458\u0435\u043d\u043e\u043c \u0443\u0441\u043a\u043b\u0430\u0452\u0435\u043d\u0435 \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u0458\u0435 \u0410\u043d\u043a\u0435\u0442\u0435 \u043e \u0440\u0430\u0434\u043d\u043e\u0458 \u0441\u043d\u0430\u0437\u0438 \u043e\u043c\u043e\u0433\u0443\u045b\u0435\u043d\u043e \u0458\u0435 \u043f\u043e\u0440\u0435\u0452\u0435\u045a\u0435 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435 \u0441 \u043f\u043e\u0434\u0430\u0446\u0438\u043c\u0430 \u0434\u0440\u0436\u0430\u0432\u0430 \u0447\u043b\u0430\u043d\u0438\u0446\u0430 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u0443\u043d\u0438\u0458\u0435 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0438\u0445 \u0437\u0435\u043c\u0430\u0459\u0430. \u041f\u0440\u0438 \u0430\u043d\u0430\u043b\u0438\u0437\u0438 \u0432\u0440\u0435\u043c\u0435\u043d\u0441\u043a\u0438\u0445 \u043f\u0440\u043e\u043c\u0458\u0435\u043d\u0430 \u043f\u043e\u0442\u0440\u0435\u0431\u043d\u043e \u0458\u0435 \u0443\u0437\u0435\u0442\u0438 \u0443 \u043e\u0431\u0437\u0438\u0440 \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0448\u043a\u0435 \u043f\u0440\u043e\u043c\u0458\u0435\u043d\u0435 \u0438 \u043f\u0440\u0435\u043a\u0438\u0434 \u0432\u0440\u0435\u043c\u0435\u043d\u0441\u043a\u0435 \u0441\u0435\u0440\u0438\u0458\u0435 \u0443 2021. \u0433\u043e\u0434\u0438\u043d\u0438, \u043f\u043e\u0432\u0435\u0437\u0430\u043d \u0441 \u043f\u0440\u0438\u043c\u0458\u0435\u043d\u043e\u043c \u043d\u043e\u0432\u043e\u0433 \u043e\u043a\u0432\u0438\u0440\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0435 \u0440\u0430\u0434\u043d\u0435 \u0441\u043d\u0430\u0433\u0435.","national_long_objective":"\u041f\u043e\u0432\u0435\u045b\u0430\u045a\u0435 \u0443\u0447\u0435\u0448\u045b\u0430 \u043e\u0434\u0440\u0430\u0441\u043b\u0438\u0445 \u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438 \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0443 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430 \u0432\u0430\u0436\u0430\u043d \u043f\u0440\u0435\u0434\u0443\u0441\u043b\u043e\u0432 \u0437\u0430 \u0440\u0430\u0437\u0432\u043e\u0458 \u0459\u0443\u0434\u0441\u043a\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0430, \u0443\u043d\u0430\u043f\u0440\u0435\u0452\u0435\u045a\u0435 \u0437\u0430\u043f\u043e\u0448\u0459\u0438\u0432\u043e\u0441\u0442\u0438, \u043f\u0440\u0438\u043b\u0430\u0433\u043e\u0452\u0430\u0432\u0430\u045a\u0435 \u043f\u043e\u0442\u0440\u0435\u0431\u0430\u043c\u0430 \u0442\u0440\u0436\u0438\u0448\u0442\u0430 \u0440\u0430\u0434\u0430 \u0438 \u0458\u0430\u0447\u0430\u045a\u0435 \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u0438\u0432\u0440\u0435\u0434\u0435 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435. \u0414\u0443\u0433\u043e\u0440\u043e\u0447\u043d\u043e \u043e\u043f\u0440\u0435\u0434\u0458\u0435\u0459\u0435\u045a\u0435 \u0458\u0435 \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043e \u043f\u043e\u0432\u0435\u045b\u0430\u045a\u0435 \u0443\u0447\u0435\u0448\u045b\u0430 \u043e\u0434\u0440\u0430\u0441\u043b\u0438\u0445 \u0443 \u0446\u0458\u0435\u043b\u043e\u0436\u0438\u0432\u043e\u0442\u043d\u043e\u043c \u0443\u0447\u0435\u045a\u0443 \u043a\u0440\u043e\u0437 \u0440\u0430\u0437\u0432\u043e\u0458 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0458\u0438\u0445 \u0438 \u0444\u043b\u0435\u043a\u0441\u0438\u0431\u0438\u043b\u043d\u0438\u0458\u0438\u0445 \u043c\u043e\u0433\u0443\u045b\u043d\u043e\u0441\u0442\u0438 \u0444\u043e\u0440\u043c\u0430\u043b\u043d\u043e\u0433 \u0438 \u043d\u0435\u0444\u043e\u0440\u043c\u0430\u043b\u043d\u043e\u0433 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0430 \u0438 \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0430, \u043a\u0430\u043e \u0438 \u0443\u043d\u0430\u043f\u0440\u0435\u0452\u0435\u045a\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0430 \u043e\u0434\u0440\u0430\u0441\u043b\u0438\u0445. \u041f\u043e\u0441\u0435\u0431\u043d\u0430 \u043a\u0432\u0430\u043d\u0442\u0438\u0442\u0430\u0442\u0438\u0432\u043d\u0430 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0430 \u0446\u0438\u0459\u043d\u0430 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442 \u0437\u0430 \u043e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043d\u0438\u0458\u0435 \u0443\u0442\u0432\u0440\u0452\u0435\u043d\u0430.","eu_indicator_definition":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043c\u0458\u0435\u0440\u0438 \u0443\u0434\u0438\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u0430 \u0443 \u0434\u043e\u0431\u0438 \u043e\u0434 25 \u0434\u043e 64 \u0433\u043e\u0434\u0438\u043d\u0435 \u043a\u043e\u0458\u0435 \u0458\u0435 \u0443\u0447\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e \u0443 \u0444\u043e\u0440\u043c\u0430\u043b\u043d\u043e\u043c \u0438\u043b\u0438 \u043d\u0435\u0444\u043e\u0440\u043c\u0430\u043b\u043d\u043e\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438 \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0443 \u0442\u043e\u043a\u043e\u043c \u0447\u0435\u0442\u0438\u0440\u0438 \u0441\u0435\u0434\u043c\u0438\u0446\u0435 \u043a\u043e\u0458\u0435 \u0441\u0443 \u043f\u0440\u0435\u0442\u0445\u043e\u0434\u0438\u043b\u0435 \u0430\u043d\u043a\u0435\u0442\u0438\u0440\u0430\u045a\u0443. \u0418\u043c\u0435\u043d\u0438\u043b\u0430\u0446 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430 \u0443\u043a\u0443\u043f\u043d\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u043e \u0438\u0441\u0442\u0435 \u0441\u0442\u0430\u0440\u043e\u0441\u043d\u0435 \u0433\u0440\u0443\u043f\u0435, \u0438\u0441\u043a\u0459\u0443\u0447\u0443\u0458\u0443\u045b\u0438 \u043b\u0438\u0446\u0430 \u043a\u043e\u0458\u0430 \u043d\u0438\u0441\u0443 \u043e\u0434\u0433\u043e\u0432\u043e\u0440\u0438\u043b\u0430 \u043d\u0430 \u043f\u0438\u0442\u0430\u045a\u0435 \u043e \u0443\u0447\u0435\u0448\u045b\u0443 \u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438 \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0443. \u0423\u0447\u0435\u045a\u0435 \u043e\u0434\u0440\u0430\u0441\u043b\u0438\u0445 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0443\u0447\u0435\u045a\u0430 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u0435 \u0441 \u043f\u043e\u0441\u043b\u043e\u043c \u0438 \u043e\u043d\u0435 \u043a\u043e\u0458\u0435 \u043d\u0438\u0441\u0443 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u0435 \u0441 \u043f\u043e\u0441\u043b\u043e\u043c, \u0430 \u043d\u0430\u0458\u0447\u0435\u0448\u045b\u0435 \u0441\u0435 \u043e\u0434\u043d\u043e\u0441\u0438 \u043d\u0430 \u0443\u0447\u0435\u045a\u0435 \u043d\u0430\u043a\u043e\u043d \u0437\u0430\u0432\u0440\u0448\u0435\u0442\u043a\u0430 \u043f\u043e\u0447\u0435\u0442\u043d\u043e\u0433 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0430.","eu_rationale":"\u041f\u043e\u0434\u0430\u0446\u0438 \u043f\u043e\u0442\u0438\u0447\u0443 \u0438\u0437 \u0410\u043d\u043a\u0435\u0442\u0435 \u043e \u0440\u0430\u0434\u043d\u043e\u0458 \u0441\u043d\u0430\u0437\u0438 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u0443\u043d\u0438\u0458\u0435 (EU-LFS), \u043a\u043e\u0458\u0430 \u0441\u0435 \u0441\u043f\u0440\u043e\u0432\u043e\u0434\u0438 \u0443 \u043e\u043a\u0432\u0438\u0440\u0443 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u043e\u0433 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u043a\u043e\u0433 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 (ESS). \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u0438\u0437\u0440\u0430\u0447\u0443\u043d\u0430\u0432\u0430 \u043a\u0430\u043e \u0443\u0434\u0438\u043e \u043b\u0438\u0446\u0430 \u0443 \u0434\u043e\u0431\u0438 \u043e\u0434 25 \u0434\u043e 64 \u0433\u043e\u0434\u0438\u043d\u0435 \u043a\u043e\u0458\u0430 \u0441\u0443 \u043d\u0430\u0432\u0435\u043b\u0430 \u0434\u0430 \u0441\u0443 \u0443\u0447\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0430 \u0443 \u0444\u043e\u0440\u043c\u0430\u043b\u043d\u043e\u043c \u0438\u043b\u0438 \u043d\u0435\u0444\u043e\u0440\u043c\u0430\u043b\u043d\u043e\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438 \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0443 \u0442\u043e\u043a\u043e\u043c \u0447\u0435\u0442\u0438\u0440\u0438 \u0441\u0435\u0434\u043c\u0438\u0446\u0435 \u043a\u043e\u0458\u0435 \u0441\u0443 \u043f\u0440\u0435\u0442\u0445\u043e\u0434\u0438\u043b\u0435 \u0430\u043d\u043a\u0435\u0442\u0438\u0440\u0430\u045a\u0443. \u041f\u043e\u0434\u0430\u0446\u0438 \u0441\u0435 \u043e\u0431\u0458\u0430\u0432\u0459\u0443\u0458\u0443 \u043d\u0430 \u0433\u043e\u0434\u0438\u0448\u045a\u0435\u043c \u043d\u0438\u0432\u043e\u0443.","eu_methodology_characteristics":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430 \u043b\u0438\u0446\u0430 \u0443 \u0434\u043e\u0431\u0438 \u043e\u0434 25 \u0434\u043e 64 \u0433\u043e\u0434\u0438\u043d\u0435 \u043a\u043e\u0458\u0430 \u0441\u0443 \u0443\u0447\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0430 \u0443 \u0444\u043e\u0440\u043c\u0430\u043b\u043d\u043e\u043c \u0438\u043b\u0438 \u043d\u0435\u0444\u043e\u0440\u043c\u0430\u043b\u043d\u043e\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438 \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0443, \u0431\u0435\u0437 \u043e\u0431\u0437\u0438\u0440\u0430 \u043d\u0430 \u0442\u043e \u0434\u0430 \u043b\u0438 \u0441\u0443 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u0435 \u0441 \u043f\u043e\u0441\u043b\u043e\u043c. \u041f\u043e\u0434\u0430\u0446\u0438 \u043e\u043c\u043e\u0433\u0443\u045b\u0430\u0432\u0430\u0458\u0443 \u043f\u043e\u0440\u0435\u0452\u0435\u045a\u0435 \u0438\u0437\u043c\u0435\u0452\u0443 \u0434\u0440\u0436\u0430\u0432\u0430 \u0447\u043b\u0430\u043d\u0438\u0446\u0430 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u0443\u043d\u0438\u0458\u0435 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0438\u0445 \u0437\u0435\u043c\u0430\u0459\u0430. \u041f\u0440\u0438 \u0430\u043d\u0430\u043b\u0438\u0437\u0438 \u0432\u0440\u0435\u043c\u0435\u043d\u0441\u043a\u0438\u0445 \u0441\u0435\u0440\u0438\u0458\u0430 \u043f\u043e\u0442\u0440\u0435\u0431\u043d\u043e \u0458\u0435 \u0443\u0437\u0435\u0442\u0438 \u0443 \u043e\u0431\u0437\u0438\u0440 \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0448\u043a\u0435 \u043f\u0440\u043e\u043c\u0458\u0435\u043d\u0435 \u0443 \u0410\u043d\u043a\u0435\u0442\u0438 \u043e \u0440\u0430\u0434\u043d\u043e\u0458 \u0441\u043d\u0430\u0437\u0438, \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443\u045b\u0438 \u043f\u0440\u0435\u043a\u0438\u0434 \u0432\u0440\u0435\u043c\u0435\u043d\u0441\u043a\u0435 \u0441\u0435\u0440\u0438\u0458\u0435 \u0443 2021. \u0433\u043e\u0434\u0438\u043d\u0438 \u0437\u0431\u043e\u0433 \u043f\u0440\u0438\u043c\u0458\u0435\u043d\u0435 \u043d\u043e\u0432\u043e\u0433 \u0440\u0435\u0433\u0443\u043b\u0430\u0442\u043e\u0440\u043d\u043e\u0433 \u043e\u043a\u0432\u0438\u0440\u0430 \u0437\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0443 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u0443 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443.","eu_long_objective":"\u0423\u0447\u0435\u0448\u045b\u0435 \u043e\u0434\u0440\u0430\u0441\u043b\u0438\u0445 \u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438 \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0443 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430 \u0432\u0430\u0436\u0430\u043d \u0435\u043b\u0435\u043c\u0435\u043d\u0442 \u0446\u0458\u0435\u043b\u043e\u0436\u0438\u0432\u043e\u0442\u043d\u043e\u0433 \u0443\u0447\u0435\u045a\u0430 \u0438 \u0440\u0430\u0437\u0432\u043e\u0458