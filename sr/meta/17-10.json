u0438\u0434\u0435\u043d\u0442\u0438\u0440\u0430\u0458\u0443 \u0441\u0442\u0432\u0430\u0440\u043d\u0438 \u043c\u0435\u0452\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0438 \u0442\u0440\u0430\u043d\u0441\u0444\u0435\u0440 \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0458\u0441\u043a\u0438\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0430 \u0438\u043b\u0438 \u0440\u043e\u0431\u0435 \u0438\u043b\u0438 \u0443\u0441\u043b\u0443\u0433\u0430 \u0432\u0440\u0435\u0434\u043d\u043e\u0432\u0430\u043d\u0438\u0445 \u043f\u043e \u0442\u0440\u043e\u0448\u043a\u0443 \u0434\u043e\u043d\u0430\u0442\u043e\u0440\u0430. \u041e\u0414\u0410 \u0458\u0435 \u043e\u0432\u0434\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0435\u043d\u0430 \u043a\u0430\u043e \u0443\u0434\u0435\u043e \u0443 \u0431\u0440\u0443\u0442\u043e \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u043c \u0434\u043e\u0445\u043e\u0442\u043a\u0443 (\u0411\u041d\u0414). \u0411\u041d\u0414 \u043f\u043e \u0442\u0440\u0436\u0438\u0448\u043d\u0438\u043c \u0446\u0435\u043d\u0430\u043c\u0430 \u0458\u0435\u0434\u043d\u0430\u043a \u0458\u0435 \u0431\u0440\u0443\u0442\u043e \u0434\u043e\u043c\u0430\u045b\u0435\u043c \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0443 (\u0411\u0414\u041f) \u0443\u043c\u0430\u045a\u0435\u043d\u043e\u043c \u0437\u0430 \u043f\u0440\u0438\u043c\u0430\u0440\u043d\u0438 \u0434\u043e\u0445\u043e\u0434\u0430\u043a \u043a\u043e\u0458\u0438 \u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043d\u0435 \u0458\u0435\u0434\u0438\u043d\u0438\u0446\u0435 \u043f\u043b\u0430\u045b\u0430\u0458\u0443 \u043d\u0435\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043d\u0438\u043c \u0458\u0435\u0434\u0438\u043d\u0438\u0446\u0430\u043c\u0430, \u043f\u043b\u0443\u0441 \u043f\u0440\u0438\u043c\u0430\u0440\u043d\u0438 \u0434\u043e\u0445\u043e\u0434\u0430\u043a \u043a\u043e\u0458\u0438 \u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442\u043d\u0435 \u0458\u0435\u0434\u0438\u043d\u0438\u0446\u0435 \u043f\u0440\u0438\u043c\u0430\u0458\u0443 \u043e\u0434 \u043e\u0441\u0442\u0430\u0442\u043a\u0430 \u0441\u0432\u0435\u0442\u0430. \u0421\u043f\u0438\u0441\u0430\u043a \u0437\u0435\u043c\u0430\u0459\u0430 \u0438 \u0442\u0435\u0440\u0438\u0442\u043e\u0440\u0438\u0458\u0430 \u043a\u043e\u0458\u0435 \u0438\u0441\u043f\u0443\u045a\u0430\u0432\u0430\u0458\u0443 \u0443\u0441\u043b\u043e\u0432\u0435 \u0437\u0430 \u041e\u0414\u0410 \u0443\u0442\u0432\u0440\u0452\u0443\u0458\u0435 \u041a\u043e\u043c\u0438\u0442\u0435\u0442 \u0437\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0443 \u043f\u043e\u043c\u043e\u045b \u041e\u0415\u0426\u0414-\u0430.","national_rationale":"\u041d\u0435\u0442\u043e \u043f\u0440\u0438\u043c\u0459\u0435\u043d\u0430 \u0441\u043b\u0443\u0436\u0431\u0435\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b (% \u0411\u041d\u0414-\u0430) \u0443 \u0411\u043e\u0441\u043d\u0438 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0438 \u0438\u0437\u043d\u043e\u0441\u0438\u043b\u0430 \u0458\u0435 1,1206% \u0443 2023. \u0433\u043e\u0434\u0438\u043d\u0438, \u043f\u0440\u0435\u043c\u0430 \u0437\u0431\u0438\u0440\u0446\u0438 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 \u0421\u0432\u0458\u0435\u0442\u0441\u043a\u0435 \u0431\u0430\u043d\u043a\u0435, \u043f\u0440\u0438\u043a\u0443\u043f\u0459\u0435\u043d\u0438\u0445 \u0438\u0437 \u0441\u043b\u0443\u0436\u0431\u0435\u043d\u043e \u043f\u0440\u0438\u0437\u043d\u0430\u0442\u0438\u0445 \u0438\u0437\u0432\u043e\u0440\u0430. \u0418\u0437\u0432\u0458\u0435\u0448\u0442\u0430\u0458 \u043e\u0431\u0458\u0435\u0434\u0438\u045a\u0443\u0458\u0435 \u043f\u0435\u0442 \u0441\u0442\u0443\u0431\u043e\u0432\u0430 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u043a\u0435 \u0443\u0441\u043f\u0458\u0435\u0448\u043d\u043e\u0441\u0442\u0438: \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u045a\u0435 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430, \u043f\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u043d\u0435 \u0443\u0441\u043b\u0443\u0433\u0435, \u043f\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u043d\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0435, \u0438\u0437\u0432\u043e\u0440\u0435 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u0438 \u043f\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u043d\u0443 \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443.","national_methodology_characteristics":"\u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0438 \u043a\u043e\u043d\u0441\u0435\u043d\u0437\u0443\u0441 \u043e \u0440\u0430\u0437\u0432\u043e\u0458\u0443 \u0438\u0437 \u0458\u0443\u043d\u0430 2017. \u0433\u043e\u0434\u0438\u043d\u0435 \u0438\u0441\u0442\u0438\u0447\u0435 \u043f\u043e\u0442\u0440\u0435\u0431\u0443 \u0434\u0430 \u0441\u0435 \u0432\u0438\u0441\u043e\u043a \u0443\u0434\u0435\u043e \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0435 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0435 \u043f\u043e\u043c\u043e\u045b\u0438 \u0434\u043e\u0434\u0435\u043b\u0438 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 \u0440\u0430\u0437\u0432\u0438\u0458\u0435\u043d\u0438\u043c \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u0438 \u0434\u0440\u0443\u0433\u0438\u043c \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u0441\u0430 \u043d\u0438\u0441\u043a\u0438\u043c \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u043c\u0430. \u0421\u0442\u043e\u0433\u0430 \u0431\u0438 0,15-0,20% \u0411\u041d\u0414-\u0430 \u0442\u0440\u0435\u0431\u0430\u043b\u043e \u0434\u043e\u0434\u0435\u043b\u0438\u0442\u0438 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 \u0440\u0430\u0437\u0432\u0438\u0458\u0435\u043d\u0438\u043c \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u0443 \u043a\u0440\u0430\u0442\u043a\u043e\u043c \u0440\u043e\u043a\u0443, \u0430 \u043e\u0432\u0430\u0458 \u0438\u0437\u043d\u043e\u0441 \u0431\u0438 \u0441\u0435 \u043f\u043e\u0432\u0435\u045b\u0430\u043e \u043d\u0430 0,20% \u0434\u043e 2030. \u0433\u043e\u0434\u0438\u043d\u0435. \u041a\u043e\u043d\u0441\u0435\u043d\u0437\u0443\u0441 \u0437\u0430\u0443\u0437\u0438\u043c\u0430 \u0441\u0432\u0435\u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430\u043d \u043f\u0440\u0438\u0441\u0442\u0443\u043f \u0438\u043c\u043f\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u0458\u0438, \u043a\u043e\u043c\u0431\u0438\u043d\u0443\u0458\u0443\u045b\u0438 \u043f\u043e\u043c\u043e\u045b \u0441\u0430 \u0434\u0440\u0443\u0433\u0438\u043c \u0440\u0435\u0441\u0443\u0440\u0441\u0438\u043c\u0430, \u0441\u0430 \u0434\u043e\u0431\u0440\u0438\u043c \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0430\u043c\u0430 \u0438 \u043e\u0458\u0430\u0447\u0430\u043d\u0438\u043c \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u043e\u043c \u043a\u043e\u0445\u0435\u0440\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u0438 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0430 \u0437\u0430 \u0440\u0430\u0437\u0432\u043e\u0458.","national_long_objective":"\u0414\u0443\u0433\u043e\u0440\u043e\u0447\u043d\u0438 \u0446\u0438\u0459 \u0437\u0430 \u043e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0458\u0435 0,7% \u0431\u0440\u0443\u0442\u043e \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u0433 \u0434\u043e\u0445\u043e\u0442\u043a\u0430 (\u0411\u041d\u0414).","eu_indicator_definition":"","eu_rationale":"","eu_methodology_characteristics":"","eu_long_objective":"","target_number":"17.10","goal_number":"17","graph_title":"\u0421\u043b\u0443\u0436\u0431\u0435\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b \u043a\u0430\u043e \u0443\u0434\u0438\u043e \u0443 \u0431\u0440\u0443\u0442\u043e \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u043c \u0434\u043e\u0445\u043e\u0442\u043a\u0443"}