{"indicator_number":17.1,"reporting_status":"complete","published":true,"sdg_goal":"17","data_non_statistical":false,"graph_type":"line","indicator_sort_order":"17-10","indicator_name":"\u0421\u043b\u0443\u0436\u0431\u0435\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b \u043a\u0430\u043e \u0443\u0434\u0438\u043e \u0443 \u0431\u0440\u0443\u0442\u043e \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u043c \u0434\u043e\u0445\u043e\u0442\u043a\u0443","source_active_1":true,"source_organisation_1":"World Bank","source_url_1":"https://data.worldbank.org/indicator/DT.ODA.ODAT.GN.ZS?locations=BA","footer_fields":[{"label":"\u0420\u0435\u0444\u0435\u0440\u0435\u043d\u0442\u043d\u0438 \u043c\u0435\u0442\u0430\u043f\u043e\u0434\u0430\u0446\u0438","value":"<a href=\"https://databank.worldbank.org/metadataglossary/world-development-indicators/series/DT.ODA.ODAT.GN.ZS\" target=\"_blank\">World Bank Metadata \u2013 Net ODA received (% of GNI)</a>"}],"graph_titles":[{"series":"\u041d\u0435\u0442\u043e \u043f\u0440\u0438\u043c\u0459\u0435\u043d\u0430 ODA (% \u0411\u041d\u0414-\u0430)","title":"\u041d\u0435\u0442\u043e \u043f\u0440\u0438\u043c\u0459\u0435\u043d\u0430 ODA (% \u0411\u041d\u0414-\u0430)"}],"national_indicator_definition":"\u0417\u0432\u0430\u043d\u0438\u0447\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b (ODA) \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0443 \u043f\u043e\u043c\u043e\u045b \u043a\u043e\u0458\u0443 \u043f\u0440\u0443\u0436\u0430 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0438 \u0441\u0435\u043a\u0442\u043e\u0440 \u0437\u0435\u043c\u0430\u0459\u0430 \u0434\u043e\u043d\u0430\u0442\u043e\u0440\u0430 \u0440\u0430\u0434\u0438 \u0443\u043d\u0430\u043f\u0440\u0435\u0452\u0435\u045a\u0430 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 \u0438 \u0431\u043b\u0430\u0433\u043e\u0441\u0442\u0430\u045a\u0430 \u0443 \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u0443 \u0440\u0430\u0437\u0432\u043e\u0458\u0443. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043f\u0440\u0438\u043a\u0430\u0437\u0443\u0458\u0435 \u043d\u0435\u0442\u043e \u043f\u0440\u0438\u043c\u0459\u0435\u043d\u0443 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0443 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0443 \u043f\u043e\u043c\u043e\u045b \u043a\u0430\u043e \u0443\u0434\u0438\u043e \u0431\u0440\u0443\u0442\u043e \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u0433 \u0434\u043e\u0445\u043e\u0442\u043a\u0430 (\u0411\u041d\u0414) \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435. \u041d\u0435\u0442\u043e \u043f\u0440\u0438\u043c\u0459\u0435\u043d\u0430 \u043f\u043e\u043c\u043e\u045b \u0438\u0437\u0440\u0430\u0447\u0443\u043d\u0430\u0432\u0430 \u0441\u0435 \u043d\u0430\u043a\u043e\u043d \u0443\u0437\u0438\u043c\u0430\u045a\u0430 \u0443 \u043e\u0431\u0437\u0438\u0440 \u043e\u0434\u0433\u043e\u0432\u0430\u0440\u0430\u0458\u0443\u045b\u0438\u0445 \u043e\u0442\u043f\u043b\u0430\u0442\u0430, \u0430 \u0443\u0434\u0438\u043e \u0441\u0435 \u0438\u0441\u043a\u0430\u0437\u0443\u0458\u0435 \u0443 \u043e\u0434\u043d\u043e\u0441\u0443 \u043d\u0430 \u0431\u0440\u0443\u0442\u043e \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u0434\u043e\u0445\u043e\u0434\u0430\u043a. \u0421\u043f\u0438\u0441\u0430\u043a \u0437\u0435\u043c\u0430\u0459\u0430 \u0438 \u0442\u0435\u0440\u0438\u0442\u043e\u0440\u0438\u0458\u0430 \u043a\u043e\u0458\u0435 \u0438\u0441\u043f\u0443\u045a\u0430\u0432\u0430\u0458\u0443 \u0443\u0441\u043b\u043e\u0432\u0435 \u0437\u0430 \u043f\u0440\u0438\u043c\u0430\u045a\u0435 ODA \u0443\u0442\u0432\u0440\u0452\u0443\u0458\u0435 \u041e\u0434\u0431\u043e\u0440 \u0437\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0443 \u043f\u043e\u043c\u043e\u045b OECD-\u0430 (OECD/DAC).","national_rationale":"\u0411\u043e\u0441\u043d\u0430 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0430 \u0443 \u043e\u0432\u043e\u043c \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u043c \u043f\u0440\u0438\u043a\u0430\u0437\u0443 \u0438\u043c\u0430 \u0443\u043b\u043e\u0433\u0443 \u0437\u0435\u043c\u0459\u0435 \u043a\u043e\u0440\u0438\u0441\u043d\u0438\u0446\u0435 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0435 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0435 \u043f\u043e\u043c\u043e\u045b\u0438, \u0430 \u043d\u0435 \u0434\u043e\u043d\u0430\u0442\u043e\u0440\u0430. \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043f\u0440\u0438\u043a\u0430\u0437\u0443\u0458\u0435 \u043d\u0435\u0442\u043e \u043f\u0440\u0438\u043c\u0459\u0435\u043d\u0443 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0443 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0443 \u043f\u043e\u043c\u043e\u045b (ODA) \u043a\u0430\u043e \u043f\u0440\u043e\u0446\u0435\u043d\u0430\u0442 \u0431\u0440\u0443\u0442\u043e \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u0433 \u0434\u043e\u0445\u043e\u0442\u043a\u0430 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435. \u041d\u0430\u0441\u0443\u043f\u0440\u043e\u0442 \u0442\u043e\u043c\u0435, \u0415\u0423 SDG \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 17.10 \u043f\u0440\u0438\u043a\u0430\u0437\u0443\u0458\u0435 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0443 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0443 \u043f\u043e\u043c\u043e\u045b \u043a\u043e\u0458\u0443 \u043f\u0440\u0443\u0436\u0430\u0458\u0443 \u0434\u0440\u0436\u0430\u0432\u0435 \u0447\u043b\u0430\u043d\u0438\u0446\u0435 \u0415\u0423, \u043a\u0430\u043e \u0438 \u0418\u0441\u043b\u0430\u043d\u0434, \u041d\u043e\u0440\u0432\u0435\u0448\u043a\u0430 \u0438 \u0428\u0432\u0430\u0458\u0446\u0430\u0440\u0441\u043a\u0430, \u0443 \u043e\u0434\u043d\u043e\u0441\u0443 \u043d\u0430 \u045a\u0438\u0445\u043e\u0432 \u0431\u0440\u0443\u0442\u043e \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u0434\u043e\u0445\u043e\u0434\u0430\u043a. \u0417\u0431\u043e\u0433 \u0440\u0430\u0437\u043b\u0438\u0447\u0438\u0442\u043e\u0433 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430, \u043e\u0432\u0435 \u0434\u0432\u0438\u0458\u0435 \u0441\u0435\u0440\u0438\u0458\u0435 \u043d\u0438\u0441\u0443 \u043d\u0435\u043f\u043e\u0441\u0440\u0435\u0434\u043d\u043e \u0443\u043f\u043e\u0440\u0435\u0434\u0438\u0432\u0435.","national_methodology_characteristics":"\u0412\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u0437\u0430 \u0411\u043e\u0441\u043d\u0443 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0443 \u0441\u043c\u0430\u045a\u0435\u043d\u0430 \u0458\u0435 \u0441\u0430 2,6% \u0443 2016. \u043d\u0430 1,1% \u0443 2023. \u0433\u043e\u0434\u0438\u043d\u0438, \u0443\u0437 \u043f\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u0430 \u043f\u043e\u0432\u0435\u045b\u0430\u045a\u0430 \u0442\u043e\u043a\u043e\u043c \u043f\u043e\u0441\u043c\u0430\u0442\u0440\u0430\u043d\u043e\u0433 \u043f\u0435\u0440\u0438\u043e\u0434\u0430. \u041f\u043e\u0434\u0430\u0446\u0438 \u0441\u0435 \u043e\u0431\u0458\u0430\u0432\u0459\u0443\u0458\u0443 \u0433\u043e\u0434\u0438\u0448\u045a\u0435, \u0430 \u0438\u0437\u0432\u043e\u0440 \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u043d\u0435 \u0441\u0435\u0440\u0438\u0458\u0435 \u0458\u0435 \u0421\u0432\u0458\u0435\u0442\u0441\u043a\u0430 \u0431\u0430\u043d\u043a\u0430, \u0443 \u043e\u043a\u0432\u0438\u0440\u0443 \u0431\u0430\u0437\u0435 \u0421\u0432\u0458\u0435\u0442\u0441\u043a\u0438\u0445 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0438\u0445 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 (World Development Indicators). \u041c\u0435\u0452\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0438 \u043f\u043e\u0434\u0430\u0446\u0438 \u043e \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u043e\u0458 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u043e\u0458 \u043f\u043e\u043c\u043e\u045b\u0438 \u0437\u0430\u0441\u043d\u0438\u0432\u0430\u0458\u0443 \u0441\u0435 \u043d\u0430 \u0435\u0432\u0438\u0434\u0435\u043d\u0446\u0438\u0458\u0430\u043c\u0430 OECD/DAC-\u0430. \u0411\u0443\u0434\u0443\u045b\u0438 \u0434\u0430 \u0437\u0430 \u043e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043d\u0438\u0458\u0435 \u0443\u0442\u0432\u0440\u0452\u0435\u043d\u0430 \u043f\u043e\u0441\u0435\u0431\u043d\u0430 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0430 \u0446\u0438\u0459\u043d\u0430 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442, \u043f\u0440\u043e\u043c\u0458\u0435\u043d\u0435 \u0441\u0435 \u043f\u0440\u0438\u043a\u0430\u0437\u0443\u0458\u0443 \u043e\u043f\u0438\u0441\u043d\u043e, \u0431\u0435\u0437 \u0434\u043e\u0434\u0458\u0435\u0459\u0438\u0432\u0430\u045a\u0430 \u0441\u0442\u0430\u0442\u0443\u0441\u0430 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430.","national_long_objective":"\u0417\u0430 \u0411\u043e\u0441\u043d\u0443 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0443 \u043d\u0438\u0458\u0435 \u0443\u0442\u0432\u0440\u0452\u0435\u043d\u0430 \u043f\u043e\u0441\u0435\u0431\u043d\u0430 \u043d\u0443\u043c\u0435\u0440\u0438\u0447\u043a\u0430 \u0446\u0438\u0459\u043d\u0430 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442 \u0437\u0430 \u043e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440. \u0426\u0438\u0459 \u0438\u0437\u0434\u0432\u0430\u0458\u0430\u045a\u0430 0,7% \u0431\u0440\u0443\u0442\u043e \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u0433 \u0434\u043e\u0445\u043e\u0442\u043a\u0430 \u0437\u0430 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0443 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0443 \u043f\u043e\u043c\u043e\u045b \u043e\u0434\u043d\u043e\u0441\u0438 \u0441\u0435 \u043d\u0430 \u0437\u0435\u043c\u0459\u0435 \u0434\u043e\u043d\u0430\u0442\u043e\u0440\u0435, \u0430 \u043d\u0435 \u043d\u0430 \u0437\u0435\u043c\u0459\u0435 \u043a\u043e\u0458\u0435 \u043f\u043e\u043c\u043e\u045b \u043f\u0440\u0438\u043c\u0430\u0458\u0443.","eu_indicator_definition":"\u0417\u0432\u0430\u043d\u0438\u0447\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b (ODA) \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430 \u0431\u0435\u0441\u043f\u043e\u0432\u0440\u0430\u0442\u043d\u0430 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430, \u0437\u0430\u0458\u043c\u043e\u0432\u0435 \u0438 \u0432\u043b\u0430\u0441\u043d\u0438\u0447\u043a\u0430 \u0443\u043b\u0430\u0433\u0430\u045a\u0430 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u043e\u0433 \u0441\u0435\u043a\u0442\u043e\u0440\u0430 \u043d\u0430\u043c\u0438\u0458\u0435\u045a\u0435\u043d\u0430 \u0443\u043d\u0430\u043f\u0440\u0435\u0452\u0435\u045a\u0443 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 \u0438 \u0431\u043b\u0430\u0433\u043e\u0441\u0442\u0430\u045a\u0430 \u0443 \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u0443 \u0440\u0430\u0437\u0432\u043e\u0458\u0443. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043f\u0440\u0438\u043a\u0430\u0437\u0443\u0458\u0435 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0443 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0443 \u043f\u043e\u043c\u043e\u045b \u043a\u0430\u043e \u043f\u0440\u043e\u0446\u0435\u043d\u0430\u0442 \u0431\u0440\u0443\u0442\u043e \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u0433 \u0434\u043e\u0445\u043e\u0442\u043a\u0430 (\u0411\u041d\u0414). \u041e\u0431\u0443\u0445\u0432\u0430\u0442\u0430 \u043f\u043e\u043c\u043e\u045b \u043a\u043e\u0458\u0443 \u043f\u0440\u0443\u0436\u0430\u0458\u0443 \u0434\u0440\u0436\u0430\u0432\u0435 \u0447\u043b\u0430\u043d\u0438\u0446\u0435 \u0415\u0423 \u0438 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0446\u0438\u0458\u0435 \u0415\u0423. \u041f\u043e\u0434\u0430\u0446\u0438 \u0441\u0435 \u0437\u0430\u0441\u043d\u0438\u0432\u0430\u0458\u0443 \u043d\u0430 \u0435\u0432\u0438\u0434\u0435\u043d\u0446\u0438\u0458\u0430\u043c\u0430 \u041e\u0434\u0431\u043e\u0440\u0430 \u0437\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0443 \u043f\u043e\u043c\u043e\u045b OECD-\u0430 (OECD/DAC) \u0438 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435.","eu_rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043f\u0440\u0430\u0442\u0438 \u0434\u043e\u043f\u0440\u0438\u043d\u043e\u0441 \u0415\u0423 \u0438 \u045a\u0435\u043d\u0438\u0445 \u0434\u0440\u0436\u0430\u0432\u0430 \u0447\u043b\u0430\u043d\u0438\u0446\u0430 \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u0430\u045a\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 \u0443 \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u0443 \u0440\u0430\u0437\u0432\u043e\u0458\u0443, \u0443 \u043e\u043a\u0432\u0438\u0440\u0443 \u0426\u0438\u0459\u0430 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 17 \u2013 \u041f\u0430\u0440\u0442\u043d\u0435\u0440\u0441\u0442\u0432\u043e\u043c \u0434\u043e \u0446\u0438\u0459\u0435\u0432\u0430. \u0414\u0443\u0433\u043e\u0440\u043e\u0447\u043d\u0430 \u043c\u0435\u0452\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0430 \u043e\u0431\u0430\u0432\u0435\u0437\u0430 \u0458\u0435 \u0438\u0437\u0434\u0432\u0430\u0458\u0430\u045a\u0435 0,7% \u0431\u0440\u0443\u0442\u043e \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u0433 \u0434\u043e\u0445\u043e\u0442\u043a\u0430 \u0437\u0430 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0443 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0443 \u043f\u043e\u043c\u043e\u045b. \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0438 \u043a\u043e\u043d\u0441\u0435\u043d\u0437\u0443\u0441 \u043e \u0440\u0430\u0437\u0432\u043e\u0458\u0443 \u0438\u0437 2017. \u0433\u043e\u0434\u0438\u043d\u0435 \u043d\u0430\u0433\u043b\u0430\u0448\u0430\u0432\u0430 \u0438 \u043f\u043e\u0442\u0440\u0435\u0431\u0443 \u0443\u0441\u043c\u0458\u0435\u0440\u0430\u0432\u0430\u045a\u0430 \u0437\u043d\u0430\u0447\u0430\u0458\u043d\u043e\u0433 \u0434\u0438\u0458\u0435\u043b\u0430 \u043f\u043e\u043c\u043e\u045b\u0438 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 \u0440\u0430\u0437\u0432\u0438\u0458\u0435\u043d\u0438\u043c \u0437\u0435\u043c\u0459\u0430\u043c\u0430, \u0443\u0437 \u043a\u0440\u0430\u0442\u043a\u043e\u0440\u043e\u0447\u043d\u0438 \u0440\u0430\u0441\u043f\u043e\u043d \u043e\u0434 0,15\u20130,20% \u0411\u041d\u0414-\u0430 \u0438 \u0446\u0438\u0459 \u043e\u0434 0,20% \u0434\u043e 2030. \u0433\u043e\u0434\u0438\u043d\u0435.","eu_methodology_characteristics":"\u041f\u043e\u0434\u0430\u0446\u0438 \u0441\u0435 \u0438\u0441\u043a\u0430\u0437\u0443\u0458\u0443 \u0433\u043e\u0434\u0438\u0448\u045a\u0435 \u043a\u0430\u043e \u043f\u0440\u043e\u0446\u0435\u043d\u0430\u0442 \u0431\u0440\u0443\u0442\u043e \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u0433 \u0434\u043e\u0445\u043e\u0442\u043a\u0430. \u041e\u0431\u0443\u0445\u0432\u0430\u0442 \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0435 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0443 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0443 \u043f\u043e\u043c\u043e\u045b \u0434\u0440\u0436\u0430\u0432\u0430 \u0447\u043b\u0430\u043d\u0438\u0446\u0430 \u0415\u0423 \u0438 \u043e\u0434\u0433\u043e\u0432\u0430\u0440\u0430\u0458\u0443\u045b\u0438 \u0434\u043e\u043f\u0440\u0438\u043d\u043e\u0441 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0446\u0438\u0458\u0430 \u0415\u0423. \u041f\u043e\u0434\u0430\u0446\u0438 \u0441\u0435 \u0437\u0430\u0441\u043d\u0438\u0432\u0430\u0458\u0443 \u043d\u0430 \u043c\u0435\u0452\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0438\u043c \u0435\u0432\u0438\u0434\u0435\u043d\u0446\u0438\u0458\u0430\u043c\u0430 OECD/DAC-\u0430, \u0443\u0437 \u0443\u0447\u0435\u0448\u045b\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u0430\u0436\u0443\u0440\u0438\u0440\u0430 \u0433\u043e\u0434\u0438\u0448\u045a\u0435. \u041f\u0440\u0438 \u043f\u043e\u0440\u0435\u0452\u0435\u045a\u0443 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u0442\u043e\u043a\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0430 \u0442\u0440\u0435\u0431\u0430 \u0443\u0437\u0435\u0442\u0438 \u0443 \u043e\u0431\u0437\u0438\u0440 \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0448\u043a\u0443 \u043f\u0440\u043e\u043c\u0458\u0435\u043d\u0443 \u0438\u0437 2018. \u0433\u043e\u0434\u0438\u043d\u0435, \u043a\u0430\u0434\u0430 \u0458\u0435 \u0437\u0430 \u043a\u043e\u043d\u0446\u0435\u0441\u0438\u043e\u043d\u0430\u043b\u043d\u0435 \u0437\u0430\u0458\u043c\u043e\u0432\u0435 \u0443\u0432\u0435\u0434\u0435\u043d \u043e\u0431\u0440\u0430\u0447\u0443\u043d \u0435\u043a\u0432\u0438\u0432\u0430\u043b\u0435\u043d\u0442\u043e\u043c \u0431\u0435\u0441\u043f\u043e\u0432\u0440\u0430\u0442\u043d\u0438\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0430\u0432a.","eu_long_objective":"\u0414\u0443\u0433\u043e\u0440\u043e\u0447\u043d\u0438 \u0446\u0438\u0459 \u0458\u0435 \u0438\u0437\u0434\u0432\u0430\u0458\u0430\u045a\u0435 0,7% \u0431\u0440\u0443\u0442\u043e \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u0433 \u0434\u043e\u0445\u043e\u0442\u043a\u0430 \u0437\u0430 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0443 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0443 \u043f\u043e\u043c\u043e\u045b. \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0438 \u043a\u043e\u043d\u0441\u0435\u043d\u0437\u0443\u0441 \u043e \u0440\u0430\u0437\u0432\u043e\u0458\u0443 \u0434\u043e\u0434\u0430\u0442\u043d\u043e \u043d\u0430\u0433\u043b\u0430\u0448\u0430\u0432\u0430 \u0438\u0437\u0434\u0432\u0430\u0458\u0430\u045a\u0435 0,15\u20130,20% \u0411\u041d\u0414-\u0430 \u0437\u0430 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 \u0440\u0430\u0437\u0432\u0438\u0458\u0435\u043d\u0435 \u0437\u0435\u043c\u0459\u0435 \u0443 \u043a\u0440\u0430\u0442\u043a\u043e\u043c \u0440\u043e\u043a\u0443, \u0443\u0437 \u0446\u0438\u0459 \u043e\u0434 0,20% \u0434\u043e 2030. \u0433\u043e\u0434\u0438\u043d\u0435.","target_number":"17.10","goal_number":"17","graph_title":"\u0421\u043b\u0443\u0436\u0431\u0435\u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0430 \u043f\u043e\u043c\u043e\u045b \u043a\u0430\u043e \u0443\u0434\u0438\u043e \u0443 \u0431\u0440\u0443\u0442\u043e \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u043c \u0434\u043e\u0445\u043e\u0442\u043a\u0443"}