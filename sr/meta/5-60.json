043e\u0458 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0458\u0438 (\u0442\u0458. \u043f\u0440\u0435\u0434\u0441\u0435\u0434\u043d\u0438\u043a\u0430, \u043d\u0435\u0438\u0437\u0432\u0440\u0448\u043d\u0435 \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u0435, \u0432\u0438\u0448\u0435 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u043e\u0446\u0435 \u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u0435 \u0437\u0430\u043f\u043e\u0441\u043b\u0435\u043d\u0438\u0445, \u0433\u0434\u0435 \u0441\u0443 \u043f\u0440\u0438\u0441\u0443\u0442\u043d\u0438). \u0420\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u043e\u0446\u0438 \u0441\u0435 \u043e\u0434\u043d\u043e\u0441\u0435 \u043d\u0430 \u0432\u0438\u0448\u0435 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u043e\u0446\u0435 \u0443 \u0434\u0432\u0430 \u043d\u0430\u0458\u0432\u0438\u0448\u0430 \u043e\u0440\u0433\u0430\u043d\u0430 \u043e\u0434\u043b\u0443\u0447\u0438\u0432\u0430\u045a\u0430 \u043d\u0430\u0458\u0432\u0435\u045b\u0438\u0445 (\u043c\u0430\u043a\u0441. 50) \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u043e\u0432\u0430\u043d\u0438\u0445 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0458\u0430 \u043a\u043e\u0458\u0435 \u043a\u043e\u0442\u0438\u0440\u0430\u0458\u0443 \u043d\u0430 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u0458 \u0431\u0435\u0440\u0437\u0438.","methodology_characteristics":"\u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0430 \u0415\u0423 \u0437\u0430 \u0440\u043e\u0434\u043d\u0443 \u0440\u0430\u0432\u043d\u043e\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442 \u043e\u0431\u0430\u0432\u0435\u0437\u0443\u0458\u0435 \u0441\u0435 \u043d\u0430 \u043f\u043e\u0441\u0442\u0438\u0437\u0430\u045a\u0435 \u0423\u043d\u0438\u0458\u0435 \u0440\u0430\u0432\u043d\u043e\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0438 \u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430 \u0446\u0438\u0459\u0435