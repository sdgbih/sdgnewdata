31\u0435\u0440\u0437\u0438.","eu_rationale":"\u041e\u0431\u0443\u0445\u0432\u0430\u0442 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 2003 \u2013 2023. \u0408\u0430\u0432\u043d\u043e \u043a\u043e\u0442\u0438\u0440\u0430\u043d\u043e \u0437\u043d\u0430\u0447\u0438 \u0434\u0430 \u0441\u0435 \u0430\u043a\u0446\u0438\u0458\u0430\u043c\u0430 \u0434\u0440\u0443\u0448\u0442\u0432\u0430 \u0442\u0440\u0433\u0443\u0458\u0435 \u043d\u0430 \u0431\u0435\u0440\u0437\u0438. \u201e\u041d\u0430\u0458\u0432\u0435\u045b\u0438\u043c\u201c \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0458\u0430\u043c\u0430 \u0441\u043c\u0430\u0442\u0440\u0430\u0458\u0443 \u0441\u0435 \u0447\u043b\u0430\u043d\u043e\u0432\u0438 (\u043c\u0430\u043a\u0441. 50) \u043f\u0440\u0438\u043c\u0430\u0440\u043d\u043e\u0433 blue-chip \u0438\u043d\u0434\u0435\u043a\u0441\u0430, \u043a\u043e\u0458\u0438 \u0458\u0435 \u0438\u043d\u0434\u0435\u043a\u0441 \u043a\u043e\u0458\u0438 \u043e\u0434\u0440\u0436\u0430\u0432\u0430 \u0431\u0435\u0440\u0437\u0430 \u0438 \u043a\u043e\u0458\u0438 \u043f\u043e\u043a\u0440\u0438\u0432\u0430 \u043d\u0430\u0458\u0432\u0435\u045b\u0435 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0458\u0435 \u043f\u0440\u0435\u043c\u0430 \u0442\u0440\u0436\u0438\u0448\u043d\u043e\u0458 \u043a\u0430\u043f\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0458\u0438 \u0438/\u0438\u043b\u0438 \u0442\u0440\u0436\u0438\u0448\u043d\u043e\u0458 \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0438. \u0420\u0430\u0447\u0443\u043d\u0430\u0458\u0443 \u0441\u0435 \u0441\u0430\u043c\u043e \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0458\u0435 \u043a\u043e\u0458\u0435 \u0441\u0443 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u043e\u0432\u0430\u043d\u0435 \u0443 \u0434\u043e\u0442\u0438\u0447\u043d\u043e\u0458 \u0437\u0435\u043c\u0459\u0438. \u0427\u043b\u0430\u043d\u043e\u0432\u0438 \u043e\u0434\u0431\u043e\u0440\u0430 \u043f\u043e\u043a\u0440\u0438\u0432\u0430\u0458\u0443 \u0441\u0432\u0435 \u0447\u043b\u0430\u043d\u043e\u0432\u0435 \u043d\u0430\u0458\u0432\u0438\u0448\u0435\u0433 \u043e\u0440\u0433\u0430\u043d\u0430 \u043e\u0434\u043b\u0443\u0447\u0438\u0432\u0430\u045a\u0430 \u0443 \u0441\u0432\u0430\u043a\u043e\u0458 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0458\u0438 (\u0442\u0458. \u043f\u0440\u0435\u0434\u0441\u0435\u0434\u043d\u0438\u043a\u0430, \u043d\u0435\u0438\u0437\u0432\u0440\u0448\u043d\u0435 \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u0435, \u0432\u0438\u0448\u0435 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u043e\u0446\u0435 \u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043d\u0438\u043a\u0435 \u0437\u0430\u043f\u043e\u0441\u043b\u0435\u043d\u0438\u0445, \u0433\u0434\u0435 \u0441\u0443 \u043f\u0440\u0438\u0441\u0443\u0442\u043d\u0438). \u0420\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u043e\u0446\u0438 \u0441\u0435 \u043e\u0434\u043d\u043e\u0441\u0435 \u043d\u0430 \u0432\u0438\u0448\u0435 \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0438\u043e\u0446\u0435 \u0443 \u0434\u0432\u0430 \u043d\u0430\u0458\u0432\u0438\u0448\u0430 \u043e\u0440\u0433\u0430\u043d\u0430 \u043e\u0434\u043b\u0443\u0447\u0438\u0432\u0430\u045a\u0430 \u043d\u0430\u0458\u0432\u0435\u045b\u0438\u0445 (\u043c\u0430\u043a\u0441. 50) \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u043e\u0432\u0430\u043d\u0438\u0445 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0458\u0430 \u043a\u043e\u0458\u0435 \u043a\u043e\u0442\u0438\u0440\u0430\u0458\u0443 \u043d\u0430 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u0458 \u0431\u0435\u0440\u0437\u0438.","eu_methodology_characteristics":"\u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0430 \u0415\u0423 \u0437\u0430 \u0440\u043e\u0434\u043d\u0443 \u0440\u0430\u0432\u043d\u043e\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442 \u043e\u0431\u0430\u0432\u0435\u0437\u0443\u0458\u0435 \u0441\u0435 \u043d\u0430 \u043f\u043e\u0441\u0442\u0438\u0437\u0430\u045a\u0435 \u0423\u043d\u0438\u0458\u0435 \u0440\u0430\u0432\u043d\u043e\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0438 \u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430 \u0446\u0438\u0459\u0435\u0432\u0435 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0435 \u0438 \u0430\u043a\u0446\u0438\u0458\u0435 \u0437\u0430 \u043f\u043e\u0441\u0442\u0438\u0437\u0430\u045a\u0435 \u0437\u043d\u0430\u0447\u0430\u0458\u043d\u043e\u0433 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u0434\u043e 2025. \u0433\u043e\u0434\u0438\u043d\u0435 \u043a\u0430 \u0415\u0432\u0440\u043e\u043f\u0438 \u0440\u043e\u0434\u043d\u0435 \u0440\u0430\u0432\u043d\u043e\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442\u0438, \u0443 \u043a\u043e\u0458\u043e\u0458 \u0441\u0443 \u0436\u0435\u043d\u0435 \u0438 \u043c\u0443\u0448\u043a\u0430\u0440\u0446\u0438, \u0434\u0458\u0435\u0432\u043e\u0458\u0447\u0438\u0446\u0435 \u0438 \u0434\u0458\u0435\u0447\u0430\u0446\u0438, \u0441\u043b\u043e\u0431\u043e\u0434\u043d\u0438 \u0434\u0430 \u0441\u043b\u0438\u0458\u0435\u0434\u0435 \u0441\u0432\u043e\u0458 \u0438\u0437\u0430\u0431\u0440\u0430\u043d\u0438 \u0436\u0438\u0432\u043e\u0442\u043d\u0438 \u043f\u0443\u0442 \u0438 \u0438\u043c\u0430\u0458\u0443 \u0458\u0435\u0434\u043d\u0430\u043a\u0435 \u043c\u043e\u0433\u0443\u045b\u043d\u043e\u0441\u0442\u0438 \u0437\u0430 \u043d\u0430\u043f\u0440\u0435\u0434\u0430\u043a","eu_long_objective":"\u0414\u0443\u0433\u043e\u0440\u043e\u0447\u043d\u0438 \u0446\u0438\u0459 \u0437\u0430 \u043e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0458\u0435 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442 \u043e\u0434 50.","target_number":"5.60","goal_number":"5","graph_title":"\u041f\u043e\u0437\u0438\u0446\u0438\u0458\u0435 \u043a\u043e\u0458\u0435 \u0437\u0430\u0443\u0437\u0438\u043c\u0430\u0458\u0443 \u0436\u0435\u043d\u0435 \u043d\u0430 \u0432\u0438\u0448\u0438\u043c \u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0435\u045b\u0438\u043c \u043f\u04