0434\u043e\u043c\u0430\u045b\u0435 \u0438\u0437\u0434\u0430\u0442\u043a\u0435 \u0437\u0430 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0435 \u0438 \u0440\u0430\u0437\u0432\u043e\u0458 (GERD) \u043a\u0430\u043e \u043f\u0440\u043e\u0446\u0435\u043d\u0430\u0442 \u0431\u0440\u0443\u0442\u043e \u0434\u043e\u043c\u0430\u045b\u0435\u0433 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0430 (\u0411\u0414\u041f-\u0430), \u043e\u0434\u043d\u043e\u0441\u043d\u043e \u0438\u043d\u0442\u0435\u043d\u0437\u0438\u0442\u0435\u0442 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0430 \u0438 \u0440\u0430\u0437\u0432\u043e\u0458\u0430. \u0418\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0435 \u0438 \u0435\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043b\u043d\u0438 \u0440\u0430\u0437\u0432\u043e\u0458 (R&D) \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430\u0458\u0443 \u043a\u0440\u0435\u0430\u0442\u0438\u0432\u0430\u043d \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0430\u043d \u0440\u0430\u0434 \u043a\u043e\u0458\u0438 \u0441\u0435 \u043f\u0440\u0435\u0434\u0443\u0437\u0438\u043c\u0430 \u0440\u0430\u0434\u0438 \u043f\u043e\u0432\u0435\u045b\u0430\u045a\u0430 \u0444\u043e\u043d\u0434\u0430 \u0437\u043d\u0430\u045a\u0430 \u0438 \u043e\u0441\u043c\u0438\u0448\u0459\u0430\u0432\u0430\u045a\u0430 \u043d\u043e\u0432\u0438\u0445 \u043f\u0440\u0438\u043c\u0458\u0435\u043d\u0430 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0433 \u0437\u043d\u0430\u045a\u0430. \u041f\u043e\u0434\u0430\u0446\u0438 \u0437\u0430 \u0411\u043e\u0441\u043d\u0443 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0443 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430\u0458\u0443 \u0443\u043a\u0443\u043f\u043d\u0435 \u0438\u0437\u0434\u0430\u0442\u043a\u0435 \u0437\u0430 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0435 \u0438 \u0440\u0430\u0437\u0432\u043e\u0458, \u043a\u0430\u043e \u0438 \u0438\u0437\u0434\u0430\u0442\u043a\u0435 \u043f\u0440\u0435\u043c\u0430 \u0441\u0435\u043a\u0442\u043e\u0440\u0438\u043c\u0430 \u0438\u0437\u0432\u043e\u0452\u0435\u045a\u0430 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0430 \u0438 \u0440\u0430\u0437\u0432\u043e\u0458\u0430.","national_rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043e\u043c\u043e\u0433\u0443\u045b\u0430\u0432\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0438\u0432\u043e\u0430 \u0443\u043b\u0430\u0433\u0430\u045a\u0430 \u0443 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0435 \u0438 \u0440\u0430\u0437\u0432\u043e\u0458 \u0443 \u043e\u0434\u043d\u043e\u0441\u0443 \u043d\u0430 \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u0443 \u0435\u043a\u043e\u043d\u043e\u043c\u0438\u0458\u0435 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435. \u041d\u0430 \u0442\u0430\u0458 \u043d\u0430\u0447\u0438\u043d \u043f\u0440\u0443\u0436\u0430 \u043e\u0441\u043d\u043e\u0432\u0443 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u0443\u043b\u0430\u0433\u0430\u045a\u0430 \u0443 \u043d\u0430\u0443\u043a\u0443, \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0458\u0443 \u0438 \u0438\u043d\u043e\u0432\u0430\u0446\u0438\u0458\u0435 \u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430 \u0458\u0435\u0434\u0430\u043d \u043e\u0434 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u0459\u0430 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u0443 \u043e\u0441\u0442\u0432\u0430\u0440\u0438\u0432\u0430\u045a\u0443 \u0446\u0438\u0459\u0430 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 9.","national_methodology_characteristics":"\u041f\u043e\u0434\u0430\u0446\u0438 \u0437\u0430 \u0411\u043e\u0441\u043d\u0443 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0443 \u0437\u0430\u0441\u043d\u0438\u0432\u0430\u0458\u0443 \u0441\u0435 \u043d\u0430 \u043f\u043e\u0434\u0430\u0446\u0438\u043c\u0430 \u0410\u0433\u0435\u043d\u0446\u0438\u0458\u0435 \u0437\u0430 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435 \u0438 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430\u0458\u0443 \u0431\u0440\u0443\u0442\u043e \u0434\u043e\u043c\u0430\u045b\u0435 \u0438\u0437\u0434\u0430\u0442\u043a\u0435 \u0437\u0430 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0435 \u0438 \u0440\u0430\u0437\u0432\u043e\u0458 \u0438\u0441\u043a\u0430\u0437\u0430\u043d\u0435 \u043a\u0430\u043e \u043f\u0440\u043e\u0446\u0435\u043d\u0430\u0442 \u0411\u0414\u041f-\u0430. \u041f\u043e\u0434\u0430\u0446\u0438 \u0441\u0443 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438 \u0437\u0430 \u043f\u0435\u0440\u0438\u043e\u0434 2019\u20132024. \u0433\u043e\u0434\u0438\u043d\u0435, \u043f\u0440\u0438 \u0447\u0435\u043c\u0443 \u0441\u0443 \u0443\u043a\u0443\u043f\u043d\u0435 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 (TOTAL, \u0421\u0432\u0438 \u0441\u0435\u043a\u0442\u043e\u0440\u0438) \u043e\u0441\u043d\u043e\u0432\u0430 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u045a\u0435\u0433\u043e\u0432\u043e\u0433 \u043a\u0440\u0435\u0442\u0430\u045a\u0430. \u0410\u0443\u0442\u043e\u043c\u0430\u0442\u0441\u043a\u0438 \u0441\u0442\u0430\u0442\u0443\u0441 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u0438\u0437\u0440\u0430\u0447\u0443\u043d\u0430\u0432\u0430 \u0441\u0435 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0443 \u0443\u043a\u0443\u043f\u043d\u0435 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430.","national_long_objective":"\u0417\u0430 \u0411\u043e\u0441\u043d\u0443 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0443 \u0443 \u043e\u043a\u0432\u0438\u0440\u0443 \u043e\u0432\u043e\u0433 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u043d\u0438\u0458\u0435 \u0443\u0442\u0432\u0440\u0452\u0435\u043d \u043f\u043e\u0441\u0435\u0431\u0430\u043d \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u043d\u0443\u043c\u0435\u0440\u0438\u0447\u043a\u0438 \u0434\u0443\u0433\u043e\u0440\u043e\u0447\u043d\u0438 \u0446\u0438\u0459 \u043a\u043e\u0458\u0438 \u0431\u0438 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438\u043e \u0437\u0430 \u0430\u0443\u0442\u043e\u043c\u0430\u0442\u0441\u043a\u0438 \u043e\u0431\u0440\u0430\u0447\u0443\u043d \u0441\u0442\u0430\u0442\u0443\u0441\u0430 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430. \u0426\u0438\u0459 \u0415\u0423 \u043e\u0434 3% \u0411\u0414\u041f-\u0430 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430 \u0440\u0435\u0444\u0435\u0440\u0435\u043d\u0442\u043d\u0438 \u0446\u0438\u0459 \u043d\u0430 \u043d\u0438\u0432\u043e\u0443 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u0443\u043d\u0438\u0458\u0435 \u0438 \u043d\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430 \u0430\u0443\u0442\u043e\u043c\u0430\u0442\u0441\u043a\u0438 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u0446\u0438\u0459 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435.","eu_indicator_definition":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043c\u0458\u0435\u0440\u0438 \u0431\u0440\u0443\u0442\u043e \u0434\u043e\u043c\u0430\u045b\u0435 \u0438\u0437\u0434\u0430\u0442\u043a\u0435 \u0437\u0430 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0435 \u0438 \u0440\u0430\u0437\u0432\u043e\u0458 (GERD) \u043a\u0430\u043e \u043f\u0440\u043e\u0446\u0435\u043d\u0430\u0442 \u0431\u0440\u0443\u0442\u043e \u0434\u043e\u043c\u0430\u045b\u0435\u0433 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0430 (\u0411\u0414\u041f-\u0430), \u0448\u0442\u043e \u0441\u0435 \u043d\u0430\u0437\u0438\u0432\u0430 \u0438 \u0438\u043d\u0442\u0435\u043d\u0437\u0438\u0442\u0435\u0442 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0430 \u0438 \u0440\u0430\u0437\u0432\u043e\u0458\u0430. \u041f\u0440\u0435\u043c\u0430 OECD-\u043e\u0432\u043e\u043c \u0424\u0440\u0430\u0441\u043a\u0430\u0442\u0438 \u043f\u0440\u0438\u0440\u0443\u0447\u043d\u0438\u043a\u0443, \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0435 \u0438 \u0435\u043a\u0441\u043f\u0435\u0440\u0438\u043c\u0435\u043d\u0442\u0430\u043b\u043d\u0438 \u0440\u0430\u0437\u0432\u043e\u0458 (R&D) \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430\u0458\u0443 \u043a\u0440\u0435\u0430\u0442\u0438\u0432\u0430\u043d \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u0430\u0442\u0438\u0447\u0430\u043d \u0440\u0430\u0434 \u043a\u043e\u0458\u0438 \u0441\u0435 \u043f\u0440\u0435\u0434\u0443\u0437\u0438\u043c\u0430 \u0440\u0430\u0434\u0438 \u043f\u043e\u0432\u0435\u045b\u0430\u045a\u0430 \u0444\u043e\u043d\u0434\u0430 \u0437\u043d\u0430\u045a\u0430, \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443\u045b\u0438 \u0437\u043d\u0430\u045a\u0435 \u043e \u0447\u043e\u0432\u0458\u0435\u0447\u0430\u043d\u0441\u0442\u0432\u0443, \u043a\u0443\u043b\u0442\u0443\u0440\u0438 \u0438 \u0434\u0440\u0443\u0448\u0442\u0432\u0443, \u043a\u0430\u043e \u0438 \u0440\u0430\u0434\u0438 \u043e\u0441\u043c\u0438\u0448\u0459\u0430\u0432\u0430\u045a\u0430 \u043d\u043e\u0432\u0438\u0445 \u043f\u0440\u0438\u043c\u0458\u0435\u043d\u0430 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0433 \u0437\u043d\u0430\u045a\u0430.","eu_rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043f\u0440\u0435\u043c\u0430 \u0446\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 9, \u043a\u043e\u0458\u0438 \u0441\u0435 \u043e\u0434\u043d\u043e\u0441\u0438 \u043d\u0430 \u0438\u0437\u0433\u0440\u0430\u0434\u045a\u0443 \u043e\u0442\u043f\u043e\u0440\u043d\u0435 \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0435, \u043f\u0440\u043e\u043c\u043e\u0432\u0438\u0441\u0430\u045a\u0435 \u0438\u043d\u043a\u043b\u0443\u0437\u0438\u0432\u043d\u0435 \u0438 \u043e\u0434\u0440\u0436\u0438\u0432\u0435 \u0438\u043d\u0434\u0443\u0441\u0442\u0440\u0438\u0458\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0458\u0435 \u0438 \u043f\u043e\u0434\u0441\u0442\u0438\u0446\u0430\u045a\u0435 \u0438\u043d\u043e\u0432\u0430\u0446\u0438\u0458\u0430. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0458\u0435 \u0438\u0434\u0435\u043d\u0442\u0438\u0447\u0430\u043d \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e\u043c \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0443 SDG 9.5.1 \u201e\u0418\u0437\u0434\u0430\u0446\u0438 \u0437\u0430 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0435 \u0438 \u0440\u0430\u0437\u0432\u043e\u0458 \u043a\u0430\u043e \u0443\u0434\u0438\u043e \u0411\u0414\u041f-\u0430\u201c.","eu_methodology_characteristics":"\u041d\u043e\u0432\u0430 \u0432\u0438\u0437\u0438\u0458\u0430 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u043e\u0433 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u0447\u043a\u043e\u0433 \u043f\u0440\u043e\u0441\u0442\u043e\u0440\u0430 (ERA) \u0443\u0441\u043c\u0458\u0435\u0440\u0435\u043d\u0430 \u0458\u0435 \u043d\u0430 \u0438\u0437\u0433\u0440\u0430\u0434\u045a\u0443 \u0437\u0430\u0458\u0435\u0434\u043d\u0438\u0447\u043a\u043e\u0433 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u043e\u0433 \u043f\u0440\u043e\u0441\u0442\u043e\u0440\u0430 \u0437\u0430 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0435 \u0438 \u0438\u043d\u043e\u0432\u0430\u0446\u0438\u0458\u0435 \u043a\u0440\u043e\u0437 \u043f\u043e\u0434\u0441\u0442\u0438\u0446\u0430\u045a\u0435 \u0443\u043b\u0430\u0433\u0430\u045a\u0430 \u0438 \u0440\u0435\u0444\u043e\u0440\u043c\u0438, \u0443\u043d\u0430\u043f\u0440\u0435\u0452\u0435\u045a\u0435 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430 \u0438\u0437\u0432\u0440\u0441\u043d\u043e\u0441\u0442\u0438, \u043f\u0440\u0435\u0442\u0432\u0430\u0440\u0430\u045a\u0435 \u0440\u0435\u0437\u0443\u043b\u0442\u0430\u0442\u0430 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0430 \u0438 \u0438\u043d\u043e\u0432\u0430\u0446\u0438\u0458\u0430 \u0443 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0443 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442 \u0438 \u0434\u0430\u0459\u0435 \u043f\u0440\u043e\u0434\u0443\u0431\u0459\u0438\u0432\u0430\u045a\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u043e\u0433 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u0447\u043a\u043e\u0433 \u043f\u0440\u043e\u0441\u0442\u043e\u0440\u0430. \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0430 \u0443\u043d\u0438\u0458\u0430 \u0438\u043c\u0430 \u0434\u0443\u0433\u043e\u0433\u043e\u0434\u0438\u0448\u045a\u0438 \u0446\u0438\u0459 \u043f\u043e\u0432\u0435\u045b\u0430\u045a\u0430 \u0438\u043d\u0442\u0435\u043d\u0437\u0438\u0442\u0435\u0442\u0430 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0430 \u0438 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 \u043d\u0430 3% \u0411\u0414\u041f-\u0430, \u0448\u0442\u043e \u0458\u0435 \u043f\u043e\u0442\u0432\u0440\u0452\u0435\u043d\u043e \u041f\u0440\u0435\u043f\u043e\u0440\u0443\u043a\u043e\u043c \u0421\u0430\u0432\u0458\u0435\u0442\u0430 \u043e \u041f\u0430\u043a\u0442\u0443 \u0437\u0430 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0435 \u0438 \u0438\u043d\u043e\u0432\u0430\u0446\u0438\u0458\u0435 \u0443 \u0415\u0432\u0440\u043e\u043f\u0438 \u0438\u0437 \u043d\u043e\u0432\u0435\u043c\u0431\u0440\u0430 2021. \u0433\u043e\u0434\u0438\u043d\u0435.","eu_long_objective":"\u0414\u0443\u0433\u043e\u0440\u043e\u0447\u043d\u0438 \u0446\u0438\