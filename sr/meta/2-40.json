{"indicator_number":2.4,"reporting_status":"complete","published":true,"sdg_goal":"2","data_non_statistical":false,"graph_type":"line","indicator_sort_order":"02-40","indicator_name":"\u041f\u043e\u0432\u0440\u0448\u0438\u043d\u0430 \u043f\u043e\u0434 \u043e\u0440\u0433\u0430\u043d\u0441\u043a\u043e\u043c \u043f\u043e\u0459\u043e\u043f\u0440\u0438\u0432\u0440\u0435\u0434\u043e\u043c","source_active_1":true,"source_organisation_1":"EEA","source_url_1":"https://www.eea.europa.eu/en/europe-environment-2025/countries/bosnia-and-herzegovina/area-under-organic-farming","footer_fields":[{"label":"\u0420\u0435\u0444\u0435\u0440\u0435\u043d\u0442\u043d\u0438 \u043c\u0435\u0442\u0430\u043f\u043e\u0434\u0430\u0446\u0438","value":"<a href=\"https://www.eea.europa.eu/en/europe-environment-2025/countries/bosnia-and-herzegovina/area-under-organic-farming?activeTab=8a280073-bf94-4717-b3e2-1374b57ca99d\">EEA Metadata Report</a>"}],"graph_titles":[{"series":"\u041f\u043e\u0432\u0440\u0448\u0438\u043d\u0430 \u043f\u043e\u0434 \u043e\u0440\u0433\u0430\u043d\u0441\u043a\u043e\u043c \u043f\u043e\u0459\u043e\u043f\u0440\u0438\u0432\u0440\u0435\u0434\u043e\u043c","title":"\u041f\u043e\u0432\u0440\u0448\u0438\u043d\u0430 \u043f\u043e\u0434 \u043e\u0440\u0433\u0430\u043d\u0441\u043a\u043e\u043c \u043f\u043e\u0459\u043e\u043f\u0440\u0438\u0432\u0440\u0435\u0434\u043e\u043c"}],"national_indicator_definition":"\u041e\u043f\u0438\u0441 \u043f\u043e\u0459\u043e\u043f\u0440\u0438\u0432\u0440\u0435\u0434\u043d\u0435 \u043f\u043e\u0432\u0440\u0448\u0438\u043d\u0435 (\u041a\u041f\u0417) \u043a\u043e\u0458\u0443 \u0437\u0430\u0443\u0437\u0438\u043c\u0430 \u043e\u0440\u0433\u0430\u043d\u0441\u043a\u0430 \u043f\u043e\u0459\u043e\u043f\u0440\u0438\u0432\u0440\u0435\u0434\u0430 (\u043f\u043e\u0441\u0442\u043e\u0458\u0435\u045b\u0435 \u043e\u0440\u0433\u0430\u043d\u0441\u043a\u0438 \u043e\u0431\u0440\u0430\u0452\u0435\u043d\u0435 \u043f\u043e\u0432\u0440\u0448\u0438\u043d\u0435 \u0438 \u043f\u043e\u0432\u0440\u0448\u0438\u043d\u0435 \u043a\u043e\u0458\u0435 \u043f\u0440\u043e\u043b\u0430\u0437\u0435 \u043a\u0440\u043e\u0437 \u043a\u043e\u043d\u0432\u0435\u0440\u0437\u0438\u0458\u0443). \u041e\u0440\u0433\u0430\u043d\u0441\u043a\u0430 \u043f\u043e\u0459\u043e\u043f\u0440\u0438\u0432\u0440\u0435\u0434\u0430 \u0458\u0435 \u043c\u0435\u0442\u043e\u0434 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u045a\u0435 \u043a\u043e\u0458\u0438 \u0441\u0442\u0430\u0432\u0459\u0430 \u043d\u0430\u0458\u0432\u0435\u045b\u0438 \u043d\u0430\u0433\u043b\u0430\u0441\u0430\u043a \u043d\u0430 \u0437\u0430\u0448\u0442\u0438\u0442\u0443 \u0436\u0438\u0432\u043e\u0442\u043d\u0435 \u0441\u0440\u0435\u0434\u0438\u043d\u0435 \u0438 \u0434\u0438\u0432\u0459\u0438\u0445 \u0436\u0438\u0432\u043e\u0442\u0438\u045a\u0430, \u0430 \u0443 \u043f\u043e\u0433\u043b\u0435\u0434\u0443 \u0441\u0442\u043e\u0447\u0430\u0440\u0441\u043a\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u045a\u0435 \u0438 \u043d\u0430 \u0440\u0430\u0437\u043c\u0430\u0442\u0440\u0430\u045a\u0430 \u0434\u043e\u0431\u0440\u043e\u0431\u0438\u0442\u0438 \u0436\u0438\u0432\u043e\u0442\u0438\u045a\u0430. \u0418\u0437\u0431\u0435\u0433\u0430\u0432\u0430 \u0438\u043b\u0438 \u0443 \u0432\u0435\u043b\u0438\u043a\u043e\u0458 \u043c\u0435\u0440\u0438 \u0441\u043c\u0430\u045a\u0443\u0458\u0435 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0443 \u0441\u0438\u043d\u0442\u0435\u0442\u0438\u0447\u043a\u0438\u0445 \u0445\u0435\u043c\u0438\u0458\u0441\u043a\u0438\u0445 \u0443\u043b\u0430\u0433\u0430\u045a\u0430, \u043a\u0430\u043e \u0448\u0442\u043e \u0441\u0443 \u0452\u0443\u0431\u0440\u0438\u0432\u0430, \u043f\u0435\u0441\u0442\u0438\u0446\u0438\u0434\u0438, \u0430\u0434\u0438\u0442\u0438\u0432\u0438 \u0438 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438.","national_rationale":"\u041e\u0440\u0433\u0430\u043d\u0441\u043a\u0430 \u043f\u043e\u0459\u043e\u043f\u0440\u0438\u0432\u0440\u0435\u0434\u0430 \u0443 \u0411\u043e\u0441\u043d\u0438 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0438 \u043f\u043e\u0447\u0435\u043b\u0430 \u0441\u0435 \u0440\u0430\u0437\u0432\u0438\u0458\u0430\u0442\u0438 1990-\u0438\u0445 \u0433\u043e\u0434\u0438\u043d\u0430. \u0423\u043f\u0440\u043a\u043e\u0441 \u0442\u043e\u043c\u0435 \u0448\u0442\u043e \u0441\u0435 \u043f\u043e\u0432\u0440\u0448\u0438\u043d\u0430 \u043f\u043e\u0434 \u043e\u0440\u0433\u0430\u043d\u0441\u043a\u043e\u043c \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u045a\u043e\u043c \u0438\u0437\u043c\u0435\u0452\u0443 2014. \u0438 2022. \u0433\u043e\u0434\u0438\u043d\u0435 \u043f\u043e\u0432\u0435\u045b\u0430\u043b\u0430 \u043e\u0441\u0430\u043c \u043f\u0443\u0442\u0430, \u0443\u043a\u0443\u043f\u043d\u043e \u043f\u043e\u0459\u043e\u043f\u0440\u0438\u0432\u0440\u0435\u0434\u043d\u043e \u0437\u0435\u043c\u0459\u0438\u0448\u0442\u0435 \u043f\u043e\u0434 \u043e\u0432\u0438\u043c \u0443\u0437\u0433\u043e\u0458\u0435\u043c \u0434\u043e\u0441\u0442\u0438\u0433\u043b\u043e \u0458\u0435 \u0441\u043a\u0440\u043e\u043c\u043d\u0438\u0445 2.495 ha \u0443 2022. \u0433\u043e\u0434\u0438\u043d\u0438. \u0408\u0435\u0434\u0430\u043d \u043e\u0434 \u0446\u0438\u0459\u0435\u0432\u0430 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0430 \u0440\u0443\u0440\u0430\u043b\u043d\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 \u0437\u0430 \u043f\u0435\u0440\u0438\u043e\u0434 2021\u20132027. \u0458\u0435\u0441\u0442\u0435 \u043e\u0441\u0442\u0432\u0430\u0440\u0438\u0432\u0430\u045a\u0435 \u0437\u043d\u0430\u0447\u0430\u0458\u043d\u043e\u0433 \u0440\u0430\u0441\u0442\u0430 \u043e\u0440\u0433\u0430\u043d\u0441\u043a\u0435 \u043f\u043e\u0459\u043e\u043f\u0440\u0438\u0432\u0440\u0435\u0434\u0435.","national_methodology_characteristics":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043c\u043e\u0436\u0435 \u0441\u043c\u0430\u0442\u0440\u0430\u0442\u0438 \u0434\u0438\u0458\u0435\u043b\u043e\u043c \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e\u0433 \u0421\u0414\u0413 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 2.4.1 \u201e\u0423\u0434\u0438\u043e \u043f\u043e\u0459\u043e\u043f\u0440\u0438\u0432\u0440\u0435\u0434\u043d\u0435 \u043f\u043e\u0432\u0440\u0448\u0438\u043d\u0435 \u043f\u043e\u0434 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u043c \u0438 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u043c \u043f\u043e\u0459\u043e\u043f\u0440\u0438\u043f\u0440\u0435\u0434\u043e\u043c\u201c. \u0418\u0430\u043a\u043e \u043e\u0440\u0433\u0430\u043d\u0441\u043a\u0430 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u045a\u0430 \u043d\u0438\u0458\u0435 \u0435\u043a\u0441\u043f\u043b\u0438\u0446\u0438\u0442\u043d\u043e \u043f\u043e\u043c\u0435\u043d\u0443\u0442\u0430 \u0443 \u0410\u0433\u0435\u043d\u0434\u0438 2030, \u0415\u0423 \u0441\u043c\u0430\u0442\u0440\u0430 \u043e\u0440\u0433\u0430\u043d\u0441\u043a\u0443 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u045a\u0443 \u043c\u0435\u0442\u043e\u0434\u043e\u043c \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u045a\u0435 \u043a\u043e\u0458\u0430 \u0441\u0442\u0430\u0432\u0459\u0430 \u043d\u0430\u0458\u0432\u0435\u045b\u0438 \u043d\u0430\u0433\u043b\u0430\u0441\u0430\u043a \u043d\u0430 \u0437\u0430\u0448\u0442\u0438\u0442\u0443 \u0436\u0438\u0432\u043e\u0442\u043d\u0435 \u0441\u0440\u0435\u0434\u0438\u043d\u0435 \u0438 \u0434\u0438\u0432\u0459\u0438\u0445 \u0432\u0440\u0441\u0442\u0430, \u0430 \u0443 \u043f\u043e\u0433\u043b\u0435\u0434\u0443 \u0441\u0442\u043e\u0447\u0430\u0440\u0441\u043a\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u045a\u0435, \u043d\u0430 \u043f\u0438\u0442\u0430\u045a\u0430 \u0434\u043e\u0431\u0440\u043e\u0431\u0438\u0442\u0438 \u0436\u0438\u0432\u043e\u0442\u0438\u045a\u0430. \u040a\u043e\u043c\u0435 \u0441\u0435 \u0438\u0437\u0431\u0458\u0435\u0433\u0430\u0432\u0430 \u0438\u043b\u0438 \u0443 \u0432\u0435\u043b\u0438\u043a\u043e\u0458 \u043c\u0458\u0435\u0440\u0438 \u0441\u043c\u0430\u045a\u0443\u0458\u0435 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0430 \u0441\u0438\u043d\u0442\u0435\u0442\u0438\u0447\u043a\u0438\u0445 \u0445\u0435\u043c\u0438\u0458\u0441\u043a\u0438\u0445 \u0438\u043d\u043f\u0443\u0442\u0430 \u043a\u0430\u043e \u0448\u0442\u043e \u0441\u0443 \u0452\u0443\u0431\u0440\u0438\u0432\u0430, \u043f\u0435\u0441\u0442\u0438\u0446\u0438\u0434\u0438, \u0430\u0434\u0438\u0442\u0438\u0432\u0438 \u0438 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438. \u041f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u045a\u0430 \u0433\u0435\u043d\u0435\u0442\u0441\u043a\u0438 \u043c\u043e\u0434\u0438\u0444\u0438\u043a\u043e\u0432\u0430\u043d\u0438\u0445 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u043c\u0430 (\u0413\u041c\u041e) \u0438 \u045a\u0438\u0445\u043e\u0432\u0430 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0430 \u0443 \u0438\u0441\u0445\u0440\u0430\u043d\u0438 \u0436\u0438\u0432\u043e\u0442\u0438\u045a\u0430 \u0441\u0443 \u0437\u0430\u0431\u0440\u0430\u045a\u0435\u043d\u0438. \u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0430 \u0437\u0430 \u0431\u0438\u043e\u0434\u0438\u0432\u0435\u0440\u0437\u0438\u0442\u0435\u0442 \u0434\u043e 2030. \u0433\u043e\u0434\u0438\u043d\u0435 \u043a\u0459\u0443\u0447\u043d\u0430 \u0458\u0435 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0430 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u043e\u0433 \u0437\u0435\u043b\u0435\u043d\u043e\u0433 \u043f\u043b\u0430\u043d\u0430. \u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0430 \u0438\u043c\u0430 \u0437\u0430 \u0446\u0438\u0459 \u0441\u043c\u0430\u045a\u0435\u045a\u0435 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0435 \u0438 \u0440\u0438\u0437\u0438\u043a\u0430 \u043e\u0434 \u0445\u0435\u043c\u0438\u0458\u0441\u043a\u0438\u0445 \u043f\u0435\u0441\u0442\u0438\u0446\u0438\u0434\u0430, \u0441\u043c\u0430\u045a\u0435\u045a\u0435 \u0433\u0443\u0431\u0438\u0442\u043a\u0430 \u0445\u0440\u0430\u045a\u0438\u0432\u0438\u0445 \u043c\u0430\u0442\u0435\u0440\u0438\u0458\u0430, \u0442\u0435 \u0441\u043c\u0430\u045a\u0435\u045a\u0435 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0435 \u0452\u0443\u0431\u0440\u0438\u0432\u0430 \u0438 \u0430\u043d\u0442\u0438\u0431\u0438\u043e\u0442\u0438\u043a\u0430. \u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0430 \u0437\u0430 \u0431\u0438\u043e\u0434\u0438\u0432\u0435\u0440\u0437\u0438\u0442\u0435\u0442 \u043f\u043e\u0441\u0442\u0430\u0432\u0459\u0430 \u0446\u0438\u0459 \u0434\u0430 \u0441\u0435 \u0434\u043e 2030. \u0433\u043e\u0434\u0438\u043d\u0435 \u043f\u043e\u0441\u0442\u0438\u0433\u043d\u0435 25% \u0443\u043a\u0443\u043f\u043d\u043e\u0433 \u043f\u043e\u0459\u043e\u043f\u0440\u0438\u0432\u0440\u0435\u0434\u043d\u043e\u0433 \u0437\u0435\u043c\u0459\u0438\u0448\u0442\u0430 \u0415\u0423 \u043f\u043e\u0434 \u043e\u0440\u0433\u0430\u043d\u0441\u043a\u043e\u043c \u043f\u043e\u0459\u043e\u043f\u0440\u0438\u043f\u0440\u0435\u0434\u043e\u043c.","national_long_objective":"\u041d\u0430\u0458\u043c\u0430\u045a\u0435 25% \u043f\u043e\u0459\u043e\u043f\u0440\u0438\u0432\u0440\u0435\u0434\u043d\u043e\u0433 \u0437\u0435\u043c\u0459\u0438\u0448\u0442\u0430 \u0415\u0423 \u0442\u0440\u0435\u0431\u0430\u043b\u043e \u0431\u0438 \u0434\u0430 \u0431\u0443\u0434\u0435 \u043f\u043e\u0434 \u043e\u0440\u0433\u0430\u043d\u0441\u043a\u043e\u043c \u043f\u043e\u0459\u043e\u043f\u0440\u0438\u0432\u0440\u0435\u0434\u043e\u043c \u0434\u043e 2030. \u0433\u043e\u0434\u0438\u043d\u0435.","eu_indicator_definition":"\u041e\u043f\u0438\u0441 \u043f\u043e\u0459\u043e\u043f\u0440\u0438\u0432\u0440\u0435\u0434\u043d\u0435 \u043f\u043e\u0432\u0440\u0448\u0438\u043d\u0435 (\u041a\u041f\u0417) \u043a\u043e\u0458\u0443 \u0437\u0430\u0443\u0437\u0438\u043c\u0430 \u043e\u0440\u0433\u0430\u043d\u0441\u043a\u0430 \u043f\u043e\u0459\u043e\u043f\u0440\u0438\u0432\u0440\u0435\u0434\u0430 (\u043f\u043e\u0441\u0442\u043e\u0458\u0435\u045b\u0435 \u043e\u0440\u0433\u0430\u043d\u0441\u043a\u0438 \u043e\u0431\u0440\u0430\u0452\u0435\u043d\u0435 \u043f\u043e\u0432\u0440\u0448\u0438\u043d\u0435 \u0438 \u043f\u043e\u0432\u0440\u0448\u0438\u043d\u0435 \u043a\u043e\u0458\u0435 \u043f\u0440\u043e\u043b\u0430\u0437\u0435 \u043a\u0440\u043e\u0437 \u043a\u043e\u043d\u0432\u0435\u0440\u0437\u0438\u0458\u0443). \u041e\u0440\u0433\u0430\u043d\u0441\u043a\u0430 \u043f\u043e\u0459\u043e\u043f\u0440\u0438\u0432\u0440\u0435\u0434\u0430 \u0458\u0435 \u043c\u0435\u0442\u043e\u0434 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u045a\u0435 \u043a\u043e\u0458\u0438 \u0441\u0442\u0430\u0432\u0459\u0430 \u043d\u0430\u0458\u0432\u0435\u045b\u0438 \u043d\u0430\u0433\u043b\u0430\u0441\u0430\u043a \u043d\u0430 \u0437\u0430\u0448\u0442\u0438\u0442\u0443 \u0436\u0438\u0432\u043e\u0442\u043d\u0435 \u0441\u0440\u0435\u0434\u0438\u043d\u0435 \u0438 \u0434\u0438\u0432\u0459\u0438\u0445 \u0436\u0438\u0432\u043e\u0442\u0438\u045a\u0430, \u0430 \u0443 \u043f\u043e\u0433\u043b\u0435\u0434\u0443 \u0441\u0442\u043e\u0447\u0430\u0440\u0441\u043a\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u045a\u0435 \u0438 \u043d\u0430 \u0440\u0430\u0437\u043c\u0430\u0442\u0440\u0430\u045a\u0430 \u0434\u043e\u0431\u0440\u043e\u0431\u0438\u0442\u0438 \u0436\u0438\u0432\u043e\u0442\u0438\u045a\u0430. \u0418\u0437\u0431\u0435\u0433\u0430\u0432\u0430 \u0438\u043b\u0438 \u0443 \u0432\u0435\u043b\u0438\u043a\u043e\u0458 \u043c\u0435\u0440\u0438 \u0441\u043c\u0430\u045a\u0443\u0458\u0435 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0443 \u0441\u0438\u043d\u0442\u0435\u0442\u0438\u0447\u043a\u0438\u0445 \u0445\u0435\u043c\u0438\u0458\u0441\u043a\u0438\u0445 \u0443\u043b\u0430\u0433\u0430\u045a\u0430, \u043a\u0430\u043e \u0448\u0442\u043e \u0441\u0443 \u0452\u0443\u0431\u0440\u0438\u0432\u0430, \u043f\u0435\u0441\u0442\u0438\u0446\u0438\u0434\u0438, \u0430\u0434\u0438\u0442\u0438\u0432\u0438 \u0438 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438.","eu_rationale":"\u041e\u0440\u0433\u0430\u043d\u0441\u043a\u0430 \u043f\u043e\u0459\u043e\u043f\u0440\u0438\u0432\u0440\u0435\u0434\u0430 \u0443 \u0411\u043e\u0441\u043d\u0438 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0438 \u043f\u043e\u0447\u0435\u043b\u0430 \u0441\u0435 \u0440\u0430\u0437\u0432\u0438\u0458\u0430\u0442\u0438 1990-\u0438\u0445 \u0433\u043e\u0434\u0438\u043d\u0430. \u0423\u043f\u0440\u043a\u043e\u0441 \u0442\u043e\u043c\u0435 \u0448\u0442\u043e \u0441\u0435 \u043f\u043e\u0432\u0440\u0448\u0438\u043d\u0430 \u043f\u043e\u0434 \u043e\u0440\u0433\u0430\u043d\u0441\u043a\u043e\u043c \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u045a\u043e\u043c \u0438\u0437\u043c\u0435\u0452\u0443 2014. \u0438 2022. \u0433\u043e\u0434\u0438\u043d\u0435 \u043f\u043e\u0432\u0435\u045b\u0430\u043b\u0430 \u043e\u0441\u0430\u043c \u043f\u0443\u0442\u0430, \u0443\u043a\u0443\u043f\u043d\u043e \u043f\u043e\u0459\u043e\u043f\u0440\u0438\u0432\u0440\u0435\u0434\u043d\u043e \u0437\u0435\u043c\u0459\u0438\u0448\u0442\u0435 \u043f\u043e\u0434 \u043e\u0432\u0438\u043c \u0443\u0437\u0433\u043e\u0458\u0435\u043c \u0434\u043e\u0441\u0442\u0438\u0433\u043b\u043e \u0458\u0435 \u0441\u043a\u0440\u043e\u043c\u043d\u0438\u0445 2.495 ha \u0443 2022. \u0433\u043e\u0434\u0438\u043d\u0438. \u0408\u0435\u0434\u0430\u043d \u043e\u0434 \u0446\u0438\u0459\u0435\u0432\u0430 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0430 \u0440\u0443\u0440\u0430\u043b\u043d\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 \u0437\u0430 \u043f\u0435\u0440\u0438\u043e\u0434 2021\u20132027. \u0458\u0435\u0441\u0442\u0435 \u043e\u0441\u0442\u0432\u0430\u0440\u0438\u0432\u0430\u045a\u0435 \u0437\u043d\u0430\u0447\u0430\u0458\u043d\u043e\u0433 \u0440\u0430\u0441\u0442\u0430 \u043e\u0440\u0433\u0430\u043d\u0441\u043a\u0435 \u043f\u043e\u0459\u043e\u043f\u0440\u0438\u0432\u0440\u0435\u0434\u0435.","eu_methodology_characteristics":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043c\u043e\u0436\u0435 \u0441\u043c\u0430\u0442\u0440\u0430\u0442\u0438 \u0434\u0438\u0458\u0435\u043b\u043e\u043c \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e\u0433 \u0421\u0414\u0413 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 2.4.1 \u201e\u0423\u0434\u0438\u043e \u043f\u043e\u0459\u043e\u043f\u0440\u0438\u0432\u0440\u0435\u0434\u043d\u0435 \u043f\u043e\u0432\u0440\u0448\u0438\u043d\u0435 \u043f\u043e\u0434 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u043c \u0438 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u043c \u043f\u043e\u0459\u043e\u043f\u0440\u0438\u043f\u0440\u0435\u0434\u043e\u043c\u201c. \u0418\u0430\u043a\u043e \u043e\u0440\u0433\u0430\u043d\u0441\u043a\u0430 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u045a\u0430 \u043d\u0438\u0458\u0435 \u0435\u043a\u0441\u043f\u043b\u0438\u0446\u0438\u0442\u043d\u043e \u043f\u043e\u043c\u0435\u043d\u0443\u0442\u0430 \u0443 \u0410\u0433\u0435\u043d\u0434\u0438 2030, \u0415\u0423 \u0441\u043c\u0430\u0442\u0440\u0430 \u043e\u0440\u0433\u0430\u043d\u0441\u043a\u0443 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u045a\u0443 \u043c\u0435\u0442\u043e\u0434\u043e\u043c \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u045a\u0435 \u043a\u043e\u0458\u0430 \u0441\u0442\u0430\u0432\u0459\u0430 \u043d\u0430\u0458\u0432\u0435\u045b\u0438 \u043d\u0430\u0433\u043b\u0430\u0441\u0430\u043a \u043d\u0430 \u0437\u0430\u0448\u0442\u0438\u0442\u0443 \u0436\u0438\u0432\u043e\u0442\u043d\u0435 \u0441\u0440\u0435\u0434\u0438\u043d\u0435 \u0438 \u0434\u0438\u0432\u0459\u0438\u0445 \u0432\u0440\u0441\u0442\u0430, \u0430 \u0443 \u043f\u043e\u0433\u043b\u0435\u0434\u0443 \u0441\u0442\u043e\u0447\u0430\u0440\u0441\u043a\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u045a\u0435, \u043d\u0430 \u043f\u0438\u0442\u0430\u045a\u0430 \u0434\u043e\u0431\u0440\u043e\u0431\u0438\u0442\u0438 \u0436\u0438\u0432\u043e\u0442\u0438\u045a\u0430. \u040a\u043e\u043c\u0435 \u0441\u0435 \u0438\u0437\u0431\u0458\u0435\u0433\u0430\u0432\u0430 \u0438\u043b\u0438 \u0443 \u0432\u0435\u043b\u0438\u043a\u043e\u0458 \u043c\u0458\u0435\u0440\u0438 \u0441\u043c\u0430\u045a\u0443\u0458\u0435 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0430 \u0441\u0438\u043d\u0442\u0435\u0442\u0438\u0447\u043a\u0438\u0445 \u0445\u0435\u043c\u0438\u0458\u0441\u043a\u0438\u0445 \u0438\u043d\u043f\u0443\u0442\u0430 \u043a\u0430\u043e \u0448\u0442\u043e \u0441\u0443 \u0452\u0443\u0431\u0440\u0438\u0432\u0430, \u043f\u0435\u0441\u0442\u0438\u0446\u0438\u0434\u0438, \u0430\u0434\u0438\u0442\u0438\u0432\u0438 \u0438 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438. \u041f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u045a\u0430 \u0433\u0435\u043d\u0435\u0442\u0441\u043a\u0438 \u043c\u043e\u0434\u0438\u0444\u0438\u043a\u043e\u0432\u0430\u043d\u0438\u0445 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u043c\u0430 (\u0413\u041c\u041e) \u0438 \u045a\u0438\u0445\u043e\u0432\u0430 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0430 \u0443 \u0438\u0441\u0445\u0440\u0430\u043d\u0438 \u0436\u0438\u0432\u043e\u0442\u0438\u045a\u0430 \u0441\u0443 \u0437\u0430\u0431\u0440\u0430\u045a\u0435\u043d\u0438. \u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0430 \u0437\u0430 \u0431\u0438\u043e\u0434\u0438\u0432\u0435\u0440\u0437\u0438\u0442\u0435\u0442 \u0434\u043e 2030. \u0433\u043e\u0434\u0438\u043d\u0435 \u043a\u0459\u0443\u0447\u043d\u0430 \u0458\u0435 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u0430 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u043e\u0433 \u0437\u0435\u043b\u0435\u043d\u043e\u0433 \u043f\u043b\u0430\u043d\u0430. \u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0430 \u0438\u043c\u0430 \u0437\u0430 \u0446\u0438\u0459 \u0441\u043c\u0430\u045a\u0435\u045a\u0435 \u0443\u043f\u043e\u0442\u0440