43 \u0434\u043e\u0431\u0438 \u043e\u0434 15 \u0434\u043e 29 \u0433\u043e\u0434\u0438\u043d\u0430 \u043a\u043e\u0458\u0430 \u043d\u0438\u0441\u0443 \u0437\u0430\u043f\u043e\u0441\u043b\u0435\u043d\u0430 \u0438 \u043d\u0438\u0441\u0443 \u0443\u043a\u0459\u0443\u0447\u0435\u043d\u0430 \u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0435 \u0438\u043b\u0438 \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0435. \u0423 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0458\u0443 \u043c\u043b\u0430\u0434\u0438\u0445 \u043a\u043e\u0458\u0438 \u043d\u0438\u0441\u0443 \u0443 \u0437\u0430\u043f\u043e\u0441\u043b\u0435\u045a\u0443, \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438\u043b\u0438 \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0443 (NEET) \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443 \u0441\u0435 \u043b\u0438\u0446\u0430 \u043a\u043e\u0458\u0430 \u043d\u0438\u0441\u0443 \u0437\u0430\u043f\u043e\u0441\u043b\u0435\u043d\u0430 \u0438 \u043a\u043e\u0458\u0430 \u043d\u0438\u0441\u0443 \u0443\u0447\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0430 \u0443 \u0444\u043e\u0440\u043c\u0430\u043b\u043d\u043e\u043c \u0438\u043b\u0438 \u043d\u0435\u0444\u043e\u0440\u043c\u0430\u043b\u043d\u043e\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438\u043b\u0438 \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0443 \u0442\u043e\u043a\u043e\u043c \u0447\u0435\u0442\u0438\u0440\u0438 \u0441\u0435\u0434\u043c\u0438\u0446\u0435 \u043a\u043e\u0458\u0435 \u043f\u0440\u0435\u0442\u0445\u043e\u0434\u0435 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0443.","national_rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043f\u0440\u0435\u043c\u0430 \u0446\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 8 \u2013 \u0414\u043e\u0441\u0442\u043e\u0458\u0430\u043d\u0441\u0442\u0432\u0435\u043d \u0440\u0430\u0434 \u0438 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0438 \u0440\u0430\u0441\u0442, \u043a\u0430\u043e \u0438 \u043f\u0440\u0435\u043c\u0430 \u0446\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 4 \u2013 \u041a\u0432\u0430\u043b\u0438\u0442\u0435\u0442\u043d\u043e \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0435. \u041f\u043e\u0441\u0435\u0431\u043d\u043e \u0443\u043a\u0430\u0437\u0443\u0458\u0435 \u043d\u0430 \u043f\u043e\u043b\u043e\u0436\u0430\u0458 \u043c\u043b\u0430\u0434\u0438\u0445 \u043a\u043e\u0458\u0438 \u043d\u0438\u0441\u0443 \u0443\u043a\u0459\u0443\u0447\u0435\u043d\u0438 \u043d\u0438 \u0443 \u0442\u0440\u0436\u0438\u0448\u0442\u0435 \u0440\u0430\u0434\u0430 \u043d\u0438 \u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0435 \u0438\u043b\u0438 \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0435 \u0438 \u043c\u043e\u0436\u0435 \u0443\u043a\u0430\u0437\u0438\u0432\u0430\u0442\u0438 \u043d\u0430 \u043f\u043e\u0442\u0435\u0448\u043a\u043e\u045b\u0435 \u0443 \u043f\u0440\u0435\u043b\u0430\u0441\u043a\u0443 \u0438\u0437 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0430 \u0443 \u0437\u0430\u043f\u043e\u0441\u043b\u0435\u045a\u0435. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043c\u043e\u0436\u0435 \u0441\u043c\u0430\u0442\u0440\u0430\u0442\u0438 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u0438\u043c \u0441 \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u0438\u043c \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u043e\u043c SDG 8.6.1 \u201e\u0423\u0434\u0438\u043e \u043c\u043b\u0430\u0434\u0438\u0445 (15\u201324 \u0433\u043e\u0434\u0438\u043d\u0435) \u043a\u043e\u0458\u0438 \u043d\u0438\u0441\u0443 \u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443, \u0437\u0430\u043f\u043e\u0441\u043b\u0435\u045a\u0443 \u0438\u043b\u0438 \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0443\u201c.","national_methodology_characteristics":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043c\u0458\u0435\u0440\u0438 \u0443\u0434\u0438\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u0430 \u0443 \u0434\u043e\u0431\u0438 \u043e\u0434 15 \u0434\u043e 29 \u0433\u043e\u0434\u0438\u043d\u0430 \u043a\u043e\u0458\u0435 \u043d\u0438\u0458\u0435 \u0437\u0430\u043f\u043e\u0441\u043b\u0435\u043d\u043e \u0438 \u043d\u0438\u0458\u0435 \u0443\u043a\u0459\u0443\u0447\u0435\u043d\u043e \u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0435 \u0438\u043b\u0438 \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0435. \u041b\u0438\u0446\u0435 \u0441\u0435 \u0441\u043c\u0430\u0442\u0440\u0430 NEET \u043b\u0438\u0446\u0435\u043c \u0430\u043a\u043e \u043d\u0438\u0458\u0435 \u0437\u0430\u043f\u043e\u0441\u043b\u0435\u043d\u043e, \u043e\u0434\u043d\u043e\u0441\u043d\u043e \u0430\u043a\u043e \u0458\u0435 \u043d\u0435\u0437\u0430\u043f\u043e\u0441\u043b\u0435\u043d\u043e \u0438\u043b\u0438 \u0438\u0437\u0432\u0430\u043d \u0440\u0430\u0434\u043d\u0435 \u0441\u043d\u0430\u0433\u0435 \u043f\u0440\u0435\u043c\u0430 \u0434\u0435\u0444\u0438\u043d\u0438\u0446\u0438\u0458\u0438 \u041c\u0435\u0452\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0435 \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0458\u0435 \u0440\u0430\u0434\u0430, \u0438 \u0430\u043a\u043e \u043d\u0438\u0458\u0435 \u0443\u0447\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u043e \u0443 \u0444\u043e\u0440\u043c\u0430\u043b\u043d\u043e\u043c \u0438\u043b\u0438 \u043d\u0435\u0444\u043e\u0440\u043c\u0430\u043b\u043d\u043e\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438\u043b\u0438 \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0443 \u0442\u043e\u043a\u043e\u043c \u0447\u0435\u0442\u0438\u0440\u0438 \u0441\u0435\u0434\u043c\u0438\u0446\u0435 \u043a\u043e\u0458\u0435 \u043f\u0440\u0435\u0442\u0445\u043e\u0434\u0435 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0443. \u0421\u043c\u0430\u045a\u0435\u045a\u0435 \u0443\u0434\u0458\u0435\u043b\u0430 \u043c\u043b\u0430\u0434\u0438\u0445 \u043a\u043e\u0458\u0438 \u043d\u0438\u0441\u0443 \u0443 \u0437\u0430\u043f\u043e\u0441\u043b\u0435\u045a\u0443, \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438\u043b\u0438 \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0443 \u0443\u043a\u0430\u0437\u0443\u0458\u0435 \u043d\u0430 \u043f\u043e\u0431\u043e\u0459\u0448\u0430\u045a\u0435 \u0443\u043a\u0459\u0443\u0447\u0438\u0432\u0430\u045a\u0430 \u043c\u043b\u0430\u0434\u0438\u0445 \u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0435, \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0435 \u0438 \u0442\u0440\u0436\u0438\u0448\u0442\u0435 \u0440\u0430\u0434\u0430.","national_long_objective":"\u0414\u0443\u0433\u043e\u0440\u043e\u0447\u043d\u0438 \u0446\u0438\u0459 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u0443\u043d\u0438\u0458\u0435 \u0458\u0435 \u0441\u043c\u0430\u045a\u0438\u0442\u0438 \u0441\u0442\u043e\u043f\u0443 \u043c\u043b\u0430\u0434\u0438\u0445 \u0443 \u0434\u043e\u0431\u0438 \u043e\u0434 15 \u0434\u043e 29 \u0433\u043e\u0434\u0438\u043d\u0430 \u043a\u043e\u0458\u0438 \u043d\u0438\u0441\u0443 \u0443 \u0437\u0430\u043f\u043e\u0441\u043b\u0435\u045a\u0443, \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438\u043b\u0438 \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0443 \u043d\u0430 9% \u0434\u043e 2030. \u0433\u043e\u0434\u0438\u043d\u0435.","eu_indicator_definition":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043f\u043e\u043a\u0430\u0437\u0443\u0458\u0435 \u0443\u0434\u0438\u043e \u043c\u043b\u0430\u0434\u0438\u0445 \u043b\u0438\u0446\u0430 \u0443 \u0434\u043e\u0431\u0438 \u043e\u0434 15 \u0434\u043e 29 \u0433\u043e\u0434\u0438\u043d\u0430 \u043a\u043e\u0458\u0430 \u043d\u0438\u0441\u0443 \u0437\u0430\u043f\u043e\u0441\u043b\u0435\u043d\u0430 \u0438 \u043d\u0438\u0441\u0443 \u0443\u043a\u0459\u0443\u0447\u0435\u043d\u0430 \u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0435 \u0438\u043b\u0438 \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0435. \u0423 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0458\u0443 \u043c\u043b\u0430\u0434\u0438\u0445 \u043a\u043e\u0458\u0438 \u043d\u0438\u0441\u0443 \u0443 \u0437\u0430\u043f\u043e\u0441\u043b\u0435\u045a\u0443, \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438\u043b\u0438 \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0443 (NEET) \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443 \u0441\u0435 \u043b\u0438\u0446\u0430 \u043a\u043e\u0458\u0430 \u043d\u0438\u0441\u0443 \u0437\u0430\u043f\u043e\u0441\u043b\u0435\u043d\u0430 \u0438 \u043a\u043e\u0458\u0430 \u043d\u0438\u0441\u0443 \u0443\u0447\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u043b\u0430 \u0443 \u0444\u043e\u0440\u043c\u0430\u043b\u043d\u043e\u043c \u0438\u043b\u0438 \u043d\u0435\u0444\u043e\u0440\u043c\u0430\u043b\u043d\u043e\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0443 \u0438\u043b\u0438 \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0443 \u0442\u043e\u043a\u043e\u043c \u0447\u0435\u0442\u0438\u0440\u0438 \u0441\u0435\u0434\u043c\u0438\u0446\u0435 \u043a\u043e\u0458\u0435 \u043f\u0440\u0435\u0442\u0445\u043e\u0434\u0435 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0443.","eu_rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043f\u0440\u0435\u043c\u0430 \u0446\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 8 \u2013 \u0414\u043e\u0441\u0442\u043e\u0458\u0430\u043d\u0441\u0442\u0432\u0435\u043d \u0440\u0430\u0434 \u0438 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0438 \u0440\u0430\u0441\u0442, \u043a\u0430\u043e \u0438 \u043f\u0440\u0435\u043c\u0430 \u0446\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 4 \u2013 \u041a\u0432\u0430\u043b\u0438\u0442\u0435\u0442\u043d\u043e \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0435. \u041f\u043e\u0441\u0435\u0431\u043d\u043e \u0443\u043a\u0430\u0437\u0443\u0458\u0435 \u043d\u0430 \u043f\u043e\u043b\u043e\u0436\u0430\u0458 \u043c\u043b\u0430\u0434\u0438\u0445 \u043a\u043e\u0458\u0438 \u043d\u0438\u0441\u0443 \u0443\u043a\u0459\u0443\u0447\u0435\u043d\u0438 \u043d\u0438 \u0443 \u0442\u0440\u0436\u0438\u0448\u0442\u0435 \u0440\u0430\u0434\u0430 \u043d\u0438 \u0443 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0435 \u0438\u043b\u0438 \u043e\u0441\u043f\u043e\u0441\u043e\u0431\u0459\u0430\u0432\u0430\u045a\u0435 \u0438 \u043c\u043e\u0436\u0435 \u0443\u043a\u0430\u0437\u0438\u0432\u0430\u0442\u0438 \u043d\u0430 \u043f\u043e\u0442\u0435\u0448\u043a\u043e\u045b\u0435 \u0443 \u043f\u0440\u0435\u043b\u0430\u0441\u043a\u0443 \u0438\u0437 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0430 \u0443 \u0437\u0430\u043f\u043e\u0441\u043b\u0435\u045a\u0435. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043c\u043e\u0436\u0435 \u0441\u043c\u0430\u0442\u0440\u0430\u0442\u0438 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u0438\u043c \u0441 \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u0438\u043c \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u043e\u043c SDG 8.6.1 \u201e\u0423\u0434\u0438\u043e \u043c\u043b\u0430\u0434\u0438\u0445 (15\u20132