 \u0447\u043b\u0430\u043d\u0438\u0446\u0430 \u0438\u043b\u0438 \u0415\u0432\u0440\u043e\u043f\u0435, \u0415\u0423 \u0440\u0430\u0434\u0438 \u043d\u0430 \u043e\u0431\u0435\u0437\u0431\u0435\u0452\u0438\u0432\u0430\u045a\u0443 \u0458\u0430\u0447\u0435\u0433 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0443\u043f\u0440\u0430\u0432\u0459\u0430\u045a\u0430 \u043e\u043a\u0435\u0430\u043d\u0438\u043c\u0430 \u043a\u0430\u043a\u043e \u0431\u0438 \u0441\u0435 \u043f\u043e\u0441\u0442\u0438\u0433\u043b\u043e \u043e\u0447\u0443\u0432\u0430\u045a\u0435 \u0438 \u043e\u0434\u0440\u0436\u0438\u0432\u043e \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u045a\u0435 \u0440\u0435\u0433\u0438\u043e\u043d\u0430\u043b\u043d\u0438\u0445 \u0438 \u043c\u0435\u0452\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0438\u0445 \u0432\u043e\u0434\u0430. \u0415\u0423 \u0442\u0430\u043a\u043e\u0452\u0435 \u0438\u043c\u0430 \u043d\u0438\u0437 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0430 \u0443\u0441\u043c\u0435\u0440\u0435\u043d\u0438\u0445 \u043d\u0430 \u0443\u0431\u043b\u0430\u0436\u0430\u0432\u0430\u045a\u0435 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0438\u0445 \u043f\u0440\u043e\u043c\u0435\u043d\u0430 \u0438 \u0441\u043c\u0430\u045a\u0435\u045a\u0435 \u0435\u043c\u0438\u0441\u0438\u0458\u0435 \u0433\u0430\u0441\u043e\u0432\u0430 \u0441\u0442\u0430\u043a\u043b\u0435\u043d\u0435 \u0431\u0430\u0448\u0442\u0435, \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443\u045b\u0438 CO2.","target_number":"14.50","goal_number":"14"}