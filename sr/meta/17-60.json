{"indicator_number":17.6,"reporting_status":"complete","published":true,"sdg_goal":"17","data_non_statistical":false,"graph_type":"bar","indicator_sort_order":"17-60","indicator_name":"\u041f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u043e\u0441\u0442 \u0431\u0440\u0437\u0438\u043c \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u043e\u043c \u043f\u0440\u0435\u043c\u0430 \u0432\u0440\u0441\u0442\u0438 \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0430","source_active_1":true,"source_organisation_1":"ITU, World Bank","source_url_1":"https://data.stateglobe.com/bosnia-and-herzegovina/fiber-optic-coverage-statistics","graph_titles":[{"series":"\u041f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u043e\u0441\u0442 \u0431\u0440\u0437\u0438\u043c \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u043e\u043c \u043f\u0440\u0435\u043c\u0430 \u0432\u0440\u0441\u0442\u0438 \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0430","title":"\u041f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u043e\u0441\u0442 \u0431\u0440\u0437\u0438\u043c \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u043e\u043c \u043f\u0440\u0435\u043c\u0430 \u0432\u0440\u0441\u0442\u0438 \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0430"}],"national_indicator_definition":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043c\u0458\u0435\u0440\u0438 \u0443\u0434\u0438\u043e \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0430\u0432\u0430 \u0441\u0430 \u0444\u0438\u043a\u0441\u043d\u043e\u043c \u0432\u0435\u0437\u043e\u043c \u043d\u0430 \u043c\u0440\u0435\u0436\u0443 \u0432\u0435\u043e\u043c\u0430 \u0432\u0438\u0441\u043e\u043a\u043e\u0433 \u043a\u0430\u043f\u0430\u0446\u0438\u0442\u0435\u0442\u0430 (VHCN). \u041c\u0440\u0435\u0436\u0430 \u0432\u0435\u043e\u043c\u0430 \u0432\u0438\u0441\u043e\u043a\u043e\u0433 \u043a\u0430\u043f\u0430\u0446\u0438\u0442\u0435\u0442\u0430 \u0458\u0435 \u0438\u043b\u0438 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u0441\u043a\u0430 \u043a\u043e\u043c\u0443\u043d\u0438\u043a\u0430\u0446\u0438\u043e\u043d\u0430 \u043c\u0440\u0435\u0436\u0430 \u043a\u043e\u0458\u0430 \u0441\u0435 \u0443 \u043f\u043e\u0442\u043f\u0443\u043d\u043e\u0441\u0442\u0438 \u0441\u0430\u0441\u0442\u043e\u0458\u0438 \u043e\u0434 \u043e\u043f\u0442\u0438\u0447\u043a\u0438\u0445 \u0432\u043b\u0430\u043a\u0430\u043d\u0430 \u0431\u0430\u0440\u0435\u043c \u0434\u043e \u0434\u0438\u0441\u0442\u0440\u0438\u0431\u0443\u0442\u0438\u0432\u043d\u0435 \u0442\u0430\u0447\u043a\u0435 \u043d\u0430 \u043b\u043e\u043a\u0430\u0446\u0438\u0458\u0438 \u0443\u0441\u043b\u0443\u0433\u0435, \u0438\u043b\u0438 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u0441\u043a\u0430 \u043a\u043e\u043c\u0443\u043d\u0438\u043a\u0430\u0446\u0438\u043e\u043d\u0430 \u043c\u0440\u0435\u0436\u0430 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u0430 \u0434\u0430 \u043e\u0431\u0435\u0437\u0431\u0435\u0434\u0438, \u043f\u043e\u0434 \u043d\u043e\u0440\u043c\u0430\u043b\u043d\u0438\u043c \u0443\u0441\u043b\u043e\u0432\u0438\u043c\u0430 \u0432\u0440\u0448\u043d\u043e\u0433 \u043e\u043f\u0442\u0435\u0440\u0435\u045b\u0435\u045a\u0430, \u0441\u043b\u0438\u0447\u043d\u0435 \u043c\u0440\u0435\u0436\u043d\u0435 \u043f\u0435\u0440\u0444\u043e\u0440\u043c\u0430\u043d\u0441\u0435 \u0443 \u0441\u043c\u0438\u0441\u043b\u0443 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0438\u0432\u043e\u0433 \u043d\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0433 \u0438 \u0443\u0437\u0432\u043e\u0434\u043d\u043e\u0433 \u043f\u0440\u043e\u043f\u0443\u0441\u043d\u043e\u0433 \u043e\u043f\u0441\u0435\u0433\u0430, \u043e\u0442\u043f\u043e\u0440\u043d\u043e\u0441\u0442\u0438, \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0430\u0440\u0430 \u0432\u0435\u0437\u0430\u043d\u0438\u0445 \u0437\u0430 \u0433\u0440\u0435\u0448\u043a\u0435 \u0438 \u043b\u0430\u0442\u0435\u043d\u0446\u0438\u0458\u0435 \u0438 \u045a\u0435\u043d\u0438\u0445 \u0432\u0430\u0440\u0438\u0458\u0430\u0446\u0438\u0458\u0430. \u041f\u043e\u0434\u0430\u0446\u0438 \u0441\u0435 \u043e\u0434\u043d\u043e\u0441\u0435 \u0438 \u043d\u0430 \u043e\u043f\u0442\u0438\u0447\u043a\u043e \u0432\u043b\u0430\u043a\u043d\u043e \u0434\u043e \u043f\u0440\u043e\u0441\u0442\u043e\u0440\u0438\u0458\u0430 (FTTP) \u0438 \u043d\u0430 \u0421\u043f\u0435\u0446\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0458\u0443 \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0458\u0441\u0430 \u0437\u0430 \u0443\u0441\u043b\u0443\u0433\u0435 \u043f\u0440\u0435\u043d\u043e\u0441\u0430 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u043f\u0440\u0435\u043a\u043e \u043a\u0430\u0431\u043b\u0430 (DOCSIS) 3.1. DOCSIS \u043e\u043c\u043e\u0433\u0443\u045b\u0430\u0432\u0430 \u0434\u043e\u0434\u0430\u0432\u0430\u045a\u0435 \u043f\u0440\u0435\u043d\u043e\u0441\u0430 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u0432\u0435\u043b\u0438\u043a\u043e\u0433 \u043f\u0440\u043e\u043f\u0443\u0441\u043d\u043e\u0433 \u043e\u043f\u0441\u0435\u0433\u0430 \u043f\u043e\u0441\u0442\u043e\u0458\u0435\u045b\u0438\u043c \u0441\u0438\u0441\u0442\u0435\u043c\u0438\u043c\u0430 \u043a\u0430\u0431\u043b\u043e\u0432\u0441\u043a\u0435 \u0442\u0435\u043b\u0435\u0432\u0438\u0437\u0438\u0458\u0435. \u201e\u0420\u0443\u0440\u0430\u043b\u043d\u0430 \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0430\u201c \u0441\u0443 \u0434\u0435\u0444\u0438\u043d\u0438\u0441\u0430\u043d\u0430 \u043a\u0430\u043e \u043e\u043d\u0430 \u0441\u0430 \u043c\u0430\u045a\u0435 \u043e\u0434 100 \u0459\u0443\u0434\u0438 \u043f\u043e \u043a\u043c\u00b2.","national_rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u0430 \u0426\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 17 \u043e \u0440\u0435\u0432\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0458\u0438 \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e\u0433 \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0441\u0442\u0432\u0430 \u0437\u0430 \u043e\u0434\u0440\u0436\u0438\u0432\u0438 \u0440\u0430\u0437\u0432\u043e\u0458 \u0438 \u0426\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 9 \u043e \u0438\u043d\u0434\u0443\u0441\u0442\u0440\u0438\u0458\u0438, \u0438\u043d\u043e\u0432\u0430\u0446\u0438\u0458\u0430\u043c\u0430 \u0438 \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0438. \u0426\u0438\u0459\u0435\u0432\u0438 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 9 \u0438 17 \u0441\u0443 \u0443\u0433\u0440\u0430\u0452\u0435\u043d\u0438 \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u201e\u041d\u043e\u0432\u0430 \u0435\u0440\u0430 \u0437\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0443 \u043e\u0434\u0431\u0440\u0430\u043d\u0443 \u0438 \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442\u201c. \u0426\u0438\u0459 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 17 \u0458\u0435 \u0442\u0430\u043a\u043e\u0452\u0435 \u0443\u0433\u0440\u0430\u0452\u0435\u043d \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u201e\u0417\u0430\u0448\u0442\u0438\u0442\u0430 \u043d\u0430\u0448\u0438\u0445 \u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u0458\u0430, \u043e\u0434\u0440\u0436\u0430\u0432\u0430\u045a\u0435 \u043d\u0430\u0448\u0438\u0445 \u0432\u0440\u0435\u0434\u043d\u043e\u0441\u0442\u0438\u201c. \u041f\u0440\u0438\u043f\u0440\u0435\u043c\u0430 \u0415\u0432\u0440\u043e\u043f\u0435 \u0437\u0430 \u0434\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u043e \u0434\u043e\u0431\u0430 \u0458\u0435 \u0441\u0442\u043e\u0433\u0430 \u0458\u0435\u0434\u0430\u043d \u043e\u0434 \u0448\u0435\u0441\u0442 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0430 \u041a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u0437\u0430 \u043f\u0435\u0440\u0438\u043e\u0434 2019\u20132024. \u0426\u0438\u0459 \u0458\u0435 \u0434\u0430 \u0434\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u0430 \u0442\u0440\u0430\u043d\u0441\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0458\u0430 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0438\u0448\u0435 \u0437\u0430 \u0459\u0443\u0434\u0435 \u0438 \u043f\u0440\u0435\u0434\u0443\u0437\u0435\u045b\u0430, \u0430 \u0438\u0441\u0442\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043e \u043f\u043e\u043c\u043e\u0433\u043d\u0435 \u0443 \u043f\u043e\u0441\u0442\u0438\u0437\u0430\u045a\u0443 \u0446\u0438\u0459\u0430 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0438 \u043d\u0435\u0443\u0442\u0440\u0430\u043b\u043d\u0435 \u0415\u0432\u0440\u043e\u043f\u0435 \u0434\u043e 2050. \u0433\u043e\u0434\u0438\u043d\u0435. \u0426\u0438\u0459 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 17 \u043f\u0440\u0435\u043f\u043e\u0437\u043d\u0430\u0458\u0435 \u0432\u0430\u0436\u043d\u043e\u0441\u0442 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430 \u043d\u0430\u0443\u0446\u0438, \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0458\u0438 \u0438 \u0438\u043d\u043e\u0432\u0430\u0446\u0438\u0458\u0430\u043c\u0430 \u0437\u0430 \u043e\u0434\u0440\u0436\u0438\u0432\u0438 \u0440\u0430\u0437\u0432\u043e\u0458. \u0411\u0440\u043e\u0458 \u043f\u0440\u0435\u0442\u043f\u043b\u0430\u0442\u0430 \u043d\u0430 \u0448\u0438\u0440\u043e\u043a\u043e\u043f\u043e\u0458\u0430\u0441\u043d\u0438 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442 \u043d\u0430 100 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0430 \u0458\u0435\u0434\u0430\u043d \u0458\u0435 \u043e\u0434 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u043a\u043e\u0458\u0435 \u0423\u041d \u043a\u043e\u0440\u0438\u0441\u0442\u0435 \u0437\u0430 \u043c\u0435\u0440\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u0430 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u043e\u043c \u0446\u0438\u0459\u0443. \u0423 \u0441\u0432\u043e\u0458\u043e\u0458 \u0414\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u043e\u0458 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0438 \u0437\u0430 2020. \u0433\u043e\u0434\u0438\u043d\u0443, \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0430 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0430 \u0458\u0435 \u0438\u0441\u0442\u0430\u043a\u043b\u0430 \u043f\u043e\u0441\u0432\u0435\u045b\u0435\u043d\u043e\u0441\u0442 \u0415\u0423 \u0440\u0430\u0437\u0432\u043e\u0458\u0443 \u0413\u043b\u043e\u0431\u0430\u043b\u043d\u0435 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0435 \u0437\u0430 \u0434\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u0443 \u0441\u0430\u0440\u0430\u0434\u045a\u0443, \u043a\u043e\u0458\u0430 \u045b\u0435 \u043e\u0434\u0440\u0430\u0436\u0430\u0432\u0430\u0442\u0438 \u0446\u0438\u0459\u0435\u0432\u0435 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430.","national_methodology_characteristics":"\u0423 \u0441\u0432\u043e\u0458\u043e\u0458 \u043a\u043e\u043c\u0443\u043d\u0438\u043a\u0430\u0446\u0438\u0458\u0438 \u0438\u0437 2016. \u0433\u043e\u0434\u0438\u043d\u0435 \u043f\u043e\u0434 \u043d\u0430\u0437\u0438\u0432\u043e\u043c \u201e\u041f\u043e\u0432\u0435\u0437\u0438\u0432\u0430\u045a\u0435 \u0437\u0430 \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u043d\u043e \u0458\u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043e \u0434\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u043e \u0442\u0440\u0436\u0438\u0448\u0442\u0435 \u2013 \u043a\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u043e\u043c \u0433\u0438\u0433\u0430\u0431\u0438\u0442\u043d\u043e\u043c \u0434\u0440\u0443\u0448\u0442\u0432\u0443\u201c, \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0430 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0430 \u0458\u0435 \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0430 \u0432\u0438\u0437\u0438\u0458\u0443 \u0437\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u043e \u0433\u0438\u0433\u0430\u0431\u0438\u0442\u043d\u043e \u0434\u0440\u0443\u0448\u0442\u0432\u043e, \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u0443 \u043a\u0440\u043e\u0437 \u0442\u0440\u0438 \u0446\u0438\u0459\u0430 \u0437\u0430 2025. \u0433\u043e\u0434\u0438\u043d\u0443. \u0415\u0423 \u0442\u0435\u0436\u0438 \u0433\u0438\u0433\u0430\u0431\u0438\u0442\u043d\u043e\u0458 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u043e\u0441\u0442\u0438 \u0437\u0430 \u043c\u0435\u0441\u0442\u0430 \u043a\u043e\u0458\u0430 \u043f\u043e\u043a\u0440\u0435\u045b\u0443 \u0434\u0440\u0443\u0448\u0442\u0432\u0435\u043d\u043e-\u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0438 \u0440\u0430\u0437\u0432\u043e\u0458, 5\u0413 \u043f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u043e\u0441\u0442\u0438 \u0437\u0430 \u0441\u0432\u0430 \u0443\u0440\u0431\u0430\u043d\u0430 \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0430 \u0438 \u0441\u0432\u0435 \u0433\u043b\u0430\u0432\u043d\u0435 \u043a\u043e\u043f\u043d\u0435\u043d\u0435 \u0441\u0430\u043e\u0431\u0440\u0430\u045b\u0430\u0458\u043d\u0435 \u0440\u0443\u0442\u0435 \u0438 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0443 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442 \u043a\u043e\u043d\u0435\u043a\u0446\u0438\u0458\u0438 \u043e\u0434 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 100 Mbps \u0437\u0430 \u0441\u0432\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0430 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0432\u0430. \u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0430 \u201e\u041e\u0434 \u0444\u0430\u0440\u043c\u0435 \u0434\u043e \u0442\u0440\u043f\u0435\u0437\u0435\u201c \u043f\u043e\u0442\u0432\u0440\u0434\u0438\u043b\u0430 \u0458\u0435 \u043e\u0432\u0430\u0458 \u0446\u0438\u0459 \u043f\u043e\u0437\u0438\u0432\u0430\u0458\u0443\u045b\u0438 \u043d\u0430 \u0443\u0431\u0440\u0437\u0430\u045a\u0435 \u0443\u0432\u043e\u0452\u0435\u045a\u0430 \u0431\u0440\u0437\u043e\u0433 \u0448\u0438\u0440\u043e\u043a\u043e\u043f\u043e\u0458\u0430\u0441\u043d\u043e\u0433 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u0430 \u0443 \u0440\u0443\u0440\u0430\u043b\u043d\u0438\u043c \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0438\u043c\u0430 \u043a\u0430\u043a\u043e \u0431\u0438 \u0441\u0435 \u043f\u043e\u0441\u0442\u0438\u0433\u0430\u043e \u0446\u0438\u0459 \u043e\u0434 100% \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430 \u0434\u043e 2025. \u0433\u043e\u0434\u0438\u043d\u0435. \u0423 \u043c\u0430\u0440\u0442\u0443 2021. \u0433\u043e\u0434\u0438\u043d\u0435, \u041a\u043e\u043c\u0438\u0441\u0438\u0458\u0430 \u0458\u0435 \u2013 \u0443 \u0441\u0432\u043e\u043c \u0414\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u043e\u043c \u043a\u043e\u043c\u043f\u0430\u0441\u0443 2030 \u2013 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b\u0430 \u0432\u0438\u0437\u0438\u0458\u0443 \u0438 \u043f\u0443\u0442\u0435\u0432\u0435 \u0437\u0430 \u0434\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u0443 \u0442\u0440\u0430\u043d\u0441\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0458\u0443 \u0415\u0432\u0440\u043e\u043f\u0435 \u0434\u043e 2030. \u0433\u043e\u0434\u0438\u043d\u0435, \u0444\u043e\u043a\u0443\u0441\u0438\u0440\u0430\u0458\u0443\u045b\u0438 \u0441\u0435 \u043d\u0430 \u0447\u0435\u0442\u0438\u0440\u0438 \u0433\u043b\u0430\u0432\u043d\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438: (1) \u0432\u0435\u0448\u0442\u0438\u043d\u0435, (2) \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u0430 \u0438 \u043e\u0434\u0440\u0436\u0438\u0432\u0430 \u0434\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u0430 \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430, (3) \u0434\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u0430 \u0442\u0440\u0430\u043d\u0441\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0458\u0430 \u043f\u0440\u0435\u0434\u0443\u0437\u0435\u045b\u0430 \u0438 (4) \u0434\u0438\u0433\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0458\u0430 \u0458\u0430\u0432\u043d\u0438\u0445 \u0443\u0441\u043b\u0443\u0433\u0430.","national_long_objective":"\u041d\u0430\u0434\u043e\u0432\u0435\u0437\u0443\u0458\u0443\u045b\u0438 \u0441\u0435 \u043d\u0430 \u0421\u0430\u043e\u043f\u0448\u0442\u0435\u045a\u0435 \u0438\u0437 2016. \u0433\u043e\u0434\u0438\u043d\u0435, \u0414\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u0438 \u043a\u043e\u043c\u043f\u0430\u0441 \u0434\u0435\u0444\u0438\u043d\u0438\u0448\u0435 \u0446\u0438\u0459 \u0434\u0430 \u0434\u043e 2030. \u0433\u043e\u0434\u0438\u043d\u0435 \u0441\u0432\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0430 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0432\u0430 \u0431\u0443\u0434\u0443 \u043f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u0430 \u0433\u0438\u0433\u0430\u0431\u0438\u0442\u043d\u043e\u043c \u043c\u0440\u0435\u0436\u043e\u043c, \u0430 \u0441\u0432\u0430 \u043d\u0430\u0441\u0435\u0459\u0435\u043d\u0430 \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0430 5G \u043c\u0440\u0435\u0436\u043e\u043c.","eu_indicator_definition":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043c\u0458\u0435\u0440\u0438 \u0443\u0434\u0438\u043e \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0430\u0432\u0430 \u0441\u0430 \u0444\u0438\u043a\u0441\u043d\u043e\u043c \u0432\u0435\u0437\u043e\u043c \u043d\u0430 \u043c\u0440\u0435\u0436\u0443 \u0432\u0435\u043e\u043c\u0430 \u0432\u0438\u0441\u043e\u043a\u043e\u0433 \u043a\u0430\u043f\u0430\u0446\u0438\u0442\u0435\u0442\u0430 (VHCN). \u041c\u0440\u0435\u0436\u0430 \u0432\u0435\u043e\u043c\u0430 \u0432\u0438\u0441\u043e\u043a\u043e\u0433 \u043a\u0430\u043f\u0430\u0446\u0438\u0442\u0435\u0442\u0430 \u0458\u0435 \u0438\u043b\u0438 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u0441\u043a\u0430 \u043a\u043e\u043c\u0443\u043d\u0438\u043a\u0430\u0446\u0438\u043e\u043d\u0430 \u043c\u0440\u0435\u0436\u0430 \u043a\u043e\u0458\u0430 \u0441\u0435 \u0443 \u043f\u043e\u0442\u043f\u0443\u043d\u043e\u0441\u0442\u0438 \u0441\u0430\u0441\u0442\u043e\u0458\u0438 \u043e\u0434 \u043e\u043f\u0442\u0438\u0447\u043a\u0438\u0445 \u0432\u043b\u0430\u043a\u0430\u043d\u0430 \u0431\u0430\u0440\u0435\u043c \u0434\u043e \u0434\u0438\u0441\u0442\u0440\u0438\u0431\u0443\u0442\u0438\u0432\u043d\u0435 \u0442\u0430\u0447\u043a\u0435 \u043d\u0430 \u043b\u043e\u043a\u0430\u0446\u0438\u0458\u0438 \u0443\u0441\u043b\u0443\u0433\u0435, \u0438\u043b\u0438 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u0441\u043a\u0430 \u043a\u043e\u043c\u0443\u043d\u0438\u043a\u0430\u0446\u0438\u043e\u043d\u0430 \u043c\u0440\u0435\u0436\u0430 \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u0430 \u0434\u0430 \u043e\u0431\u0435\u0437\u0431\u0435\u0434\u0438, \u043f\u043e\u0434 \u043d\u043e\u0440\u043c\u0430\u043b\u043d\u0438\u043c \u0443\u0441\u043b\u043e\u0432\u0438\u043c\u0430 \u0432\u0440\u0448\u043d\u043e\u0433 \u043e\u043f\u0442\u0435\u0440\u0435\u045b\u0435\u045a\u0430, \u0441\u043b\u0438\u0447\u043d\u0435 \u043c\u0440\u0435\u0436\u043d\u0435 \u043f\u0435\u0440\u0444\u043e\u0440\u043c\u0430\u043d\u0441\u0435 \u0443 \u0441\u043c\u0438\u0441\u043b\u0443 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0438\u0432\u043e\u0433 \u043d\u0438\u0437\u0432\u043e\u0434\u043d\u043e\u0433 \u0438 \u0443\u0437\u0432\u043e\u0434\u043d\u043e\u0433 \u043f\u0440\u043e\u043f\u0443\u0441\u043d\u043e\u0433 \u043e\u043f\u0441\u0435\u0433\u0430, \u043e\u0442\u043f\u043e\u0440\u043d\u043e\u0441\u0442\u0438, \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0430\u0440\u0430 \u0432\u0435\u0437\u0430\u043d\u0438\u0445 \u0437\u0430 \u0433\u0440\u0435\u0448\u043a\u0435 \u0438 \u043b\u0430\u0442\u0435\u043d\u0446\u0438\u0458\u0435 \u0438 \u045a\u0435\u043d\u0438\u0445 \u0432\u0430\u0440\u0438\u0458\u0430\u0446\u0438\u0458\u0430. \u041f\u043e\u0434\u0430\u0446\u0438 \u0441\u0435 \u043e\u0434\u043d\u043e\u0441\u0435 \u0438 \u043d\u0430 \u043e\u043f\u0442\u0438\u0447\u043a\u043e \u0432\u043b\u0430\u043a\u043d\u043e \u0434\u043e \u043f\u0440\u043e\u0441\u0442\u043e\u0440\u0438\u0458\u0430 (FTTP) \u0438 \u043d\u0430 \u0421\u043f\u0435\u0446\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0458\u0443 \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0458\u0441\u0430 \u0437\u0430 \u0443\u0441\u043b\u0443\u0433\u0435 \u043f\u0440\u0435\u043d\u043e\u0441\u0430 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u043f\u0440\u0435\u043a\u043e \u043a\u0430\u0431\u043b\u0430 (DOCSIS) 3.1. DOCSIS \u043e\u043c\u043e\u0433\u0443\u045b\u0430\u0432\u0430 \u0434\u043e\u0434\u0430\u0432\u0430\u045a\u0435 \u043f\u0440\u0435\u043d\u043e\u0441\u0430 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u0432\u0435\u043b\u0438\u043a\u043e\u0433 \u043f\u0440\u043e\u043f\u0443\u0441\u043d\u043e\u0433 \u043e\u043f\u0441\u0435\u0433\u0430 \u043f\u043e\u0441\u0442\u043e\u0458\u0435\u045b\u0438\u043c \u0441\u0438\u0441\u0442\u0435\u043c\u0438\u043c\u0430 \u043a\u0430\u0431\u043b\u043e\u0432\u0441\u043a\u0435 \u0442\u0435\u043b\u0435\u0432\u0438\u0437\u0438\u0458\u0435. \u201e\u0420\u0443\u0440\u0430\u043b\u043d\u0430 \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0430\u201c \u0441\u0443 \u0434\u0435\u0444\u0438\u043d\u0438\u0441\u0430\u043d\u0430 \u043a\u0430\u043e \u043e\u043d\u0430 \u0441\u0430 \u043c\u0430\u045a\u0435 \u043e\u0434 100 \u0459\u0443\u0434\u0438 \u043f\u043e \u043a\u043c\u00b2.","eu_rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u0430 \u0426\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 17 \u043e \u0440\u0435\u0432\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0458\u0438 \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e\u0433 \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0441\u0442\u0432\u0430 \u0437\u0430 \u043e\u0434\u0440\u0436\u0438\u0432\u0438 \u0440\u0430\u0437\u0432\u043e\u0458 \u0438 \u0426\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 9 \u043e \u0438\u043d\u0434\u0443\u0441\u0442\u0440\u0438\u0458\u0438, \u0438\u043d\u043e\u0432\u0430\u0446\u0438\u0458\u0430\u043c\u0430 \u0438 \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0438. \u0426\u0438\u0459\u0435\u0432\u0438 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 9 \u0438 17 \u0441\u0443 \u0443\u0433\u0440\u0430\u0452\u0435\u043d\u0438 \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u201e\u041d\u043e\u0432\u0430 \u0435\u0440\u0430 \u0437\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0443 \u043e\u0434\u0431\u0440\u0430\u043d\u0443 \u0438 \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442\u201c. \u0426\u0438\u0459 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 17 \u0458\u0435 \u0442\u0430\u043a\u043e\u0452\u0435 \u0443\u0433\u0440\u0430\u0452\u0435\u043d \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u201e\u0417\u0430\u0448\u0442\u0438\u0442\u0430 \u043d\u0430\u0448\u0438\u0445 \u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u0458\u0430, \u043e\u0434\u0440\u0436\u0430\u0432\u0430\u045a\u0435 \u043d\u0430\u0448\u0438\u0445 \u0432\u0440\u0435\u0434\u043d\u043e\u0441\u0442\u0438\u201c. \u041f\u0440\u0438\u043f\u0440\u0435\u043c\u0430 \u0415\u0432\u0440\u043e\u043f\u0435 \u0437\u0430 \u0434\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u043e \u0434\u043e\u0431\u0430 \u0458\u0435 \u0441\u0442\u043e\u0433\u0430 \u0458\u0435\u0434\u0430\u043d \u043e\u0434 \u0448\u0435\u0441\u0442 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0430 \u041a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u0437\u0430 \u043f\u0435\u0440\u0438\u043e\u0434 2019\u20132024. \u0426\u0438\u0459 \u0458\u0435 \u0434\u0430 \u0434\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u0430 \u0442\u0440\u0430\u043d\u0441\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0458\u0430 \u0444\u0443\u043d\u043a\u0446\u0438\u043e\u043d\u0438\u0448\u0435 \u0437\u0430 \u0459\u0443\u0434\u0435 \u0438 \u043f\u0440\u0435\u0434\u0443\u0437\u0435\u045b\u0430, \u0430 \u0438\u0441\u0442\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043e \u043f\u043e\u043c\u043e\u0433\u043d\u0435 \u0443 \u043f\u043e\u0441\u0442\u0438\u0437\u0430\u045a\u0443 \u0446\u0438\u0459\u0430 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0438 \u043d\u0435\u0443\u0442\u0440\u0430\u043b\u043d\u0435 \u0415\u0432\u0440\u043e\u043f\u0435 \u0434\u043e 2050. \u0433\u043e\u0434\u0438\u043d\u0435. \u0426\u0438\u0459 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 17 \u043f\u0440\u0435\u043f\u043e\u0437\u043d\u0430\u0458\u0435 \u0432\u0430\u0436\u043d\u043e\u0441\u0442 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430 \u043d\u0430\u0443\u0446\u0438, \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0458\u0438 \u0438 \u0438\u043d\u043e\u0432\u0430\u0446\u0438\u0458\u0430\u043c\u0430 \u0437\u0430 \u043e\u0434\u0440\u0436\u0438\u0432\u0438 \u0440\u0430\u0437\u0432\u043e\u0458. \u0411\u0440\u043e\u0458 \u043f\u0440\u0435\u0442\u043f\u043b\u0430\u0442\u0430 \u043d\u0430 \u0448\u0438\u0440\u043e\u043a\u043e\u043f\u043e\u0458\u0430\u0441\u043d\u0438 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442 \u043d\u0430 100 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0430 \u0458\u0435\u0434\u0430\u043d \u0458\u0435 \u043e\u0434 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u043a\u043e\u0458\u0435 \u0423\u041d \u043a\u043e\u0440\u0438\u0441\u0442\u0435 \u0437\u0430 \u043c\u0435\u0440\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u0430 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u043e\u043c \u0446\u0438\u0459\u0443. \u0423 \u0441\u0432\u043e\u0458\u043e\u0458 \u0414\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u043e\u0458 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0438 \u0437\u0430 2020. \u0433\u043e\u0434\u0438\u043d\u0443, \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0430 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0430 \u0458\u0435 \u0438\u0441\u0442\u0430\u043a\u043b\u0430 \u043f\u043e\u0441\u0432\u0435\u045b\u0435\u043d\u043e\u0441\u0442 \u0415\u0423 \u0440\u0430\u0437\u0432\u043e\u0458\u0443 \u0413\u043b\u043e\u0431\u0430\u043b\u043d\u0435 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0435 \u0437\u0430 \u0434\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u0443 \u0441\u0430\u0440\u0430\u0434\u045a\u0443, \u043a\u043e\u0458\u0430 \u045b\u0435 \u043e\u0434\u0440\u0430\u0436\u0430\u0432\u0430\u0442\u0438 \u0446\u0438\u0459\u0435\u0432\u0435 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430.","eu_methodology_characteristics":"\u0423 \u0441\u0432\u043e\u0458\u043e\u0458 \u043a\u043e\u043c\u0443\u043d\u0438\u043a\u0430\u0446\u0438\u0458\u0438 \u0438\u0437 2016. \u0433\u043e\u0434\u0438\u043d\u0435 \u043f\u043e\u0434 \u043d\u0430\u0437\u0438\u0432\u043e\u043c \u201e\u041f\u043e\u0432\u0435\u0437\u0438\u0432\u0430\u045a\u0435 \u0437\u0430 \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u043d\u043e \u0458\u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043e \u0434\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u043e \u0442\u0440\u0436\u0438\u0448\u0442\u0435 \u2013 \u043a\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u043e\u043c \u0433\u0438\u0433\u0430\u0431\u0438\u0442\u043d\u043e\u043c \u0434\u0440\u0443\u0448\u0442\u0432\u0443\u201c, \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0430 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0430 \u0458\u0435 \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0430 \u0432\u0438\u0437\u0438\u0458\u0443 \u0437\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u043e \u0433\u0438\u0433\u0430\u0431\u0438\u0442\u043d\u043e \u0434\u0440\u0443\u0448\u0442\u0432\u043e, \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u0443 \u043a\u0440\u043e\u0437 \u0442\u0440\u0438 \u0446\u0438\u0459\u0430 \u0437\u0430 2025. \u0433\u043e\u0434\u0438\u043d\u0443. \u0415\u0423 \u0442\u0435\u0436\u0438 \u0433\u0438\u0433\u0430\u0431\u0438\u0442\u043d\u043e\u0458 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u043e\u0441\u0442\u0438 \u0437\u0430 \u043c\u0435\u0441\u0442\u0430 \u043a\u043e\u0458\u0430 \u043f\u043e\u043a\u0440\u0435\u045b\u0443 \u0434\u0440\u0443\u0448\u0442\u0432\u0435\u043d\u043e-\u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0438 \u0440\u0430\u0437\u0432\u043e\u0458, 5\u0413 \u043f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u043e\u0441\u0442\u0438 \u0437\u0430 \u0441\u0432\u0430 \u0443\u0440\u0431\u0430\u043d\u0430 \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0430 \u0438 \u0441\u0432\u0435 \u0433\u043b\u0430\u0432\u043d\u0435 \u043a\u043e\u043f\u043d\u0435\u043d\u0435 \u0441\u0430\u043e\u0431\u0440\u0430\u045b\u0430\u0458\u043d\u0435 \u0440\u0443\u0442\u0435 \u0438 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0443 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442 \u043a\u043e\u043d\u0435\u043a\u0446\u0438\u0458\u0438 \u043e\u0434 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 100 Mbps \u0437\u0430 \u0441\u0432\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0430 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0432\u0430. \u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0430 \u201e\u041e\u0434 \u0444\u0430\u0440\u043c\u0435 \u0434\u043e \u0442\u0440\u043f\u0435\u0437\u0435\u201c \u043f\u043e\u0442\u0432\u0440\u0434\u0438\u043b\u0430 \u0458\u0435 \u043e\u0432\u0430\u0458 \u0446\u0438\u0459 \u043f\u043e\u0437\u0438\u0432\u0430\u0458\u0443\u045b\u0438 \u043d\u0430 \u0443\u0431\u0440\u0437\u0430\u045a\u0435 \u0443\u0432\u043e\u0452\u0435\u045a\u0430 \u0431\u0440\u0437\u043e\u0433 \u0448\u0438\u0440\u043e\u043a\u043e\u043f\u043e\u0458\u0430\u0441\u043d\u043e\u0433 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u0430 \u0443 \u0440\u0443\u0440\u0430\u043b\u043d\u0438\u043c \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0438\u043c\u0430 \u043a\u0430\u043a\u043e \u0431\u0438 \u0441\u0435 \u043f\u043e\u0441\u0442\u0438\u0433\u0430\u043e \u0446\u0438\u0459 \u043e\u0434 100% \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430 \u0434\u043e 2025. \u0433\u043e\u0434\u0438\u043d\u0435. \u0423 \u043c\u0430\u0440\u0442\u0443 2021. \u0433\u043e\u0434\u0438\u043d\u0435, \u041a\u043e\u043c\u0438\u0441\u0438\u0458\u0430 \u0458\u0435 \u2013 \u0443 \u0441\u0432\u043e\u043c \u0414\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u043e\u043c \u043a\u043e\u043c\u043f\u0430\u0441\u0443 2030 \u2013 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u043b\u0430 \u0432\u0438\u0437\u0438\u0458\u0443 \u0438 \u043f\u0443\u0442\u0435\u0432\u0435 \u0437\u0430 \u0434\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u0443 \u0442\u0440\u0430\u043d\u0441\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0458\u0443 \u0415\u0432\u0440\u043e\u043f\u0435 \u0434\u043e 2030. \u0433\u043e\u0434\u0438\u043d\u0435, \u0444\u043e\u043a\u0443\u0441\u0438\u0440\u0430\u0458\u0443\u045b\u0438 \u0441\u0435 \u043d\u0430 \u0447\u0435\u0442\u0438\u0440\u0438 \u0433\u043b\u0430\u0432\u043d\u0435 \u043e\u0431\u043b\u0430\u0441\u0442\u0438: (1) \u0432\u0435\u0448\u0442\u0438\u043d\u0435, (2) \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u0430 \u0438 \u043e\u0434\u0440\u0436\u0438\u0432\u0430 \u0434\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u0430 \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430, (3) \u0434\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u0430 \u0442\u0440\u0430\u043d\u0441\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0458\u0430 \u043f\u0440\u0435\u0434\u0443\u0437\u0435\u045b\u0430 \u0438 (4) \u0434\u0438\u0433\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0458\u0430 \u0458\u0430\u0432\u043d\u0438\u0445 \u0443\u0441\u043b\u0443\u0433\u0430.","eu_long_objective":"\u041d\u0430\u0434\u043e\u0432\u0435\u0437\u0443\u0458\u0443\u045b\u0438 \u0441\u0435 \u043d\u0430 \u0421\u0430\u043e\u043f\u0448\u0442\u0435\u045a\u0435 \u0438\u0437 2016. \u0433\u043e\u0434\u0438\u043d\u0435, \u0414\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u0438 \u043a\u043e\u043c\u043f\u0430\u0441 \u0434\u0435\u0444\u0438\u043d\u0438\u0448\u0435 \u0446\u0438\u0459 \u0434\u0430 \u0434\u043e 2030. \u0433\u043e\u0434\u0438\u043d\u0435 \u0441\u0432\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0430 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0432\u0430 \u0431\u0443\u0434\u0443 \u043f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u0430 \u0433\u0438\u0433\u0430\u0431\u0438\u0442\u043d\u043e\u043c \u043c\u0440\u0435\u0436\u043e\u043c, \u0430 \u0441\u0432\u0430 \u043d\u0430\u0441\u0435\u0459\u0435\u043d\u0430 \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0430 5G \u043c\u0440\u0435\u0436\u043e\u043c.","target_number":"17.60","goal_number":"17","graph_title":"\u041f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u043e\u0441\u0442 \u0431\u0440\u0437\u0438\u043c \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u043e\u043c \u043f\u0440\u0435\u043c\u0430 \u0432\u0440\u0441\u0442\u0438 \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0430"}