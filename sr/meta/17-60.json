{"indicator_number":17.6,"reporting_status":"complete","published":true,"sdg_goal":"17","data_non_statistical":false,"graph_type":"bar","indicator_sort_order":"17-60","indicator_name":"\u041f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u043e\u0441\u0442 \u0431\u0440\u0437\u0438\u043c \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u043e\u043c \u043f\u0440\u0435\u043c\u0430 \u0432\u0440\u0441\u0442\u0438 \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0430","source_active_1":true,"source_organisation_1":"RAK, BHAS","source_url_1":null,"graph_titles":[{"series":"\u041f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u043e\u0441\u0442 \u0431\u0440\u0437\u0438\u043c \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u043e\u043c \u043f\u0440\u0435\u043c\u0430 \u0432\u0440\u0441\u0442\u0438 \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0430","title":"\u041f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u043e\u0441\u0442 \u0431\u0440\u0437\u0438\u043c \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u043e\u043c \u043f\u0440\u0435\u043c\u0430 \u0432\u0440\u0441\u0442\u0438 \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0430"}],"national_indicator_definition":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043c\u0458\u0435\u0440\u0438 \u0443\u0434\u0438\u043e \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0430\u0432\u0430 \u0443 \u0411\u043e\u0441\u043d\u0438 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0438 \u043a\u043e\u0458\u0438\u043c\u0430 \u0458\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u0444\u0438\u043a\u0441\u043d\u0430 \u043c\u0440\u0435\u0436\u0430 \u0432\u0440\u043b\u043e \u0432\u0438\u0441\u043e\u043a\u043e\u0433 \u043a\u0430\u043f\u0430\u0446\u0438\u0442\u0435\u0442\u0430 (VHCN). \u041e\u0431\u0443\u0445\u0432\u0430\u0442\u0430 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0432\u0430 \u043a\u043e\u0458\u0438\u043c\u0430 \u0458\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u043e\u043f\u0442\u0438\u0447\u043a\u0430 \u043c\u0440\u0435\u0436\u0430 \u0434\u043e \u043f\u0440\u043e\u0441\u0442\u043e\u0440\u0430 \u043a\u043e\u0440\u0438\u0441\u043d\u0438\u043a\u0430 (FTTP), \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443\u045b\u0438 FTTH \u0438 FTTB, \u043a\u0430\u043e \u0438 \u043a\u0430\u0431\u043b\u043e\u0432\u0441\u043a\u0430 \u043c\u0440\u0435\u0436\u0430 \u043a\u043e\u0458\u0430 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0458\u0443 DOCSIS 3.1 \u0438\u043b\u0438 \u043d\u043e\u0432\u0438\u0458\u0443. \u041f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u043e\u0441\u0442 \u0441\u0435 \u0438\u0437\u0440\u0430\u0436\u0430\u0432\u0430 \u043a\u0430\u043e \u043f\u0440\u043e\u0446\u0435\u043d\u0430\u0442 \u0443\u043a\u0443\u043f\u043d\u043e\u0433 \u0431\u0440\u043e\u0458\u0430 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0430\u0432\u0430.","national_rationale":"\u041f\u043e\u0434\u0430\u0442\u043a\u0435 \u043e \u043f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u043e\u0441\u0442\u0438 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0430\u0432\u0430 \u0444\u0438\u043a\u0441\u043d\u0438\u043c \u043c\u0440\u0435\u0436\u0430\u043c\u0430 \u0432\u0440\u043b\u043e \u0432\u0438\u0441\u043e\u043a\u043e\u0433 \u043a\u0430\u043f\u0430\u0446\u0438\u0442\u0435\u0442\u0430 \u0437\u0430 \u0411\u043e\u0441\u043d\u0443 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0443 \u0434\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0430 \u0458\u0435 \u0420\u0435\u0433\u0443\u043b\u0430\u0442\u043e\u0440\u043d\u0430 \u0430\u0433\u0435\u043d\u0446\u0438\u0458\u0430 \u0437\u0430 \u043a\u043e\u043c\u0443\u043d\u0438\u043a\u0430\u0446\u0438\u0458\u0435 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435 (\u0420\u0410\u041a), \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0443 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u043a\u043e\u0458\u0435 \u0441\u0443 \u0410\u0433\u0435\u043d\u0446\u0438\u0458\u0438 \u0434\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0438 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0438 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u0441\u043a\u0438\u0445 \u043a\u043e\u043c\u0443\u043d\u0438\u043a\u0430\u0446\u0438\u0458\u0430. \u041f\u043e\u0434\u0430\u0446\u0438 \u0441\u0435 \u043e\u0434\u043d\u043e\u0441\u0435 \u043d\u0430 2025. \u0433\u043e\u0434\u0438\u043d\u0443 \u0438 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430\u0458\u0443 \u0431\u0440\u043e\u0458 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0430\u0432\u0430 \u043a\u043e\u0458\u0438\u043c\u0430 \u0458\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 FTTP \u043c\u0440\u0435\u0436\u0430 (FTTH \u0438 FTTB) \u0438 \u043a\u0430\u0431\u043b\u043e\u0432\u0441\u043a\u0430 \u043c\u0440\u0435\u0436\u0430 DOCSIS 3.1 \u0438\u043b\u0438 \u043d\u043e\u0432\u0438\u0458\u0430. \u041f\u0440\u0435\u043c\u0430 \u043f\u043e\u0434\u0430\u0446\u0438\u043c\u0430 \u0420\u0410\u041a-\u0430, \u0443\u043a\u0443\u043f\u043d\u043e 418.323 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0432\u0430 \u0443 \u0411\u043e\u0441\u043d\u0438 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0438 \u043f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u0430 \u0441\u0443 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 \u0458\u0435\u0434\u043d\u043e\u043c \u043e\u0434 \u043d\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u0445 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0458\u0430, \u0443\u0437 \u0443\u0432\u0430\u0436\u0430\u0432\u0430\u045a\u0435 \u043f\u0440\u0435\u043a\u043b\u0430\u043f\u0430\u045a\u0430 \u043f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u043e\u0441\u0442\u0438 \u0438\u0437\u043c\u0435\u0452\u0443 \u0440\u0430\u0437\u043b\u0438\u0447\u0438\u0442\u0438\u0445 \u043c\u0440\u0435\u0436\u0430 \u0438 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430. \u041e\u0434 \u0442\u043e\u0433\u0430 \u0458\u0435 408.383 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0430\u0432\u0430 \u043f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u043e FTTP \u043c\u0440\u0435\u0436\u043e\u043c, \u0434\u043e\u043a \u0458\u0435 9.940 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0430\u0432\u0430 \u043f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u043e \u043a\u0430\u0431\u043b\u043e\u0432\u0441\u043a\u043e\u043c \u043c\u0440\u0435\u0436\u043e\u043c DOCSIS 3.1 \u0438\u043b\u0438 \u043d\u043e\u0432\u0438\u0458\u043e\u043c. \u0417\u0430 \u0443\u043a\u0443\u043f\u0430\u043d \u0431\u0440\u043e\u0458 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0430\u0432\u0430 \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u043d\u0430 \u0458\u0435 \u043e\u043a\u0432\u0438\u0440\u043d\u0430 \u043f\u0440\u043e\u0446\u0458\u0435\u043d\u0430 \u043a\u043e\u0458\u0443 \u0458\u0435 \u0434\u043e\u0441\u0442\u0430\u0432\u0438\u043e \u0421\u0435\u043a\u0442\u043e\u0440 \u0437\u0430 \u0434\u0435\u043c\u043e\u0433\u0440\u0430\u0444\u0438\u0458\u0443 \u0410\u0433\u0435\u043d\u0446\u0438\u0458\u0435 \u0437\u0430 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435 (\u0411\u0425\u0410\u0421).","national_methodology_characteristics":"\u0417\u0430 \u0411\u043e\u0441\u043d\u0443 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0443 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0438\u0432 \u0458\u0435 \u043f\u043e\u0434\u0430\u0442\u0430\u043a \u0437\u0430 2025. \u0433\u043e\u0434\u0438\u043d\u0443, \u043a\u043e\u0458\u0438 \u0458\u0435 \u0420\u0410\u041a \u043f\u0440\u0432\u0438 \u043f\u0443\u0442 \u0438\u0437\u0440\u0430\u0447\u0443\u043d\u0430\u043e \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0443 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u043a\u043e\u0458\u0435 \u0441\u0443 \u0434\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0438 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0438 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u0441\u043a\u0438\u0445 \u043a\u043e\u043c\u0443\u043d\u0438\u043a\u0430\u0446\u0438\u0458\u0430. \u0420\u0410\u041a \u0458\u0435 \u0442\u0430\u043a\u043e\u0452\u0435 \u043d\u0430\u0432\u0435\u043e \u0434\u0430 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0438 \u0443 \u0411\u043e\u0441\u043d\u0438 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0438 \u0434\u043e\u043c\u0438\u043d\u0430\u043d\u0442\u043d\u043e \u043f\u0440\u0443\u0436\u0430\u0458\u0443 \u0443\u0441\u043b\u0443\u0433\u0435 \u043f\u0443\u0442\u0435\u043c \u043a\u0430\u0431\u043b\u043e\u0432\u0441\u043a\u0435 \u043c\u0440\u0435\u0436\u0435 DOCSIS 3.0, \u0434\u043e\u043a \u0441\u0443 \u0443 \u043f\u043e\u0441\u043c\u0430\u0442\u0440\u0430\u043d\u043e\u043c \u043f\u0435\u0440\u0438\u043e\u0434\u0443 \u0441\u0430\u043c\u043e \u0442\u0440\u0438 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430 \u043f\u0440\u0443\u0436\u0430\u043b\u0430 \u0443\u0441\u043b\u0443\u0433\u0435 \u043f\u0443\u0442\u0435\u043c \u043c\u0440\u0435\u0436\u0430 DOCSIS 3.1 \u0438\u043b\u0438 \u043d\u043e\u0432\u0438\u0458\u0438\u0445. \u0417\u0431\u043e\u0433 \u0442\u043e\u0433\u0430 \u0441\u0435 \u0443 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443 \u0441\u0430\u043c\u043e \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0432\u0430 \u043a\u043e\u0458\u0438\u043c\u0430 \u0441\u0443 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0435 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0458\u0435 \u043a\u043e\u0458\u0435 \u043e\u0434\u0433\u043e\u0432\u0430\u0440\u0430\u0458\u0443 \u0434\u0435\u0444\u0438\u043d\u0438\u0446\u0438\u0458\u0438 VHCN, \u0430 \u043d\u0435 \u0441\u0432\u0430 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0432\u0430 \u043f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u0430 \u043a\u0430\u0431\u043b\u043e\u0432\u0441\u043a\u043e\u043c \u043c\u0440\u0435\u0436\u043e\u043c. \u041f\u0440\u0438\u043b\u0438\u043a\u043e\u043c \u0442\u0443\u043c\u0430\u0447\u0435\u045a\u0430 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u0437\u0430 2025. \u0433\u043e\u0434\u0438\u043d\u0443 \u043f\u043e\u0442\u0440\u0435\u0431\u043d\u043e \u0458\u0435 \u0443\u0437\u0435\u0442\u0438 \u0443 \u043e\u0431\u0437\u0438\u0440 \u0434\u0430 \u0458\u0435 \u0443\u043a\u0443\u043f\u0430\u043d \u0431\u0440\u043e\u0458 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0430\u0432\u0430 \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u043d \u0443 \u043e\u0431\u0440\u0430\u0447\u0443\u043d\u0443 \u0437\u0430\u0441\u043d\u043e\u0432\u0430\u043d \u043d\u0430 \u043e\u043a\u0432\u0438\u0440\u043d\u043e\u0458 \u043f\u0440\u043e\u0446\u0458\u0435\u043d\u0438. \u0417\u0430 \u043f\u0440\u0435\u0442\u0445\u043e\u0434\u043d\u0435 \u0433\u043e\u0434\u0438\u043d\u0435 \u043d\u0438\u0441\u0443 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0438\u0432\u0438 \u0443\u043f\u043e\u0440\u0435\u0434\u0438\u0432\u0438 \u043f\u043e\u0434\u0430\u0446\u0438, \u0437\u0431\u043e\u0433 \u0447\u0435\u0433\u0430 \u043d\u0438\u0458\u0435 \u043c\u043e\u0433\u0443\u045b\u0435 \u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0430\u0442\u0438 \u0432\u0440\u0435\u043c\u0435\u043d\u0441\u043a\u0438 \u0442\u0440\u0435\u043d\u0434 \u043d\u0438\u0442\u0438 \u0438\u0437\u0440\u0430\u0447\u0443\u043d\u0430\u0442\u0438 \u043d\u0430\u043f\u0440\u0435\u0434\u0430\u043a \u0443 \u043e\u0434\u043d\u043e\u0441\u0443 \u043d\u0430 \u043f\u0440\u0435\u0442\u0445\u043e\u0434\u043d\u0438 \u043f\u0435\u0440\u0438\u043e\u0434. ","national_long_objective":"\u0420\u0430\u0437\u0432\u043e\u0458 \u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0441\u0442 \u043c\u0440\u0435\u0436\u0430 \u0432\u0440\u043b\u043e \u0432\u0438\u0441\u043e\u043a\u043e\u0433 \u043a\u0430\u043f\u0430\u0446\u0438\u0442\u0435\u0442\u0430 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430\u0458\u0443 \u0432\u0430\u0436\u0430\u043d \u043f\u0440\u0435\u0434\u0443\u0441\u043b\u043e\u0432 \u0437\u0430 \u0443\u043d\u0430\u043f\u0440\u0435\u0452\u0435\u045a\u0435 \u0434\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u0435 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u043e\u0441\u0442\u0438, \u0440\u0430\u0437\u0432\u043e\u0458 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u0441\u043a\u0438\u0445 \u043a\u043e\u043c\u0443\u043d\u0438\u043a\u0430\u0446\u0438\u0458\u0430 \u0438 \u0448\u0438\u0440\u0443 \u043f\u0440\u0438\u043c\u0458\u0435\u043d\u0443 \u0434\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u0438\u0445 \u0443\u0441\u043b\u0443\u0433\u0430 \u0443 \u0411\u043e\u0441\u043d\u0438 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0438. \u0417\u0430 \u043e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043d\u0438\u0458\u0435 \u0443\u0442\u0432\u0440\u0452\u0435\u043d \u043f\u043e\u0441\u0435\u0431\u0430\u043d \u043a\u0432\u0430\u043d\u0442\u0438\u0442\u0430\u0442\u0438\u0432\u043d\u0438 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u0446\u0438\u0459 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435. \u0426\u0438\u0459 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u0443\u043d\u0438\u0458\u0435 \u0437\u0430 2030. \u0433\u043e\u0434\u0438\u043d\u0443, \u043f\u0440\u0435\u043c\u0430 \u043a\u043e\u0458\u0435\u043c \u0431\u0438 \u0441\u0432\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0430 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0432\u0430 \u0442\u0440\u0435\u0431\u0430\u043b\u043e \u0434\u0430 \u0431\u0443\u0434\u0443 \u043f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u0430 \u0433\u0438\u0433\u0430\u0431\u0438\u0442\u043d\u043e\u043c \u043c\u0440\u0435\u0436\u043e\u043c, \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0438 \u0441\u0442\u0440\u0430\u0442\u0435\u0448\u043a\u0438 \u0446\u0438\u0459 \u0438 \u043d\u0435 \u0442\u0440\u0435\u0431\u0430 \u0433\u0430 \u0442\u0443\u043c\u0430\u0447\u0438\u0442\u0438 \u043a\u0430\u043e \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u0438 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u0446\u0438\u0459 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435.","eu_indicator_definition":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043c\u0458\u0435\u0440\u0438 \u0443\u0434\u0438\u043e \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0430\u0432\u0430 \u043f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u0438\u0445 \u0444\u0438\u043a\u0441\u043d\u043e\u043c \u043c\u0440\u0435\u0436\u043e\u043c \u0432\u0440\u043b\u043e \u0432\u0435\u043b\u0438\u043a\u043e\u0433 \u043a\u0430\u043f\u0430\u0446\u0438\u0442\u0435\u0442\u0430 (VHCN), \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443\u045b\u0438 \u043e\u043f\u0442\u0438\u0447\u043a\u0435 \u043c\u0440\u0435\u0436\u0435 FTTP \u0438 \u043e\u0434\u0433\u043e\u0432\u0430\u0440\u0430\u0458\u0443\u045b\u0435 \u043a\u0430\u0431\u043b\u043e\u0432\u0441\u043a\u0435 \u043c\u0440\u0435\u0436\u0435 DOCSIS 3.1. \u041f\u043e\u0434\u0430\u0446\u0438 \u0441\u0435 \u043c\u043e\u0433\u0443 \u0440\u0430\u0437\u0432\u0440\u0441\u0442\u0430\u0442\u0438 \u043f\u0440\u0435\u043c\u0430 \u0432\u0440\u0441\u0442\u0438 \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0430.","eu_rationale":"\u041f\u043e\u0434\u0430\u0446\u0438 \u0441\u0435 \u0437\u0430\u0441\u043d\u0438\u0432\u0430\u0458\u0443 \u043d\u0430 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0443 \u043f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u043e\u0441\u0442\u0438 \u0448\u0438\u0440\u043e\u043a\u043e\u043f\u043e\u0458\u0430\u0441\u043d\u0438\u043c \u043c\u0440\u0435\u0436\u0430\u043c\u0430 \u0443 \u0415\u0432\u0440\u043e\u043f\u0438 (Broadband Coverage in Europe), \u043a\u043e\u0458\u0435 \u0441\u0435 \u0441\u043f\u0440\u043e\u0432\u043e\u0434\u0438 \u0437\u0430 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0443 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0443, \u043e\u0434\u043d\u043e\u0441\u043d\u043e \u0413\u0435\u043d\u0435\u0440\u0430\u043b\u043d\u0438 \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u0430\u0442 \u0437\u0430 \u043a\u043e\u043c\u0443\u043d\u0438\u043a\u0430\u0446\u0438\u043e\u043d\u0435 \u043c\u0440\u0435\u0436\u0435, \u0441\u0430\u0434\u0440\u0436\u0430\u0458 \u0438 \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0458\u0443 (DG CNECT). \u041f\u043e\u0434\u0430\u0446\u0438 \u0441\u0435 \u043f\u0440\u0438\u043a\u0443\u043f\u0459\u0430\u0458\u0443 \u043e\u0434 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0430 \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u0441\u043a\u0438\u0445 \u043a\u043e\u043c\u0443\u043d\u0438\u043a\u0430\u0446\u0438\u0458\u0430 \u0438 \u043e\u0434\u043d\u043e\u0441\u0435 \u0441\u0435 \u043d\u0430 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0441\u0442 \u043c\u0440\u0435\u0436\u043d\u0435 \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0435 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0432\u0438\u043c\u0430. \u041f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u043e\u0441\u0442 \u0441\u0435 \u0438\u0437\u0440\u0430\u0436\u0430\u0432\u0430 \u043a\u0430\u043e \u043f\u0440\u043e\u0446\u0435\u043d\u0430\u0442 \u0443\u043a\u0443\u043f\u043d\u043e\u0433 \u0431\u0440\u043e\u0458\u0430 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0430\u0432\u0430.","eu_methodology_characteristics":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0432\u0430 \u043a\u043e\u0458\u0438\u043c\u0430 \u0458\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u0444\u0438\u043a\u0441\u043d\u0430 \u043c\u0440\u0435\u0436\u0430 \u0432\u0440\u043b\u043e \u0432\u0438\u0441\u043e\u043a\u043e\u0433 \u043a\u0430\u043f\u0430\u0446\u0438\u0442\u0435\u0442\u0430, \u043e\u0434\u043d\u043e\u0441\u043d\u043e FTTP \u043c\u0440\u0435\u0436\u0430 \u0438\u043b\u0438 \u043a\u0430\u0431\u043b\u043e\u0432\u0441\u043a\u0430 \u043c\u0440\u0435\u0436\u0430 DOCSIS 3.1 \u0438\u043b\u0438 \u043d\u043e\u0432\u0438\u0458\u0430. \u041f\u043e\u0434\u0430\u0446\u0438 \u0441\u0435 \u043f\u0440\u0438\u043a\u0443\u043f\u0459\u0430\u0458\u0443 \u043d\u0430 \u0433\u043e\u0434\u0438\u0448\u045a\u0435\u043c \u043d\u0438\u0432\u043e\u0443 \u0438 \u043e\u043c\u043e\u0433\u0443\u045b\u0430\u0432\u0430\u0458\u0443 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 \u043f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u043e\u0441\u0442\u0438 \u0438 \u043f\u043e\u0440\u0435\u0452\u0435\u045a\u0435 \u0438\u0437\u043c\u0435\u0452\u0443 \u0434\u0440\u0436\u0430\u0432\u0430 \u0447\u043b\u0430\u043d\u0438\u0446\u0430 \u0415\u0423, \u043a\u0430\u043e \u0438 \u0438\u0437\u043c\u0435\u0452\u0443 \u0443\u0440\u0431\u0430\u043d\u0438\u0445 \u0438 \u0440\u0443\u0440\u0430\u043b\u043d\u0438\u0445 \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0430.","eu_long_objective":"\u041f\u0440\u0435\u043c\u0430 \u0446\u0438\u0459\u0435\u0432\u0438\u043c\u0430 \u0414\u0438\u0433\u0438\u0442\u0430\u043b\u043d\u0435 \u0434\u0435\u0446\u0435\u043d\u0438\u0458\u0435 \u0415\u0423 \u0437\u0430 2030. \u0433\u043e\u0434\u0438\u043d\u0443, \u0441\u0432\u0430 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0432\u0430 \u0443 \u0415\u0423 \u0442\u0440\u0435\u0431\u0430\u043b\u043e \u0431\u0438 \u0434\u0430 \u0431\u0443\u0434\u0443 \u043f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u0430 \u0433\u0438\u0433\u0430\u0431\u0438\u0442\u043d\u043e\u043c \u043c\u0440\u0435\u0436\u043e\u043c, \u0430 \u0441\u0432\u0430 \u043d\u0430\u0441\u0435\u0459\u0435\u043d\u0430 \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0430 \u0442\u0440\u0435\u0431\u0430\u043b\u043e \u0431\u0438 \u0434\u0430 \u0438\u043c\u0430\u0458\u0443 \u043f\u0440\u0438\u0441\u0442\u0443\u043f 5G \u043c\u0440\u0435\u0436\u0438.","target_number":"17.60","goal_number":"17","graph_title":"\u041f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u043e\u0441\u0442 \u0431\u0440\u0437\u0438\u043c \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u043e\u043c \u043f\u0440\u0435\u043c\u0430 \u0432\u0440\u0441\u0442\u0438 \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0430"}