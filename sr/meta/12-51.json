445 \u0435\u043b\u0435\u043c\u0435\u043d\u0430\u0442\u0430 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u043e\u0433 \u0437\u0435\u043b\u0435\u043d\u043e\u0433 \u043f\u043b\u0430\u043d\u0430.","methodology_characteristics":"\u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0430 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0430 \u0458\u0435 \u0443\u0441\u0432\u043e\u0458\u0438\u043b\u0430 \u043d\u043e\u0432\u0438 \u0410\u043a\u0446\u0438\u043e\u043d\u0438 \u043f\u043b\u0430\u043d \u0437\u0430 \u0446\u0438\u0440\u043a\u0443\u043b\u0430\u0440\u043d\u0443 \u0435\u043a\u043e\u043d\u043e\u043c\u0438\u0458\u0443 (CEAP) \u0443 \u043c\u0430\u0440\u0442\u0443 2020. \u0433\u043e\u0434\u0438\u043d\u0435. \u041f\u0440\u0435\u043b\u0430\u0437\u0430\u043a \u0415\u0423 \u043d\u0430 \u0446\u0438\u0440\u043a\u0443\u043b\u0430\u0440\u043d\u0443 \u0435\u043a\u043e\u043d\u043e\u043c\u0438\u0458\u0443 \u0441\u043c\u0430\u045a\u0438\u045b\u0435 \u043f\u0440\u0438\u0442\u0438\u0441\u0430\u043a \u043d\u0430 \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u0435 \u0438 \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u043e\u0434\u0440\u0436\u0438\u0432\u0438 \u0440\u0430\u0441\u0442 \u0438 \u0440\u0430\u0434\u043d\u0430 \u043c\u0435\u0441\u0442\u0430. \u041d\u043e\u0432\u0438 \u0430\u043a\u0446\u0438\u043e\u043d\u0438 \u043f\u043b\u0430\u043d \u043d\u0430\u0458\u0430\u0432\u0459\u0443\u0458\u0435 \u0438\u043d\u0438\u0446\u0438\u0458\u0430\u0442\u0438\u0432\u0435 \u0434\u0443\u0436 \u0446\u0435\u043b\u043e\u0433 \u0436\u0438\u0432\u043e\u0442\u043d\u043e\u0433 \u0446\u0438\u043a\u043b\u0443\u0441\u0430 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0430. \u041e\u043d \u0458\u0435 \u0443\u0441\u043c\u0435\u0440\u0435\u043d \u043d\u0430 \u043d\u0430\u0447\u0438\u043d \u043d\u0430 \u043a\u043e\u0458\u0438 \u0441\u0443 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438 \u0434\u0438\u0437\u0430\u0458\u043d\u0438\u0440\u0430\u043d\u0438, \u043f\u0440\u043e\u043c\u