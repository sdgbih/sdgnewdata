u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0443 \u043c\u0458\u0435\u0440\u0438 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0435 \u0433\u0443\u0431\u0438\u0442\u043a\u0435 \u0443\u0437\u0440\u043e\u043a\u043e\u0432\u0430\u043d\u0435 \u0432\u0440\u0435\u043c\u0435\u043d\u0441\u043a\u0438\u043c \u0438 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0438\u043c \u0434\u043e\u0433\u0430\u0452\u0430\u0458\u0438\u043c\u0430, \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443\u045b\u0438 \u043c\u0435\u0442\u0435\u043e\u0440\u043e\u043b\u043e\u0448\u043a\u0435 \u0434\u043e\u0433\u0430\u0452\u0430\u0458\u0435, \u043a\u0430\u043e \u0448\u0442\u043e \u0441\u0443 \u043e\u043b\u0443\u0458\u0435 \u0438 \u043b\u0430\u0432\u0438\u043d\u0435, \u0445\u0438\u0434\u0440\u043e\u043b\u043e\u0448\u043a\u0435 \u0434\u043e\u0433\u0430\u0452\u0430\u0458\u0435, \u043a\u0430\u043e \u0448\u0442\u043e \u0441\u0443 \u043f\u043e\u043f\u043b\u0430\u0432\u0435, \u0442\u0435 \u043a\u043b\u0438\u043c\u0430\u0442\u043e\u043b\u043e\u0448\u043a\u0435 \u0434\u043e\u0433\u0430\u0452\u0430\u0458\u0435, \u043a\u0430\u043e \u0448\u0442\u043e \u0441\u0443 \u0442\u043e\u043f\u043b\u043e\u0442\u043d\u0438 \u0442\u0430\u043b\u0430\u0441\u0438, \u0445\u043b\u0430\u0434\u043d\u0438 \u0442\u0430\u043b\u0430\u0441\u0438, \u0441\u0443\u0448\u0435 \u0438 \u0448\u0443\u043c\u0441\u043a\u0438 \u043f\u043e\u0436\u0430\u0440\u0438. \u041f\u043e\u0434\u0430\u0446\u0438 \u0437\u0430 \u0411\u043e\u0441\u043d\u0443 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0443 \u0434\u0438\u043e \u0441\u0443 \u0437\u0430\u0458\u0435\u0434\u043d\u0438\u0447\u043a\u0435 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u0441\u0435\u0440\u0438\u0458\u0435 \u043a\u043e\u0458\u0443 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0415\u0432\u0440\u043e\u0441\u0442\u0430\u0442 \u0438 \u0437\u0430\u0441\u043d\u0438\u0432\u0430\u0458\u0443 \u0441\u0435 \u043d\u0430 \u043f\u043e\u0434\u0430\u0446\u0438\u043c\u0430 \u0438\u0437 \u0431\u0430\u0437\u0435 CATDAT RiskLayer-\u0430, \u0443\u0437 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0443 \u0430\u0433\u0435\u043d\u0446\u0438\u0458\u0443 \u0437\u0430 \u0436\u0438\u0432\u043e\u0442\u043d\u0443 \u0441\u0440\u0435\u0434\u0438\u043d\u0443 (EEA) \u043a\u0430\u043e \u043f\u0440\u0443\u0436\u0430\u043e\u0446\u0430 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430. \u0423 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u043c \u0441\u043a\u0443\u043f\u0443 \u0433\u043e\u0434\u0438\u0448\u045a\u0435 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u0441\u0443 \u043f\u0440\u0438\u043a\u0430\u0437\u0430\u043d\u0435 \u043e\u0434 2000. \u0433\u043e\u0434\u0438\u043d\u0435, \u0434\u043e\u043a \u0458\u0435 30-\u0433\u043e\u0434\u0438\u0448\u045a\u0438 \u043f\u043e\u043a\u0440\u0435\u0442\u043d\u0438 \u043f\u0440\u043e\u0441\u0458\u0435\u043a \u043f\u0440\u0438\u043a\u0430\u0437\u0430\u043d \u043e\u0434 2009. \u0433\u043e\u0434\u0438\u043d\u0435. \u0412\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u0441\u0435 \u0438\u0441\u043a\u0430\u0437\u0443\u0458\u0443 \u0443 \u043c\u0438\u043b\u0438\u043e\u043d\u0438\u043c\u0430 \u0435\u0443\u0440\u0430 \u0438 \u0435\u0443\u0440\u0438\u043c\u0430 \u043f\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0443, \u0443 \u0441\u0442\u0430\u043b\u043d\u0438\u043c \u0446\u0438\u0458\u0435\u043d\u0430\u043c\u0430.","national_rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0438\u0445 \u043f\u043e\u0441\u0459\u0435\u0434\u0438\u0446\u0430 \u0432\u0440\u0435\u043c\u0435\u043d\u0441\u043a\u0438\u0445 \u0438 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0438\u0445 \u0435\u043a\u0441\u0442\u0440\u0435\u043c\u0430 \u0438 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435 \u0443 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0435 \u043e\u0442\u043f\u043e\u0440\u043d\u043e\u0441\u0442\u0438 \u0438 \u043f\u0440\u0438\u043b\u0430\u0433\u043e\u0452\u0430\u0432\u0430\u045a\u0430 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0438\u043c \u043f\u0440\u043e\u043c\u0458\u0435\u043d\u0430\u043c\u0430. \u041f\u043e\u0441\u0435\u0431\u043d\u043e \u0458\u0435 \u0437\u043d\u0430\u0447\u0430\u0458\u0430\u043d \u0437\u0431\u043e\u0433 \u0438\u0437\u0440\u0430\u0436\u0435\u043d\u0435 \u043c\u0435\u0452\u0443\u0433\u043e\u0434\u0438\u0448\u045a\u0435 \u043f\u0440\u043e\u043c\u0458\u0435\u043d\u0459\u0438\u0432\u043e\u0441\u0442\u0438 \u0433\u0443\u0431\u0438\u0442\u0430\u043a\u0430, \u043a\u043e\u0458\u0430 \u043c\u043e\u0436\u0435 \u0431\u0438\u0442\u0438 \u043f\u043e\u0441\u0459\u0435\u0434\u0438\u0446\u0430 \u043f\u043e\u0458\u0430\u0432\u0435 \u043f\u043e\u0458\u0435\u0434\u0438\u043d\u0430\u0447\u043d\u0438\u0445 \u0435\u043a\u0441\u0442\u0440\u0435\u043c\u043d\u0438\u0445 \u0434\u043e\u0433\u0430\u0452\u0430\u0458\u0430 \u0441\u0430 \u0432\u0435\u043b\u0438\u043a\u0438\u043c \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0438\u043c \u043f\u043e\u0441\u0459\u0435\u0434\u0438\u0446\u0430\u043c\u0430. \u0417\u0431\u043e\u0433 \u0442\u043e\u0433\u0430 \u0441\u0435, \u043f\u043e\u0440\u0435\u0434 \u0433\u043e\u0434\u0438\u0448\u045a\u0438\u0445 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442\u0438, \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0438 30-\u0433\u043e\u0434\u0438\u0448\u045a\u0438 \u043f\u043e\u043a\u0440\u0435\u0442\u043d\u0438 \u043f\u0440\u043e\u0441\u0458\u0435\u043a \u043a\u043e\u0458\u0438 \u043e\u043c\u043e\u0433\u0443\u045b\u0430\u0432\u0430 \u0441\u0442\u0430\u0431\u0438\u043b\u043d\u0438\u0458\u0435 \u0441\u0430\u0433\u043b\u0435\u0434\u0430\u0432\u0430\u045a\u0435 \u0434\u0443\u0433\u043e\u0440\u043e\u0447\u043d\u043e\u0433 \u0442\u0440\u0435\u043d\u0434\u0430. \u041f\u043e\u0434\u0430\u0446\u0438 \u0437\u0430 \u0411\u043e\u0441\u043d\u0443 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0443 \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0448\u043a\u0438 \u0441\u0443 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u0438 \u0441\u0430 \u0438\u0441\u0442\u0438\u043c \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0438\u043c \u0438\u0437\u0432\u043e\u0440\u043e\u043c \u043a\u043e\u0458\u0438 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0437\u0430 \u043e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0443 \u0415\u0432\u0440\u043e\u0441\u0442\u0430\u0442\u043e\u0432\u043e\u0458 \u0431\u0430\u0437\u0438.","national_methodology_characteristics":"\u041d\u0430\u043f\u0440\u0435\u0434\u0430\u043a \u0441\u0435 \u043d\u0430 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u043c \u043d\u0438\u0432\u043e\u0443 \u0440\u0430\u0447\u0443\u043d\u0430 \u0443 \u0441\u043a\u043b\u0430\u0434\u0443 \u0441\u0430 \u0415\u0432\u0440\u043e\u0441\u0442\u0430\u0442\u043e\u0432\u0438\u043c \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u043e\u043c \u0437\u0430 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0435 \u0431\u0435\u0437 \u043a\u0432\u0430\u043d\u0442\u0438\u0442\u0430\u0442\u0438\u0432\u043d\u043e\u0433 \u0446\u0438\u0459\u0430. \u0417\u0430 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 13.40 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0441\u0435 \u0430\u043f\u0441\u043e\u043b\u0443\u0442\u043d\u0430 \u043c\u0458\u0435\u0440\u043d\u0430 \u0458\u0435\u0434\u0438\u043d\u0438\u0446\u0430 \u043c\u0438\u043b\u0438\u043e\u043d \u0435\u0443\u0440\u0430, \u0430 \u0437\u0430 \u0438\u0437\u0440\u0430\u0447\u0443\u043d\u0430\u0432\u0430\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043e\u0434\u0430\u0431\u0440\u0430\u043d\u0430 \u0458\u0435 \u0441\u0435\u0440\u0438\u0458\u0430 30-\u0433\u043e\u0434\u0438\u0448\u045a\u0435\u0433 \u043f\u043e\u043a\u0440\u0435\u0442\u043d\u043e\u0433 \u043f\u0440\u043e\u0441\u0458\u0435\u043a\u0430 (AVG_30Y). \u0423 \u0441\u043a\u043b\u0430\u0434\u0443 \u0441\u0430 \u0415\u0432\u0440\u043e\u0441\u0442\u0430\u0442\u043e\u0432\u043e\u043c \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u0458\u043e\u043c, \u0437\u0430 \u043f\u0440\u043e\u0446\u0458\u0435\u043d\u0443 \u043a\u0440\u0430\u0442\u043a\u043e\u0440\u043e\u0447\u043d\u043e\u0433 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0441\u0435 \u043f\u0440\u043e\u0441\u0458\u0435\u0447\u043d\u0430 \u0433\u043e\u0434\u0438\u0448\u045a\u0430 \u0441\u0442\u043e\u043f\u0430 \u043f\u0440\u043e\u043c\u0458\u0435\u043d\u0435 (CAGR) \u0437\u0430 \u043f\u043e\u0441\u0459\u0435\u0434\u045a\u0438\u0445 \u043f\u0435\u0442 \u0433\u043e\u0434\u0438\u043d\u0430. \u0417\u0430 \u0411\u043e\u0441\u043d\u0443 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0443 \u043f\u043e\u0441\u0459\u0435\u0434\u045a\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438 \u043f\u0435\u0440\u0438\u043e\u0434 \u0458\u0435 2019\u20132024. \u0417\u0430 2019. \u0433\u043e\u0434\u0438\u043d\u0443 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442 30-\u0433\u043e\u0434\u0438\u0448\u045a\u0435\u0433 \u043f\u0440\u043e\u0441\u0458\u0435\u043a\u0430 \u0438\u0437\u043d\u043e\u0441\u0438 161 \u043c\u0438\u043b\u0438\u043e\u043d \u0435\u0443\u0440\u0430, \u0430 \u0437\u0430 2024. \u0433\u043e\u0434\u0438\u043d\u0443 178 \u043c\u0438\u043b\u0438\u043e\u043d\u0430 \u0435\u0443\u0440\u0430. \u041f\u0440\u043e\u0441\u0458\u0435\u0447\u043d\u0430 \u0433\u043e\u0434\u0438\u0448\u045a\u0430 \u0441\u0442\u043e\u043f\u0430 \u043f\u0440\u043e\u043c\u0458\u0435\u043d\u0435 \u0438\u0437\u0440\u0430\u0447\u0443\u043d\u0430\u0432\u0430 \u0441\u0435 \u0444\u043e\u0440\u043c\u0443\u043b\u043e\u043c: CAGR = (178 / 161)^(1/5) \u2212 1 = +2,03 % \u041a\u043e\u0434 \u043e\u0432\u043e\u0433 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u043f\u043e\u0436\u0435\u0459\u0430\u043d \u0458\u0435 \u0441\u043c\u0458\u0435\u0440 \u0441\u043c\u0430\u045a\u0435\u045a\u0430 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0438\u0445 \u0433\u0443\u0431\u0438\u0442\u0430\u043a\u0430. \u0417\u0431\u043e\u0433 \u0442\u043e\u0433\u0430 \u043f\u043e\u0437\u0438\u0442\u0438\u0432\u043d\u0430 \u0441\u0442\u043e\u043f\u0430 \u0440\u0430\u0441\u0442\u0430 \u043e\u0434 \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u043d\u043e 2,03 % \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430 \u043a\u0440\u0435\u0442\u0430\u045a\u0435 \u0443 \u043d\u0435\u043f\u043e\u0432\u043e\u0459\u043d\u043e\u043c \u0441\u043c\u0458\u0435\u0440\u0443. \u041f\u0440\u0435\u043c\u0430 \u0415\u0432\u0440\u043e\u0441\u0442\u0430\u0442\u043e\u0432\u043e\u0458 \u0444\u0443\u043d\u043a\u0446\u0438\u0458\u0438 \u0431\u043e\u0434\u043e\u0432\u0430\u045a\u0430 \u0437\u0430 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0435 \u0431\u0435\u0437 \u043a\u0432\u0430\u043d\u0442\u0438\u0442\u0430\u0442\u0438\u0432\u043d\u043e\u0433 \u0446\u0438\u0459\u0430, \u0442\u0430\u043a\u0432\u043e \u043a\u0440\u0435\u0442\u0430\u045a\u0435 \u043e\u0434\u0433\u043e\u0432\u0430\u0440\u0430 \u0440\u0435\u0437\u0443\u043b\u0442\u0430\u0442\u0443 \u22125, \u0448\u0442\u043e \u0441\u0435 \u043d\u0430 \u043f\u043e\u0440\u0442\u0430\u043b\u0443 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435 \u043f\u0440\u0438\u043a\u0430\u0437\u0443\u0458\u0435 \u043a\u0430\u043e \u201e\u041f\u043e\u0433\u043e\u0440\u0448\u0430\u045a\u0435\u201c. \u0421\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u043d\u043e\u0441\u0442 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435 \u0458\u0435 \u0434\u0430 \u0441\u0435 \u0437\u0430 \u043e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043d\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0435 \u043f\u043e\u0434\u0430\u0446\u0438 \u0438\u0437 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u0433 ESS \u0438\u0437\u0432\u043e\u0440\u0430, \u0432\u0435\u045b \u043f\u043e\u0434\u0430\u0446\u0438 \u0437\u0430 \u0411\u0438\u0425 \u0438\u0437 \u0437\u0430\u0458\u0435\u0434\u043d\u0438\u0447\u043a\u043e\u0433 CATDAT/RiskLayer \u0441\u043a\u0443\u043f\u0430 \u043a\u043e\u0458\u0438 \u0434\u0438\u0441\u0442\u0440\u0438\u0431\u0443\u0438\u0440\u0430 EEA. \u0417\u0431\u043e\u0433 \u0442\u043e\u0433\u0430 \u0458\u0435 \u0443\u043f\u043e\u0440\u0435\u0434\u0438\u0432\u043e\u0441\u0442 \u0441\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0438\u043c \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u0437\u0430\u0441\u043d\u043e\u0432\u0430\u043d\u0430 \u043d\u0430 \u0438\u0441\u0442\u043e\u0458 \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0448\u043a\u043e\u0458 \u043e\u0441\u043d\u043e\u0432\u0438. \u0413\u043e\u0434\u0438\u0448\u045a\u0435 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u043c\u043e\u0433\u0443 \u0437\u043d\u0430\u0447\u0430\u0458\u043d\u043e \u043e\u0441\u0446\u0438\u043b\u0438\u0440\u0430\u0442\u0438 \u0438\u0437\u043c\u0435\u0452\u0443 \u0433\u043e\u0434\u0438\u043d\u0430, \u043f\u0430 30-\u0433\u043e\u0434\u0438\u0448\u045a\u0438 \u043f\u043e\u043a\u0440\u0435\u0442\u043d\u0438 \u043f\u0440\u043e\u0441\u0458\u0435\u043a \u0438\u043c\u0430 \u043f\u043e\u0441\u0435\u0431\u0430\u043d \u0437\u043d\u0430\u0447\u0430\u0458 \u0437\u0430 \u0442\u0443\u043c\u0430\u0447\u0435\u045a\u0435 \u0434\u0443\u0433\u043e\u0440\u043e\u0447\u043d\u043e\u0433 \u043a\u0440\u0435\u0442\u0430\u045a\u0430.","national_long_objective":"\u0417\u0430 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 13.40 \u043d\u0438\u0458\u0435 \u0443\u0442\u0432\u0440\u0452\u0435\u043d \u043f\u043e\u0441\u0435\u0431\u0430\u043d \u043a\u0432\u0430\u043d\u0442\u0438\u0444\u0438\u043a\u043e\u0432\u0430\u043d\u0438 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u0446\u0438\u0459 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435 \u043a\u043e\u0458\u0438 \u0431\u0438 \u0441\u0435 \u043c\u043e\u0433\u0430\u043e \u043a\u043e\u0440\u0438\u0441\u0442\u0438\u0442\u0438 \u043a\u0430\u043e \u0431\u0440\u043e\u0458\u0447\u0430\u043d\u0430 \u0446\u0438\u0459\u043d\u0430 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442 \u0443 \u0438\u0437\u0440\u0430\u0447\u0443\u043d\u0430\u0432\u0430\u045a\u0443 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430. \u0417\u0431\u043e\u0433 \u0442\u043e\u0433\u0430 \u0441\u0435 \u043d\u0430 \u043f\u043e\u0440\u0442\u0430\u043b\u0443 \u043d\u0435 \u043f\u043e\u0441\u0442\u0430\u0432\u0459\u0430 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0459\u0430\u043d \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u0446\u0438\u0459, \u0432\u0435\u045b \u0441\u0435 \u043d\u0430\u043f\u0440\u0435\u0434\u0430\u043a \u043f\u0440\u0430\u0442\u0438 \u043a\u0440\u043e\u0437 \u043f\u0440\u043e\u043c\u0458\u0435\u043d\u0443 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u0443 \u0441\u043a\u043b\u0430\u0434\u0443 \u0441\u0430 \u0415\u0432\u0440\u043e\u0441\u0442\u0430\u0442\u043e\u0432\u043e\u043c \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u0458\u043e\u043c. \u0414\u0443\u0433\u043e\u0440\u043e\u0447\u043d\u0438 \u0446\u0438\u0459 \u0458\u0435 \u0441\u043c\u0430\u045a\u0435\u045a\u0435 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0438\u0445 \u043f\u043e\u0441\u0459\u0435\u0434\u0438\u0446\u0430 \u0432\u0440\u0435\u043c\u0435\u043d\u0441\u043a\u0438\u0445 \u0438 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0438\u0445 \u0435\u043a\u0441\u0442\u0440\u0435\u043c\u0430, \u0458\u0430\u0447\u0430\u045a\u0435 \u043e\u0442\u043f\u043e\u0440\u043d\u043e\u0441\u0442\u0438 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435 \u043d\u0430 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0435 \u0440\u0438\u0437\u0438\u043a\u0435 \u0438 \u0443\u043d\u0430\u043f\u0440\u0435\u0452\u0435\u045a\u0435 \u043a\u0430\u043f\u0430\u0446\u0438\u0442\u0435\u0442\u0430 \u0437\u0430 \u043f\u0440\u0438\u043b\u0430\u0433\u043e\u0452\u0430\u0432\u0430\u045a\u0435 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0438\u043c \u043f\u0440\u043e\u043c\u0458\u0435\u043d\u0430\u043c\u0430.","eu_indicator_definition":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043c\u0458\u0435\u0440\u0438 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0435 \u0433\u0443\u0431\u0438\u0442\u043a\u0435 \u0443\u0437\u0440\u043e\u043a\u043e\u0432\u0430\u043d\u0435 \u0432\u0440\u0435\u043c\u0435\u043d\u0441\u043a\u0438\u043c \u0438 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0438\u043c \u0434\u043e\u0433\u0430\u0452\u0430\u0458\u0438\u043c\u0430. \u0412\u0440\u0435\u043c\u0435\u043d\u0441\u043a\u0438 \u0438 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0438 \u0434\u043e\u0433\u0430\u0452\u0430\u0458\u0438 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430\u0458\u0443 \u043c\u0435\u0442\u0435\u043e\u0440\u043e\u043b\u043e\u0448\u043a\u0435 \u0434\u043e\u0433\u0430\u0452\u0430\u0458\u0435, \u043a\u0430\u043e \u0448\u0442\u043e \u0441\u0443 \u043e\u043b\u0443\u0458\u0435 \u0438 \u043b\u0430\u0432\u0438\u043d\u0435, \u0445\u0438\u0434\u0440\u043e\u043b\u043e\u0448\u043a\u0435 \u0434\u043e\u0433\u0430\u0452\u0430\u0458\u0435, \u043a\u0430\u043e \u0448\u0442\u043e \u0441\u0443 \u043f\u043e\u043f\u043b\u0430\u0432\u0435, \u0442\u0435 \u043a\u043b\u0438\u043c\u0430\u0442\u043e\u043b\u043e\u0448\u043a\u0435 \u0434\u043e\u0433\u0430\u0452\u0430\u0458\u0435, \u043a\u0430\u043e \u0448\u0442\u043e \u0441\u0443 \u0442\u043e\u043f\u043b\u043e\u0442\u043d\u0438 \u0442\u0430\u043b\u0430\u0441\u0438, \u0445\u043b\u0430\u0434\u043d\u0438 \u0442\u0430\u043b\u0430\u0441\u0438, \u0441\u0443\u0448\u0435 \u0438 \u0448\u0443\u043c\u0441\u043a\u0438 \u043f\u043e\u0436\u0430\u0440\u0438, \u043f\u0440\u0435\u043c\u0430 \u043a\u043b\u0430\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0458\u0438 \u041c\u0435\u0452\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0433 \u0441\u0430\u0432\u0458\u0435\u0442\u0430 \u0437\u0430 \u043d\u0430\u0443\u043a\u0443 (ICSU). \u041f\u043e\u0440\u0435\u0434 \u0433\u043e\u0434\u0438\u0448\u045a\u0438\u0445 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442\u0438, \u043f\u0440\u0438\u043a\u0430\u0437\u0443\u0458\u0435 \u0441\u0435 \u0438 \u0438\u0437\u0433\u043b\u0430\u0452\u0435\u043d\u0438 \u0432\u0440\u0435\u043c\u0435\u043d\u0441\u043a\u0438 \u043d\u0438\u0437 \u0437\u0430\u0441\u043d\u043e\u0432\u0430\u043d \u043d\u0430 30-\u0433\u043e\u0434\u0438\u0448\u045a\u0435\u043c \u043f\u043e\u043a\u0440\u0435\u0442\u043d\u043e\u043c \u043f\u0440\u043e\u0441\u0458\u0435\u043a\u0443. \u041e\u0432\u0430\u0458 \u043f\u0440\u043e\u0441\u0458\u0435\u043a \u043e\u043c\u043e\u0433\u0443\u045b\u0430\u0432\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u0434\u0443\u0433\u043e\u0440\u043e\u0447\u043d\u0438\u0458\u0435\u0433 \u0442\u0440\u0435\u043d\u0434\u0430 \u0443\u0437 \u0441\u043c\u0430\u045a\u0435\u045a\u0435 \u0443\u0442\u0438\u0446\u0430\u0458\u0430 \u0432\u0435\u043b\u0438\u043a\u0435 \u043c\u0435\u0452\u0443\u0433\u043e\u0434\u0438\u0448\u045a\u0435 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0435 \u0432\u0430\u0440\u0438\u0458\u0430\u0431\u0438\u043b\u043d\u043e\u0441\u0442\u0438. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u0437\u0430\u0441\u043d\u0438\u0432\u0430 \u043d\u0430 \u043f\u043e\u0434\u0430\u0446\u0438\u043c\u0430 \u0438\u0437 \u0431\u0430\u0437\u0435 CATDAT \u043a\u043e\u0458\u0443 \u043e\u0431\u0435\u0437\u0431\u0458\u0435\u0452\u0443\u0458\u0435 RiskLayer, \u0434\u043e\u043a \u0458\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0430 \u0430\u0433\u0435\u043d\u0446\u0438\u0458\u0430 \u0437\u0430 \u0436\u0438\u0432\u043e\u0442\u043d\u0443 \u0441\u0440\u0435\u0434\u0438\u043d\u0443 (EEA) \u043f\u0440\u0443\u0436\u0430\u043b\u0430\u0446 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u0437\u0430 \u0415\u0432\u0440\u043e\u0441\u0442\u0430\u0442. \u0412\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u0441\u0435 \u0438\u0441\u043a\u0430\u0437\u0443\u0458\u0443 \u0443 \u043c\u0438\u043b\u0438\u043e\u043d\u0438\u043c\u0430 \u0435\u0443\u0440\u0430 \u0438 \u0435\u0443\u0440\u0438\u043c\u0430 \u043f\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0443, \u0443 \u0441\u0442\u0430\u043b\u043d\u0438\u043c \u0446\u0438\u0458\u0435\u043d\u0430\u043c\u0430.","eu_rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043f\u0440\u0435\u043c\u0430 \u0426\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 13 \u043e \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u043e\u043c \u0434\u0458\u0435\u043b\u043e\u0432\u0430\u045a\u0443, \u043a\u043e\u0458\u0438 \u0458\u0435 \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0441\u0430\u043d \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435. SDG 13 \u0438\u043c\u0430 \u0437\u0430 \u0446\u0438\u0459 \u0458\u0430\u0447\u0430\u045a\u0435 \u043e\u0442\u043f\u043e\u0440\u043d\u043e\u0441\u0442\u0438 \u0438 \u043a\u0430\u043f\u0430\u0446\u0438\u0442\u0435\u0442\u0430 \u0437\u0430 \u043f\u0440\u0438\u043b\u0430\u0433\u043e\u0452\u0430\u0432\u0430\u045a\u0435 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0438\u043c \u0440\u0438\u0437\u0438\u0446\u0438\u043c\u0430 \u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u0438\u043c \u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438\u043c\u0430 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u0438\u043c \u0441\u0430 \u043a\u043b\u0438\u043c\u043e\u043c, \u043a\u0430\u043e \u0438 \u043f\u043e\u0441\u0442\u0438\u0437\u0430\u045a\u0435 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0435 \u043d\u0435\u0443\u0442\u0440\u0430\u043b\u043d\u043e\u0441\u0442\u0438 \u0434\u043e \u0441\u0440\u0435\u0434\u0438\u043d\u0435 \u0432\u0438\u0458\u0435\u043a\u0430 \u0438 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0430\u0432\u0430\u045a\u0435 \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e\u0433 \u0437\u0430\u0433\u0440\u0438\u0458\u0430\u0432\u0430\u045a\u0430 \u043d\u0430 \u0437\u043d\u0430\u0442\u043d\u043e \u0438\u0441\u043f\u043e\u0434 2 \u00b0C, \u0443\u0437 \u043d\u0430\u0441\u0442\u043e\u0458\u0430\u045a\u0435 \u0434\u0430 \u0441\u0435 \u043e\u043d\u043e \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438 \u043d\u0430 1,5 \u00b0C \u0443 \u043e\u0434\u043d\u043e\u0441\u0443 \u043d\u0430 \u043f\u0440\u0435\u0434\u0438\u043d\u0434\u0443\u0441\u0442\u0440\u0438\u0458\u0441\u043a\u0438 \u043f\u0435\u0440\u0438\u043e\u0434. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0458\u0435 \u0441\u043b\u0438\u0447\u0430\u043d \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u0438\u043c \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0438\u043c\u0430 SDG 1.5.2 \u0438 11.5.2, \u043a\u043e\u0458\u0438 \u043f\u0440\u0430\u0442\u0435 \u0434\u0438\u0440\u0435\u043a\u0442\u043d\u0435 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0435 \u0433\u0443\u0431\u0438\u0442\u043a\u0435 \u0443\u0441\u0459\u0435\u0434 \u043a\u0430\u0442\u0430\u0441\u0442\u0440\u043e\u0444\u0430 \u0443 \u043e\u0434\u043d\u043e\u0441\u0443 \u043d\u0430 \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u0438 \u0411\u0414\u041f.","eu_methodology_characteristics":"\u0415\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0438 \u0433\u0443\u0431\u0438\u0446\u0438 \u043e\u0434 \u0432\u0440\u0435\u043c\u0435\u043d\u0441\u043a\u0438\u0445 \u0438 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0438\u0445 \u0435\u043a\u0441\u0442\u0440\u0435\u043c\u0430 \u043f\u043e\u043a\u0430\u0437\u0443\u0458\u0443 \u0432\u0435\u043b\u0438\u043a\u0443 \u043c\u0435\u0452\u0443\u0433\u043e\u0434\u0438\u0448\u045a\u0443 \u0432\u0430\u0440\u0438\u0458\u0430\u0431\u0438\u043b\u043d\u043e\u0441\u0442, \u0437\u0431\u043e\u0433 \u0447\u0435\u0433\u0430 \u0441\u0435 \u0443\u0437 \u0433\u043e\u0434\u0438\u0448\u045a\u0435 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 30-\u0433\u043e\u0434\u0438\u0448\u045a\u0438 \u043f\u043e\u043a\u0440\u0435\u0442\u043d\u0438 \u043f\u0440\u043e\u0441\u0458\u0435\u043a. \u041d\u0430 \u0442\u0430\u0458 \u043d\u0430\u0447\u0438\u043d \u043e\u043c\u043e\u0433\u0443\u045b\u0430\u0432\u0430 \u0441\u0435 \u0441\u0442\u0430\u0431\u0438\u043b\u043d\u0438\u0458\u0435 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u0434\u0443\u0433\u043e\u0440\u043e\u0447\u043d\u043e\u0433 \u043a\u0440\u0435\u0442\u0430\u045a\u0430 \u0433\u0443\u0431\u0438\u0442\u0430\u043a\u0430. \u0417\u0430 \u043f\u043e\u0442\u0440\u0435\u0431\u0435 \u043f\u0440\u043e\u0446\u0458\u0435\u043d\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0441\u0435 \u0430\u043f\u0441\u043e\u043b\u0443\u0442\u043d\u0430 \u043c\u0458\u0435\u0440\u043d\u0430 \u0458\u0435\u0434\u0438\u043d\u0438\u0446\u0430 \u043c\u0438\u043b\u0438\u043e\u043d \u0435\u0443\u0440\u0430, \u0434\u043e\u043a \u0441\u0435 \u0437\u0430 \u043f\u0440\u043e\u0446\u0458\u0435\u043d\u0443 \u0441\u0442\u0430\u0442\u0443\u0441\u0430 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442 \u0443 \u0435\u0443\u0440\u0438\u043c\u0430 \u043f\u043e \u04