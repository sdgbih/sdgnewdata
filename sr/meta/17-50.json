{"indicator_number":17.5,"reporting_status":"complete","published":true,"sdg_goal":"17","data_non_statistical":false,"graph_type":"line","indicator_sort_order":"17-50","indicator_name":"\u0423\u0434\u0438\u043e \u0435\u043a\u043e\u043b\u043e\u0448\u043a\u0438\u0445 \u043f\u043e\u0440\u0435\u0437\u0430 \u0443 \u0443\u043a\u0443\u043f\u043d\u0438\u043c \u043f\u043e\u0440\u0435\u0441\u043a\u0438\u043c \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u043c\u0430","source_active_1":true,"source_organisation_1":"BHAS","source_url_1":"https://bhas.gov.ba/data/Publikacije/Saopstenja/2025/ENV_24_2023_Y1_1_BS.pdf","footer_fields":[{"label":"\u0420\u0435\u0444\u0435\u0440\u0435\u043d\u0442\u043d\u0438 \u043c\u0435\u0442\u0430\u043f\u043e\u0434\u0430\u0446\u0438","value":"<a href=\"https://ec.europa.eu/eurostat/cache/metadata/en/sdg_17_50_esmsip2.htm\" target=\"_blank\">Eurostat Metadata Report (sdg_17_50)</a>"}],"graph_titles":[{"series":"\u0423\u0434\u0438\u043e \u0435\u043a\u043e\u043b\u043e\u0448\u043a\u0438\u0445 \u043f\u043e\u0440\u0435\u0437\u0430 \u0443 \u0443\u043a\u0443\u043f\u043d\u0438\u043c \u043f\u043e\u0440\u0435\u0441\u043a\u0438\u043c \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u043c\u0430","title":"\u0423\u0434\u0438\u043e \u0435\u043a\u043e\u043b\u043e\u0448\u043a\u0438\u0445 \u043f\u043e\u0440\u0435\u0437\u0430 \u0443 \u0443\u043a\u0443\u043f\u043d\u0438\u043c \u043f\u043e\u0440\u0435\u0441\u043a\u0438\u043c \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u043c\u0430"}],"national_indicator_definition":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043c\u0458\u0435\u0440\u0438 \u0443\u0434\u0438\u043e \u043f\u043e\u0440\u0435\u0437\u0430 \u043d\u0430 \u0437\u0430\u0448\u0442\u0438\u0442\u0443 \u0436\u0438\u0432\u043e\u0442\u043d\u0435 \u0441\u0440\u0435\u0434\u0438\u043d\u0435 \u0443 \u0443\u043a\u0443\u043f\u043d\u0438\u043c \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u043c\u0430 \u043e\u0434 \u043f\u043e\u0440\u0435\u0437\u0430 \u0438 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u0438\u0445 \u0434\u043e\u043f\u0440\u0438\u043d\u043e\u0441\u0430. \u041f\u043e\u0440\u0435\u0437\u0438 \u043d\u0430 \u0437\u0430\u0448\u0442\u0438\u0442\u0443 \u0436\u0438\u0432\u043e\u0442\u043d\u0435 \u0441\u0440\u0435\u0434\u0438\u043d\u0435 \u0441\u0443 \u0434\u0435\u0444\u0438\u043d\u0438\u0441\u0430\u043d\u0438 \u043a\u0430\u043e \u043f\u043e\u0440\u0435\u0437\u0438 \u0447\u0438\u0458\u0430 \u0458\u0435 \u043f\u043e\u0440\u0435\u0441\u043a\u0430 \u043e\u0441\u043d\u043e\u0432\u0438\u0446\u0430 \u0444\u0438\u0437\u0438\u0447\u043a\u0430 \u0458\u0435\u0434\u0438\u043d\u0438\u0446\u0430 (\u0438\u043b\u0438 \u045a\u0435\u043d\u0430 \u0437\u0430\u043c\u0435\u043d\u0430) \u043d\u0435\u0447\u0435\u0433\u0430 \u0448\u0442\u043e \u0438\u043c\u0430 \u0434\u043e\u043a\u0430\u0437\u0430\u043d, \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0430\u043d \u043d\u0435\u0433\u0430\u0442\u0438\u0432\u0430\u043d \u0443\u0442\u0438\u0446\u0430\u0458 \u043d\u0430 \u0436\u0438\u0432\u043e\u0442\u043d\u0443 \u0441\u0440\u0435\u0434\u0438\u043d\u0443. \u041f\u0440\u0438\u0445\u043e\u0434\u0438 \u043e\u0434 \u043f\u043e\u0440\u0435\u0437\u0430 \u043d\u0430 \u0437\u0430\u0448\u0442\u0438\u0442\u0443 \u0436\u0438\u0432\u043e\u0442\u043d\u0435 \u0441\u0440\u0435\u0434\u0438\u043d\u0435 \u0434\u043e\u043b\u0430\u0437\u0435 \u0438\u0437 \u0447\u0435\u0442\u0438\u0440\u0438 \u0432\u0440\u0441\u0442\u0435 \u043f\u043e\u0440\u0435\u0437\u0430: \u043f\u043e\u0440\u0435\u0437\u0438 \u043d\u0430 \u0435\u043d\u0435\u0440\u0433\u0438\u0458\u0443 (\u043a\u043e\u0458\u0438 \u0434\u043e\u043f\u0440\u0438\u043d\u043e\u0441\u0435 \u043e\u043a\u043e \u0442\u0440\u0438 \u0447\u0435\u0442\u0432\u0440\u0442\u0438\u043d\u0435 \u0443\u043a\u0443\u043f\u043d\u043e\u0433 \u0438\u0437\u043d\u043e\u0441\u0430), \u043f\u043e\u0440\u0435\u0437\u0438 \u043d\u0430 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442 (\u043e\u043a\u043e \u0458\u0435\u0434\u043d\u0435 \u043f\u0435\u0442\u0438\u043d\u0435 \u0443\u043a\u0443\u043f\u043d\u043e\u0433 \u0438\u0437\u043d\u043e\u0441\u0430) \u0438 \u043f\u043e\u0440\u0435\u0437\u0438 \u043d\u0430 \u0437\u0430\u0433\u0430\u0452\u0435\u045a\u0435 \u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u0435 (\u043e\u043a\u043e 4% \u0443\u043a\u0443\u043f\u043d\u043e\u0433 \u0438\u0437\u043d\u043e\u0441\u0430).","national_rationale":"\u041f\u0440\u0438\u043f\u0440\u0435\u043c\u0459\u0435\u043d\u0430 \u0458\u0435 \u043b\u0438\u0441\u0442\u0430 \u0435\u043a\u043e\u043b\u043e\u0448\u043a\u0438\u0445 \u043f\u043e\u0440\u0435\u0437\u0430 \u0437\u0430 \u0411\u043e\u0441\u043d\u0443 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0443. \u0421\u0432\u0438 \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u043e\u0432\u0430\u043d\u0438 \u0435\u043a\u043e\u043b\u043e\u0448\u043a\u0438 \u043f\u043e\u0440\u0435\u0437\u0438 \u0433\u0440\u0443\u043f\u0438\u0441\u0430\u043d\u0438 \u0441\u0443 \u0443 \u0447\u0435\u0442\u0438\u0440\u0438 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0458\u0435: \u043f\u043e\u0440\u0435\u0437\u0438 \u043d\u0430 \u0435\u043d\u0435\u0440\u0433\u0438\u0458\u0443, \u043f\u043e\u0440\u0435\u0437\u0438 \u043d\u0430 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442, \u0437\u0430\u0433\u0430\u0452\u0435\u045a\u0435 \u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u0435. \u0421\u043f\u0438\u0441\u0430\u043a \u043f\u043e\u0440\u0435\u0437\u0430 \u043d\u0430 CO2, \u043a\u0430\u043e \u0438 \u043e\u0441\u0442\u0430\u043b\u0438\u0445 \u043f\u043e\u0440\u0435\u0437\u0430 \u043d\u0430 CO2, \u043d\u0435 \u043f\u043e\u0441\u0442\u043e\u0458\u0438 \u0443 \u0411\u043e\u0441\u043d\u0438 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0438 \u0437\u0430 \u0438\u0437\u0432\u0458\u0435\u0448\u0442\u0430\u0458\u043d\u0438 \u043f\u0435\u0440\u0438\u043e\u0434. \u0415\u043a\u043e\u043b\u043e\u0448\u043a\u0438 \u043f\u043e\u0440\u0435\u0437\u0438 \u0442\u0435\u043c\u0435\u0459\u0435 \u0441\u0435 \u043d\u0430 \u043f\u043e\u0441\u0442\u043e\u0458\u0435\u045b\u043e\u0458 \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u0458 \u043f\u043e\u0440\u0435\u0441\u043a\u043e\u0458 \u043b\u0438\u0441\u0442\u0438 (\u041d\u0422\u041b) \u0426\u0435\u043d\u0442\u0440\u0430\u043b\u043d\u0435 \u0431\u0430\u043d\u043a\u0435 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435 \u0438 \u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438 \u0441\u0443 \u0438\u0437 \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043d\u0438\u0445 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u043e\u0432\u0430\u043d\u0438\u0445 \u0443 \u0438\u0437\u0432\u043e\u0440\u0438\u043c\u0430 \u043f\u043e\u0440\u0435\u0441\u043a\u0438\u0445 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430. \u0421\u0432\u0438 \u043f\u043e\u0434\u0430\u0446\u0438 \u043f\u0440\u0438\u043a\u0443\u043f\u0459\u0430\u0458\u0443 \u0441\u0435 \u0434\u0438\u0440\u0435\u043a\u0442\u043d\u043e \u0438\u0437 \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043d\u0438\u0445 \u0438\u0437\u0432\u043e\u0440\u0430: \u0423\u043f\u0440\u0430\u0432\u0435 \u0437\u0430 \u0438\u043d\u0434\u0438\u0440\u0435\u043a\u0442\u043d\u043e \u043e\u043f\u043e\u0440\u0435\u0437\u0438\u0432\u0430\u045a\u0435 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435, \u041f\u043e\u0440\u0435\u0441\u043a\u0435 \u0443\u043f\u0440\u0430\u0432\u0435 \u0420\u0435\u043f\u0443\u0431\u043b\u0438\u043a\u0435 \u0421\u0440\u043f\u0441\u043a\u0435, \u041f\u043e\u0440\u0435\u0441\u043a\u0435 \u0443\u043f\u0440\u0430\u0432\u0435 \u0424\u0435\u0434\u0435\u0440\u0430\u0446\u0438\u0458\u0435 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435 \u0438 \u0414\u0438\u0440\u0435\u043a\u0446\u0438\u0458\u0435 \u0437\u0430 \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0458\u0435 \u0411\u0440\u0447\u043a\u043e \u0414\u0438\u0441\u0442\u0440\u0438\u043a\u0442\u0430.","national_methodology_characteristics":"\u0423 \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e\u043c \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0443, \u0433\u0434\u0458\u0435 \u043e\u0431\u0440\u0430\u0441\u0446\u0438 \u043f\u043e\u0442\u0440\u043e\u0448\u045a\u0435 \u0443 \u0458\u0435\u0434\u043d\u043e\u043c \u0440\u0435\u0433\u0438\u043e\u043d\u0443 \u043c\u043e\u0433\u0443 \u043e\u0437\u0431\u0438\u0459\u043d\u043e \u0443\u0442\u0438\u0446\u0430\u0442\u0438 \u043d\u0430 \u043e\u0431\u0440\u0430\u0441\u0446\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u045a\u0435 \u0443 \u0434\u0440\u0443\u0433\u0438\u043c \u0434\u0438\u0458\u0435\u043b\u043e\u0432\u0438\u043c\u0430 \u0441\u0432\u0438\u0458\u0435\u0442\u0430, \u043f\u043e\u0441\u0435\u0431\u043d\u043e \u0458\u0435 \u0432\u0430\u0436\u043d\u043e \u0434\u0430 \u0446\u0438\u0458\u0435\u043d\u0435 \u043e\u0434\u0440\u0430\u0436\u0430\u0432\u0430\u0458\u0443 \u0441\u0442\u0432\u0430\u0440\u043d\u0435 \u0442\u0440\u043e\u0448\u043a\u043e\u0432\u0435 \u043f\u043e\u0442\u0440\u043e\u0448\u045a\u0435 \u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u045a\u0435. \u0421\u0442\u043e\u0433\u0430 \u0431\u0438 \u0442\u0440\u0435\u0431\u0430\u043b\u043e \u0434\u0430 \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443 \u0438 \u043f\u043b\u0430\u045b\u0430\u045a\u0430 \u0437\u0430 \u0448\u0442\u0435\u0442\u0443 \u043a\u043e\u0458\u0443 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0443\u0437\u0440\u043e\u043a\u0443\u0458\u0443 \u0459\u0443\u0434\u0441\u043a\u043e\u043c \u0437\u0434\u0440\u0430\u0432\u0459\u0443 \u0438 \u0436\u0438\u0432\u043e\u0442\u043d\u043e\u0458 \u0441\u0440\u0435\u0434\u0438\u043d\u0438. \u041f\u043e\u043b\u0438\u0442\u0438\u043a\u0435 \u0415\u0423, \u043f\u043e\u043f\u0443\u0442 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u043e\u0433 \u0437\u0435\u043b\u0435\u043d\u043e\u0433 \u043f\u043b\u0430\u043d\u0430, \u043f\u043e\u0437\u0438\u0432\u0430\u0458\u0443 \u043d\u0430 \u043f\u0440\u0435\u043b\u0430\u0437\u0430\u043a \u0441\u0430 \u043f\u043e\u0440\u0435\u0437\u0430 \u043d\u0430 \u0440\u0430\u0434 \u043d\u0430 \u043f\u043e\u0440\u0435\u0437\u0435 \u043d\u0430 \u0435\u043d\u0435\u0440\u0433\u0438\u0458\u0443 \u0438 \u0436\u0438\u0432\u043e\u0442\u043d\u0443 \u0441\u0440\u0435\u0434\u0438\u043d\u0443 \u043a\u0430\u043e \u0434\u0438\u043e \u201e\u043e\u0437\u0435\u043b\u0435\u045a\u0430\u0432\u0430\u045a\u0430\u201c \u043f\u043e\u0440\u0435\u0441\u043a\u0438\u0445 \u0441\u0438\u0441\u0442\u0435\u043c\u0430, \u0448\u0442\u043e \u0437\u043d\u0430\u0447\u0438 \u0434\u0430 \u0431\u0438 \u0441\u0435 \u043f\u0440\u0438\u0445\u043e\u0434\u0438 \u043e\u0434 \u043f\u043e\u0440\u0435\u0437\u0430 \u043d\u0430 \u0436\u0438\u0432\u043e\u0442\u043d\u0443 \u0441\u0440\u0435\u0434\u0438\u043d\u0443 \u0442\u0440\u0435\u0431\u0430\u043b\u0438 \u043f\u043e\u0432\u0435\u045b\u0430\u0442\u0438 \u0443 \u043e\u0434\u043d\u043e\u0441\u0443 \u043d\u0430 \u043f\u043e\u0440\u0435\u0437\u0435 \u043d\u0430 \u0440\u0430\u0434. \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0438 \u0441\u0435\u043c\u0435\u0441\u0442\u0430\u0440 \u043f\u0440\u0430\u0442\u0438 \u043d\u0430\u043f\u0440\u0435\u0434\u0430\u043a \u043a\u0430 \u0446\u0438\u0459\u0435\u0432\u0438\u043c\u0430 \u043f\u043e\u0441\u0442\u0430\u0432\u0459\u0435\u043d\u0438\u043c \u0443 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0438\u043c \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0430\u043c\u0430.","national_long_objective":"\u041d\u0435\u043c\u0430 \u043e\u043f\u0438\u0441\u0430","eu_indicator_definition":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043c\u0458\u0435\u0440\u0438 \u0443\u0434\u0438\u043e \u043f\u043e\u0440\u0435\u0437\u0430 \u043d\u0430 \u0437\u0430\u0448\u0442\u0438\u0442\u0443 \u0436\u0438\u0432\u043e\u0442\u043d\u0435 \u0441\u0440\u0435\u0434\u0438\u043d\u0435 \u0443 \u0443\u043a\u0443\u043f\u043d\u0438\u043c \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u043c\u0430 \u043e\u0434 \u043f\u043e\u0440\u0435\u0437\u0430 \u0438 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u0438\u0445 \u0434\u043e\u043f\u0440\u0438\u043d\u043e\u0441\u0430. \u041f\u043e\u0440\u0435\u0437\u0438 \u043d\u0430 \u0437\u0430\u0448\u0442\u0438\u0442\u0443 \u0436\u0438\u0432\u043e\u0442\u043d\u0435 \u0441\u0440\u0435\u0434\u0438\u043d\u0435 \u0441\u0443 \u0434\u0435\u0444\u0438\u043d\u0438\u0441\u0430\u043d\u0438 \u043a\u0430\u043e \u043f\u043e\u0440\u0435\u0437\u0438 \u0447\u0438\u0458\u0430 \u0458\u0435 \u043f\u043e\u0440\u0435\u0441\u043a\u0430 \u043e\u0441\u043d\u043e\u0432\u0438\u0446\u0430 \u0444\u0438\u0437\u0438\u0447\u043a\u0430 \u0458\u0435\u0434\u0438\u043d\u0438\u0446\u0430 (\u0438\u043b\u0438 \u045a\u0435\u043d\u0430 \u0437\u0430\u043c\u0435\u043d\u0430) \u043d\u0435\u0447\u0435\u0433\u0430 \u0448\u0442\u043e \u0438\u043c\u0430 \u0434\u043e\u043a\u0430\u0437\u0430\u043d, \u0441\u043f\u0435\u0446\u0438\u0444\u0438\u0447\u0430\u043d \u043d\u0435\u0433\u0430\u0442\u0438\u0432\u0430\u043d \u0443\u0442\u0438\u0446\u0430\u0458 \u043d\u0430 \u0436\u0438\u0432\u043e\u0442\u043d\u0443 \u0441\u0440\u0435\u0434\u0438\u043d\u0443. \u041f\u0440\u0438\u0445\u043e\u0434\u0438 \u043e\u0434 \u043f\u043e\u0440\u0435\u0437\u0430 \u043d\u0430 \u0437\u0430\u0448\u0442\u0438\u0442\u0443 \u0436\u0438\u0432\u043e\u0442\u043d\u0435 \u0441\u0440\u0435\u0434\u0438\u043d\u0435 \u0434\u043e\u043b\u0430\u0437\u0435 \u0438\u0437 \u0447\u0435\u0442\u0438\u0440\u0438 \u0432\u0440\u0441\u0442\u0435 \u043f\u043e\u0440\u0435\u0437\u0430: \u043f\u043e\u0440\u0435\u0437\u0438 \u043d\u0430 \u0435\u043d\u0435\u0440\u0433\u0438\u0458\u0443 (\u043a\u043e\u0458\u0438 \u0434\u043e\u043f\u0440\u0438\u043d\u043e\u0441\u0435 \u043e\u043a\u043e \u0442\u0440\u0438 \u0447\u0435\u0442\u0432\u0440\u0442\u0438\u043d\u0435 \u0443\u043a\u0443\u043f\u043d\u043e\u0433 \u0438\u0437\u043d\u043e\u0441\u0430), \u043f\u043e\u0440\u0435\u0437\u0438 \u043d\u0430 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442 (\u043e\u043a\u043e \u0458\u0435\u0434\u043d\u0435 \u043f\u0435\u0442\u0438\u043d\u0435 \u0443\u043a\u0443\u043f\u043d\u043e\u0433 \u0438\u0437\u043d\u043e\u0441\u0430) \u0438 \u043f\u043e\u0440\u0435\u0437\u0438 \u043d\u0430 \u0437\u0430\u0433\u0430\u0452\u0435\u045a\u0435 \u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u0435 (\u043e\u043a\u043e 4% \u0443\u043a\u0443\u043f\u043d\u043e\u0433 \u0438\u0437\u043d\u043e\u0441\u0430).","eu_rationale":"\u041f\u0440\u0438\u043f\u0440\u0435\u043c\u0459\u0435\u043d\u0430 \u0458\u0435 \u043b\u0438\u0441\u0442\u0430 \u0435\u043a\u043e\u043b\u043e\u0448\u043a\u0438\u0445 \u043f\u043e\u0440\u0435\u0437\u0430 \u0437\u0430 \u0411\u043e\u0441\u043d\u0443 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0443. \u0421\u0432\u0438 \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u043e\u0432\u0430\u043d\u0438 \u0435\u043a\u043e\u043b\u043e\u0448\u043a\u0438 \u043f\u043e\u0440\u0435\u0437\u0438 \u0433\u0440\u0443\u043f\u0438\u0441\u0430\u043d\u0438 \u0441\u0443 \u0443 \u0447\u0435\u0442\u0438\u0440\u0438 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0458\u0435: \u043f\u043e\u0440\u0435\u0437\u0438 \u043d\u0430 \u0435\u043d\u0435\u0440\u0433\u0438\u0458\u0443, \u043f\u043e\u0440\u0435\u0437\u0438 \u043d\u0430 \u0442\u0440\u0430\u043d\u0441\u043f\u043e\u0440\u0442, \u0437\u0430\u0433\u0430\u0452\u0435\u045a\u0435 \u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u0435. \u0421\u043f\u0438\u0441\u0430\u043a \u043f\u043e\u0440\u0435\u0437\u0430 \u043d\u0430 CO2, \u043a\u0430\u043e \u0438 \u043e\u0441\u0442\u0430\u043b\u0438\u0445 \u043f\u043e\u0440\u0435\u0437\u0430 \u043d\u0430 CO2, \u043d\u0435 \u043f\u043e\u0441\u0442\u043e\u0458\u0438 \u0443 \u0411\u043e\u0441\u043d\u0438 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0438 \u0437\u0430 \u0438\u0437\u0432\u0458\u0435\u0448\u0442\u0430\u0458\u043d\u0438 \u043f\u0435\u0440\u0438\u043e\u0434. \u0415\u043a\u043e\u043b\u043e\u0448\u043a\u0438 \u043f\u043e\u0440\u0435\u0437\u0438 \u0442\u0435\u043c\u0435\u0459\u0435 \u0441\u0435 \u043d\u0430 \u043f\u043e\u0441\u0442\u043e\u0458\u0435\u045b\u043e\u0458 \u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u0458 \u043f\u043e\u0440\u0435\u0441\u043a\u043e\u0458 \u043b\u0438\u0441\u0442\u0438 (\u041d\u0422\u041b) \u0426\u0435\u043d\u0442\u0440\u0430\u043b\u043d\u0435 \u0431\u0430\u043d\u043a\u0435 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435 \u0438 \u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438 \u0441\u0443 \u0438\u0437 \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043d\u0438\u0445 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u043e\u0432\u0430\u043d\u0438\u0445 \u0443 \u0438\u0437\u0432\u043e\u0440\u0438\u043c\u0430 \u043f\u043e\u0440\u0435\u0441\u043a\u0438\u0445 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430. \u0421\u0432\u0438 \u043f\u043e\u0434\u0430\u0446\u0438 \u043f\u0440\u0438\u043a\u0443\u043f\u0459\u0430\u0458\u0443 \u0441\u0435 \u0434\u0438\u0440\u0435\u043a\u0442\u043d\u043e \u0438\u0437 \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043d\u0438\u0445 \u0438\u0437\u0432\u043e\u0440\u0430: \u0423\u043f\u0440\u0430\u0432\u0435 \u0437\u0430 \u0438\u043d\u0434\u0438\u0440\u0435\u043a\u0442\u043d\u043e \u043e\u043f\u043e\u0440\u0435\u0437\u0438\u0432\u0430\u045a\u0435 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435, \u041f\u043e\u0440\u0435\u0441\u043a\u0435 \u0443\u043f\u0440\u0430\u0432\u0435 \u0420\u0435\u043f\u0443\u0431\u043b\u0438\u043a\u0435 \u0421\u0440\u043f\u0441\u043a\u0435, \u041f\u043e\u0440\u0435\u0441\u043a\u0435 \u0443\u043f\u0440\u0430\u0432\u0435 \u0424\u0435\u0434\u0435\u0440\u0430\u0446\u0438\u0458\u0435 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435 \u0438 \u0414\u0438\u0440\u0435\u043a\u0446\u0438\u0458\u0435 \u0437\u0430 \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0458\u0435 \u0411\u0440\u0447\u043a\u043e \u0414\u0438\u0441\u0442\u0440\u0438\u043a\u0442\u0430.","eu_methodology_characteristics":"\u0423 \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e\u043c \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0443, \u0433\u0434\u0458\u0435 \u043e\u0431\u0440\u0430\u0441\u0446\u0438 \u043f\u043e\u0442\u0440\u043e\u0448\u045a\u0435 \u0443 \u0458\u0435\u0434\u043d\u043e\u043c \u0440\u0435\u0433\u0438\u043e\u043d\u0443 \u043c\u043e\u0433\u0443 \u043e\u0437\u0431\u0438\u0459\u043d\u043e \u0443\u0442\u0438\u0446\u0430\u0442\u0438 \u043d\u0430 \u043e\u0431\u0440\u0430\u0441\u0446\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u045a\u0435 \u0443 \u0434\u0440\u0443\u0433\u0438\u043c \u0434\u0438\u0458\u0435\u043b\u043e\u0432\u0438\u043c\u0430 \u0441\u0432\u0438\u0458\u0435\u0442\u0430, \u043f\u043e\u0441\u0435\u0431\u043d\u043e \u0458\u0435 \u0432\u0430\u0436\u043d\u043e \u0434\u0430 \u0446\u0438\u0458\u0435\u043d\u0435 \u043e\u0434\u0440\u0430\u0436\u0430\u0432\u0430\u0458\u0443 \u0441\u0442\u0432\u0430\u0440\u043d\u0435 \u0442\u0440\u043e\u0448\u043a\u043e\u0432\u0435 \u043f\u043e\u0442\u0440\u043e\u0448\u045a\u0435 \u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u045a\u0435. \u0421\u0442\u043e\u0433\u0430 \u0431\u0438 \u0442\u0440\u0435\u0431\u0430\u043b\u043e \u0434\u0430 \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443 \u0438 \u043f\u043b\u0430\u045b\u0430\u045a\u0430 \u0437\u0430 \u0448\u0442\u0435\u0442\u0443 \u043a\u043e\u0458\u0443 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0438 \u0443\u0437\u0440\u043e\u043a\u0443\u0458\u0443 \u0459\u0443\u0434\u0441\u043a\u043e\u043c \u0437\u0434\u0440\u0430\u0432\u04