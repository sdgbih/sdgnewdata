{"indicator_number":2.1,"reporting_status":"complete","published":true,"sdg_goal":"2","data_non_statistical":false,"graph_type":"bar","indicator_sort_order":"02-10","indicator_name":"\u0421\u0442\u043e\u043f\u0430 \u0433\u043e\u0458\u0430\u0437\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u0435\u043c\u0430 \u0438\u043d\u0434\u0435\u043a\u0441\u0443 \u0442j\u0435\u043b\u0435\u0441\u043d\u0435 \u043c\u0430\u0441\u0435 (BMI)","source_active_1":true,"source_organisation_1":"ESS (EHIS & SILC)","source_url_1":"https://ec.europa.eu/eurostat/databrowser/view/sdg_02_10/default/table","graph_titles":[{"series":"\u0421\u0442\u043e\u043f\u0430 \u0433\u043e\u0458\u0430\u0437\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u0435\u043c\u0430 \u0438\u043d\u0434\u0435\u043a\u0441\u0443 \u0442j\u0435\u043b\u0435\u0441\u043d\u0435 \u043c\u0430\u0441\u0435 (BMI)","title":"\u0421\u0442\u043e\u043f\u0430 \u0433\u043e\u0458\u0430\u0437\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u0435\u043c\u0430 \u0438\u043d\u0434\u0435\u043a\u0441\u0443 \u0442j\u0435\u043b\u0435\u0441\u043d\u0435 \u043c\u0430\u0441\u0435 (BMI)"}],"national_indicator_definition":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043f\u0440\u0438\u043a\u0430\u0437\u0443\u0458\u0435 \u0443\u0434\u0438\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u0430 \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u0438 18 \u0438 \u0432\u0438\u0448\u0435 \u0433\u043e\u0434\u0438\u043d\u0430 \u043a\u043e\u0458\u0435 \u0458\u0435 \u043a\u043b\u0430\u0441\u0438\u0444\u0438\u043a\u043e\u0432\u0430\u043d\u043e \u043a\u0430\u043e \u0433\u043e\u0458\u0430\u0437\u043d\u043e \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0443 \u0438\u043d\u0434\u0435\u043a\u0441\u0430 \u0442\u0458\u0435\u043b\u0435\u0441\u043d\u0435 \u043c\u0430\u0441\u0435 (BMI). \u0413\u043e\u0458\u0430\u0437\u043d\u043e\u0441\u0442 \u0441\u0435 \u0434\u0435\u0444\u0438\u043d\u0438\u0448\u0435 \u043a\u0430\u043e BMI \u043e\u0434 30 kg/m\u00b2 \u0438\u043b\u0438 \u0432\u0438\u0448\u0435. BMI \u0441\u0435 \u0438\u0437\u0440\u0430\u0447\u0443\u043d\u0430\u0432\u0430 \u043a\u0430\u043e \u0442\u0458\u0435\u043b\u0435\u0441\u043d\u0430 \u043c\u0430\u0441\u0430 \u0443 \u043a\u0438\u043b\u043e\u0433\u0440\u0430\u043c\u0438\u043c\u0430 \u043f\u043e\u0434\u0438\u0458\u0435\u0459\u0435\u043d\u0430 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u043c \u0442\u0458\u0435\u043b\u0435\u0441\u043d\u0435 \u0432\u0438\u0441\u0438\u043d\u0435 \u0443 \u043c\u0435\u0442\u0440\u0438\u043c\u0430.","national_rationale":"\u0418\u0437\u0432\u043e\u0440 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u0437\u0430 \u0411\u043e\u0441\u043d\u0443 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0443 \u0458\u0435 \u0415\u0432\u0440\u043e\u0441\u0442\u0430\u0442\u043e\u0432 \u0441\u043a\u0443\u043f \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u0437\u0430 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 sdg_02_10. \u041f\u043e\u0434\u0430\u0442\u0430\u043a \u0458\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u0430\u043d \u0437\u0430 2022. \u0433\u043e\u0434\u0438\u043d\u0443. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u0438\u0437\u0440\u0430\u0436\u0430\u0432\u0430 \u0443 \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u0438\u043c\u0430, \u0430 \u0441\u0442\u043e\u043f\u0430 \u0433\u043e\u0458\u0430\u0437\u043d\u043e\u0441\u0442\u0438 \u0438\u0437\u0440\u0430\u0447\u0443\u043d\u0430\u0432\u0430 \u0441\u0435 \u043a\u0430\u043e \u0443\u0434\u0438\u043e \u043e\u0441\u043e\u0431\u0430 \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u0438 18 \u0438 \u0432\u0438\u0448\u0435 \u0433\u043e\u0434\u0438\u043d\u0430 \u0441\u0430 BMI-\u0458\u0435\u043c \u043e\u0434 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 30 kg/m\u00b2 \u0443 \u0443\u043a\u0443\u043f\u043d\u043e\u043c \u0431\u0440\u043e\u0458\u0443 \u043e\u0441\u043e\u0431\u0430 \u0442\u0435 \u0441\u0442\u0430\u0440\u043e\u0441\u043d\u0435 \u0433\u0440\u0443\u043f\u0435 \u0437\u0430 \u043a\u043e\u0458\u0435 \u0441\u0435 BMI \u043c\u043e\u0436\u0435 \u0438\u0437\u0440\u0430\u0447\u0443\u043d\u0430\u0442\u0438. \u0415\u0432\u0440\u043e\u0441\u0442\u0430\u0442\u043e\u0432\u0430 \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u0458\u0430 \u0437\u0430 \u043e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u043f\u043e\u0434\u0430\u0442\u043a\u0435 \u0438\u0437 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u043e\u0433 \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u043e\u0433 \u0430\u043d\u043a\u0435\u0442\u043d\u043e\u0433 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0430 (EHIS) \u0438 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u0443\u043d\u0438\u0458\u0435 \u043e \u0434\u043e\u0445\u043e\u0442\u043a\u0443 \u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u043c\u0430 \u0436\u0438\u0432\u043e\u0442\u0430 (EU-SILC). \u0417\u0430 \u043f\u043e\u0434\u0430\u0442\u043a\u0435 \u0438\u0437 SILC-\u0430 \u0440\u0435\u0444\u0435\u0440\u0435\u043d\u0442\u043d\u0435 2022. \u0433\u043e\u0434\u0438\u043d\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0441\u0435 \u0432\u0430\u0440\u0438\u0458\u0430\u0431\u043b\u0430 PH110, \u043a\u043e\u0458\u0430 \u0441\u0435 \u043e\u0434\u043d\u043e\u0441\u0438 \u043d\u0430 \u0438\u043d\u0434\u0435\u043a\u0441 \u0442\u0458\u0435\u043b\u0435\u0441\u043d\u0435 \u043c\u0430\u0441\u0435 (BMI). \u0415\u0443\u0440\u043e\u0441\u0442\u0430\u0442 \u043f\u043e\u0434\u0430\u0442\u043a\u0435 \u0437\u0430 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0434\u043e\u0431\u0438\u0458\u0430 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0443 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u043f\u0440\u0438\u043a\u0443\u043f\u0459\u0435\u043d\u0438\u0445 \u043f\u0443\u0442\u0435\u043c \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438\u0445 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0430.","national_methodology_characteristics":"\u041f\u043e\u0434\u0430\u0442\u0430\u043a \u0437\u0430 2022. \u0433\u043e\u0434\u0438\u043d\u0443 \u043f\u043e\u043a\u0430\u0437\u0443\u0458\u0435 \u0434\u0430 \u0458\u0435 15,7% \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u0430 \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u0438 18 \u0438 \u0432\u0438\u0448\u0435 \u0433\u043e\u0434\u0438\u043d\u0430 \u0431\u0438\u043b\u043e \u0433\u043e\u0458\u0430\u0437\u043d\u043e (BMI \u2265 30 kg/m\u00b2). \u0414\u043e\u0434\u0430\u0442\u043d\u043e, 44,6% \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u0430 \u0438\u043c\u0430\u043b\u043e \u0458\u0435 BMI \u043e\u0434 25 \u0434\u043e \u043c\u0430\u045a\u0435 \u043e\u0434 30 kg/m\u00b2, \u0434\u043e\u043a \u0458\u0435 \u0443\u043a\u0443\u043f\u043d\u043e 60,3% \u0438\u043c\u0430\u043b\u043e BMI \u043e\u0434 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 25 kg/m\u00b2. \u041e\u0432\u0435 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0458\u0435 \u0441\u0443 \u043c\u0435\u0452\u0443\u0441\u043e\u0431\u043d\u043e \u0443\u0441\u0430\u0433\u043b\u0430\u0448\u0435\u043d\u0435: \u0443\u0434\u0438\u043e \u043e\u0441\u043e\u0431\u0430 \u0441\u0430 BMI-\u0458\u0435\u043c \u043e\u0434 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 25 kg/m\u00b2 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430 \u043e\u0441\u043e\u0431\u0435 \u0441\u0430 \u043f\u0440\u0435\u043a\u043e\u043c\u0458\u0435\u0440\u043d\u043e\u043c \u0442\u0458\u0435\u043b\u0435\u0441\u043d\u043e\u043c \u043c\u0430\u0441\u043e\u043c \u0438 \u043e\u0441\u043e\u0431\u0435 \u0441\u0430 \u0433\u043e\u0458\u0430\u0437\u043d\u043e\u0448\u045b\u0443. \u0417\u0430 \u0411\u043e\u0441\u043d\u0443 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0443 \u0443 \u043e\u0432\u043e\u043c \u0441\u043a\u0443\u043f\u0443 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u0458\u0435 \u0441\u0430\u043c\u043e \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442 \u0437\u0430 2022. \u0433\u043e\u0434\u0438\u043d\u0443, \u043f\u0430 \u043d\u0438\u0458\u0435 \u043c\u043e\u0433\u0443\u045b\u0435 \u043f\u0440\u043e\u0446\u0438\u0458\u0435\u043d\u0438\u0442\u0438 \u0432\u0440\u0435\u043c\u0435\u043d\u0441\u043a\u0438 \u0442\u0440\u0435\u043d\u0434 \u043d\u0438\u0442\u0438 \u0438\u0437\u0440\u0430\u0447\u0443\u043d\u0430\u0442\u0438 \u043d\u0430\u043f\u0440\u0435\u0434\u0430\u043a. \u0423\u043f\u043e\u0440\u0435\u0434\u0438\u0432\u043e\u0441\u0442 \u0441\u0430 \u0434\u0440\u0443\u0433\u0438\u043c \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u0437\u0430\u0432\u0438\u0441\u0438 \u0438 \u043e\u0434 \u0438\u0437\u0432\u043e\u0440\u0430 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430, \u043d\u0430\u0447\u0438\u043d\u0430 \u0443\u0442\u0432\u0440\u0452\u0438\u0432\u0430\u045a\u0430 \u0432\u0438\u0441\u0438\u043d\u0435 \u0438 \u0442\u0435\u0436\u0438\u043d\u0435 \u0442\u0435 \u043f\u0440\u0438\u043c\u0438\u0458\u0435\u045a\u0435\u043d\u0435 \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u0458\u0435.","national_long_objective":"\u041f\u0440\u0435\u043a\u043e\u043c\u0458\u0435\u0440\u043d\u0430 \u0442\u0458\u0435\u043b\u0435\u0441\u043d\u0430 \u043c\u0430\u0441\u0430 \u0438 \u0433\u043e\u0458\u0430\u0437\u043d\u043e\u0441\u0442 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430\u0458\u0443 \u0437\u043d\u0430\u0447\u0430\u0458\u043d\u0430 \u0458\u0430\u0432\u043d\u043e\u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0430 \u043f\u0438\u0442\u0430\u045a\u0430 \u0437\u0431\u043e\u0433 \u045a\u0438\u0445\u043e\u0432\u0435 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u043e\u0441\u0442\u0438 \u0441\u0430 \u043f\u043e\u0432\u0435\u045b\u0430\u043d\u0438\u043c \u0440\u0438\u0437\u0438\u043a\u043e\u043c \u043e\u0434 \u0445\u0440\u043e\u043d\u0438\u0447\u043d\u0438\u0445 \u043d\u0435\u0437\u0430\u0440\u0430\u0437\u043d\u0438\u0445 \u0431\u043e\u043b\u0435\u0441\u0442\u0438. \u0423 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u043c \u0438\u0437\u0432\u043e\u0440\u0438\u043c\u0430 \u043d\u0438\u0458\u0435 \u043f\u043e\u0442\u0432\u0440\u0452\u0435\u043d \u0458\u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d, \u043a\u0432\u0430\u043d\u0442\u0438\u0442\u0430\u0442\u0438\u0432\u043d\u043e \u0434\u0435\u0444\u0438\u043d\u0438\u0441\u0430\u043d \u0446\u0438\u0459 \u0437\u0430 \u0411\u043e\u0441\u043d\u0443 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0443 \u043a\u043e\u0458\u0438\u043c \u0431\u0438 \u0441\u0435 \u043e\u0434\u0440\u0435\u0434\u0438\u043b\u043e \u0441\u043c\u0430\u045a\u0435\u045a\u0435 \u0441\u0442\u043e\u043f\u0435 \u0433\u043e\u0458\u0430\u0437\u043d\u043e\u0441\u0442\u0438 \u0437\u0430 \u043e\u0434\u0440\u0435\u0452\u0435\u043d\u0438 \u043f\u0440\u043e\u0446\u0435\u043d\u0430\u0442 \u0434\u043e \u0443\u0442\u0432\u0440\u0452\u0435\u043d\u043e\u0433 \u0440\u043e\u043a\u0430.","eu_indicator_definition":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043f\u0440\u0438\u043a\u0430\u0437\u0443\u0458\u0435 \u0443\u0434\u0438\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u0430 \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u0438 18 \u0438 \u0432\u0438\u0448\u0435 \u0433\u043e\u0434\u0438\u043d\u0430 \u0441\u0430 \u043f\u0440\u0435\u043a\u043e\u043c\u0458\u0435\u0440\u043d\u043e\u043c \u0442\u0458\u0435\u043b\u0435\u0441\u043d\u043e\u043c \u043c\u0430\u0441\u043e\u043c \u0438 \u0433\u043e\u0458\u0430\u0437\u043d\u043e\u0448\u045b\u0443, \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0443 \u0438\u043d\u0434\u0435\u043a\u0441\u0430 \u0442\u0458\u0435\u043b\u0435\u0441\u043d\u0435 \u043c\u0430\u0441\u0435 (BMI). BMI \u0441\u0435 \u0438\u0437\u0440\u0430\u0447\u0443\u043d\u0430\u0432\u0430 \u043a\u0430\u043e \u0442\u0458\u0435\u043b\u0435\u0441\u043d\u0430 \u043c\u0430\u0441\u0430 \u0443 \u043a\u0438\u043b\u043e\u0433\u0440\u0430\u043c\u0438\u043c\u0430 \u043f\u043e\u0434\u0438\u0458\u0435\u0459\u0435\u043d\u0430 \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u043e\u043c \u0442\u0458\u0435\u043b\u0435\u0441\u043d\u0435 \u0432\u0438\u0441\u0438\u043d\u0435 \u0443 \u043c\u0435\u0442\u0440\u0438\u043c\u0430. \u041f\u0440\u0435\u043a\u043e\u043c\u0458\u0435\u0440\u043d\u0430 \u0442\u0458\u0435\u043b\u0435\u0441\u043d\u0430 \u043c\u0430\u0441\u0430 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430 BMI \u043e\u0434 25 \u0434\u043e \u043c\u0430\u045a\u0435 \u043e\u0434 30 kg/m\u00b2, \u0430 \u0433\u043e\u0458\u0430\u0437\u043d\u043e\u0441\u0442 BMI \u043e\u0434 30 kg/m\u00b2 \u0438\u043b\u0438 \u0432\u0438\u0448\u0435. \u0423\u043a\u0443\u043f\u043d\u0438 \u0443\u0434\u0438\u043e \u043e\u0441\u043e\u0431\u0430 \u0441\u0430 BMI-\u0458\u0435\u043c \u043e\u0434 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 25 kg/m\u00b2 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430 \u043e\u0431\u0458\u0435 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0458\u0435.","eu_rationale":"\u0418\u0437\u0432\u043e\u0440 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u0458\u0435 \u0415\u0432\u0440\u043e\u0441\u0442\u0430\u0442, \u0441\u043a\u0443\u043f \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 sdg_02_10. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u0437\u0430\u0441\u043d\u0438\u0432\u0430 \u043d\u0430 \u043f\u043e\u0434\u0430\u0446\u0438\u043c\u0430 \u0438\u0437 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u043e\u0433 \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u043e\u0433 \u0430\u043d\u043a\u0435\u0442\u043d\u043e\u0433 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0430 (EHIS) \u0438 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u0443\u043d\u0438\u0458\u0435 \u043e \u0434\u043e\u0445\u043e\u0442\u043a\u0443 \u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u043c\u0430 \u0436\u0438\u0432\u043e\u0442\u0430 (EU-SILC). \u0421\u0442\u043e\u043f\u0430 \u0433\u043e\u0458\u0430\u0437\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430 \u0443\u0434\u0438\u043e \u043e\u0441\u043e\u0431\u0430 \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u0438 18 \u0438 \u0432\u0438\u0448\u0435 \u0433\u043e\u0434\u0438\u043d\u0430 \u0441\u0430 BMI-\u0458\u0435\u043c \u043e\u0434 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 30 kg/m\u00b2 \u043c\u0435\u0452\u0443 \u043e\u0441\u043e\u0431\u0430\u043c\u0430 \u0437\u0430 \u043a\u043e\u0458\u0435 \u0441\u0435 BMI \u043c\u043e\u0436\u0435 \u0438\u0437\u0440\u0430\u0447\u0443\u043d\u0430\u0442\u0438. \u0420\u0435\u0437\u0443\u043b\u0442\u0430\u0442\u0438 \u0441\u0435 \u0438\u0437\u0440\u0430\u0436\u0430\u0432\u0430\u0458\u0443 \u0443 \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u0438\u043c\u0430.","eu_methodology_characteristics":"\u041f\u043e\u0434\u0430\u0446\u0438 \u0441\u0435 \u043e\u0434\u043d\u043e\u0441\u0435 \u043d\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u043e \u0441\u0442\u0430\u0440\u043e\u0441\u0442\u0438 18 \u0438 \u0432\u0438\u0448\u0435 \u0433\u043e\u0434\u0438\u043d\u0430. \u0414\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0441\u0442 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u0437\u0430\u0432\u0438\u0441\u0438 \u043e\u0434 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0430 \u0438 \u0440\u0435\u0444\u0435\u0440\u0435\u043d\u0442\u043d\u0435 \u0433\u043e\u0434\u0438\u043d\u0435. EHIS \u0441\u0435 \u0441\u043f\u0440\u043e\u0432\u043e\u0434\u0438 \u0443 \u0432\u0438\u0448\u0435\u0433\u043e\u0434\u0438\u0448\u045a\u0438\u043c \u0446\u0438\u043a\u043b\u0443\u0441\u0438\u043c\u0430, \u0434\u043e\u043a \u0441\u0435 \u0440\u0435\u043b\u0435\u0432\u0430\u043d\u0442\u043d\u0438 \u043f\u043e\u0434\u0430\u0446\u0438 \u043e BMI-\u0458\u0443 \u043c\u043e\u0433\u0443 \u043f\u0440\u0438\u043a\u0443\u043f\u0459\u0430\u0442\u0438 \u0438 \u043f\u0443\u0442\u0435\u043c EU-SILC-\u0430. \u041f\u0440\u0438 \u043f\u043e\u0440\u0435\u0452\u0435\u045a\u0443 \u0437\u0435\u043c\u0430\u0459\u0430 \u0438 \u0433\u043e\u0434\u0438\u043d\u0430 \u043f\u043e\u0442\u0440\u0435\u0431\u043d\u043e \u0458\u0435 \u0443\u0437\u0435\u0442\u0438 \u0443 \u043e\u0431\u0437\u0438\u0440 \u0438\u0437\u0432\u043e\u0440 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430, \u043d\u0430\u0447\u0438\u043d \u043f\u0440\u0438\u043a\u0443\u043f\u0459\u0430\u045a\u0430 \u0432\u0438\u0441\u0438\u043d\u0435 \u0438 \u0442\u0435\u0436\u0438\u043d\u0435 \u0438 \u043c\u043e\u0433\u0443\u045b\u0435 \u0440\u0430\u0437\u043b\u0438\u043a\u0435 \u0443 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0443.","eu_long_objective":"\u041f\u0440\u0435\u043a\u043e\u043c\u0458\u0435\u0440\u043d\u0430 \u0442\u0458\u0435\u043b\u0435\u0441\u043d\u0430 \u043c\u0430\u0441\u0430 \u0438 \u0433\u043e\u0458\u0430\u0437\u043d\u043e\u0441\u0442 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430\u0458\u0443 \u0432\u0430\u0436\u043d\u0435 \u0458\u0430\u0432\u043d\u043e\u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0435 \u0438\u0437\u0430\u0437\u043e\u0432\u0435 \u0443 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u043e\u0458 \u0443\u043d\u0438\u0458\u0438 \u0437\u0431\u043e\u0433 \u045a\u0438\u0445\u043e\u0432\u0435 \u043f\u043e\u0432\u0435\u0437\u0430\u043d\u043e\u0441\u0442\u0438 \u0441\u0430 \u0445\u0440\u043e\u043d\u0438\u0447\u043d\u0438\u043c \u043d\u0435\u0437\u0430\u0440\u0430\u0437\u043d\u0438\u043c \u0431\u043e\u043b\u0435\u0441\u0442\u0438\u043c\u0430. \u041e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043e\u043c\u043e\u0433\u0443\u045b\u0430\u0432\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u0443\u0434\u0458\u0435\u043b\u0430 \u043e\u0434\u0440\u0430\u0441\u043b\u043e\u0433 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u0430 \u0441\u0430 \u043f\u0440\u0435\u043a\u043e\u043c\u0458\u0435\u0440\u043d\u043e\u043c \u0442\u0458\u0435\u043b\u0435\u0441\u043d\u043e\u043c \u043c\u0430\u0441\u043e\u043c \u0438 \u0433\u043e\u0458\u0430\u0437\u043d\u043e\u0448\u045b\u0443. \u041d\u0435 \u0442\u0440\u0435\u0431\u0430 \u0433\u0430 \u0442\u0443\u043c\u0430\u0447\u0438\u0442\u0438 \u043a\u0430\u043e \u043c\u0458\u0435\u0440\u0443 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u0430 \u043f\u043e\u0441\u0435\u0431\u043d\u043e\u043c \u043a\u0432\u0430\u043d\u0442\u0438\u0442\u0430\u0442\u0438\u0432\u043d\u043e\u043c \u0446\u0438\u0459\u0443 \u0415\u0423 \u0437\u0430 \u0441\u043c\u0430\u045a\u0435\u045a\u0435 \u0433\u043e\u0458\u0430\u0437\u043d\u043e\u0441\u0442\u0438 \u0430\u043a\u043e \u0442\u0430\u043a\u0430\u0432 \u0446\u0438\u0459 \u043d\u0438\u0458\u0435 \u0438\u0437\u0440\u0438\u0447\u0438\u0442\u043e \u0434\u0435\u0444\u0438\u043d\u0438\u0441\u0430\u043d \u0437\u0430 \u043e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440.","target_number":"2.10","goal_number":"2","graph_title":"\u0421\u0442\u043e\u043f\u0430 \u0433\u043e\u0458\u0430\u0437\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u0435\u043c\u0430 \u0438\u043d\u0434\u0435\u043a\u0441\u0443 \u0442j\u0435\u043b\u0435\u0441\u043d\u0435 \u043c\u0430\u0441\u0435 (BMI)"}