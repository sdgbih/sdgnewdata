58\u0435\u043d\u0438 \u0443\u0442\u0438\u0446\u0430\u0458\u0430 \u0441\u0443\u0448\u0435 \u043d\u0430 \u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442 \u0432\u0435\u0433\u0435\u0442\u0430\u0446\u0438\u0458\u0435, \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0443 \u0441\u0430\u0442\u0435\u043b\u0438\u0442\u0441\u043a\u0438\u0445 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u043e \u0441\u0442\u0430\u045a\u0443 \u0432\u0435\u0433\u0435\u0442\u0430\u0446\u0438\u0458\u0435 \u0438 \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043a\u0443 \u0432\u043b\u0430\u0433\u0435 \u0443 \u0437\u0435\u043c\u0459\u0438\u0448\u0442\u0443 \u0442\u043e\u043a\u043e\u043c \u0432\u0435\u0433\u0435\u0442\u0430\u0446\u0438\u043e\u043d\u0435 \u0441\u0435\u0437\u043e\u043d\u0435.","national_rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043f\u0440\u0443\u0436\u0430 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0458\u0435 \u043e \u043f\u0440\u043e\u0441\u0442\u043e\u0440\u043d\u043e\u043c \u043e\u0431\u0438\u043c\u0443 \u0443\u0442\u0438\u0446\u0430\u0458\u0430 \u0441\u0443\u0448\u0435 \u043d\u0430 \u0435\u043a\u043e\u0441\u0438\u0441\u0442\u0435\u043c\u0435. \u0412\u0430\u0436\u0430\u043d \u0458\u0435 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043f\u043e\u0441\u0459\u0435\u0434\u0438\u0446\u0430 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0435 \u0432\u0430\u0440\u0438\u0458\u0430\u0431\u0438\u043b\u043d\u043e\u0441\u0442\u0438 \u0438 \u043a\u043b\u0438\u043c\u0430\u0442\u0441\u043a\u0438\u0445 \u043f\u0440\u043e\u043c\u0458\u0435\u043d\u0430, \u043f\u0440\u043e\u0446\u0458\u0435\u043d\u0443 \u0440\u0430\u045a\u0438\u0432\u043e\u0441\u0442\u0438 \u0435\u043a\u043e\u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0438 \u043f\u043b\u0430\u043d\u0438\u0440\u0430\u045a\u0435 \u043c\u0458\u0435\u0440\u0430 \u043f\u0440\u0438\u043b\u0430\u0433\u043e\u0452\u0430\u0432\u0430\u045a\u0430 \u0441\u0443\u0448\u0438.","national_methodology_characteristics":"\u041f\u0440\u0435\u043c\u0430 \u043f\u043e\u0434\u0430\u0446\u0438\u043c\u0430 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u0430\u0433\u0435\u043d\u0446\u0438\u0458\u0435 \u0437\u0430 \u0436\u0438\u0432\u043e\u0442\u043d\u0443 \u0441\u0440\u0435\u0434\u0438\u043d\u0443 (EEA), \u0443\u0434\u0438\u043e \u0442\u0435\u0440\u0438\u0442\u043e\u0440\u0438\u0458\u0435 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435 \u043f\u043e\u0433\u043e\u0452\u0435\u043d\u0435 \u0441\u0443\u0448\u043e\u043c \u0438\u0437\u043d\u043e\u0441\u0438\u043e \u0458\u0435 3,1% \u0443 2015. \u0433\u043e\u0434\u0438\u043d\u0438, \u0434\u043e\u043a \u0458\u0435 \u0443 2024. \u0433\u043e\u0434\u0438\u043d\u0438 \u0438\u0437\u043d\u043e\u0441\u0438\u043e 4,0%. \u0422\u043e\u043a\u043e\u043c \u043f\u043e\u0441\u043c\u0430\u0442\u0440\u0430\u043d\u043e\u0433 \u043f\u0435\u0440\u0438\u043e\u0434\u0430 \u0437\u0430\u0431\u0438\u0459\u0435\u0436\u0435\u043d\u0435 \u0441\u0443 \u0437\u043d\u0430\u0447\u0430\u0458\u043d\u0435 \u0433\u043e\u0434\u0438\u0448\u045a\u0435 \u043e\u0441\u0446\u0438\u043b\u0430\u0446\u0438\u0458\u0435, \u0430 \u043d\u0430\u0458\u0432\u0435\u045b\u0430 \u043f\u0440\u0438\u043a\u0430\u0437\u0430\u043d\u0430 \u0433\u043e\u0434\u0438\u0448\u045a\u0430 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442 \u0438\u0437\u043d\u043e\u0441\u0438\u043b\u0430 \u0458\u0435 46,8% \u0443 2022. \u0433\u043e\u0434\u0438\u043d\u0438. \u0417\u0430 \u0438\u0437\u0440\u0430\u0447\u0443\u043d\u0430\u0432\u0430\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0441\u0435 \u0434\u0435\u0441\u0435\u0442\u043e\u0433\u043e\u0434\u0438\u0448\u045a\u0438 \u043f\u0440\u043e\u0441\u0458\u0435\u043a, \u043a\u043e\u0458\u0438 \u0443\u0431\u043b\u0430\u0436\u0430\u0432\u0430 \u0443\u0442\u0438\u0446\u0430\u0458 \u0433\u043e\u0434\u0438\u0448\u045a\u0438\u04