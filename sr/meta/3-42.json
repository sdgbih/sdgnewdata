42\u043d\u043e\u0441\u0442\u0438 \u043a\u043e\u0458\u0438 \u0441\u0435 \u043c\u043e\u0433\u0443 \u0441\u043f\u0440\u0438\u0458\u0435\u0447\u0438\u0442\u0438 \u0438 \u0438\u0437\u043b\u0438\u0458\u0435\u0447\u0438\u0442\u0438. \u0421\u043c\u0440\u0442\u043d\u043e\u0441\u0442 \u043a\u043e\u0458\u0430 \u0441\u0435 \u043c\u043e\u0436\u0435 \u0441\u043f\u0440\u0438\u0458\u0435\u0447\u0438\u0442\u0438 \u043e\u0434\u043d\u043e\u0441\u0438 \u0441\u0435 \u043d\u0430 \u0441\u043c\u0440\u0442\u043d\u043e\u0441\u0442 \u043a\u043e\u0458\u0430 \u0441\u0435 \u0443\u0433\u043b\u0430\u0432\u043d\u043e\u043c \u043c\u043e\u0436\u0435 \u0438\u0437\u0431\u0458\u0435\u045b\u0438 \u0435\u0444\u0438\u043a\u0430\u0441\u043d\u0438\u043c \u0438\u043d\u0442\u0435\u0440\u0432\u0435\u043d\u0446\u0438\u0458\u0430\u043c\u0430 \u0458\u0430\u0432\u043d\u043e\u0433 \u0437\u0434\u0440\u0430\u0432\u0459\u0430 \u0438 \u043f\u0440\u0438\u043c\u0430\u0440\u043d\u0435 \u043f\u0440\u0435\u0432\u0435\u043d\u0446\u0438\u0458\u0435 (\u0441\u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u0435 \u043f\u0440\u0438\u0458\u0435 \u043f\u043e\u0458\u0430\u0432\u0435 \u0431\u043e\u043b\u0435\u0441\u0442\u0438/\u043f\u043e\u0432\u0440\u0435\u0434\u0430 \u043a\u0430\u043a\u043e \u0431\u0438 \u0441\u0435 \u0441\u043c\u0430\u045a\u0438\u043b\u0430 \u0438\u043d\u0446\u0438\u0434\u0435\u043d\u0446\u0430). \u0418\u0437\u043b\u0438\u0458\u0435\u0447\u0438\u0432\u0430 \u0441\u043c\u0440\u0442\u043d\u043e\u0441\u0442 \u0441\u0435 \u0443\u0433\u043b\u0430\u0432\u043d\u043e\u043c \u043c\u043e\u0436\u0435 \u0438\u0437\u0431\u0458\u0435\u045b\u0438 \u0431\u043b\u0430\u0433\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u0438\u043c \u0438 \u0435\u0444\u0438\u043a\u0430\u0441\u043d\u0438\u043c \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u043c \u0438\u043d\u0442\u0435\u0440\u0432\u0435\u043d\u0446\u0438\u0458\u0430\u043c\u0430, \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443\u045b\u0438 \u0441\u0435\u043a\u0443\u043d\u0434\u0430\u0440\u043d\u0443 \u043f\u0440\u0435\u0432\u0435\u043d\u0446\u0438\u0458\u0443 \u0438 \u043b\u0435\u0447\u0435\u045a\u0435 (\u043d\u0430\u043a\u043e\u043d \u043f\u043e\u0458\u0430\u0432\u0435 \u0431\u043e\u043b\u0435\u0441\u0442\u0438).","rationale":"\u041a\u043e\u0440\u0438\u0441\u0442\u0438 \u0441\u0435 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u0430 \u0446\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 3 \u043e \u0434\u043e\u0431\u0440\u043e\u043c \u0437\u0434\u0440\u0430\u0432\u0459\u0443 \u0438 \u0434\u043e\u0431\u0440\u043e\u0431\u0438\u0442\u0438 \u043a\u043e\u0458\u0438 \u0458\u0435 \u0443\u0433\u0440\u0430\u0452\u0435\u043d \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u0437\u0430 \u043f\u0435\u0440\u0438\u043e\u0434 2024-2029. \u0433\u043e\u0434\u0438\u043d\u0435 \u043f\u043e\u0434 \u043d\u0430\u0437\u0438\u0432\u043e\u043c \u201e\u041f\u043e\u0434\u0440\u0448\u043a\u0430 \u0459\u0443\u0434\u0438\u043c\u0430, \u0458\u0430\u0447\u0430\u045a\u0435 \u043d\u0430\u0448\u0435\u0433 \u0434\u0440\u0443\u0448\u0442\u0432\u0430 \u0438 \u043d\u0430\u0448\u0435\u0433 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u043e\u0433 \u043c\u043e\u0434\u0435\u043b\u0430\u201d.  \u0413\u043b\u0430\u0432\u043d\u0438 \u043f\u0440\u0435\u0434\u0443\u0441\u043b\u043e\u0432 \u0437\u0430 \u043f\u043e\u0441\u0442\u0438\u0437\u0430\u045a\u0435 \u043e\u0432\u0438\u0445 \u0446\u0438\u0459\u0435\u0432\u0430 \u0458\u0435 \u0443\u043d\u0438\u0432\u0435\u0440\u0437\u0430\u043b\u043d\u0430 \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0430 \u043f\u043e\u043a\u0440\u0438\u0432\u0435\u043d\u043e\u0441\u0442; \u043f\u0440\u0438\u0441\u0442\u0443\u043f \u0443\u0441\u043b\u0443\u0433\u0430\u043c\u0430 \u0441\u0435\u043a\u0441\u0443\u0430\u043b\u043d\u043e\u0433 \u0438 \u0440\u0435\u043f\u0440\u043e\u0434\u0443\u043a\u0442\u0438\u0432\u043d\u043e\u0433 \u0437\u0434\u0440\u0430\u0432\u0459\u0430 \u0438 \u0431\u0435\u0437\u0431\u0458\u0435\u0434\u043d\u0438\u043c, \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\u0447\u043d\u0438\u043c \u0438 \u0435\u0444\u0438\u043a\u0430\u0441\u043d\u0438\u043c \u043b\u0438\u0458\u0435\u043a\u043e\u0432\u0438\u043c\u0430 \u0438 \u0432\u0430\u043a\u0446\u0438\u043d\u0430\u043c\u0430 \u0437\u0430 \u0441\u0432\u0435. \u0421\u0442\u0430\u043d\u0434\u0430\u0440\u0434\u0438\u0437\u043e\u0432\u0430\u043d\u0435 \u0441\u0442\u043e\u043f\u0435 \u0441\u043c\u0440\u0442\u043d\u043e\u0441\u0442\u0438 \u043a\u043e\u0458\u0435 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0435 \u0437\u0430 \u043e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0443\u0437\u0438\u043c\u0430\u0458\u0443 \u0443 \u043e\u0431\u0437\u0438\u0440 \u0434\u0430 \u0437\u0435\u043c\u0459\u0435 \u0441\u0430 \u0432\u0435\u045b\u0438\u043c \u0443\u0434\u0458\u0435\u043b\u043e\u043c \u0441\u0442\u0430\u0440\u0438\u0458\u0438\u0445 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0430 \u0442\u0430\u043a\u043e\u0452\u0435 \u0438\u043c\u0430\u0458\u0443 \u0432\u0435\u045b\u0435 \u0441\u0442\u043e\u043f\u0435 \u0441\u043c\u0440\u0442\u043d\u043e\u0441\u0442\u0438.","methodology_characteristics":"\u0423\u043a\u0443\u043f\u043d\u0430 \u0441\u0442\u043e\u043f\u0430 \u0441\u043c\u0440\u0442\u043d\u043e\u0441\u0442\u0438 \u043a\u043e\u0458\u0430 \u0441\u0435 \u043c\u043e\u0436\u0435 \u0438\u0437\u0431\u0458\u0435\u045b\u0438 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430 \u043d\u0438\u0437 \u0437\u0430\u0440\u0430\u0437\u043d\u0438\u0445 \u0431\u043e\u043b\u0435\u0441\u0442\u0438, \u043d\u0435\u043a\u043e\u043b\u0438\u043a\u043e \u0432\u0440\u0441\u0442\u0430 \u043a\u0430\u0440\u0446\u0438\u043d\u043e\u043c\u0430, \u0435\u043d\u0434\u043e\u043a\u0440\u0438\u043d\u0438\u0445 \u0438 \u043c\u0435\u0442\u0430\u0431\u043e\u043b\u0438\u0447\u043a\u0438\u0445 \u0431\u043e\u043b\u0435\u0441\u0442\u0438, \u043a\u0430\u043e \u0438 \u043d\u0435\u043a\u0435 \u0431\u043e\u043b\u0435\u0441\u0442\u0438 \u043d\u0435\u0440\u0432\u043d\u043e\u0433, \u0446\u0438\u0440\u043a\u0443\u043b\u0430\u0442\u043e\u0440\u043d\u043e\u0433, \u0440\u0435\u0441\u043f\u0438\u0440\u0430\u0442\u043e\u0440\u043d\u043e\u0433, \u0434\u0438\u0433\u0435\u0441\u0442\u0438\u0432\u043d\u043e\u0433 \u0438 \u0433\u0435\u043d\u0438\u0442\u043e\u0443\u0440\u0438\u043d\u0430\u0440\u043d\u043e\u0433 \u0441\u0438\u0441\u0442\u0435\u043c\u0430, \u043d\u0435\u043a\u0435 \u0431\u043e\u043b\u0435\u0441\u0442\u0438 \u0432\u0435\u0437\u0430\u043d\u0435 \u0437\u0430 \u0442\u0440\u0443\u0434\u043d\u043e\u045b\u0443, \u043f\u043e\u0440\u043e\u0452\u0430\u0458 \u0438 \u043f\u0435\u0440\u0438\u043d\u0430\u0442\u0430\u043b\u043d\u0438 \u043f\u0435\u0440\u0438\u043e\u0434, \u043d\u0438\u0437 \u0443\u0440\u043e\u0452\u0435\u043d\u0438\u0445 \u043c\u0430\u043b\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0458\u0430, \u043d\u0435\u0436\u0435\u0459\u0435\u043d\u0438\u0445 \u0435\u0444\u0435\u043a\u0430\u0442\u0430 \u043c\u0435\u0434\u0438\u0446\u0438\u043d\u0441\u043a\u0435 \u0438 \u0445\u0438\u0440\u0443\u0440\u0448\u043a\u0435 \u043d\u0435\u0433\u0435, \u0441\u043f\u0438\u0441\u0430\u043a \u043f\u043e\u0432\u0440\u0435\u0434\u0430 \u0438 \u043f\u043e\u0440\u0435\u043c\u0435\u045b\u0430\u0458\u0430 \u0432\u0435\u0437\u0430\u043d\u0438\u0445 \u0437\u0430 \u0430\u043b\u043a\u043e\u0445\u043e\u043b \u0438 \u0434\u0440\u043e\u0433\u0443. \u0421\u043c\u0440\u0442\u043d\u043e\u0441\u0442 \u043a\u043e\u0458\u0430 \u0441\u0435 \u043c\u043e\u0436\u0435 \u043b\u0438\u0458\u0435\u0447\u0438\u0442\u0438 \u0443\u0433\u043b\u0430\u0432\u043d\u043e\u043c \u0441\u0435 \u043c\u043e\u0436\u0435 \u0438\u0437\u0431\u0435\u045b\u0438 \u043f\u0440\u0430\u0432\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u0438\u043c \u0438 \u0435\u0444\u0438\u043a\u0430\u0441\u043d\u0438\u043c \u0438\u043d\u0442\u0435\u0440\u0432\u0435\u043d\u0446\u0438\u0458\u0430\u043c\u0430 \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0435 \u0437\u0430\u0448\u0442\u0438\u0442\u0435, \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443\u045b\u0438 \u0441\u0435\u043a\u0443\u043d\u0434\u0430\u0440\u043d\u0443 \u043f\u0440\u0435\u0432\u0435\u043d\u0446\u0438\u0458\u0443 \u0438 \u043b\u0438\u0458\u0435\u0447\u0435\u045a\u0435 (\u043d\u0430\u043a\u043e\u043d \u043f\u043e\u0458\u0430\u0432\u0435 \u0431\u043e\u043b\u0435\u0441\u0442\u0438 \u043a\u0430\u043a\u043e \u0431\u0438 \u0441\u0435 \u0441\u043c\u0430\u045a\u0438\u043b\u0430 \u0441\u043c\u0440\u0442\u043d\u043e\u0441\u0442 \u043e\u0434 \u0441\u043b\u0443\u0447\u0430\u0458\u0430). \u041f\u043e\u0434\u0430\u0446\u0438 \u0441\u0443 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0435\u043d\u0438 \u043a\u0430\u043e \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0434\u0438\u0437\u043e\u0432\u0430\u043d\u0435 \u0441\u0442\u043e\u043f\u0435 \u0441\u043c\u0440\u0442\u043d\u043e\u0441\u0442\u0438, \u0448\u0442\u043e \u0437\u043d\u0430\u0447\u0438 \u0434\u0430 \u0441\u0443 \u043f\u0440\u0438\u043b\u0430\u0433\u043e\u0452\u0435\u043d\u0438 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0434\u043d\u043e\u0458 \u0441\u0442\u0430\u0440\u043e\u0441\u043d\u043e\u0458 \u0434\u0438\u0441\u0442\u0440\u0438\u0431\u0443\u0446\u0438\u0458\u0438 \u043a\u0430\u043a\u043e \u0431\u0438 \u0441\u0435 \u0438\u0437\u043c\u0458\u0435\u0440\u0438\u043b\u0435 \u0441\u0442\u043e\u043f\u0435 \u0441\u043c\u0440\u0442\u043d\u043e\u0441\u0442\u0438 \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u043d\u043e \u043e\u0434 \u0440\u0430\u0437\u043b\u0438\u0447\u0438\u0442\u0438\u0445 \u0441\u0442\u0430\u0440\u043e\u0441\u043d\u0438\u0445 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430 \u043f\u043e\u043f\u0443\u043b\u0430\u0446\u0438\u0458\u0430 \u043a\u0430\u043a\u043e \u0431\u0438 \u