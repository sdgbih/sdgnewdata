{"indicator_number":10.41,"reporting_status":"complete","published":true,"sdg_goal":"10","data_non_statistical":false,"graph_type":"line","indicator_sort_order":"10-41","indicator_name":"\u0420\u0430\u0441\u043f\u043e\u0434j\u0435\u043b\u0430 \u043f\u0440\u0438\u0445\u043e\u0434\u0430 - \u0437\u0430\u043c\u0458\u0435\u043d\u0441\u043a\u0438 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440","source_active_1":true,"source_organisation_1":"World Bank, Development Research Group.","source_url_1":"https://www.indexmundi.com/facts/bosnia-and-herzegovina/income-distribution","footer_fields":[{"label":"\u0420\u0435\u0444\u0435\u0440\u0435\u043d\u0442\u043d\u0438 \u043c\u0435\u0442\u0430\u043f\u043e\u0434\u0430\u0446\u0438","value":"<a href=\"https://www.indexmundi.com/facts/bosnia-and-herzegovina/indicator/SI.DST.FRST.20\">IndexMundi</a>"}],"graph_titles":[{"series":"\u0420\u0430\u0441\u043f\u043e\u0434j\u0435\u043b\u0430 \u043f\u0440\u0438\u0445\u043e\u0434\u0430 - \u0437\u0430\u043c\u0458\u0435\u043d\u0441\u043a\u0438 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440","title":"\u0420\u0430\u0441\u043f\u043e\u0434j\u0435\u043b\u0430 \u043f\u0440\u0438\u0445\u043e\u0434\u0430 - \u0437\u0430\u043c\u0458\u0435\u043d\u0441\u043a\u0438 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440"}],"national_indicator_definition":"\u041f\u0440\u043e\u0446\u0435\u043d\u0442\u0443\u0430\u043b\u043d\u0438 \u0443\u0434\u0438\u043e \u043f\u0440\u0438\u0445\u043e\u0434\u0430 \u0438\u043b\u0438 \u043f\u043e\u0442\u0440\u043e\u0448\u045a\u0435 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430 \u0443\u0434\u0438\u043e \u043a\u043e\u0458\u0438 \u043f\u0440\u0438\u043f\u0430\u0434\u0430 \u043f\u043e\u0434\u0433\u0440\u0443\u043f\u0430\u043c\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u0430 \u043f\u043e\u0434\u0458\u0435\u0459\u0435\u043d\u0438\u043c \u043d\u0430 \u0434\u0435\u0446\u0438\u043b\u0435 \u0438\u043b\u0438 \u043a\u0432\u0438\u043d\u0442\u0438\u043b\u0435. \u041f\u0440\u043e\u0446\u0435\u043d\u0442\u0443\u0430\u043b\u043d\u0438 \u0443\u0434\u0458\u0435\u043b\u0438 \u043f\u043e \u043a\u0432\u0438\u043d\u0442\u0438\u043b\u0438\u043c\u0430 \u043c\u043e\u0436\u0434\u0430 \u043d\u0435\u045b\u0435 \u0438\u0437\u043d\u043e\u0441\u0438\u0442\u0438 \u0442\u0430\u0447\u043d\u043e 100% \u0437\u0431\u043e\u0433 \u0437\u0430\u043e\u043a\u0440\u0443\u0436\u0438\u0432\u0430\u045a\u0430 \u0431\u0440\u043e\u0458\u0435\u0432\u0430. \u041f\u043e\u0434\u0430\u0446\u0438 \u0441\u0435 \u0437\u0430\u0441\u043d\u0438\u0432\u0430\u0458\u0443 \u043d\u0430 \u043f\u0440\u0438\u043c\u0430\u0440\u043d\u0438\u043c \u043f\u043e\u0434\u0430\u0446\u0438\u043c\u0430 \u0438\u0437 \u0430\u043d\u043a\u0435\u0442\u0430 \u043e \u043f\u043e\u0442\u0440\u043e\u0448\u045a\u0438 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0430\u0432\u0430, \u043f\u0440\u0438\u043a\u0443\u043f\u0459\u0435\u043d\u0438\u043c \u043e\u0434 \u0434\u0440\u0436\u0430\u0432\u043d\u0438\u0445 \u0437\u0430\u0432\u043e\u0434\u0430 \u0437\u0430 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443 \u0438 \u043e\u0434\u0458\u0435\u0459\u0435\u045a\u0430 \u0421\u0432\u0458\u0435\u0442\u0441\u043a\u0435 \u0431\u0430\u043d\u043a\u0435 \u0437\u0430 \u043f\u043e\u0458\u0435\u0434\u0438\u043d\u0435 \u0437\u0435\u043c\u0459\u0435.","national_rationale":"\u0423\u043f\u0440\u043a\u043e\u0441 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0443 \u0443 \u043f\u043e\u0441\u043b\u0435\u0434\u045a\u043e\u0458 \u0434\u0435\u0446\u0435\u043d\u0438\u0458\u0438, \u0438\u0437\u0430\u0437\u043e\u0432\u0438 \u0443 \u043c\u0458\u0435\u0440\u0435\u045a\u0443 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u0438 \u0434\u0430\u0459\u0435 \u043f\u043e\u0441\u0442\u043e\u0458\u0435. \u041f\u0440\u0430\u0432\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043e\u0441\u0442, \u0443\u0447\u0435\u0441\u0442\u0430\u043b\u043e\u0441\u0442, \u043a\u0432\u0430\u043b\u0438\u0442\u0435\u0442 \u0438 \u0443\u043f\u043e\u0440\u0435\u0434\u0438\u0432\u043e\u0441\u0442 \u0430\u043d\u043a\u0435\u0442\u0430 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0430\u0432\u0430 \u043c\u043e\u0440\u0430\u0458\u0443 \u0441\u0435 \u0437\u043d\u0430\u0447\u0430\u0458\u043d\u043e \u043f\u043e\u0432\u0435\u045b\u0430\u0442\u0438, \u043f\u043e\u0441\u0435\u0431\u043d\u043e \u0443 \u043d\u0430\u0458\u0441\u0438\u0440\u043e\u043c\u0430\u0448\u043d\u0438\u0458\u0438\u043c \u0437\u0435\u043c\u0459\u0430\u043c\u0430. \u0410\u043d\u043a\u0435\u0442\u0435 \u0441\u0430\u0434\u0440\u0436\u0435 \u0434\u0435\u0442\u0430\u0459\u043d\u0430 \u043f\u0438\u0442\u0430\u045a\u0430 \u043e \u0438\u0437\u0432\u043e\u0440\u0438\u043c\u0430 \u043f\u0440\u0438\u0445\u043e\u0434\u0430 \u0438 \u043d\u0430\u0447\u0438\u043d\u0443 \u043d\u0430 \u043a\u043e\u0458\u0438 \u0441\u0443 \u043e\u043d\u0438 \u0443\u0442\u0440\u043e\u0448\u0435\u043d\u0438, \u0448\u0442\u043e \u043e\u0431\u0443\u0447\u0435\u043d\u043e \u043e\u0441\u043e\u0431\u0459\u0435 \u043c\u043e\u0440\u0430 \u043f\u0430\u0436\u0459\u0438\u0432\u043e \u0435\u0432\u0438\u0434\u0435\u043d\u0442\u0438\u0440\u0430\u0442\u0438. \u041f\u0440\u0438\u0445\u043e\u0434\u0435 \u0458\u0435 \u0433\u0435\u043d\u0435\u0440\u0430\u043b\u043d\u043e \u0442\u0435\u0436\u0435 \u043f\u0440\u0435\u0446\u0438\u0437\u043d\u043e \u0438\u0437\u043c\u0458\u0435\u0440\u0438\u0442\u0438, \u0434\u043e\u043a \u0458\u0435 \u043f\u043e\u0442\u0440\u043e\u0448\u045a\u0430 \u0431\u043b\u0438\u0436\u0430 \u0441\u0430\u043c\u043e\u043c \u043f\u043e\u0458\u043c\u0443 \u0436\u0438\u0432\u043e\u0442\u043d\u043e\u0433 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0434\u0430. \u0412\u0435\u045b\u0438\u043d\u0430 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u0438\u0437 \u0430\u043d\u043a\u0435\u0442\u0430 \u0434\u0430\u043d\u0430\u0441 \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0435 \u0438 \u043f\u0440\u043e\u0446\u0458\u0435\u043d\u0435 \u0432\u0440\u0435\u0434\u043d\u043e\u0432\u0430\u045a\u0430 \u043f\u043e\u0442\u0440\u043e\u0448\u045a\u0435 \u0438\u043b\u0438 \u043f\u0440\u0438\u0445\u043e\u0434\u0430 \u0438\u0437 \u0441\u043e\u043f\u0441\u0442\u0432\u0435\u043d\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u045a\u0435, \u0430\u043b\u0438 \u0441\u0435 \u043c\u0435\u0442\u043e\u0434\u0435 \u0432\u0440\u0435\u0434\u043d\u043e\u0432\u0430\u045a\u0430 \u0440\u0430\u0437\u043b\u0438\u043a\u0443\u0458\u0443.","national_methodology_characteristics":"\u041d\u0435\u0458\u0435\u0434\u043d\u0430\u043a\u043e\u0441\u0442 \u0443 \u0440\u0430\u0441\u043f\u043e\u0434\u0458\u0435\u043b\u0438 \u0434\u043e\u0445\u043e\u0442\u043a\u0430 \u043e\u0433\u043b\u0435\u0434\u0430 \u0441\u0435 \u0443 \u0443\u0434\u0458\u0435\u043b\u0443 \u0434\u043e\u0445\u043e\u0442\u043a\u0430 \u0438\u043b\u0438 \u043f\u043e\u0442\u0440\u043e\u0448\u045a\u0435 \u043a\u043e\u0458\u0438 \u043f\u0440\u0438\u043f\u0430\u0434\u0430 \u0434\u0438\u0458\u0435\u043b\u0443 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u0430 \u0440\u0430\u043d\u0433\u0438\u0440\u0430\u043d\u043e\u043c \u043f\u0440\u0435\u043c\u0430 \u043d\u0438\u0432\u043e\u0443 \u0434\u043e\u0445\u043e\u0442\u043a\u0430 \u0438\u043b\u0438 \u043f\u043e\u0442\u0440\u043e\u0448\u045a\u0435. \u0414\u0438\u0458\u0435\u043b\u043e\u0432\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u0430 \u043a\u043e\u0458\u0438 \u0441\u0443 \u043d\u0430\u0458\u043d\u0438\u0436\u0435 \u0440\u0430\u043d\u0433\u0438\u0440\u0430\u043d\u0438 \u043f\u043e \u043b\u0438\u0447\u043d\u043e\u043c \u0434\u043e\u0445\u043e\u0442\u043a\u0443 \u043e\u0441\u0442\u0432\u0430\u0440\u0443\u0458\u0443 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 \u0443\u0434\u0458\u0435\u043b\u0435 \u0443 \u0443\u043a\u0443\u043f\u043d\u043e\u043c \u0434\u043e\u0445\u043e\u0442\u043a\u0443. \u041f\u043e\u0434\u0430\u0446\u0438 \u043e \u0440\u0430\u0441\u043f\u043e\u0434\u0458\u0435\u043b\u0438 \u0434\u043e\u0445\u043e\u0442\u043a\u0430 \u0438\u043b\u0438 \u043f\u043e\u0442\u0440\u043e\u0448\u045a\u0435 \u043f\u043e\u0442\u0438\u0447\u0443 \u0438\u0437 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e \u0440\u0435\u043f\u0440\u0435\u0437\u0435\u043d\u0442\u0430\u0442\u0438\u0432\u043d\u0438\u0445 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0430 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0430\u0432\u0430. \u0422\u0430\u043c\u043e \u0433\u0434\u0458\u0435 \u0441\u0443 \u0431\u0438\u043b\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u043d\u0438 \u043f\u043e\u0434\u0430\u0446\u0438 \u0438\u0437 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0430 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0430\u0432\u0430, \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u043d\u0438 \u0441\u0443 \u0437\u0430 \u0434\u0438\u0440\u0435\u043a\u0442\u043d\u043e \u0438\u0437\u0440\u0430\u0447\u0443\u043d\u0430\u0432\u0430\u045a\u0435 \u0443\u0434\u0458\u0435\u043b\u0430 \u0434\u043e\u0445\u043e\u0442\u043a\u0430 \u0438\u043b\u0438 \u043f\u043e\u0442\u0440\u043e\u0448\u045a\u0435 \u043f\u043e \u043a\u0432\u0438\u043d\u0442\u0438\u043b\u0438\u043c\u0430. \u0423 \u0441\u0443\u043f\u0440\u043e\u0442\u043d\u043e\u043c, \u0443\u0434\u0458\u0435\u043b\u0438 \u0441\u0443 \u043f\u0440\u043e\u0446\u0438\u0458\u0435\u045a\u0435\u043d\u0438 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0443 \u043d\u0430\u0458\u0431\u043e\u0459\u0438\u0445 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0445 \u0433\u0440\u0443\u043f\u0438\u0441\u0430\u043d\u0438\u0445 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430. \u041f\u043e\u0434\u0430\u0446\u0438 \u043e \u0440\u0430\u0441\u043f\u043e\u0434\u0458\u0435\u043b\u0438 \u043f\u0440\u0438\u043b\u0430\u0433\u043e\u0452\u0435\u043d\u0438 \u0441\u0443 \u0432\u0435\u043b\u0438\u0447\u0438\u043d\u0438 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0432\u0430, \u0447\u0438\u043c\u0435 \u0441\u0435 \u043e\u0431\u0435\u0437\u0431\u0458\u0435\u0452\u0443\u0458\u0435 \u0434\u043e\u0441\u0459\u0435\u0434\u043d\u0438\u0458\u0430 \u043c\u0458\u0435\u0440\u0430 \u0434\u043e\u0445\u043e\u0442\u043a\u0430 \u0438\u043b\u0438 \u043f\u043e\u0442\u0440\u043e\u0448\u045a\u0435 \u043f\u043e \u0433\u043b\u0430\u0432\u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0430. \u0413\u043e\u0434\u0438\u043d\u0430 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0430 \u0458\u0435 \u0433\u043e\u0434\u0438\u043d\u0430 \u0443 \u043a\u043e\u0458\u043e\u0458 \u0441\u0443 \u043f\u0440\u0438\u043a\u0443\u043f\u0459\u0435\u043d\u0438 \u043e\u0441\u043d\u043e\u0432\u043d\u0438 \u043f\u043e\u0434\u0430\u0446\u0438 \u0438\u0437 \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0430 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0430\u0432\u0430 \u0438\u043b\u0438, \u043a\u0430\u0434\u0430 \u043f\u0435\u0440\u0438\u043e\u0434 \u043f\u0440\u0438\u043a\u0443\u043f\u0459\u0430\u045a\u0430 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430 \u0434\u0432\u0438\u0458\u0435 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u0441\u043a\u0435 \u0433\u043e\u0434\u0438\u043d\u0435, \u0433\u043e\u0434\u0438\u043d\u0430 \u0443 \u043a\u043e\u0458\u043e\u0458 \u0458\u0435 \u043f\u0440\u0438\u043a\u0443\u043f\u0459\u0435\u043d\u0430 \u0432\u0435\u045b\u0438\u043d\u0430 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430. \u041f\u0440\u043e\u0446\u0435\u043d\u0442\u0443\u0430\u043b\u043d\u0438 \u0443\u0434\u0458\u0435\u043b\u0438 \u043f\u043e \u043a\u0432\u0438\u043d\u0442\u0438\u043b\u0438\u043c\u0430 \u043c\u043e\u0436\u0434\u0430 \u043d\u0435\u045b\u0435 \u0438\u0437\u043d\u043e\u0441\u0438\u0442\u0438 100% \u0437\u0431\u043e\u0433 \u0437\u0430\u043e\u043a\u0440\u0443\u0436\u0438\u0432\u0430\u045a\u0430.","national_long_objective":"\u0426\u0438\u0459 \u0413\u0440\u0443\u043f