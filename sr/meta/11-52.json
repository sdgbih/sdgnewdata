35\u043c\u0435\u043d\u0438\u0445 \u0441\u043c\u0440\u0442\u0438 \u0438 \u043a\u0430\u043e \u0431\u0440\u043e\u0458 \u043f\u0440\u0438\u0458\u0435\u0432\u0440\u0435\u043c\u0435\u043d\u0438\u0445 \u0441\u043c\u0440\u0442\u0438 \u043d\u0430 100 000 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0430. \u0417\u0430 \u0430\u0443\u0442\u043e\u043c\u0430\u0442\u0441\u043a\u0438 \u043e\u0431\u0440\u0430\u0447\u0443\u043d \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043d\u0430 \u043f\u043e\u0440\u0442\u0430\u043b\u0443 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0441\u0435 \u0441\u0435\u0440\u0438\u0458\u0430 \u0438\u0437\u0440\u0430\u0436\u0435\u043d\u0430 \u043a\u0430\u043e \u0443\u043a\u0443\u043f\u0430\u043d \u0431\u0440\u043e\u0458 \u043f\u0440\u0438\u0458\u0435\u0432\u0440\u0435\u043c\u0435\u043d\u0438\u0445 \u0441\u043c\u0440\u0442\u0438. \u041d\u0430\u043f\u0440\u0435\u0434\u0430\u043a \u0441\u0435 \u0438\u0437\u0440\u0430\u0447\u0443\u043d\u0430\u0432\u0430 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0443 \u0441\u043b\u043e\u0436\u0435\u043d\u0435 \u043f\u0440\u043e\u0441\u0458\u0435\u0447\u043d\u0435 \u0433\u043e\u0434\u0438\u0448\u045a\u0435 \u0441\u0442\u043e\u043f\u0435 \u043f\u0440\u043e\u043c\u0458\u0435\u043d\u0435 (CAGR), \u043f\u0440\u0438 \u0447\u0435\u043c\u0443 \u0458\u0435 2015. \u0433\u043e\u0434\u0438\u043d\u0430 \u043f\u043e\u0447\u0435\u0442\u043d\u0430 \u0433\u043e\u0434\u0438\u043d\u0430 \u043e\u0431\u0440\u0430\u0447\u0443\u043d\u0430, \u0458\u0435\u0440 \u0441\u0443 \u0437\u0430 \u0442\u0443 \u0433\u043e\u0434\u0438\u043d\u0443 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438 \u043f\u043e\u0434\u0430\u0446\u0438. \u0421\u043c\u0430\u045a\u0435\u045a\u0435 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430 \u043d\u0430\u043f\u0440\u0435\u0434\u0430\u043a.","national_long_objective":"\u0411\u043e\u0441\u043d\u0430 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0430 \u043d\u0435\u043c\u0430 \u043f\u043e\u0441\u0435\u0431\u043d\u043e \u0443\u0442\u0432\u0440\u0452\u0435\u043d \u043a\u0432\u0430\u043d\u0442\u0438\u0442\u0430\u0442\u0438\u0432\u043d\u0438 \u0434\u0443\u0433\u043e\u0440\u043e\u0447\u043d\u0438 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u0446\u0438\u0459 \u0437\u0430 \u043e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440. \u0426\u0438\u0459 \u0415\u0423 \u0441\u043c\u0430\u045a\u0435\u045a\u0430 \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u0445 \u043f\u043e\u0441\u0459\u0435\u0434\u0438\u0446\u0430 \u0437\u0430\u0433\u0430\u0452\u0435\u045a\u0430 \u0432\u0430\u0437\u0434\u0443\u0445\u0430 \u0437\u0430 55% \u0434\u043e 2030. \u0433\u043e\u0434\u0438\u043d\u0435 \u0443 \u043e\u0434\u043d\u043e\u0441\u0443 \u043d\u0430 2005. \u0433\u043e\u0434\u0438\u043d\u0443 \u043e\u0434\u043d\u043e\u0441\u0438 \u0441\u0435 \u043d\u0430 \u043e\u043a\u0432\u0438\u0440 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0435 \u0415\u0423 \u0438 \u043d\u0435 \u0442\u0440\u0435\u0442\u0438\u0440\u0430 \u0441\u0435 \u043a\u0430\u043e \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u0446\u0438\u0459 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435.","eu_indicator_definition":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043c\u0458\u0435\u0440\u0438 \u043f\u0440\u043e\u0446\u0438\u0458\u0435\u045a\u0435\u043d\u0438 \u0431\u0440\u043e\u0458 \u043f\u0440\u0438\u0458\u0435\u0432\u0440\u0435\u043c\u0435\u043d\u0438\u0445 \u0441\u043c\u0440\u0442\u0438 \u043a\u043e\u0458\u0435 \u0441\u0435 \u043f\u0440\u0438\u043f\u0438\u0441\u0443\u0458\u0443 \u0434\u0443\u0433\u043e\u0442\u0440\u0430\u0458\u043d\u043e\u0458 \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u043e\u0441\u0442\u0438 \u0444\u0438\u043d\u0438\u043c \u0447\u0435\u0441\u0442\u0438\u0446\u0430\u043c\u0430 PM2.5. \u041f\u0440\u043e\u0446\u0458\u0435\u043d\u0430 \u0441\u0435 \u043e\u0434\u043d\u043e\u0441\u0438 \u043d\u0430 \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u043e\u0441\u0442 \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u0458\u0430\u043c\u0430 PM2.5 \u0438\u0437\u043d\u0430\u0434 \u043d\u0438\u0432\u043e\u0430 \u043e\u0434 5 \u00b5g/m\u00b3. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u0438\u0441\u043a\u0430\u0437\u0443\u0458\u0435 \u043a\u0430\u043e \u0443\u043a\u0443\u043f\u0430\u043d \u0431\u0440\u043e\u0458 \u043f\u0440\u0438\u0458\u0435\u0432\u0440\u0435\u043c\u0435\u043d\u0438\u0445 \u0441\u043c\u0440\u0442\u0438 \u0438 \u043a\u0430\u043e \u0431\u0440\u043e\u0458 \u043f\u0440\u0438\u0458\u0435\u0432\u0440\u0435\u043c\u0435\u043d\u0438\u0445 \u0441\u043c\u0440\u0442\u0438 \u043d\u0430 100 000 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u043a\u0430.","eu_rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043f\u0440\u0430\u0442\u0438 \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0435 \u043f\u043e\u0441\u0459\u0435\u0434\u0438\u0446\u0435 \u0434\u0443\u0433\u043e\u0442\u0440\u0430\u0458\u043d\u0435 \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u043e\u0441\u0442\u0438 \u0444\u0438\u043d\u0438\u043c \u0447\u0435\u0441\u0442\u0438\u0446\u0430\u043c\u0430 PM2.5 \u0438 \u0434\u043e\u043f\u0440\u0438\u043d\u043e\u0441\u0438 \u043f\u0440\u0430\u045b\u0435\u045a\u0443 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u0443 \u0441\u043c\u0430\u045a\u0435\u045a\u0443 \u0443\u0442\u0438\u0446\u0430\u0458\u0430 \u0437\u0430\u0433\u0430\u0452\u0435\u045a\u0430 \u0432\u0430\u0437\u0434\u0443\u0445\u0430 \u043d\u0430 \u0437\u0434\u0440\u0430\u0432\u0459\u0435 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u0430.","eu_methodology_characteristics":"\u041f\u043e\u0434\u0430\u0442\u043a\u0435 \u043f\u0440\u0438\u043f\u0440\u0435\u043c\u0430 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0430 \u0430\u0433\u0435\u043d\u0446\u0438\u0458\u0430 \u0437\u0430 \u0436\u0438\u0432\u043e\u0442\u043d\u0443 \u0441\u0440\u0435\u0434\u0438\u043d\u0443 (EEA). \u0411\u0440\u043e\u0458 \u043f\u0440\u0438\u0458\u0435\u0432\u0440\u0435\u043c\u0435\u043d\u0438\u0445 \u0441\u043c\u0440\u0442\u0438 \u043f\u0440\u043e\u0446\u0458\u0435\u045a\u0443\u0458\u0435 \u0441\u0435 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0443 \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u0458\u0430 PM2.5 \u0438 \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u0458\u0435 \u0437\u0430\u0441\u043d\u043e\u0432\u0430\u043d\u0435 \u043d\u0430 \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u0458\u0441\u043a\u043e-\u043e\u0434\u0433\u043e\u0432\u043e\u0440\u043d\u0438\u043c \u0444\u0443\u043d\u043a\u0446\u0438\u0458\u0430\u043c\u0430 \u0437\u0430 \u043f\u0440\u043e\u0446\u0458\u0435\u043d\u0443 \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0438\u0445 \u043f\u043e\u0441\u0459\u0435\u0434\u0438\u0446\u0430 \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u043e\u0441\u0442\u0438. \u041f\u0440\u043e\u0446\u0458\u0435\u045a\u0443\u0458\u0435 \u0441\u0435 \u0441\u0430\u043c\u043e \u0443\u0442\u0438\u0446\u0430\u0458 \u0438\u0437\u043b\u043e\u0436\u0435\u043d\u043e\u0441\u0442\u0438 \u0438\u0437\u043d\u0430\u0434 5 \u00b5g/m\u00b3. \u041f\u043e\u0434\u0430\u0446\u0438 \u0441\u0435 \u0438\u0441\u043a\u0430\u0437\u0443\u0458\u0443 \u043d\u0430 \u0433\u043e\u0434\u0438\u0448\u045a\u0435\u043c \u043d\u0438\u0432\u043e\u0443.","eu_long_objective":"\u0423 \u043e\u043a\u0432\u0438\u0440\u0443 \u0410\u043a\u0446\u0438\u043e\u043d\u043e\u0433 \u043f\u043b\u0430\u043d\u0430 \u0415\u0423 \u201e\u041f\u0440\u0435\u043c\u0430 \u043d\u0443\u043b\u0442\u043e\u043c \u0437\u0430\u0433\u0430\u0452\u0435\u045a\u0443 \u0432\u0430\u0437\u0434\u0443\u0445\u0430, \u0432\u043e\u0434\u0435 \u0438 \u0437\u0435\u043c\