443 \u043f\u0440\u0438\u043b\u0430\u0433\u043e\u0452\u0430\u0432\u0430\u045a\u0430 \u0437\u0430 \u0440\u0430\u0437\u043b\u0438\u043a\u0435 \u0443 \u043a\u0443\u043f\u043e\u0432\u043d\u043e\u0458 \u043c\u043e\u045b\u0438). \u0412\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442 \u043e\u0434 8,30 USD \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430 \u0442\u0438\u043f\u0438\u0447\u043d\u0443 \u0433\u0440\u0430\u043d\u0438\u0446\u0443 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u0437\u0430 \u0437\u0435\u043c\u0459\u0435 \u0441\u0430 \u0432\u0438\u0448\u0438\u043c \u0441\u0440\u0435\u0434\u045a\u0438\u043c \u0434\u043e\u0445\u043e\u0442\u043a\u043e\u043c, \u0448\u0442\u043e \u0458\u0435 \u043f\u0440\u043e\u0446\u0438\u0458\u0435\u045a\u0435\u043d\u0438 \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u043d\u0438 \u0438\u0437\u043d\u043e\u0441 \u043d\u043e\u0432\u0446\u0430 \u043f\u043e\u0442\u0440\u0435\u0431\u0430\u043d \u043f\u043e\u0458\u0435\u0434\u0438\u043d\u0446\u0443 \u0443 \u043e\u0432\u0438\u043c \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u0437\u0430 \u043f\u043e\u043a\u0440\u0438\u0432\u0430\u045a\u0435 \u0441\u0432\u0430\u043a\u043e\u0434\u043d\u0435\u0432\u043d\u0438\u0445 \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u0445 \u043f\u043e\u0442\u0440\u0435\u0431\u0430, \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443\u045b\u0438 \u0445\u0440\u0430\u043d\u0443, \u043e\u0434\u0458\u0435\u045b\u0443, \u0441\u043c\u0458\u0435\u0448\u0442\u0430\u0458, \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0435\u043d\u0443 \u0437\u0430\u0448\u0442\u0438\u0442\u0443, \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u045a\u0435 \u0438 \u043e\u0441\u0442\u0430\u043b\u0435 \u043e\u0441\u043d\u043e\u0432\u043d\u0435 \u0442\u0440\u043e\u0448\u043a\u043e\u0432\u0435.","national_methodology_characteristics":"\u0416\u0438\u0432\u043e\u0442\u043d\u0438 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0434 \u0438 \u0431\u043b\u0430\u0433\u043e\u0441\u0442\u0430\u045a\u0435 \u0459\u0443\u0434\u0438 \u0443 \u0440\u0430\u0437\u043b\u0438\u0447\u0438\u0442\u0438\u043c \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u043c\u043e\u0433\u0443 \u0441\u0435 \u043c\u0458\u0435\u0440\u0438\u0442\u0438 \u043d\u0430 \u0437\u0430\u0458\u0435\u0434\u043d\u0438\u0447\u043a\u043e\u0458 \u0441\u043a\u0430\u043b\u0438 \u043f\u0440\u0438\u043b\u0430\u0433\u043e\u0452\u0430\u0432\u0430\u045a\u0435\u043c \u0440\u0430\u0437\u043b\u0438\u043a\u0430 \u0443 \u043a\u0443\u043f\u043e\u0432\u043d\u043e\u0458 \u043c\u043e\u045b\u0438 \u0432\u0430\u043b\u0443\u0442\u0430. \u041a\u0430\u043a\u043e \u0441\u0435 \u0442\u0440\u043e\u0448\u043a\u043e\u0432\u0438 \u0436\u0438\u0432\u043e\u0442\u0430 \u0448\u0438\u0440\u043e\u043c \u0441\u0432\u0438\u0458\u0435\u0442\u0430 \u043c\u0438\u0458\u0435\u045a\u0430\u0458\u0443, \u043c\u0435\u0452\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0430 \u0433\u0440\u0430\u043d\u0438\u0446\u0430 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u043f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u043d\u043e \u0441\u0435 \u0430\u0436\u0443\u0440\u0438\u0440\u0430 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0443 \u043d\u043e\u0432\u0438\u0445 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u043e \u043f\u0430\u0440\u0438\u0442\u0435\u0442\u0443 \u043a\u0443\u043f\u043e\u0432\u043d\u0435 \u043c\u043e\u045b\u0438 (\u041f\u041a\u041c). \u041f\u043e\u0441\u0459\u0435\u0434\u045a\u0430 \u0438\u0437\u043c\u0458\u0435\u043d\u0430 \u0438\u0437\u0432\u0440\u0448\u0435\u043d\u0430 \u0458\u0435 \u0443 \u0441\u0435\u043f\u0442\u0435\u043c\u0431\u0440\u0443 2022. \u0433\u043e\u0434\u0438\u043d\u0435, \u043a\u0430\u0434\u0430 \u0458\u0435 \u0443\u0441\u0432\u043e\u0458\u0435\u043d\u0430 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442 \u043e\u0434 3,00 USD \u043a\u0430\u043e \u043c\u0435\u0452\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0430 \u0433\u0440\u0430\u043d\u0438\u0446\u0430 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u043f\u0440\u0435\u043c\u0430 \u041f\u041a\u041c-\u0443 \u0438\u0437 2021. \u0433\u043e\u0434\u0438\u043d\u0435. \u041c\u0458\u0435\u0440\u0438\u043b\u0430 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u0437\u0430\u0441\u043d\u043e\u0432\u0430\u043d\u0430 \u043d\u0430 \u043c\u0435\u0452\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0438\u043c \u0433\u0440\u0430\u043d\u0438\u0446\u0430\u043c\u0430 \u043d\u0430\u0441\u0442\u043e\u0458\u0435 \u0434\u0430 \u043e\u0434\u0440\u0436\u0435 \u0440\u0435\u0430\u043b\u043d\u0443 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442 \u0433\u0440\u0430\u043d\u0438\u0446\u0435 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u043a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u043d\u043e\u043c \u043c\u0435\u0452\u0443 \u0437\u0435\u043c\u0459\u0430\u043c\u0430, \u0458\u0435\u0434\u043d\u0430\u043a\u0438\u043c \u043f\u0440\u0438\u043d\u0446\u0438\u043f\u043e\u043c \u043a\u043e\u0458\u0438 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u043f\u0440\u0438 \u043f\u043e\u0440\u0435\u0452\u0435\u045a\u0443 \u043a\u0440\u043e\u0437 \u0432\u0440\u0438\u0458\u0435\u043c\u0435. \u0413\u0440\u0430\u043d\u0438\u0446\u0430 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u043e\u0434 4,20 USD \u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0430 \u0458\u0435 \u0438\u0437 \u0442\u0438\u043f\u0438\u0447\u043d\u0438\u0445 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438\u0445 \u0433\u0440\u0430\u043d\u0438\u0446\u0430 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u0443 \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u0441\u0430 \u043d\u0438\u0436\u0438\u043c \u0441\u0440\u0435\u0434\u045a\u0438\u043c \u0434\u043e\u0445\u043e\u0442\u043a\u043e\u043c. \u0413\u0440\u0430\u043d\u0438\u0446\u0430 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u043e\u0434 8,30 USD \u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0430 \u0458\u0435 \u0438\u0437 \u0442\u0