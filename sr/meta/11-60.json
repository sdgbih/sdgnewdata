43e\u043d\u043e\u0432\u043d\u0443 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0443 \u0438 \u0430\u043d\u0430\u0435\u0440\u043e\u0431\u043d\u0443 \u0434\u0438\u0433\u0435\u0441\u0442\u0438\u0458\u0443. \u041a\u043e\u043c\u0443\u043d\u0430\u043b\u043d\u0438 \u043e\u0442\u043f\u0430\u0434 \u0441\u0435 \u0443\u0433\u043b\u0430\u0432\u043d\u043e\u043c \u0441\u0430\u0441\u0442\u043e\u0458\u0438 \u043e\u0434 \u043e\u0442\u043f\u0430\u0434\u0430 \u043a\u043e\u0458\u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0435 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0432\u0430, \u0430\u043b\u0438 \u043c\u043e\u0436\u0435 \u0434\u0430 \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0435 \u0438 \u0441\u043b\u0438\u0447\u0430\u043d \u043e\u0442\u043f\u0430\u0434 \u043a\u043e\u0458\u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0435 \u043c\u0430\u043b\u0430 \u043f\u0440\u0435\u0434\u0443\u0437\u0435\u045b\u0430 \u0438 \u0458\u0430\u0432\u043d\u0435 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0446\u0438\u0458\u0435, \u0430 \u043a\u043e\u0458\u0438 \u0441\u0430\u043a\u0443\u043f\u0459\u0430 \u043e\u043f\u0448\u0442\u0438\u043d\u0430. \u041e\u0432\u0430\u0458 \u0434\u0440\u0443\u0433\u0438 \u0434\u0435\u043e \u043a\u043e\u043c\u0443\u043d\u0430\u043b\u043d\u043e\u0433 \u043e\u0442\u043f\u0430\u0434\u0430 \u043c\u043e\u0436\u0435 \u0434\u0430 \u0432\u0430\u0440\u0438\u0440\u0430 \u043e\u0434 \u043e\u043f\u0448\u0442\u0438\u043d\u0435 \u0434\u043e \u043e\u043f\u0448\u0442\u0438\u043d\u0435 \u0438 \u043e\u0434 \u0437\u0435\u043c\u0459\u0435 \u0434\u043e \u0437\u0435\u043c\u0459\u0435, \u0443 \u0437\u0430\u0432\u0438\u0441\u043d\u043e\u0441\u0442\u0438 \u043e\u0434 \u043b\u043e\u043a\u0430\u043b\u043d\u043e\u0433 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0443\u043f\u0440\u0430\u0432\u0459\u0430\u045a\u0430 \u043e\u0442\u043f\u0430\u0434\u043e\u043c. \u0417\u0430 \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0430 \u043a\u043e\u0458\u0430 \u043d\u0438\u0441\u0443 \u043e\u0431\u0443\u0445\u0432\u0430\u045b\u0435\u043d\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u043c \u0441\u0430\u043a\u0443\u043f\u0459\u0430\u045a\u0430 \u043a\u043e\u043c\u0443\u043d\u0430\u043b\u043d\u043e\u0433 \u043e\u0442\u043f\u0430\u0434\u0430, \u043f\u0440\u043e\u0446\u0435\u045a\u0443\u0458\u0435 \u0441\u0435 \u043a\u043e\u043b\u0438\u0447\u0438\u043d\u0430 \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u043e\u0433 \u043e\u0442\u043f\u0430\u0434\u0430.","national_rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u0430 \u043e\u0441\u0442\u0432\u0430\u0440\u0438\u0432\u0430\u045a\u0443 \u0426\u0438\u0459\u0430 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 11 \u043e \u0442\u043e\u043c\u0435 \u0434\u0430 \u0433\u0440\u0430\u0434\u043e\u0432\u0438 \u0438 \u0459\u0443\u0434\u0441\u043a\u0430 \u043d\u0430\u0441\u0435\u0459\u0430 \u0431\u0443\u0434\u0443 \u0438\u043d\u043a\u043b\u0443\u0437\u0438\u0432\u043d\u0438, \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u0438, \u043e\u0442\u043f\u043e\u0440\u043d\u0438 \u0438 \u043e\u0434\u0440\u0436\u0438\u0432\u0438, \u0448\u0442\u043e \u0458\u0435 \u0443\u0433\u0440\u0430\u0452\u0435\u043d\u043e \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u0443 \u043e\u043a\u0432\u0438\u0440\u0443 \u201e\u041d\u043e\u0432\u0435 \u0435\u0440\u0435 \u0437\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0443 \u043e\u0434\u0431\u0440\u0430\u043d\u0443 \u0438 \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442\u201c, \u201e\u041f\u043e\u0434\u0440\u0448\u043a\u0430 \u0459\u0443\u0434\u0438\u043c\u0430, \u0458\u0430\u0447\u0430\u045a\u0435 \u043d\u0430\u0448\u0438\u0445 \u0434\u0440\u0443\u0448\u0442\u0430\u0432\u0430 \u0438 \u043d\u0430\u0448\u0435\u0433 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u043e\u0433 \u043c\u043e\u0434\u0435\u043b\u0430\u201c, \u201e\u041e\u0434\u0440\u0436\u0430\u0432\u0430\u045a\u0435 \u043d\u0430\u0448\u0435\u0433 \u043a\u0432\u0430\u043b\u0438\u0442\u0435\u0442\u0430 \u0436\u0438\u0432\u043e\u0442\u0430: \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442 \u0445\u0440\u0430\u043d\u0435, \u0432\u043e\u0434\u0430 \u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u0430\u201c \u0438 \u201e\u0417\u0430\u0448\u0442\u0438\u0442\u0430 \u043d\u0430\u0448\u0435 \u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u0458\u0435, \u043e\u0447\u0443\u0432\u0430\u045a\u0435 \u043d\u0430\u0448\u0438\u0445 \u0432\u0440\u0435\u0434\u043d\u043e\u0441\u0442\u0438\u201c.","national_methodology_characteristics":"\u0410\u043a\u0446\u0438\u043e\u043d\u0438 \u043f\u043b\u0430\u043d \u0437\u0430 \u0446\u0438\u0440\u043a\u0443\u043b\u0430\u0440\u043d\u0443 \u0435\u043a\u043e\u043d\u043e\u043c\u0438\u0458\u0443 \u0438\u0437 2015. \u0433\u043e\u0434\u0438\u043d\u0435 \u043f\u043e\u0434\u0440\u0436\u0430\u0432\u0430 \u043f\u0440\u0435\u043b\u0430\u0437\u0430\u043a \u043d\u0430 \u0458\u0430\u0447\u0443 \u0438 \u0446\u0438\u0440\u043a\u0443\u043b\u0430\u0440\u043d\u0438\u0458\u0443 \u0435\u043a\u043e\u043d\u043e\u043c\u0438\u0458\u0443. \u0414\u0438\u0440\u0435\u043a\u0442\u0438\u0432\u0430 (\u0415\u0423) 2018/851 \u043e\u0434 30. \u043c\u0430\u0458\u0430 2018. \u0433\u043e\u0434\u0438\u043d\u0435 \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0430 \u0458\u0435 \u043d\u043e\u0432\u0435, \u0430\u043c\u0431\u0438\u0446\u0438\u043e\u0437\u043d\u0438\u0458\u0435 \u043f\u0440\u0430\u0432\u043d\u043e \u043e\u0431\u0430\u0432\u0435\u0437\u0443\u0458\u0443\u045b\u0435 \u0446\u0438\u0459\u0435\u0432\u0435 \u0437\u0430 \u0440\u0435\u0446\u0438\u043a\u043b\u0430\u0436\u0443 \u0438 \u043f\u043e\u043d\u043e\u0432\u043d\u0443 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0443 \u043a\u043e\u043c\u0443\u043d\u0430\u043b\u043d\u043e\u0433 \u043e\u0442\u043f\u0430\u0434\u0430. \u0417\u0435\u043c\u0459\u0435 \u0415\u0423 \u045b\u0435 \u0441\u0430\u0434\u0430 \u043c\u043e\u0440\u0430\u0442\u0438 \u0434\u0430 \u0440\u0435\u0446\u0438\u043a\u043b\u0438\u0440\u0430\u0458\u0443 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 55% \u0441\u0432\u043e\u0433 \u043a\u043e\u043c\u0443\u043d\u0430\u043b\u043d\u043e\u0433 \u043e\u0442\u043f\u0430\u0434\u0430 \u0434\u043e 2025. \u0433\u043e\u0434\u0438\u043d\u0435, 60% \u0434\u043e 2030. \u0433\u043e\u0434\u0438\u043d\u0435 \u0438 65% \u0434\u043e 2035. \u0433\u043e\u0434\u0438\u043d\u0435. \u041f\u0440\u0435\u0434\u043b\u043e\u0433 \u043f\u0430\u043a\u0435\u0442\u0430 \u0437\u0430 \u0446\u0438\u0440\u043a\u0443\u043b\u0430\u0440\u043d\u0443 \u0435\u043a\u043e\u043d\u043e\u043c\u0438\u0458\u0443 \u0438\u0437 2022. \u0433\u043e\u0434\u0438\u043d\u0435 \u0437\u0430 \u0414\u0438\u0440\u0435\u043a\u0442\u0438\u0432\u0443 \u043e \u0430\u043c\u0431\u0430\u043b\u0430\u0436\u0438 \u0438 \u0430\u043c\u0431\u0430\u043b\u0430\u0436\u043d\u043e\u043c \u043e\u0442\u043f\u0430\u0434\u0443 \u0438\u043c\u0430 \u0437\u0430 \u0446\u0438\u0459 \u0441\u043c\u0430\u045a\u0435\u045a\u0435 \u0430\u043c\u0431\u0430\u043b\u0430\u0436\u043d\u043e\u0433 \u043e\u0442\u043f\u0430\u0434\u0430 \u0438 \u043f\u043e\u0432\u0435\u045b\u0430\u045a\u0435 \u0440\u0435\u0446\u0438\u043a\u043b\u0430\u0436\u0435.","national_long_objective":"\u0414\u0443\u0433\u043e\u0440\u043e\u0447\u043d\u0438 \u0446\u0438\u0459 \u0437\u0430 \u043e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0458\u0435 \u0432\u0440\u0435\u0434\u043d\u043e\u0441\u0442 \u043e\u0434 62.","eu_indicator_definition":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043c\u0435\u0440\u0438 \u043a\u043e\u043b\u0438\u0447\u0438\u043d\u0443 \u0440\u0435\u0446\u0438\u043a\u043b\u0438\u0440\u0430\u043d\u043e\u0433 \u043a\u043e\u043c\u0443\u043d\u0430\u043b\u043d\u043e\u0433 \u043e\u0442\u043f\u0430\u0434\u0430 \u043f\u043e\u0434\u0435\u0459\u0435\u043d\u0443 \u0441\u0430 \u0443\u043a\u0443\u043f\u043d\u043e\u043c \u043a\u043e\u043b\u0438\u0447\u0438\u043d\u043e\u043c \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u043e\u0433 \u043a\u043e\u043c\u0443\u043d\u0430\u043b\u043d\u043e\u0433 \u043e\u0442\u043f\u0430\u0434\u0430. \u0420\u0435\u0446\u0438\u043a\u043b\u0430\u0436\u0430 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430 \u0440\u0435\u0446\u0438\u043a\u043b\u0430\u0436\u0443 \u043c\u0430\u0442\u0435\u0440\u0438\u0458\u0430\u043b\u0430, \u043a\u043e\u043c\u043f\u043e\u0441\u0442\u0438\u0440\u0430\u045a\u0435, \u043f\u0440\u0438\u043f\u0440\u0435\u043c\u0443 \u0437\u0430 \u043f\u043e\u043d\u043e\u0432\u043d\u0443 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0443 \u0438 \u0430\u043d\u0430\u0435\u0440\u043e\u0431\u043d\u0443 \u0434\u0438\u0433\u0435\u0441\u0442\u0438\u0458\u0443. \u041a\u043e\u043c\u0443\u043d\u0430\u043b\u043d\u0438 \u043e\u0442\u043f\u0430\u0434 \u0441\u0435 \u0443\u0433\u043b\u0430\u0432\u043d\u043e\u043c \u0441\u0430\u0441\u0442\u043e\u0458\u0438 \u043e\u0434 \u043e\u0442\u043f\u0430\u0434\u0430 \u043a\u043e\u0458\u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0435 \u0434\u043e\u043c\u0430\u045b\u0438\u043d\u0441\u0442\u0432\u0430, \u0430\u043b\u0438 \u043c\u043e\u0436\u0435 \u0434\u0430 \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0435 \u0438 \u0441\u043b\u0438\u0447\u0430\u043d \u043e\u0442\u043f\u0430\u0434 \u043a\u043e\u0458\u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0435 \u043c\u0430\u043b\u0430 \u043f\u0440\u0435\u0434\u0443\u0437\u0435\u045b\u0430 \u0438 \u0458\u0430\u0432\u043d\u0435 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0446\u0438\u0458\u0435, \u0430 \u043a\u043e\u0458\u0438 \u0441\u0430\u043a\u0443\u043f\u0459\u0430 \u043e\u043f\u0448\u0442\u0438\u043d\u0430. \u041e\u0432\u0430\u0458 \u0434\u0440\u0443\u0433\u0438 \u0434\u0435\u043e \u043a\u043e\u043c\u0443\u043d\u0430\u043b\u043d\u043e\u0433 \u043e\u0442\u043f\u0430\u0434\u0430 \u043c\u043e\u0436\u0435 \u0434\u0430 \u0432\u0430\u0440\u0438\u0440\u0430 \u043e\u0434 \u043e\u043f\u0448\u0442\u0438\u043d\u0435 \u0434\u043e \u043e\u043f\u0448\u0442\u0438\u043d\u0435 \u0438 \u043e\u0434 \u0437\u0435\u043c\u0459\u0435 \u0434\u043e \u0437\u0435\u043c\u0459\u0435, \u0443 \u0437\u0430\u0432\u0438\u0441\u043d\u043e\u0441\u0442\u0438 \u043e\u0434 \u043b\u043e\u043a\u0430\u043b\u043d\u043e\u0433 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0443\u043f\u0440\u0430\u0432\u0459\u0430\u045a\u0430 \u043e\u0442\u043f\u0430\u0434\u043e\u043c. \u0417\u0430 \u043f\u043e\u0434\u0440\u0443\u0447\u0458\u0430 \u043a\u043e\u0458\u0430 \u043d\u0438\u0441\u0443 \u043e\u0431\u0443\u0445\u0432\u0430\u045b\u0435\u043d\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u043c \u0441\u0430\u043a\u0443\u043f\u0459\u0430\u045a\u0430 \u043a\u043e\u043c\u0443\u043d\u0430\u043b\u043d\u043e\u0433 \u043e\u0442\u043f\u0430\u0434\u0430, \u043f\u0440\u043e\u0446\u0435\u045a\u0443\u0458\u0435 \u0441\u0435 \u043a\u043e\u043b\u0438\u0447\u0438\u043d\u0430 \u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u043e\u0433 \u043e\u0442\u043f\u0430\u0434\u0430.","eu_rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u0430 \u043e\u0441\u0442\u0432\u0430\u0440\u0438\u0432\u0430\u045a\u0443 \u0426\u0438\u0459\u0430 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 11 \u043e \u0442\u043e\u043c\u0435 \u0434\u0430 \u0433\u0440\u0430\u0434\u043e\u0432\u0438 \u0438 \u0459\u0443\u0434\u0441\u043a\u0430 \u043d\u0430\u0441\u0435\u0459\u0430 \u0431\u0443\u0434\u0443 \u0438\u043d\u043a\u043b\u0443\u0437\u0438\u0432\u043d\u0438, \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u0438, \u043e\u0442\u043f\u043e\u0440\u043d\u0438 \u0438 \u043e\u0434\u0440\u0436\u0438\u0432\u0438, \u0448\u0442\u043e \u0458\u0435 \u0443\u0433\u0440\u0430\u0452\u0435\u043d\u043e \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u0443 \u043e\u043a\u0432\u0438\u0440\u0443 \u201e\u041d\u043e\u0432\u0435 \u0435\u0440\u0435 \u0437\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0443 \u043e\u0434\u0431\u0440\u0430\u043d\u0443 \u0438 \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442\u201c, \u201e\u041f\u043e\u0434\u0440\u0448\u043a\u0430 \u0459\u0443\u0434\u0438\u043c\u0430, \u0458\u0430\u0447\u0430\u045a\u0435 \u043d\u0430\u0448\u0438\u0445 \u0434\u0440\u0443\u0448\u0442\u0430\u0432\u0430 \u0438 \u043d\u0430\u0448\u0435\u0433 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u043e\u0433 \u043c\u043e\u0434\u0435\u043b\u0430\u201c, \u201e\u041e\u0434\u0440\u0436\u0430\u0432\u0430\u045a\u0435 \u043d\u0430\u0448\u0435\u0433 \u043a\u0432\u0430\u043b\u0438\u0442\u0435\u0442\u0430 \u0436\u0438\u0432\u043e\u0442\u0430: \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442 \u0445\u0440\u0430\u043d\u0435, \u0432\u043e\u0434\u0430 \u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u0430\u201c \u0438 \u201e\u0417\u0430\u0448\u0442\u0438\u0442\u0430 \u043d\u0430\u0448\u0435 \u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u0458\u0435, \u043e\u0447\u0443\u0432\u0430\u045a\u0435 \u043d\u0430\u0448\u0438\u0445 \u0432\u0440\u0435\u0434\u043d\u043e\u0441\u0442\u0438\u201c.","eu_methodology_characteristics":"\u0410\u043a\u0446\u0438\u043e\u043d\u0438 \u043f\u043b\u0430\u043d \u0437\u0430 \u0446\u0438\u0440\u043a\u0443\u043b\u0430\u0440\u043d\u0443 \u0435\u043a\u043e\u043d\u043e\u043c\u0438\u0458\u0443 \u0438\u0437 2015. \u0433\u043e\u0434\u0438\u043d\u0435 \u043f\u043e\u0434\u0440\u0436\u0430\u0432\u0430 \u043f\u0440\u0435\u043b\u0430\u0437\u0430\u043a \u043d\u0430 \u0458\u0430\u0447\u0443 \u0438 \u0446\u0438\u0440\u043a\u0443\u043b\u0430\u0440\u043d\u0438\u0458\u0443 \u0435\u043a\u043e\u043d\u043e\u043c\u0438\u0458\u0443. \u0414\u0438\u0440\u0435\u043a\u0442\u0438\u0432\u0430 (\u0415\u0423) 2018/851 \u043e\u0434 30. \u043c\u0430\u0458\u0430 2018. \u0433\u043e\u0434\u0438\u043d\u0435 \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b\u0430 \u0458\u0435 \u043d\u043e\u0432\u0435, \u0430\u043c\u0431\u0438\u0446\u0438\u043e\u0437\u043d\u0438\u0458\u0435 \u043f\u0440\u0430\u0432\u043d\u043e \u043e\u0431\u0430\u0432\u0435\u0437\u0443\u0458\u0443\u045b\u0435 \u0446\u0438\u0459\u0435\u0432\u0435 \u0437\u0430 \u0440\u0435\u0446\u0438\u043a\u043b\u0430\u0436\u0443 \u0438 \u043f\u043e\u043d\u043e\u0432\u043d\u0443 \u0443\u043f\u043e\u0442\u0440\u0435\u0431\u0443 \u043a\u043e\u043c\u0443\u043d\u0430\u043b\u043d\u043e\u0433 \u043e\u0442\u043f\u0430\u0434\u0430. \u0417\u0435\u043c\u0459\u0435 \u0415\u0423 \u045b\u0435 \u0441\u0430\u0434\u0430 \u043c\u043e\u0440\u0430\u0442\u0438 \u0434\u0430 \u0440\u0435\u0446\u0438\u043a\u043b\u0438\u0440\u0430\u0458\u0443 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 55% \u0441\u0432\u043e\u0433 \u043a\u043e\u043c\u0443\u043d\u0430\u043b\u043d\u043e\u0433 \u043e\u0442\u043f\u0430\u0434\u0430 \u0434\u043e 2025. \u0433\u043e\u0434\u0438\u043d\u0435, 60% \u0434\u043e 2030. \u0433\u043e\u0434\u0438\u043d\u0435 \u0438 65% \u0434\u043e 2035. \u0433\u043e\u0434\u0438\u043d\u0435. \u041f\u0440\u0435\u0434\u043b\u043e\u0433 \u043f\u0430\u043a\u0435\u0442\u0430 \u0437\u0430 \u0446\u0438\u0440\u043a\u0443\u043b\u0430\u0440\u043d\u0443 \u0435\u043a\u043e\u043d\u043e\u043c\u0438\u0458\u0443 \u0438\u0437 2022. \u0433\u043e\u0434\u0438\u043d\u0435 \u0437\u0430 \u0414\u0438\u0440\u0435\u043a\u0442\u0438\u0432\u0443 \u043e \u0430\u043c\u0431\u0430\u043b\u0430\u0436\u0438 \u0438 \u0430\u043c\u0431\u0430\u043b\u0430\u0436\u043d\u043e\u043c \u043e\u0442\u043f\u0430\u0434\u0443 \u0438\u043c\u0430 \u0437\u0430 \u0446\u0438\u0459 \u0441\u043c\u0430\u045a\u0435\u045a\u0435 \u0430\u043c\u0431\u0430\u043b\u0430\u0436\u043d\u043e\u0433 \u043e\u0442\u043f\u0430\u0434\u0430 \u0438 \u043f\u043e\u0432\u0435\u045b\u0430\u045a\u0435 \u0440\u0435\u0446\u0438\u043a\u043b\u0430\u0436\u0435.","eu_long_objective":"\u0414\u0443\u0433\u043e\u0440\u043e\u0447\u043d\u0438 \u0446\u0438\u0459 \u0437\u0430 \u043e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0458\u0435 \u0432\u0440\u0435\u0434\u043d\u043e\u0441\u0442 \u043e\u0434 62.","target_number":"11.60","goal_number":"11","graph_title":"\u0421\u0442\u043e\u043f\u0430 \u0440\u0435\u0446\u0438\u043a\u043b\u0438\u0440\u0430\u045a\u0430 \u043a\u043e\u043c\u0443\u043d\u0430\u043b\u043d\u043e\u0433 \u043e\u0442\u043f\u0430\u0434\u0430"}