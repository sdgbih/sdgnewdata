{"indicator_number":5.11,"reporting_status":"complete","published":true,"sdg_goal":"5","data_non_statistical":false,"graph_type":"bar","indicator_sort_order":"05-11","indicator_name":"\u0424\u0438\u0437\u0438\u0447\u043a\u043e \u0438 \u0441\u0435\u043a\u0441\u0443\u0430\u043b\u043d\u043e \u043d\u0430\u0441\u0438\u0459\u0435 \u043d\u0430\u0434 \u0436\u0435\u043d\u0430\u043c\u0430 \u043f\u043e \u0441\u0442\u0430\u0440\u043e\u0441\u043d\u0438\u043c \u0433\u0440\u0443\u043f\u0430\u043c\u0430","source_active_1":true,"source_organisation_1":"OESS/OSCE","source_url_1":"https://projects.osce.org/sites/default/files/f/documents/f/7/439724_0.pdf","footer_fields":[{"label":"\u0420\u0435\u0444\u0435\u0440\u0435\u043d\u0442\u043d\u0438 \u043c\u0435\u0442\u0430\u043f\u043e\u0434\u0430\u0446\u0438","value":"<a href=\"https://ec.europa.eu/eurostat/cache/metadata/en/sdg_05_11_esmsip2.htm\" target=\"_blank\">Eurostat Metadata Report (sdg_05_11)</a>"}],"graph_titles":[{"series":"\u0424\u0438\u0437\u0438\u0447\u043a\u043e \u0438 \u0441\u0435\u043a\u0441\u0443\u0430\u043b\u043d\u043e \u043d\u0430\u0441\u0438\u0459\u0435 \u043d\u0430\u0434 \u0436\u0435\u043d\u0430\u043c\u0430 \u043f\u043e \u0441\u0442\u0430\u0440\u043e\u0441\u043d\u0438\u043c \u0433\u0440\u0443\u043f\u0430\u043c\u0430","title":"\u0424\u0438\u0437\u0438\u0447\u043a\u043e \u0438 \u0441\u0435\u043a\u0441\u0443\u0430\u043b\u043d\u043e \u043d\u0430\u0441\u0438\u0459\u0435 \u043d\u0430\u0434 \u0436\u0435\u043d\u0430\u043c\u0430 \u043f\u043e \u0441\u0442\u0430\u0440\u043e\u0441\u043d\u0438\u043c \u0433\u0440\u0443\u043f\u0430\u043c\u0430"}],"national_indicator_definition":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043c\u0458\u0435\u0440\u0438 \u0443\u0434\u0438\u043e \u0436\u0435\u043d\u0430 \u0443 \u0434\u043e\u0431\u0438 \u043e\u0434 18 \u0438 \u0432\u0438\u0448\u0435 \u0433\u043e\u0434\u0438\u043d\u0430 \u043a\u043e\u0458\u0435 \u0441\u0443 \u043d\u0430\u0432\u0435\u043b\u0435 \u0434\u0430 \u0441\u0443 \u0434\u043e\u0436\u0438\u0432\u0458\u0435\u043b\u0435 \u0444\u0438\u0437\u0438\u0447\u043a\u043e \u0438/\u0438\u043b\u0438 \u0441\u0435\u043a\u0441\u0443\u0430\u043b\u043d\u043e \u043d\u0430\u0441\u0438\u0459\u0435 \u043e\u0434 \u0441\u0442\u0440\u0430\u043d\u0435 \u0438\u043d\u0442\u0438\u043c\u043d\u043e\u0433 \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0430 \u0438\u043b\u0438 \u043e\u0441\u043e\u0431\u0435 \u043a\u043e\u0458\u0430 \u0438\u043c \u043d\u0438\u0458\u0435 \u043f\u0430\u0440\u0442\u043d\u0435\u0440 \u0443 \u043f\u0435\u0440\u0438\u043e\u0434\u0443 \u043e\u0434 12 \u043c\u0458\u0435\u0441\u0435\u0446\u0438 \u043f\u0440\u0438\u0458\u0435 \u0438\u043d\u0442\u0435\u0440\u0432\u0458\u0443\u0430. \u0418\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0435 \u0458\u0435 \u0441\u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u043e \u0443 \u043f\u0440\u043e\u0459\u0435\u045b\u0435/\u0459\u0435\u0442\u043e 2018. \u0433\u043e\u0434\u0438\u043d\u0435.","national_rationale":"\u041e\u0432\u0438 \u043f\u043e\u0434\u0430\u0446\u0438 \u043f\u0440\u0438\u043a\u0430\u0437\u0443\u0458\u0443 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u045a\u0435\u043d\u043e\u0441\u0442 \u0444\u0438\u0437\u0438\u0447\u043a\u043e\u0433 \u0438 \u0441\u0435\u043a\u0441\u0443\u0430\u043b\u043d\u043e\u0433 \u043d\u0430\u0441\u0438\u0459\u0430 \u043d\u0430\u0434 \u0436\u0435\u043d\u0430\u043c\u0430 \u0443 \u0434\u043e\u0431\u0438 \u043e\u0434 18 \u0434\u043e 74 \u0433\u043e\u0434\u0438\u043d\u0435 \u0443 \u0411\u043e\u0441\u043d\u0438 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0438, \u0430 \u043f\u0440\u0438\u043a\u0443\u043f\u0459\u0435\u043d\u0438 \u0441\u0443 \u0443 \u0441\u0432\u0440\u0445\u0443 \u043f\u0440\u0430\u045b\u0435\u045a\u0430 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u0459\u0430 \u0426\u0438\u0459\u0430 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 5 (SDG 5: \u0420\u043e\u0434\u043d\u0430 \u0440\u0430\u0432\u043d\u043e\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442), \u0441\u0430 \u043d\u0430\u0433\u043b\u0430\u0441\u043a\u043e\u043c \u043d\u0430 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 EU SDG 5.11. \u041f\u0440\u0438\u043a\u0430\u0437\u0430\u043d\u0435 \u0441\u0442\u043e\u043f\u0435 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430\u0458\u0443 \u043d\u0430\u0441\u0438\u0459\u0435 \u043e\u0434 \u0441\u0442\u0440\u0430\u043d\u0435 \u0438\u043d\u0442\u0438\u043c\u043d\u0438\u0445 \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0430 \u0438 \u043e\u0441\u043e\u0431\u0430 \u043a\u043e\u0458\u0435 \u0438\u043c \u043d\u0438\u0441\u0443 \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0438, \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443\u045b\u0438 \u043f\u0440\u0435\u0432\u0430\u043b\u0435\u043d\u0446\u0438\u0458\u0443 \u0442\u043e\u043a\u043e\u043c \u0436\u0438\u0432\u043e\u0442\u0430 (\u043e\u0434 15. \u0433\u043e\u0434\u0438\u043d\u0435) \u0438 \u0443 \u043f\u043e\u0441\u0459\u0435\u0434\u045a\u0438\u0445 12 \u043c\u0458\u0435\u0441\u0435\u0446\u0438.","national_methodology_characteristics":"\u041e\u0432\u0430 \u0441\u0442\u0443\u0434\u0438\u0458\u0430 \u0458\u0435 \u0437\u0430\u0441\u043d\u043e\u0432\u0430\u043d\u0430 \u043d\u0430 \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u0458\u0438 \u043a\u043e\u0458\u0443 \u0458\u0435 \u0410\u0433\u0435\u043d\u0446\u0438\u0458\u0430 \u0415\u0423 \u0437\u0430 \u043e\u0441\u043d\u043e\u0432\u043d\u0430 \u043f\u0440\u0430\u0432\u0430 (FRA) \u043a\u043e\u0440\u0438\u0441\u0442\u0438\u043b\u0430 \u0443 \u0441\u0432\u043e\u043c \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0443 \u0438\u0437 2012. \u0433\u043e\u0434\u0438\u043d\u0435 \u043e \u043d\u0430\u0441\u0438\u0459\u0443 \u043d\u0430\u0434 \u0436\u0435\u043d\u0430\u043c\u0430 \u0443 28 \u0434\u0440\u0436\u0430\u0432\u0430 \u0447\u043b\u0430\u043d\u0438\u0446\u0430 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u0443\u043d\u0438\u0458\u0435, \u043f\u0430 \u0458\u0435 \u0441\u0430 \u045a\u043e\u043c \u0438 \u0443\u043f\u043e\u0440\u0435\u0434\u0438\u0432\u0430. \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0438 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u0437\u0430 \u0440\u043e\u0434\u043d\u0443 \u0440\u0430\u0432\u043d\u043e\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442 (EIGE) \u0443 \u0441\u0432\u043e\u043c \u0440\u0430\u0434\u0443 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u043f\u043e\u0434\u0430\u0442\u043a\u0435 \u0438\u0437 \u0441\u0442\u0443\u0434\u0438\u0458\u0435 FRA, \u0430 \u0441\u0442\u0443\u0434\u0438\u0458\u0430 OSI \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430 \u043e\u0434\u0430\u0431\u0440\u0430\u043d\u0430 \u043f\u0438\u0442\u0430\u045a\u0430 \u0415\u0432\u0440\u043e\u0431\u0430\u0440\u043e\u043c\u0435\u0442\u0440\u0430 \u043e \u0441\u0442\u0430\u0432\u043e\u0432\u0438\u043c\u0430 \u043f\u0440\u0435\u043c\u0430 \u043d\u0430\u0441\u0438\u0459\u0443 \u043d\u0430\u0434 \u0436\u0435\u043d\u0430\u043c\u0430. \u0414\u0438\u0437\u0430\u0458\u043d \u0443\u0437\u043e\u0440\u043a\u0430 \u0438 \u043f\u043e\u043d\u0434\u0435\u0440\u0438 \u0437\u0430\u0441\u043d\u043e\u0432\u0430\u043d\u0438 \u0441\u0443 \u043d\u0430 \u043f\u043e\u043f\u0438\u0441\u0443 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u0430 \u0438\u0437 2013. \u0433\u043e\u0434\u0438\u043d\u0435 \u0438 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430\u0458\u0443 \u043f\u043e\u043f\u0443\u043b\u0430\u0446\u0438\u0458\u0443 \u0436\u0435\u043d\u0430 \u0441\u0442\u0430\u0440\u043e\u0441\u043d\u0435 \u0434\u043e\u0431\u0438 \u043e\u0434 18 \u0434\u043e 74 \u0433\u043e\u0434\u0438\u043d\u0435 \u043a\u043e\u0458\u0435 \u0436\u0438\u0432\u0435 \u0443 \u0411\u043e\u0441\u043d\u0438 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0438.","national_long_objective":"\u041e\u0441\u0438\u0433\u0443\u0440\u0430\u0442\u0438 \u043f\u043e\u0443\u0437\u0434\u0430\u043d\u0443, \u043c\u0435\u0452\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e \u0443\u043f\u043e\u0440\u0435\u0434\u0438\u0432\u0443 \u0438 \u043d\u0430 \u0434\u043e\u043a\u0430\u0437\u0438\u043c\u0430 \u0443\u0442\u0435\u043c\u0435\u0459\u0435\u043d\u0443 \u0435\u043c\u043f\u0438\u0440\u0438\u0458\u0441\u043a\u0443 \u043e\u0441\u043d\u043e\u0432\u0443 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u0459\u0430 EU SDG 5.11 \u0443 \u0441\u043a\u043b\u0430\u0434\u0443 \u0441 \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0448\u043a\u0438\u043c \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0434\u0438\u043c\u0430 \u0415\u0432\u0440\u043e\u0441\u0442\u0430\u0442\u0430. \u041a\u0440\u0430\u0458\u045a\u0438 \u0446\u0438\u0459 \u043f\u0440\u0438\u043a\u0443\u043f\u0459\u0430\u045a\u0430 \u043e\u0432\u0438\u0445 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u0458\u0435\u0441\u0442 \u0443\u0441\u043c\u0458\u0435\u0440\u0430\u0432\u0430\u045a\u0435 \u0458\u0430\u0432\u043d\u0438\u0445 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0430 \u0438 \u0437\u0430\u043a\u043e\u043d\u043e\u0434\u0430\u0432\u0441\u0442\u0432\u0430 \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u0442\u043f\u0443\u043d\u043e\u043c \u0438\u0441\u043a\u043e\u0440\u0458\u0435\u045a\u0438\u0432\u0430\u045a\u0443 \u0440\u043e\u0434\u043d\u043e \u0437\u0430\u0441\u043d\u043e\u0432\u0430\u043d\u043e\u0433 \u043d\u0430\u0441\u0438\u0459\u0430, \u0458\u0430\u0447\u0430\u045a\u0443 \u043a\u0430\u043f\u0430\u0446\u0438\u0442\u0435\u0442\u0430 \u0441\u043b\u0443\u0436\u0431\u0438 \u0437\u0430 \u043f\u043e\u0434\u0440\u0448\u043a\u0443 \u0436\u0440\u0442\u0432\u0430\u043c\u0430 \u0442\u0435 \u043e\u0441\u0438\u0433\u0443\u0440\u0430\u0432\u0430\u045a\u0443 \u043f\u043e\u0442\u043f\u0443\u043d\u043e\u0433 \u0431\u043b\u0430\u0433\u043e\u0441\u0442\u0430\u045a\u0430 \u0438 \u0431\u0435\u0437\u0431\u0458\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u0436\u0435\u043d\u0430 \u0438 \u0434\u0458\u0435\u0432\u043e\u0458\u0447\u0438\u0446\u0430 \u0443 \u0458\u0430\u0432\u043d\u043e\u0458 \u0438 \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u043e\u0458 \u0441\u0444\u0435\u0440\u0438","eu_indicator_definition":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043c\u0458\u0435\u0440\u0438 \u0443\u0434\u0438\u043e \u0436\u0435\u043d\u0430 \u0443 \u0434\u043e\u0431\u0438 \u043e\u0434 18 \u0438 \u0432\u0438\u0448\u0435 \u0433\u043e\u0434\u0438\u043d\u0430 \u043a\u043e\u0458\u0435 \u0441\u0443 \u043d\u0430\u0432\u0435\u043b\u0435 \u0434\u0430 \u0441\u0443 \u0434\u043e\u0436\u0438\u0432\u0458\u0435\u043b\u0435 \u0444\u0438\u0437\u0438\u0447\u043a\u043e \u0438/\u0438\u043b\u0438 \u0441\u0435\u043a\u0441\u0443\u0430\u043b\u043d\u043e \u043d\u0430\u0441\u0438\u0459\u0435 \u043e\u0434 \u0441\u0442\u0440\u0430\u043d\u0435 \u0438\u043d\u0442\u0438\u043c\u043d\u043e\u0433 \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0430 \u0438\u043b\u0438 \u043e\u0441\u043e\u0431\u0435 \u043a\u043e\u0458\u0430 \u0438\u043c \u043d\u0438\u0458\u0435 \u043f\u0430\u0440\u0442\u043d\u0435\u0440 \u0443 \u043f\u0435\u0440\u0438\u043e\u0434\u0443 \u043e\u0434 12 \u043c\u0458\u0435\u0441\u0435\u0446\u0438 \u043f\u0440\u0438\u0458\u0435 \u0438\u043d\u0442\u0435\u0440\u0432\u0458\u0443\u0430. \u0418\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0435 \u0458\u0435 \u0441\u043f\u0440\u043e\u0432\u0435\u0434\u0435\u043d\u043e \u0443 \u043f\u0440\u043e\u0459\u0435\u045b\u0435/\u0459\u0435\u0442\u043e 2018. \u0433\u043e\u0434\u0438\u043d\u0435.","eu_rationale":"\u041e\u0432\u0438 \u043f\u043e\u0434\u0430\u0446\u0438 \u043f\u0440\u0438\u043a\u0430\u0437\u0443\u0458\u0443 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u045a\u0435\u043d\u043e\u0441\u0442 \u0444\u0438\u0437\u0438\u0447\u043a\u043e\u0433 \u0438 \u0441\u0435\u043a\u0441\u0443\u0430\u043b\u043d\u043e\u0433 \u043d\u0430\u0441\u0438\u0459\u0430 \u043d\u0430\u0434 \u0436\u0435\u043d\u0430\u043c\u0430 \u0443 \u0434\u043e\u0431\u0438 \u043e\u0434 18 \u0434\u043e 74 \u0433\u043e\u0434\u0438\u043d\u0435 \u0443 \u0411\u043e\u0441\u043d\u0438 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0438, \u0430 \u043f\u0440\u0438\u043a\u0443\u043f\u0459\u0435\u043d\u0438 \u0441\u0443 \u0443 \u0441\u0432\u0440\u0445\u0443 \u043f\u0440\u0430\u045b\u0435\u045a\u0430 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u0459\u0430 \u0426\u0438\u0459\u0430 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 5 (SDG 5: \u0420\u043e\u0434\u043d\u0430 \u0440\u0430\u0432\u043d\u043e\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442), \u0441\u0430 \u043d\u0430\u0433\u043b\u0430\u0441\u043a\u043e\u043c \u043d\u0430 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 EU SDG 5.11. \u041f\u0440\u0438\u043a\u0430\u0437\u0430\u043d\u0435 \u0441\u0442\u043e\u043f\u0435 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430\u0458\u0443 \u043d\u0430\u0441\u0438\u0459\u0435 \u043e\u0434 \u0441\u0442\u0440\u0430\u043d\u0435 \u0438\u043d\u0442\u0438\u043c\u043d\u0438\u0445 \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0430 \u0438 \u043e\u0441\u043e\u0431\u0430 \u043a\u043e\u0458\u0435 \u0438\u043c \u043d\u0438\u0441\u0443 \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0438, \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443\u045b\u0438 \u043f\u0440\u0435\u0432\u0430\u043b\u0435\u043d\u0446\u0438\u0458\u0443 \u0442\u043e\u043a\u043e\u043c \u0436\u0438\u0432\u043e\u0442\u0430 (\u043e\u0434 15. \u0433\u043e\u0434\u0438\u043d\u0435) \u0438 \u0443 \u043f\u043e\u0441\u0459\u0435\u0434\u045a\u0438\u0445 12 \u043c\u0458\u0435\u0441\u0435\u0446\u0438.","eu_methodology_characteristics":"\u041e\u0432\u0430 \u0441\u0442\u0443\u0434\u0438\u0458\u0430 \u0458\u0435 \u0437\u0430\u0441\u043d\u043e\u0432\u0430\u043d\u0430 \u043d\u0430 \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u0458\u0438 \u043a\u043e\u0458\u0443 \u0458\u0435 \u0410\u0433\u0435\u043d\u0446\u0438\u0458\u0430 \u0415\u0423 \u0437\u0430 \u043e\u0441\u043d\u043e\u0432\u043d\u0430 \u043f\u0440\u0430\u0432\u0430 (FRA) \u043a\u043e\u0440\u0438\u0441\u0442\u0438\u043b\u0430 \u0443 \u0441\u0432\u043e\u043c \u0438\u0441\u0442\u0440\u0430\u0436\u0438\u0432\u0430\u045a\u0443 \u0438\u0437 2012. \u0433\u043e\u0434\u0438\u043d\u0435 \u043e \u043d\u0430\u0441\u0438\u0459\u0443 \u043d\u0430\u0434 \u0436\u0435\u043d\u0430\u043c\u0430 \u0443 28 \u0434\u0440\u0436\u0430\u0432\u0430 \u0447\u043b\u0430\u043d\u0438\u0446\u0430 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u0443\u043d\u0438\u0458\u0435, \u043f\u0430 \u0458\u0435 \u0441\u0430 \u045a\u043e\u043c \u0438 \u0443\u043f\u043e\u0440\u0435\u0434\u0438\u0432\u0430. \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0438 \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0442 \u0437\u0430 \u0440\u043e\u0434\u043d\u0443 \u0440\u0430\u0432\u043d\u043e\u043f\u0440\u0430\u0432\u043d\u043e\u0441\u0442 (EIGE) \u0443 \u0441\u0432\u043e\u043c \u0440\u0430\u0434\u0443 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u043f\u043e\u0434\u0430\u0442\u043a\u0435 \u0438\u0437 \u0441\u0442\u0443\u0434\u0438\u0458\u0435 FRA, \u0430 \u0441\u0442\u0443\u0434\u0438\u0458\u0430 OSI \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430 \u043e\u0434\u0430\u0431\u0440\u0430\u043d\u0430 \u043f\u0438\u0442\u0430\u045a\u0430 \u0415\u0432\u0440\u043e\u0431\u0430\u0440\u043e\u043c\u0435\u0442\u0440\u0430 \u043e \u0441\u0442\u0430\u0432\u043e\u0432\u0438\u043c\u0430 \u043f\u0440\u0435\u043c\u0430 \u043d\u0430\u0441\u0438\u0459\u0443 \u043d\u0430\u0434 \u0436\u0435\u043d\u0430\u043c\u0430. \u0414\u0438\u0437\u0430\u0458\u043d \u0443\u0437\u043e\u0440\u043a\u0430 \u0438 \u043f\u043e\u043d\u0434\u0435\u0440\u0438 \u0437\u0430\u0441\u043d\u043e\u0432\u0430\u043d\u0438 \u0441\u0443 \u043d\u0430 \u043f\u043e\u043f\u0438\u0441\u0443 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u0430 \u0438\u0437 2013. \u0433\u043e\u0434\u0438\u043d\u0435 \u0438 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430\u0458\u0443 \u043f\u043e\u043f\u0443\u043b\u0430\u0446\u0438\u0458\u0443 \u0436\u0435\u043d\u0430 \u0441\u0442\u0430\u0440\u043e\u0441\u043d\u0435 \u0434\u043e\u0431\u0438 \u043e\u0434 18 \u0434\u043e 74 \u0433\u043e\u0434\u0438\u043d\u0435 \u043a\u043e\u0458\u0435 \u0436\u0438\u0432\u0435 \u0443 \u0411\u043e\u0441\u043d\u0438 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0438.","eu_long_objective":"\u041e\u0441\u0438\u0433\u0443\u0440\u0430\u0442\u0438 \u043f\u043e\u0443\u0437\u0434\u0430\u043d\u0443, \u043c\u0435\u0452\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e \u0443\u043f\u043e\u0440\u0435\u0434\u0438\u0432\u0443 \u0438 \u043d\u0430 \u0434\u043e\u043a\u0430\u0437\u0438\u043c\u0430 \u0443\u0442\u0435\u043c\u0435\u0459\u0435\u043d\u0443 \u0435\u043c\u043f\u0438\u0440\u0438\u0458\u0441\u043a\u0443 \u043e\u0441\u043d\u043e\u0432\u0443 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u0459\u0430 EU SDG 5.11 \u0443 \u0441\u043a\u043b\u0430\u0434\u0443 \u0441 \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0448\u043a\u0438\u043c \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0434\u0438\u043c\u0430 \u0415\u0432\u0440\u043e\u0441\u0442\u0430\u0442\u0430. \u041a\u0440\u0430\u0458\u045a\u0438 \u0446\u0438\u0459 \u043f\u0440\u0438\u043a\u0443\u043f\u0459\u0430\u045a\u0430 \u043e\u0432\u0438\u0445 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u0458\u0435\u0441\u0442 \u0443\u0441\u043c\u0458\u0435\u0440\u0430\u0432\u0430\u045a\u0435 \u0458\u0430\u0432\u043d\u0438\u0445 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0430 \u0438 \u0437\u0430\u043a\u043e\u043d\u043e\u0434\u0430\u0432\u0441\u0442\u0432\u0430 \u043f\u0440\u0435\u043c\u0430 \u043f\u043e\u0442\u043f\u0443\u043d\u043e\u043c \u0438\u0441\u043a\u043e\u0440\u0458\u0435\u045a\u0438\u0432\u0430\u045a\u0443 \u0440\u043e\u0434\u043d\u043e \u0437\u0430\u0441\u043d\u043e\u0432\u0430\u043d\u043e\u0433 \u043d\u0430\u0441\u0438\u0459\u0430, \u0458\u0430\u0447\u0430\u045a\u0443 \u043a\u0430\u043f\u0430\u0446\u0438\u0442\u0435\u0442\u0430 \u0441\u043b\u0443\u0436\u0431\u0438 \u0437\u0430 \u043f\u043e\u0434\u0440\u0448\u043a\u0443 \u0436\u0440\u0442\u0432\u0430\u043c\u0430 \u0442\u0435 \u043e\u0441\u0438\u0433\u0443\u0440\u0430\u0432\u0430\u045a\u0443 \u043f\u043e\u0442\u043f\u0443\u043d\u043e\u0433 \u0431\u043b\u0430\u0433\u043e\u0441\u0442\u0430\u045a\u0430 \u0438 \u0431\u0435\u0437\u0431\u0458\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u0436\u0435\u043d\u0430 \u0438 \u0434\u0458\u0435\u0432\u043e\u0458\u0447\u0438\u0446\u0430 \u0443 \u0458\u0430\u0432\u043d\u043e\u0458 \u0438 \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u043e\u0458 \u0441\u0444\u0435\u0440\u0438","target_number":"5.11","goal_number":"5","graph_title":"\u0424\u0438\u0437\u0438\u0447\u043a\u043e \u0438 \u0441\u0435\u043a\u0441\u0443\u0430\u043b\u043d\u043e \u043d\u0430\u0441\u0438\u0459\u0435 \u043d\u0430\u0434 \u0436\u0435\u043d\u0430\u043c\u0430 \u043f\u043e \u0441\u0442\u0430\u0440\u043e\u0441\u043d\u0438\u043c \u0433\u0440\u0443\u043f\u0430\u043c\u0430"}