30\u0446\u0438\u0458\u0430. \u041e\u0432\u0435 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0458\u0435 \u0437\u0430\u0442\u0438\u043c \u0434\u0440\u0436\u0430\u0432\u0435 \u0447\u043b\u0430\u043d\u0438\u0446\u0435 \u043f\u0440\u0438\u043b\u0430\u0433\u043e\u0452\u0430\u0432\u0430\u0458\u0443 \u043a\u0430\u043a\u043e \u0431\u0438 \u0443\u0437\u0435\u043b\u0435 \u0443 \u043e\u0431\u0437\u0438\u0440 \u0443\u0442\u0438\u0446\u0430\u0458 \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0435 \u0438\u0441\u043f\u043e\u0434 \u043e\u0432\u043e\u0433 \u043f\u0440\u0430\u0433\u0430.","rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u0430 \u0426\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 17 \u043e \u0440\u0435\u0432\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0458\u0438 \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e\u0433 \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0441\u0442\u0432\u0430 \u0437\u0430 \u043e\u0434\u0440\u0436\u0438\u0432\u0438 \u0440\u0430\u0437\u0432\u043e\u0458, \u0448\u0442\u043e \u0458\u0435 \u0443\u0433\u0440\u0430\u0452\u0435\u043d\u043e \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u0443 \u043e\u043a\u0432\u0438\u0440\u0443 \u201e\u041d\u043e\u0432\u0430 \u0435\u0440\u0430 \u0437\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0443 \u043e\u0434\u0431\u0440\u0430\u043d\u0443 \u0438 \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442\u201c \u0438 \u201e\u0417\u0430\u0448\u0442\u0438\u0442\u0430 \u043d\u0430\u0448\u0438\u0445 \u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u0458\u0430, \u043e\u0447\u0443\u0432\u0430\u045a\u0435 \u043d\u0430\u0448\u0438\u0445 \u0432\u0440\u0435\u0434\u043d\u043e\u0441\u0442\u0438\u201c. \u041f\u043e\u0442\u0435\u043d\u0446\u0438\u0458\u0430\u043b\u043d\u0438 \u0434\u043e\u043f\u0440\u0438\u043d\u043e\u0441 \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0435 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u043c \u0440\u0430\u0437\u0432\u043e\u0458\u0443 \u0458\u0435 \u043e\u0434\u0430\u0432\u043d\u043e \u043f\u0440\u0435\u043f\u043e\u0437\u043d\u0430\u0442. \u0415\u0423 \u043f\u0440\u0435\u0434\u0432\u043e\u0434\u0438 \u043f\u0443\u0442 \u043a\u0430 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0438\u0458\u0435\u043c \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e\u043c \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0441\u0442\u0432\u0443 \u0441\u0430 \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u0443 \u0440\u0430\u0437\u0432\u043e\u0458\u0443 \u0437\u0430\u0443\u0437\u0438\u043c\u0430\u0458\u0443\u045b\u0438 \u043e\u0434\u0433\u043e\u0432\u043e\u0440\u0430\u043d \u043f\u0440\u0438\u0441\u0442\u0443\u043f \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0441\u043a\u043e\u0458 \u0438 \u0438\u043d\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u043e\u043d\u043e\u0458 \u043f\u043e\u043b\u0438\u0442\u0438\u0446\u0438, \u043d\u0430 \u043f\u0440\u0438\u043c\u0435\u0440 \u043a\u0440\u043e\u0437 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0443 \u201e\u0422\u0440\u0433\u043e\u0432\u0438\u043d\u0430 \u0437\u0430 \u0441\u0432\u0435\u201c (2015) \u043a\u043e\u0458\u0430 \u0438\u043c\u0430 \u0437\u0430 \u0446\u0438\u0459 \u0434\u0430 \u043f\u043e\u043c\u043e\u0433\u043d\u0435 \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u0443 \u0440\u0430\u0437\u0432\u043e\u0458\u0443 \u0434\u0430 \u043f\u043e\u0442\u043f\u0443\u043d\u0438\u0458\u0435 \u0443\u0447\u0435\u0441\u0442\u0432\u0443\u0458\u0443 \u043d\u0430 \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e\u043c \u0442\u0440\u0436\u0438\u0448\u0442\u0443. \u0428\u0442\u0430\u0432\u0438\u0448\u0435, \u0415\u0423 \u043e\u043b\u0430\u043a\u0448\u0430\u0432\u0430 \u0443\u0432\u043e\u0437 \u0438\u0437 \u0437\u0435\u043c\u0430\u0459\u0430 \u0443 \u0440\u0430\u0437\u0432\u043e\u0458\u0443 \u043e\u0434\u043e\u0431\u0440\u0430\u0432\u0430\u045a\u0435\u043c \u0441\u043c\u0430\u045a\u0435\u045a\u0430 \u0446\u0430\u0440\u0438\u043d\u0430 \u0443 \u043e\u043a\u0432\u0438\u0440\u0443 \u0441\u0432\u043e\u0458\u0435 \u0413\u0435\u043d\u0435\u0440\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u0435 \u0448\u0435\u043c\u0435 \u043f\u0440\u0435\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0458\u0430 \u0438 \u043f\u0440\u0443\u0436\u0430\u045a\u0435\u043c \u201e\u041f\u043e\u043c\u043e\u045b\u0438 \u0437\u0430 \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0443\u201c \u0443\u0441\u043c\u0435\u0440\u0435\u043d\u0435 \u043d\u0430 \u043f\u043e\u0434\u0440\u0448\u043a\u0443 \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0441\u043a\u043e\u0458 \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0438, \u043f\u043e\u043c\u043e\u045b\u0438 \u0432\u0435\u0437\u0430\u043d\u043e\u0458 \u0437\u0430 \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0443 \u0438 \u0440\u0430\u0437\u0432\u043e\u0458\u0443 \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u043e\u0433 \u0441\u0435\u043a\u0442\u043e\u0440\u0430. \u041a\u043e\u043d\u0430\u0447\u043d\u043e, \u0421\u043f\u043e\u0440\u0430\u0437\u0443\u043c \u0438\u0437 \u041a\u043e\u0442\u043e\u043d\u0443\u0430 \u0440\u0435\u0433\u0443\u043b\u0438\u0448\u0435 \u043e\u0434\u043d\u043e\u0441\u0435 \u0415\u0423 \u0441\u0430 79 \u0437\u0435\u043c\u0430\u0459\u0430 \u0410\u0444\u0440\u0438\u043a\u0435, \u041a\u0430\u0440\u0438\u0431\u0430 \u0438 \u041f\u0430\u0446\u0438\u0444\u0438\u043a\u0430 (\u0410\u041a\u041f), \u0444\u043e\u043a\u0443\u0441\u0438\u0440\u0430\u0458\u0443\u045b\u0438 \u0441\u0435 \u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0443 \u0441\u0430\u0440\u0430\u0434\u045a\u0443, \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u043a\u0443 \u0441\u0430\u0440\u0430\u0434\u045a\u0443, \u043a\u0430\u043e \u0438 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0443 \u0438 \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0441\u043a\u0443 \u0441\u0430\u0440\u0430\u0434\u045a\u0443.","methodology_characteristics":"\u0415\u0423 \u0458\u0435 \u0430\u0436\u0443\u0440\u0438\u0440\u0430\u043b\u0430 \u0441\u0432\u043e\u0458\u0443 \u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0443 \u043f\u043e\u043c\u043e\u045b\u0438 \u0437\u0430 \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0443 2017. \u0433\u043e\u0434\u0438\u043d\u0435, \u043a\u0430\u043a\u043e \u0431\u0438 \u043e\u0434\u0440\u0430\u0436\u0430\u0432\u0430\u043b\u0430 \u0437\u043d\u0430\u0447\u0430\u0458\u043d\u0435 \u043f\u0440\u043e\u043c\u0435\u043d\u0435 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0430 \u0438 \u043d\u0430 \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e\u043c \u043d\u0438\u0432\u043e\u0443 - \u043f\u043e\u0441\u0435\u0431\u043d\u043e \u0410\u0433\u0435\u043d\u0434\u0443 2030 - \u0438 \u043d\u0430 \u043d\u0438\u0432\u043e\u0443 \u0415\u0423, \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443\u045b\u0438 \u043d\u043e\u0432\u0438 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0438 \u043a\u043e\u043d\u0441\u0435\u043d\u0437\u0443\u0441 \u043e \u0440\u0430\u0437\u0432\u043e\u0458\u0443 \u0438 \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0438 \u0437\u0430 \u0441\u0432\u0435. \u0410\u0436\u0443\u0440\u0438\u0440\u0430\u043d\u0430 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0430 \u0438\u043c\u0430 \u0437\u0430 \u0446\u0438\u0459 \u043f\u043e\u0431\u043e\u0459\u0448\u0430\u045a\u0435 \u043a\u043e\u0445\u0435\u0440\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u0438 \u043f\u043e\u043c\u043e\u045b\u0438 \u0437\u0430 \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0443 \u0441\u0430 \u0434\u0440\u0443\u0433\u0438\u043c \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0430\u043c\u0430 \u0438 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0438\u043c\u0430 \u0415\u0423, \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443\u045b\u0438 \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0441\u043a\u0435 \u0441\u043f\u043e\u0440\u0430\u0437\u0443\u043c\u0435 \u0415\u0423 \u0438 \u0458\u0435\u0434\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u0435 \u0448\u0435\u043c\u0435 \u043f\u0440\u0435\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0458\u0430. \u0424\u043e\u043a\u0443\u0441 \u043d\u0430 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 \u0440\u0430\u0437\u0432\u0438\u0458\u0435\u043d\u0435 \u0437\u0435\u043c\u0459\u0435 \u0458\u0435 \u043a\u0459\u0443\u0447\u043d\u0438 \u0434\u0435\u043e \u0430\u0436\u0443\u0440\u0438\u0440\u0430\u043d\u0435 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0435. \u0415\u0423 \u0458\u0435 2021. \u0433\u043e\u0434\u0438\u043d\u0435 \u0440\u0435\u0432\u0438\u0434\u0438\u0440\u0430\u043b\u0430 \u0441\u0432\u043e\u0458\u0443 \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0441\u043a\u0443 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0443, \u0441\u0430 \u0446\u0438\u0459\u0435\u043c \u0434\u0430 \u043e\u0434\u0440\u0430\u0436\u0430\u0432\u0430 \u0441\u0432\u043e\u0458 \u043d\u043e\u0432\u0438, \u043e\u0434\u0440\u0436\u0438\u0432\u0438\u0458\u0438 \u043c\u043e\u0434\u0435\u043b \u0440\u0430\u0441\u0442\u0430, \u043a\u0430\u043e \u0438 \u0446\u0438\u0459\u0435\u0432\u0435 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430.","eu_indicator_definition":"\u041e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0458\u0435 \u0434\u0435\u0444\u0438\u043d\u0438\u0441\u0430\u043d \u043a\u0430\u043e \u0443\u0434\u0435\u043e \u0443\u043a\u0443\u043f\u043d\u043e\u0433 \u0443\u0432\u043e\u0437\u0430 \u0432\u0430\u043d \u0415\u0423 \u043a\u043e\u0458\u0438 \u0434\u043e\u043b\u0430\u0437\u0438 \u0438\u0437 \u0437\u0435\u043c\u0430\u0459\u0430 \u043a\u043e\u0458\u0435 \u0441\u0443 \u0423\u041d \u043a\u043b\u0430\u0441\u0438\u0444\u0438\u043a\u043e\u0432\u0430\u043b\u0435 \u043a\u0430\u043e \u043d\u0430\u0458\u043c\u0430\u045a\u0435 \u0440\u0430\u0437\u0432\u0438\u0458\u0435\u043d\u0435. \u041e\u043d \u043f\u043e\u043a\u0430\u0437\u0443\u0458\u0435 \u0443 \u043a\u043e\u0458\u043e\u0458 \u043c\u0435\u0440\u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438 \u0438\u0437 \u043e\u0432\u0438\u0445 \u0437\u0435\u043c\u0430\u0459\u0430 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u0430\u0458\u0443 \u0442\u0440\u0436\u0438\u0448\u0442\u0443 \u0415\u0423. \u0418\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0458\u0435 \u0437\u0430 \u043e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043f\u0440\u0443\u0436\u0430\u0458\u0443 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0458\u0435 \u0441\u0430 \u043e\u0431\u0438\u043c\u043e\u043c \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0435 \u0438\u0437\u043d\u0430\u0434 \u0443\u0442\u0432\u0440\u0452\u0435\u043d\u043e\u0433 \u043f\u0440\u0430\u0433\u0430 \u0438 \u043f\u0440\u0438\u043a\u0443\u043f\u0459\u0430\u0458\u0443 \u0441\u0435 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0443 \u0446\u0430\u0440\u0438\u043d\u0441\u043a\u0438\u0445 \u0434\u0435\u043a\u043b\u0430\u0440\u0430\u0446\u0438\u0458\u0430. \u041e\u0432\u0435 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0458\u0435 \u0437\u0430\u0442\u0438\u043c \u0434\u0440\u0436\u0430\u0432\u0435 \u0447\u043b\u0430\u043d\u0438\u0446\u0435 \u043f\u0440\u0438\u043b\u0430\u0433\u043e\u0452\u0430\u0432\u0430\u0458\u0443 \u043a\u0430\u043a\u043e \u0431\u0438 \u0443\u0437\u0435\u043b\u0435 \u0443 \u043e\u0431\u0437\u0438\u0440 \u0443\u0442\u0438\u0446\u0430\u0458 \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0435 \u0438\u0441\u043f\u043e\u0434 \u043e\u0432\u043e\u0433 \u043f\u0440\u0430\u0433\u0430.","eu_rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u0430 \u0426\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 17 \u043e \u0440\u0435\u0432\u0438\u0442\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0458\u0438 \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e\u0433 \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0441\u0442\u0432\u0430 \u0437\u0430 \u043e\u0434\u0440\u0436\u0438\u0432\u0438 \u0440\u0430\u0437\u0432\u043e\u0458, \u0448\u0442\u043e \u0458\u0435 \u0443\u0433\u0440\u0430\u0452\u0435\u043d\u043e \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u0443 \u043e\u043a\u0432\u0438\u0440\u0443 \u201e\u041d\u043e\u0432\u0430 \u0435\u0440\u0430 \u0437\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0443 \u043e\u0434\u0431\u0440\u0430\u043d\u0443 \u0438 \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442\u201c \u0438 \u201e\u0417\u0430\u0448\u0442\u0438\u0442\u0430 \u043d\u0430\u0448\u0438\u0445 \u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u0458\u0430, \u043e\u0447\u0443\u0432\u0430\u045a\u0435 \u043d\u0430\u0448\u0438\u0445 \u0432\u0440\u0435\u0434\u043d\u043e\u0441\u0442\u0438\u201c. \u041f\u043e\u0442\u0435\u043d\u0446\u0438\u0458\u0430\u043b\u043d\u0438 \u0434\u043e\u043f\u0440\u0438\u043d\u043e\u0441 \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0435 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u043c \u0440\u0430\u0437\u0432\u043e\u0458\u0443 \u0458\u0435 \u043e\u0434\u0430\u0432\u043d\u043e \u043f\u0440\u0435\u043f\u043e\u0437\u043d\u0430\u0442. \u0415\u0423 \u043f\u0440\u0435\u0434\u0432\u043e\u0434\u0438 \u043f\u0443\u0442 \u043a\u0430 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0438\u0458\u0435\u043c \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e\u043c \u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0441\u0442\u0432\u0443 \u0441\u0430 \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u0443 \u0440\u0430\u0437\u0432\u043e\u0458\u0443 \u0437\u0430\u0443\u0437\u0438\u043c\u0430\u0458\u0443\u045b\u0438 \u043e\u0434\u0433\u043e\u0432\u043e\u0440\u0430\u043d \u043f\u0440\u0438\u0441\u0442\u0443\u043f \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0441\u043a\u043e\u0458 \u0438 \u0438\u043d\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u043e\u043d\u043e\u0458 \u043f\u043e\u043b\u0438\u0442\u0438\u0446\u0438, \u043d\u0430 \u043f\u0440\u0438\u043c\u0435\u0440 \u043a\u0440\u043e\u0437 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0443 \u201e\u0422\u0440\u0433\u043e\u0432\u0438\u043d\u0430 \u0437\u0430 \u0441\u0432\u0435\u201c (2015) \u043a\u043e\u0458\u0430 \u0438\u043c\u0430 \u0437\u0430 \u0446\u0438\u0459 \u0434\u0430 \u043f\u043e\u043c\u043e\u0433\u043d\u0435 \u0437\u0435\u043c\u0459\u0430\u043c\u0430 \u0443 \u0440\u0430\u0437\u0432\u043e\u0458\u0443 \u0434\u0430 \u043f\u043e\u0442\u043f\u0443\u043d\u0438\u0458\u0435 \u0443\u0447\u0435\u0441\u0442\u0432\u0443\u0458\u0443 \u043d\u0430 \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e\u043c \u0442\u0440\u0436\u0438\u0448\u0442\u0443. \u0428\u0442\u0430\u0432\u0438\u0448\u0435, \u0415\u0423 \u043e\u043b\u0430\u043a\u0448\u0430\u0432\u0430 \u0443\u0432\u043e\u0437 \u0438\u0437 \u0437\u0435\u043c\u0430\u0459\u0430 \u0443 \u0440\u0430\u0437\u0432\u043e\u0458\u0443 \u043e\u0434\u043e\u0431\u0440\u0430\u0432\u0430\u045a\u0435\u043c \u0441\u043c\u0430\u045a\u0435\u045a\u0430 \u0446\u0430\u0440\u0438\u043d\u0430 \u0443 \u043e\u043a\u0432\u0438\u0440\u0443 \u0441\u0432\u043e\u0458\u0435 \u0413\u0435\u043d\u0435\u0440\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u0435 \u0448\u0435\u043c\u0435 \u043f\u0440\u0435\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0458\u0430 \u0438 \u043f\u0440\u0443\u0436\u0430\u045a\u0435\u043c \u201e\u041f\u043e\u043c\u043e\u045b\u0438 \u0437\u0430 \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0443\u201c \u0443\u0441\u043c\u0435\u0440\u0435\u043d\u0435 \u043d\u0430 \u043f\u043e\u0434\u0440\u0448\u043a\u0443 \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0441\u043a\u043e\u0458 \u0438\u043d\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0438, \u043f\u043e\u043c\u043e\u045b\u0438 \u0432\u0435\u0437\u0430\u043d\u043e\u0458 \u0437\u0430 \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0443 \u0438 \u0440\u0430\u0437\u0432\u043e\u0458\u0443 \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u043e\u0433 \u0441\u0435\u043a\u0442\u043e\u0440\u0430. \u041a\u043e\u043d\u0430\u0447\u043d\u043e, \u0421\u043f\u043e\u0440\u0430\u0437\u0443\u043c \u0438\u0437 \u041a\u043e\u0442\u043e\u043d\u0443\u0430 \u0440\u0435\u0433\u0443\u043b\u0438\u0448\u0435 \u043e\u0434\u043d\u043e\u0441\u0435 \u0415\u0423 \u0441\u0430 79 \u0437\u0435\u043c\u0430\u0459\u0430 \u0410\u0444\u0440\u0438\u043a\u0435, \u041a\u0430\u0440\u0438\u0431\u0430 \u0438 \u041f\u0430\u0446\u0438\u0444\u0438\u043a\u0430 (\u0410\u041a\u041f), \u0444\u043e\u043a\u0443\u0441\u0438\u0440\u0430\u0458\u0443\u045b\u0438 \u0441\u0435 \u043d\u0430 \u0440\u0430\u0437\u0432\u043e\u0458\u043d\u0443 \u0441\u0430\u0440\u0430\u0434\u045a\u0443, \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u043a\u0443 \u0441\u0430\u0440\u0430\u0434\u045a\u0443, \u043a\u0430\u043e \u0438 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u0443 \u0438 \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0441\u043a\u0443 \u0441\u0430\u0440\u0430\u0434\u045a\u0443.","eu_methodology_characteristics":"\u0415\u0423 \u0458\u0435 \u0430\u0436\u0443\u0440\u0438\u0440\u0430\u043b\u0430 \u0441\u0432\u043e\u0458\u0443 \u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0443 \u043f\u043e\u043c\u043e\u045b\u0438 \u0437\u0430 \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0443 2017. \u0433\u043e\u0434\u0438\u043d\u0435, \u043a\u0430\u043a\u043e \u0431\u0438 \u043e\u0434\u0440\u0430\u0436\u0430\u0432\u0430\u043b\u0430 \u0437\u043d\u0430\u0447\u0430\u0458\u043d\u0435 \u043f\u0440\u043e\u043c\u0435\u043d\u0435 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0430 \u0438 \u043d\u0430 \u0433\u043b\u043e\u0431\u0430\u043b\u043d\u043e\u043c \u043d\u0438\u0432\u043e\u0443 - \u043f\u043e\u0441\u0435\u0431\u043d\u043e \u0410\u0433\u0435\u043d\u0434\u0443 2030 - \u0438 \u043d\u0430 \u043d\u0438\u0432\u043e\u0443 \u0415\u0423, \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443\u045b\u0438 \u043d\u043e\u0432\u0438 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0438 \u043a\u043e\u043d\u0441\u0435\u043d\u0437\u0443\u0441 \u043e \u0440\u0430\u0437\u0432\u043e\u0458\u0443 \u0438 \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0438 \u0437\u0430 \u0441\u0432\u0435. \u0410\u0436\u0443\u0440\u0438\u0440\u0430\u043d\u0430 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0430 \u0438\u043c\u0430 \u0437\u0430 \u0446\u0438\u0459 \u043f\u043e\u0431\u043e\u0459\u0448\u0430\u045a\u0435 \u043a\u043e\u0445\u0435\u0440\u0435\u043d\u0442\u043d\u043e\u0441\u0442\u0438 \u043f\u043e\u043c\u043e\u045b\u0438 \u0437\u0430 \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0443 \u0441\u0430 \u0434\u0440\u0443\u0433\u0438\u043c \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0430\u043c\u0430 \u0438 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0438\u043c\u0430 \u0415\u0423, \u0443\u043a\u0459\u0443\u0447\u0443\u0458\u0443\u045b\u0438 \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0441\u043a\u0435 \u0441\u043f\u043e\u0440\u0430\u0437\u0443\u043c\u0435 \u0415\u0423 \u0438 \u0458\u0435\u0434\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u0435 \u0448\u0435\u043c\u0435 \u043f\u0440\u0435\u0444\u0435\u0440\u0435\u043d\u0446\u0438\u0458\u0430. \u0424\u043e\u043a\u0443\u0441 \u043d\u0430 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 \u0440\u0430\u0437\u0432\u0438\u0458\u0435\u043d\u0435 \u0437\u0435\u043c\u0459\u0435 \u0458\u0435 \u043a\u0459\u0443\u0447\u043d\u0438 \u0434\u0435\u043e \u0430\u0436\u0443\u0440\u0438\u0440\u0430\u043d\u0435 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0435. \u0415\u0423 \u0458\u0435 2021. \u0433\u043e\u0434\u0438\u043d\u0435 \u0440\u0435\u0432\u0438\u0434\u0438\u0440\u0430\u043b\u0430 \u0441\u0432\u043e\u0458\u0443 \u0442\u0440\u0433\u043e\u0432\u0438\u043d\u0441\u043a\u0443 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0458\u0443, \u0441\u0430 \u0446\u0438\u0459\u0435\u043c \u0434\u0430 \u043e\u0434\u0440\u0430\u0436\u0430\u0432\u0430 \u0441\u0432\u043e\u0458 \u043d\u043e\u0432\u0438, \u043e\u0434\u0440\u0436\u0438\u0432\u0438\u0458\u0438 \u043c\u043e\u0434\u0435\u043b \u0440\u0430\u0441\u0442\u0430, \u043a\u0430\u043e \u0438 \u0446\u0438\u0459\u0435\u0432\u0435 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430.","target_number":"17.31","goal_number":"17","indicator_name":"\u0423\u0432\u043e\u0437 \u0415\u0423 \u0438\u0437 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 \u0440\u0430\u0437\u0432\u0438\u0458\u0435\u043d\u0438\u0445 \u0437\u0435\u043c\u0430\u0459\u0430","graph_title":"\u0423\u0432\u043e\u0437 \u0415\u0423 \u0438\u0437 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 \u0440\u0430\u0437\u0432\u0438\u0458\u0435\u043d\u0438\u0445 \u0437\u0435\u043c\u0430\u0459\u0430"}