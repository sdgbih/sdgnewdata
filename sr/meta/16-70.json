u0435\u0437\u0443\u043b\u0442\u0430\u0442 \u0437\u0430 \u0441\u043a\u0443\u043f \u0437\u0435\u043c\u0430\u0459\u0430/\u0442\u0435\u0440\u0438\u0442\u043e\u0440\u0438\u0458\u0430 \u0438 \u043a\u043e\u0458\u0438 \u043c\u0435\u0440\u0435 \u043f\u0435\u0440\u0446\u0435\u043f\u0446\u0438\u0458\u0443 \u043a\u043e\u0440\u0443\u043f\u0446\u0438\u0458\u0435 \u0443 \u0458\u0430\u0432\u043d\u043e\u043c \u0441\u0435\u043a\u0442\u043e\u0440\u0443. \u0414\u0430 \u0431\u0438 \u0431\u0438\u043b\u0430 \u0443\u043a\u0459\u0443\u0447\u0435\u043d\u0430 \u0443 \u0440\u0430\u043d\u0433\u0438\u0440\u0430\u045a\u0435, \u0437\u0435\u043c\u0459\u0430/\u0442\u0435\u0440\u0438\u0442\u043e\u0440\u0438\u0458\u0430 \u043c\u043e\u0440\u0430 \u0431\u0438\u0442\u0438 \u0443\u043a\u0459\u0443\u0447\u0435\u043d\u0430 \u0443 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 \u0442\u0440\u0438 \u0438\u0437\u0432\u043e\u0440\u0430 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u0418\u041f\u0426-\u0430. \u0418\u041f\u0426 \u043e\u0431\u0458\u0430\u0432\u0459\u0443\u0458\u0435 \u0422\u0440\u0430\u043d\u0441\u043f\u0430\u0440\u0435\u043d\u0441\u0438 \u0418\u043d\u0442\u0435\u0440\u043d\u0435\u0448\u0435\u043d\u0435\u043b.","eu_rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u0430 \u043e\u0441\u0442\u0432\u0430\u0440\u0438\u0432\u0430\u045a\u0443 \u0426\u0438\u0459\u0430 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 16 \u043e \u043c\u0438\u0440\u0443, \u043f\u0440\u0430\u0432\u0434\u0438 \u0438 \u0458\u0430\u043a\u0438\u043c \u0438\u043d\u0441\u0442\u0438\u0442\u0443\u0446\u0438\u0458\u0430\u043c\u0430, \u043a\u043e\u0458\u0438 \u0458\u0435 \u0443\u0433\u0440\u0430\u0452\u0435\u043d \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u0443 \u043e\u043a\u0432\u0438\u0440\u0443 \u201e\u041d\u043e\u0432\u0435 \u0435\u0440\u0435 \u0437\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0443 \u043e\u0434\u0431\u0440\u0430\u043d\u0443 \u0438 \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442\u201c \u0438 \u201e\u0417\u0430\u0448\u0442\u0438\u0442\u0435 \u043d\u0430\u0448\u0438\u0445 \u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u0458\u0430, \u043f\u043e\u0434\u0440\u0436\u0430\u0432\u0430\u045a\u0430 \u043d\u0430\u0448\u0438\u0445 \u0432\u0440\u0435\u0434\u043d\u043e\u0441\u0442\u0438\u201c.","eu_methodology_characteristics":"\u0411\u0435\u0437\u0431\u0458\u0435\u0434\u043d\u043e\u0441\u0442 \u0458\u0435 \u043a\u0459\u0443\u0447\u043d\u0438 \u0430\u0441\u043f\u0435\u043a\u0442 \u0443 \u0436\u0438\u0432\u043e\u0442\u0438\u043c\u0430 \u0459\u0443\u0434\u0438. \u041d\u0435\u0441\u0438\u0433\u0443\u0440\u043d\u043e\u0441\u0442 \u0431\u0438\u043b\u043e \u043a\u043e\u0458\u0435 \u0432\u0440\u0441\u0442\u0435 \u0458\u0435 \u0438\u0437\u0432\u043e\u0440 \u0441\u0442\u0440\u0430\u0445\u0430 \u0438 \u0431\u0440\u0438\u0433\u0435, \u0448\u0442\u043e \u043d\u0435\u0433\u0430\u0442\u0438\u0432\u043d\u043e \u0443\u0442\u0438\u0447\u0435 \u043d\u0430 \u043a\u0432\u0430\u043b\u0438\u0442\u0435\u0442 \u0436\u0438\u0432\u043e\u0442\u0430. \u0424\u0438\u0437\u0438\u0447\u043a\u0430 \u043d\u0435\u0441\u0438\u0433\u0443\u0440\u043d\u043e\u0441\u0442 \u043e\u0431\u0443\u0445\u0432\u0430\u0442\u0430 \u0441\u0432\u0435 \u0441\u043f\u043e\u0459\u043d\u0435 \u0444\u0430\u043a\u0442\u043e\u0440\u0435 \u043a\u043e\u0458\u0438 \u043f\u043e\u0442\u0435\u043d\u0446\u0438\u0458\u0430\u043b\u043d\u043e \u043c\u043e\u0433\u0443 \u0443\u0433\u0440\u043e\u0437\u0438\u0442\u0438 \u0444\u0438\u0437\u0438\u0447\u043a\u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0442\u0435\u0442 \u043f\u043e\u0458\u0435\u0434\u0438\u043d\u0446\u0430. \u041a\u0440\u0438\u