{"indicator_number":11.11,"reporting_status":"complete","published":true,"sdg_goal":"11","data_non_statistical":false,"graph_type":"line","indicator_sort_order":"11-11","source_active_1":true,"source_organisation_1":"ESS (SILC)","source_url_1":"https://ec.europa.eu/eurostat/databrowser/view/sdg_11_11/default/table","footer_fields":[{"label":"\u041d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u0440\u0435\u0444\u0435\u0440\u0435\u043d\u0442\u043d\u0438 \u043c\u0435\u0442\u0430\u043f\u043e\u0434\u0430\u0446\u0438","value":"<a href=\"https://ec.europa.eu/eurostat/cache/metadata/en/sdg_11_11_esmsip2.htm\" target=\"_blank\">Eurostat Metadata Report (sdg_11_11)</a>"}],"indicator_definition":"\u0421\u0442\u043e\u043f\u0430 \u0442\u0435\u0448\u043a\u0435 \u0441\u0442\u0430\u043c\u0431\u0435\u043d\u0435 \u0434\u0435\u043f\u0440\u0438\u0432\u0430\u0446\u0438\u0458\u0435 \u0434\u0435\u0444\u0438\u043d\u0438\u0448\u0435 \u0441\u0435 \u043a\u0430\u043e \u043f\u0440\u043e\u0446\u0435\u043d\u0430\u0442 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u0430 \u043a\u043e\u0458\u0435 \u0436\u0438\u0432\u0438 \u0443 \u0441\u0442\u0430\u043c\u0431\u0435\u043d\u043e\u0458 \u0458\u0435\u0434\u0438\u043d\u0438\u0446\u0438 \u043a\u043e\u0458\u0430 \u0441\u0435 \u0441\u043c\u0430\u0442\u0440\u0430 \u043f\u0440\u0435\u043d\u0430\u0441\u0435\u0459\u0435\u043d\u043e\u043c \u0438 \u0438\u0441\u0442\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043e \u043f\u043e\u043a\u0430\u0437\u0443\u0458\u0435 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 \u0458\u0435\u0434\u043d\u0443 \u043e\u0434 \u0441\u043b\u0435\u0434\u0435\u045b\u0438\u0445 \u043c\u0435\u0440\u0430 \u0441\u0442\u0430\u043c\u0431\u0435\u043d\u0435 \u0434\u0435\u043f\u0440\u0438\u0432\u0430\u0446\u0438\u0458\u0435: i) \u043a\u0440\u043e\u0432 \u043a\u043e\u0458\u0438 \u0446\u0443\u0440\u0438, ii) \u043d\u0435\u043c\u0430 \u043a\u0430\u0434\u0435/\u0442\u0443\u0448\u0430 \u0438 \u043d\u0435\u043c\u0430 \u0442\u043e\u0430\u043b\u0435\u0442\u0430 \u0443 \u0437\u0430\u0442\u0432\u043e\u0440\u0435\u043d\u043e\u043c \u043f\u0440\u043e\u0441\u0442\u043e\u0440\u0443, iii) \u0441\u043c\u0430\u0442\u0440\u0430 \u0441\u0435 \u043f\u0440\u0435\u0432\u0438\u0448\u0435 \u043c\u0440\u0430\u0447\u043d\u043e\u043c.","rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u0430 \u0426\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 11 \u043e \u0442\u043e\u043c\u0435 \u0434\u0430 \u0433\u0440\u0430\u0434\u043e\u0432\u0438 \u0438 \u0459\u0443\u0434\u0441\u043a\u0430 \u043d\u0430\u0441\u0435\u0459\u0430 \u0431\u0443\u0434\u0443 \u0438\u043d\u043a\u043b\u0443\u0437\u0438\u0432\u043d\u0438, \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u0438, \u043e\u0442\u043f\u043e\u0440\u043d\u0438 \u0438 \u043e\u0434\u0440\u0436\u0438\u0432\u0438, \u0438 \u043a\u0430 \u0426\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 1 \u043e \u0432\u0438\u0448\u0435\u0434\u0438\u043c\u0435\u043d\u0437\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u043c \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0443. \u0426\u0438\u0459 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 11 \u0458\u0435 \u0443\u0433\u0440\u0430\u0452\u0435\u043d \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u201e\u041d\u043e\u0432\u0430 \u0435\u0440\u0430 \u0437\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0443 \u043e\u0434\u0431\u0440\u0430\u043d\u0443 \u0438 \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442\u201c, \u201e\u041f\u043e\u0434\u0440\u0448\u043a\u0430 \u0459\u0443\u0434\u0438\u043c\u0430, \u0458\u0430\u0447\u0430\u045a\u0435 \u043d\u0430\u0448\u0438\u0445 \u0434\u0440\u0443\u0448\u0442\u0430\u0432\u0430 \u0438 \u043d\u0430\u0448\u0435\u0433 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u043e\u0433 \u043c\u043e\u0434\u0435\u043b\u0430\u201c, \u201e\u041e\u0434\u0440\u0436\u0430\u0432\u0430\u045a\u0435 \u043d\u0430\u0448\u0435\u0433 \u043a\u0432\u0430\u043b\u0438\u0442\u0435\u0442\u0430 \u0436\u0438\u0432\u043e\u0442\u0430: \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442 \u0445\u0440\u0430\u043d\u0435, \u0432\u043e\u0434\u0430 \u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u0430\u201c \u0438 \u201e\u0417\u0430\u0448\u0442\u0438\u0442\u0430 \u043d\u0430\u0448\u0435 \u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u0458\u0435, \u043f\u043e\u0448\u0442\u043e\u0432\u0430\u045a\u0435 \u043d\u0430\u0448\u0438\u0445 \u0432\u0440\u0435\u0434\u043d\u043e\u0441\u0442\u0438\u201c. \u0426\u0438\u0459 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 1 \u0458\u0435 \u0443\u0433\u0440\u0430\u0452\u0435\u043d \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u201e\u041f\u043e\u0434\u0440\u0448\u043a\u0430 \u0459\u0443\u0434\u0438\u043c\u0430, \u0458\u0430\u0447\u0430\u045a\u0435 \u043d\u0430\u0448\u0438\u0445 \u0434\u0440\u0443\u0448\u0442\u0430\u0432\u0430 \u0438 \u043d\u0430\u0448\u0435\u0433 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u043e\u0433 \u043c\u043e\u0434\u0435\u043b\u0430\u201c.","methodology_characteristics":"\u0426\u0438\u0459 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 11 \u0438\u043c\u0430 \u0437\u0430 \u0446\u0438\u0459 \u043e\u0431\u043d\u043e\u0432\u0443 \u0438 \u043f\u043b\u0430\u043d\u0438\u0440\u0430\u045a\u0435 \u0433\u0440\u0430\u0434\u043e\u0432\u0430 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0459\u0443\u0434\u0441\u043a\u0438\u0445 \u043d\u0430\u0441\u0435\u0459\u0430 \u0442\u0430\u043a\u043e \u0434\u0430 \u043d\u0443\u0434\u0435 \u043c\u043e\u0433\u0443\u045b\u043d\u043e\u0441\u0442\u0438 \u0437\u0430 \u0441\u0432\u0435, \u0441\u0430 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u043e\u043c \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0443\u0441\u043b\u0443\u0433\u0430\u043c\u0430, \u0435\u043d\u0435\u0440\u0433\u0438\u0458\u0438, \u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045a\u0443, \u043f\u0440\u0435\u0432\u043e\u0437\u0443, \u0437\u0435\u043b\u0435\u043d\u0438\u043c \u0458\u0430\u0432\u043d\u0438\u043c \u043f\u043e\u0432\u0440\u0448\u0438\u043d\u0430\u043c\u0430 \u0438 \u0458\u043e\u0448 \u043c\u043d\u043e\u0433\u043e \u0442\u043e\u0433\u0430, \u0443\u0437 \u043f\u043e\u0431\u043e\u0459\u0448\u0430\u045a\u0435 \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u045a\u0430 \u0440\u0435\u0441\u0443\u0440\u0441\u0430 \u0438 \u0441\u043c\u0430\u045a\u0435\u045a\u0435 \u0443\u0442\u0438\u0446\u0430\u0458\u0430 \u043d\u0430 \u0436\u0438\u0432\u043e\u0442\u043d\u0443 \u0441\u0440\u0435\u0434\u0438\u043d\u0443. \u0426\u0438\u0459 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 1, \u0438\u0437\u043c\u0435\u0452\u0443 \u043e\u0441\u0442\u0430\u043b\u043e\u0433, \u043f\u043e\u0437\u0438\u0432\u0430 \u043d\u0430 \u0438\u0441\u043a\u043e\u0440\u0435\u045a\u0438\u0432\u0430\u045a\u0435 \u0435\u043a\u0441\u0442\u0440\u0435\u043c\u043d\u043e\u0433 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u0438 \u0441\u043c\u0430\u045a\u0435\u045a\u0435 \u0440\u0435\u043b\u0430\u0442\u0438\u0432\u043d\u043e\u0433 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u0438 \u0443\u0433\u0440\u0430\u0452\u0435\u043d \u0458\u0435 \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u0443 \u043e\u043a\u0432\u0438\u0440\u0443 \u201e\u0415\u043a\u043e\u043d\u043e\u043c\u0438\u0458\u0435 \u043a\u043e\u0458\u0430 \u0440\u0430\u0434\u0438 \u0437\u0430 \u0459\u0443\u0434\u0435\u201c.","eu_indicator_definition":"\u0421\u0442\u043e\u043f\u0430 \u0442\u0435\u0448\u043a\u0435 \u0441\u0442\u0430\u043c\u0431\u0435\u043d\u0435 \u0434\u0435\u043f\u0440\u0438\u0432\u0430\u0446\u0438\u0458\u0435 \u0434\u0435\u0444\u0438\u043d\u0438\u0448\u0435 \u0441\u0435 \u043a\u0430\u043e \u043f\u0440\u043e\u0446\u0435\u043d\u0430\u0442 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u0430 \u043a\u043e\u0458\u0435 \u0436\u0438\u0432\u0438 \u0443 \u0441\u0442\u0430\u043c\u0431\u0435\u043d\u043e\u0458 \u0458\u0435\u0434\u0438\u043d\u0438\u0446\u0438 \u043a\u043e\u0458\u0430 \u0441\u0435 \u0441\u043c\u0430\u0442\u0440\u0430 \u043f\u0440\u0435\u043d\u0430\u0441\u0435\u0459\u0435\u043d\u043e\u043c \u0438 \u0438\u0441\u0442\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043e \u043f\u043e\u043a\u0430\u0437\u0443\u0458\u0435 \u043d\u0430\u0458\u043c\u0430\u045a\u0435 \u0458\u0435\u0434\u043d\u0443 \u043e\u0434 \u0441\u043b\u0435\u0434\u0435\u045b\u0438\u0445 \u043c\u0435\u0440\u0430 \u0441\u0442\u0430\u043c\u0431\u0435\u043d\u0435 \u0434\u0435\u043f\u0440\u0438\u0432\u0430\u0446\u0438\u0458\u0435: i) \u043a\u0440\u043e\u0432 \u043a\u043e\u0458\u0438 \u0446\u0443\u0440\u0438, ii) \u043d\u0435\u043c\u0430 \u043a\u0430\u0434\u0435/\u0442\u0443\u0448\u0430 \u0438 \u043d\u0435\u043c\u0430 \u0442\u043e\u0430\u043b\u0435\u0442\u0430 \u0443 \u0437\u0430\u0442\u0432\u043e\u0440\u0435\u043d\u043e\u043c \u043f\u0440\u043e\u0441\u0442\u043e\u0440\u0443, iii) \u0441\u043c\u0430\u0442\u0440\u0430 \u0441\u0435 \u043f\u0440\u0435\u0432\u0438\u0448\u0435 \u043c\u0440\u0430\u0447\u043d\u043e\u043c.","eu_rationale":"\u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0437\u0430 \u043f\u0440\u0430\u045b\u0435\u045a\u0435 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043a\u0430 \u0426\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 11 \u043e \u0442\u043e\u043c\u0435 \u0434\u0430 \u0433\u0440\u0430\u0434\u043e\u0432\u0438 \u0438 \u0459\u0443\u0434\u0441\u043a\u0430 \u043d\u0430\u0441\u0435\u0459\u0430 \u0431\u0443\u0434\u0443 \u0438\u043d\u043a\u043b\u0443\u0437\u0438\u0432\u043d\u0438, \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u0438, \u043e\u0442\u043f\u043e\u0440\u043d\u0438 \u0438 \u043e\u0434\u0440\u0436\u0438\u0432\u0438, \u0438 \u043a\u0430 \u0426\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 1 \u043e \u0432\u0438\u0448\u0435\u0434\u0438\u043c\u0435\u043d\u0437\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u043c \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0443. \u0426\u0438\u0459 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 11 \u0458\u0435 \u0443\u0433\u0440\u0430\u0452\u0435\u043d \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u201e\u041d\u043e\u0432\u0430 \u0435\u0440\u0430 \u0437\u0430 \u0435\u0432\u0440\u043e\u043f\u0441\u043a\u0443 \u043e\u0434\u0431\u0440\u0430\u043d\u0443 \u0438 \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442\u201c, \u201e\u041f\u043e\u0434\u0440\u0448\u043a\u0430 \u0459\u0443\u0434\u0438\u043c\u0430, \u0458\u0430\u0447\u0430\u045a\u0435 \u043d\u0430\u0448\u0438\u0445 \u0434\u0440\u0443\u0448\u0442\u0430\u0432\u0430 \u0438 \u043d\u0430\u0448\u0435\u0433 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u043e\u0433 \u043c\u043e\u0434\u0435\u043b\u0430\u201c, \u201e\u041e\u0434\u0440\u0436\u0430\u0432\u0430\u045a\u0435 \u043d\u0430\u0448\u0435\u0433 \u043a\u0432\u0430\u043b\u0438\u0442\u0435\u0442\u0430 \u0436\u0438\u0432\u043e\u0442\u0430: \u0431\u0435\u0437\u0431\u0435\u0434\u043d\u043e\u0441\u0442 \u0445\u0440\u0430\u043d\u0435, \u0432\u043e\u0434\u0430 \u0438 \u043f\u0440\u0438\u0440\u043e\u0434\u0430\u201c \u0438 \u201e\u0417\u0430\u0448\u0442\u0438\u0442\u0430 \u043d\u0430\u0448\u0435 \u0434\u0435\u043c\u043e\u043a\u0440\u0430\u0442\u0438\u0458\u0435, \u043f\u043e\u0448\u0442\u043e\u0432\u0430\u045a\u0435 \u043d\u0430\u0448\u0438\u0445 \u0432\u0440\u0435\u0434\u043d\u043e\u0441\u0442\u0438\u201c. \u0426\u0438\u0459 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 1 \u0458\u0435 \u0443\u0433\u0440\u0430\u0452\u0435\u043d \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u201e\u041f\u043e\u0434\u0440\u0448\u043a\u0430 \u0459\u0443\u0434\u0438\u043c\u0430, \u0458\u0430\u0447\u0430\u045a\u0435 \u043d\u0430\u0448\u0438\u0445 \u0434\u0440\u0443\u0448\u0442\u0430\u0432\u0430 \u0438 \u043d\u0430\u0448\u0435\u0433 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u043e\u0433 \u043c\u043e\u0434\u0435\u043b\u0430\u201c.","eu_methodology_characteristics":"\u0426\u0438\u0459 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 11 \u0438\u043c\u0430 \u0437\u0430 \u0446\u0438\u0459 \u043e\u0431\u043d\u043e\u0432\u0443 \u0438 \u043f\u043b\u0430\u043d\u0438\u0440\u0430\u045a\u0435 \u0433\u0440\u0430\u0434\u043e\u0432\u0430 \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u0459\u0443\u0434\u0441\u043a\u0438\u0445 \u043d\u0430\u0441\u0435\u0459\u0430 \u0442\u0430\u043a\u043e \u0434\u0430 \u043d\u0443\u0434\u0435 \u043c\u043e\u0433\u0443\u045b\u043d\u043e\u0441\u0442\u0438 \u0437\u0430 \u0441\u0432\u0435, \u0441\u0430 \u043f\u0440\u0438\u0441\u0442\u0443\u043f\u043e\u043c \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u043c \u0443\u0441\u043b\u0443\u0433\u0430\u043c\u0430, \u0435\u043d\u0435\u0440\u0433\u0438\u0458\u0438, \u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045a\u0443, \u043f\u0440\u0435\u0432\u043e\u0437\u0443, \u0437\u0435\u043b\u0435\u043d\u0438\u043c \u0458\u0430\u0432\u043d\u0438\u043c \u043f\u043e\u0432\u0440\u0448\u0438\u043d\u0430\u043c\u0430 \u0438 \u0458\u043e\u0448 \u043c\u043d\u043e\u0433\u043e \u0442\u043e\u0433\u0430, \u0443\u0437 \u043f\u043e\u0431\u043e\u0459\u0448\u0430\u045a\u0435 \u043a\u043e\u0440\u0438\u0448\u045b\u0435\u045a\u0430 \u0440\u0435\u0441\u0443\u0440\u0441\u0430 \u0438 \u0441\u043c\u0430\u045a\u0435\u045a\u0435 \u0443\u0442\u0438\u0446\u0430\u0458\u0430 \u043d\u0430 \u0436\u0438\u0432\u043e\u0442\u043d\u0443 \u0441\u0440\u0435\u0434\u0438\u043d\u0443. \u0426\u0438\u0459 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430 1, \u0438\u0437\u043c\u0435\u0452\u0443 \u043e\u0441\u0442\u0430\u043b\u043e\u0433, \u043f\u043e\u0437\u0438\u0432\u0430 \u043d\u0430 \u0438\u0441\u043a\u043e\u0440\u0435\u045a\u0438\u0432\u0430\u045a\u0435 \u0435\u043a\u0441\u0442\u0440\u0435\u043c\u043d\u043e\u0433 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u0438 \u0441\u043c\u0430\u045a\u0435\u045a\u0435 \u0440\u0435\u043b\u0430\u0442\u0438\u0432\u043d\u043e\u0433 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u0438 \u0443\u0433\u0440\u0430\u0452\u0435\u043d \u0458\u0435 \u0443 \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u0435 \u0415\u0432\u0440\u043e\u043f\u0441\u043a\u0435 \u043a\u043e\u043c\u0438\u0441\u0438\u0458\u0435 \u0443 \u043e\u043a\u0432\u0438\u0440\u0443 \u201e\u0415\u043a\u043e\u043d\u043e\u043c\u0438\u0458\u0435 \u043a\u043e\u0458\u0430 \u0440\u0430\u0434\u0438 \u0437\u0430 \u0459\u0443\u0434\u0435\u201c.","target_number":"11.11","goal_number":"11","indicator_name":"\u0421\u0442\u043e\u043f\u0430 \u0442\u0435\u0448\u043a\u0435 \u0441\u0442\u0430\u043c\u0431\u0435\u043d\u0435 \u0434\u0435\u043f\u0440\u0438\u0432\u0430\u0446\u0438\u0458\u0435","graph_title":"\u0421\u0442\u043e\u043f\u0430 \u0442\u0435\u0448\u04