43e\u045b\u0438 \u0438\u0437 2021. \u0433\u043e\u0434\u0438\u043d\u0435) \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430 \u043f\u0440\u043e\u0441\u0458\u0435\u0447\u043d\u0438 \u0434\u0435\u0444\u0438\u0446\u0438\u0442 \u043f\u0440\u0438\u0445\u043e\u0434\u0430 \u0438\u043b\u0438 \u043f\u043e\u0442\u0440\u043e\u0448\u045a\u0435 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u0430 \u0443 \u043e\u0434\u043d\u043e\u0441\u0443 \u043d\u0430 \u043d\u0430\u0432\u0435\u0434\u0435\u043d\u0443 \u0433\u0440\u0430\u043d\u0438\u0446\u0443 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430, \u043f\u0440\u0438 \u0447\u0435\u043c\u0443 \u0441\u0435 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u0443 \u043a\u043e\u0458\u0435 \u043d\u0438\u0458\u0435 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u043d\u043e \u043f\u0440\u0438\u043f\u0438\u0441\u0443\u0458\u0435 \u0434\u0435\u0444\u0438\u0446\u0438\u0442 \u043d\u0443\u043b\u0430. \u0418\u0437\u0440\u0430\u0436\u0430\u0432\u0430 \u0441\u0435 \u043a\u0430\u043e \u043f\u0440\u043e\u0446\u0435\u043d\u0430\u0442 \u0433\u0440\u0430\u043d\u0438\u0446\u0435 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u0438 \u043e\u0434\u0440\u0430\u0436\u0430\u0432\u0430 \u0434\u0443\u0431\u0438\u043d\u0443 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430, \u0430 \u043d\u0435 \u0441\u0430\u043c\u043e \u0443\u0434\u0438\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u0430 \u043a\u043e\u0458\u0435 \u0436\u0438\u0432\u0438 \u0438\u0441\u043f\u043e\u0434 \u0442\u0435 \u0433\u0440\u0430\u043d\u0438\u0446\u0435.","national_rationale":"\u041f\u0440\u0430\u045b\u0435\u045a\u0435 \u0434\u0443\u0431\u0438\u043d\u0435 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u0434\u043e\u043f\u0440\u0438\u043d\u043e\u0441\u0438 \u0431\u043e\u0459\u0435\u043c \u0440\u0430\u0437\u0443\u043c\u0438\u0458\u0435\u0432\u0430\u045a\u0443 \u0435\u043a\u043e\u043d\u043e\u043c\u0441\u043a\u043e\u0433 \u043f\u043e\u043b\u043e\u0436\u0430\u0458\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u0430 \u043a\u043e\u0458\u0435 \u0436\u0438\u0432\u0438 \u0438\u0441\u043f\u043e\u0434 \u043c\u0435\u0452\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u0435 \u0433\u0440\u0430\u043d\u0438\u0446\u0435 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430. \u0408\u0430\u0437 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u043f\u043e\u043a\u0430\u0437\u0443\u0458\u0435 \u043a\u043e\u043b\u0438\u043a\u043e \u0441\u0443, \u0443 \u043f\u0440\u043e\u0441\u0458\u0435\u043a\u0443, \u043f\u0440\u0438\u0445\u043e\u0434 \u0438\u043b\u0438 \u043f\u043e\u0442\u0440\u043e\u0448\u045a\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u0430 \u0443\u0434\u0430\u0459\u0435\u043d\u0438 \u043e\u0434 \u0442\u0435 \u0433\u0440\u0430\u043d\u0438\u0446\u0435, \u0443\u0437 \u0443\u043a\u0459\u0443\u0447\u0438\u0432\u0430\u045a\u0435 \u0443\u043a\u0443\u043f\u043d\u043e\u0433 \u0441\u0442\u0430\u043d\u043e\u0432\u043d\u0438\u0448\u0442\u0432\u0430 \u0443 \u043e\u0431\u0440\u0430\u0447\u0443\u043d. \u041e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043a\u043e\u0440\u0438\u0441\u0442\u0438 \u0441\u0435 \u043a\u0430\u043e \u0437\u0430\u043c\u0458\u0435\u043d\u0441\u043a\u0438 (proxy) \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0437\u0430 \u0411\u043e\u0441\u043d\u0443 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0443. \u041f\u043e\u0434\u0430\u0446\u0438 \u0438\u0437 \u0410\u043d\u043a\u0435\u0442\u0435 \u043e \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u043c\u0430 \u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u043c\u0430 \u0436\u0438\u0432\u043e\u0442\u0430 (Statistics on Income and Living Conditions \u2013 SILC) \u043d\u0438\u0441\u0443 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438 \u0443 \u0415\u0432\u0440\u043e\u0441\u0442\u0430\u0442\u043e\u0432\u043e\u0458 \u0431\u0430\u0437\u0438 \u0437\u0430 \u043f\u0440\u0438\u043a\u0430\u0437 \u0415\u0423 SDG \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 1.10 \u201e\u041b\u0438\u0446\u0430 \u0443 \u0440\u0438\u0437\u0438\u043a\u0443 \u043e\u0434 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u0438\u043b\u0438 \u0441\u043e\u0446\u0438\u0458\u0430\u043b\u043d\u0435 \u0438\u0441\u043a\u0459\u0443\u0447\u0435\u043d\u043e\u0441\u0442\u0438\u201c \u0437\u0430 \u0411\u043e\u0441\u043d\u0443 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0443, \u0437\u0431\u043e\u0433 \u0447\u0435\u0433\u0430 \u043d\u0438\u0458\u0435 \u043c\u043e\u0433\u0443\u045b\u0435 \u043f\u0440\u0438\u043a\u0430\u0437\u0430\u0442\u0438 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442\u0438 \u0442\u043e\u0433 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u043f\u0440\u0435\u043c\u0430 \u0437\u0430\u0458\u0435\u0434\u043d\u0438\u0447\u043a\u043e\u0458 \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u0458\u0438 \u0415\u0423. \u0418\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0421\u0432\u0458\u0435\u0442\u0441\u043a\u0435 \u0431\u0430\u043d\u043a\u0435 \u043f\u0440\u0443\u0436\u0430 \u0434\u043e\u0434\u0430\u0442\u043d\u0443 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0458\u0443 \u043e \u0434\u0443\u0431\u0438\u043d\u0438 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430, \u0430\u043b\u0438 \u043d\u0438\u0458\u0435 \u043d\u0435\u043f\u043e\u0441\u0440\u0435\u0434\u043d\u043e \u0443\u043f\u043e\u0440\u0435\u0434\u0438\u0432 \u0441\u0430 \u043d\u0430\u0432\u0435\u0434\u0435\u043d\u0438\u043c \u0415\u0423 SDG \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u043e\u043c \u043d\u0438\u0442\u0438 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0459\u0430 \u043c\u0458\u0435\u0440\u0443 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u043f\u0440\u0435\u043c\u0430 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u043e\u0458 \u0433\u0440\u0430\u043d\u0438\u0446\u0438 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435.","national_methodology_characteristics":"\u041f\u043e\u0434\u0430\u0446\u0438 \u0421\u0432\u0458\u0435\u0442\u0441\u043a\u0435 \u0431\u0430\u043d\u043a\u0435 \u2013 Poverty and Inequality Platform \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438 \u0441\u0443 \u0437\u0430 \u043e\u0434\u0430\u0431\u0440\u0430\u043d\u0435 \u0433\u043e\u0434\u0438\u043d\u0435 \u0443 \u043f\u0435\u0440\u0438\u043e\u0434\u0443 2001\u20132021. \u0433\u043e\u0434\u0438\u043d\u0435. \u041f\u0440\u0435\u043c\u0430 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0438\u0432\u043e\u0458 \u0441\u0435\u0440\u0438\u0458\u0438, \u0458\u0430\u0437 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u043f\u0440\u0435\u043c\u0430 \u0433\u0440\u0430\u043d\u0438\u0446\u0438 \u043e\u0434 8,30 USD \u0434\u043d\u0435\u0432\u043d\u043e \u0438\u0437\u043d\u043e\u0441\u0438\u043e \u0458\u0435 4,7% \u0443 2001. \u0433\u043e\u0434\u0438\u043d\u0438, 2,2% \u0443 2004, 4,3% \u0443 2007. \u0438 2011, 4,9% \u0443 2015. \u0442\u0435 2,7% \u0443 2021. \u0433\u043e\u0434\u0438\u043d\u0438. \u0418\u0437\u043c\u0435\u0452\u0443 2015. \u0438 2021. \u0433\u043e\u0434\u0438\u043d\u0435 \u0432\u0440\u0438\u0458\u0435\u0434\u043d\u043e\u0441\u0442 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u0441\u043c\u0430\u045a\u0435\u043d\u0430 \u0458\u0435 \u0437\u0430 2,2 \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u043d\u0430 \u043f\u043e\u0435\u043d\u0430. \u041e\u0432\u0430\u0458 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043e\u043f\u0438\u0441\u0443\u0458\u0435 \u0434\u0443\u0431\u0438\u043d\u0443 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u043f\u0440\u0435\u043c\u0430 \u043c\u0435\u0452\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0458 \u0433\u0440\u0430\u043d\u0438\u0446\u0438 \u0421\u0432\u0458\u0435\u0442\u0441\u043a\u0435 \u0431\u0430\u043d\u043a\u0435. \u0417\u0431\u043e\u0433 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0435 \u0443\u0447\u0435\u0441\u0442\u0430\u043b\u043e\u0441\u0442\u0438 \u043f\u043e\u0434\u0430\u0442\u0430\u043a\u0430 \u0438 \u0437\u0430\u043c\u0458\u0435\u043d\u0441\u043a\u043e\u0433 \u043a\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0430 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430, \u043d\u0430\u0432\u0435\u0434\u0435\u043d\u043e \u0441\u043c\u0430\u045a\u0435\u045a\u0435 \u0441\u0430\u043c\u043e \u043f\u043e \u0441\u0435\u0431\u0438 \u043d\u0438\u0458\u0435 \u0434\u043e\u0432\u043e\u0459\u043d\u043e \u0437\u0430 \u043f\u043e\u0443\u0437\u0434\u0430\u043d\u0443 \u043e\u0446\u0458\u0435\u043d\u0443 \u043d\u0430\u043f\u0440\u0435\u0442\u043a\u0430 \u043f\u0440\u0435\u043c\u0430 \u0437\u0432\u0430\u043d\u0438\u0447\u043d\u043e\u043c \u0446\u0438\u0459\u0443 \u043e\u0434\u0440\u0436\u0438\u0432\u043e\u0433 \u0440\u0430\u0437\u0432\u043e\u0458\u0430.","national_long_objective":"\u0417\u0430 \u043e\u0432\u0430\u0458 \u0437\u0430\u043c\u0458\u0435\u043d\u0441\u043a\u0438 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u043d\u0438\u0458\u0435 \u0443\u0442\u0432\u0440\u0452\u0435\u043d \u043f\u043e\u0441\u0435\u0431\u0430\u043d \u043a\u0432\u0430\u043d\u0442\u0438\u0442\u0430\u0442\u0438\u0432\u043d\u0438 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438 \u0446\u0438\u0459 \u0411\u043e\u0441\u043d\u0435 \u0438 \u0425\u0435\u0440\u0446\u0435\u0433\u043e\u0432\u0438\u043d\u0435. \u040a\u0435\u0433\u043e\u0432\u043e \u0442\u0443\u043c\u0430\u0447\u0435\u045a\u0435 \u0442\u0440\u0435\u0431\u0430 \u0437\u0430\u0441\u043d\u0438\u0432\u0430\u0442\u0438 \u043d\u0430 \u0434\u0435\u0444\u0438\u043d\u0438\u0446\u0438\u0458\u0438 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u0438 \u0440\u0430\u0437\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u0438 \u0433\u0430 \u043e\u0434 \u043d\u0430\u0446\u0438\u043e\u043d\u0430\u043b\u043d\u0438\u0445 \u043c\u0458\u0435\u0440\u0430 \u0438 \u0446\u0438\u0459\u0435\u0432\u0430 \u0437\u0430 \u0441\u043c\u0430\u045a\u0435\u045a\u0435 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430.","target_number":"1.20","goal_number":"1","graph_title":"\u0408\u0430\u0437 \u0441\u0438\u0440\u043e\u043c\u0430\u0448\u0442\u0432\u0430 \u043d\u0430 8,30 USD \u0434\u043d\u0435\u0432\u043d\u043e (\u041f\u041a\u041c \u0437\u0430 2021. \u0433\u043e\u0434\u0438\u043d\u0443) (%) \u2013 \u0437\u0430\u043c\u0458\u0435\u043d\u0441\u043a\u0438 \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440"}