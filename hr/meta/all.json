dnost 0.","methodology_characteristics":"Podaci se temelje na uskla\u0111enom godi\u0161njem istra\u017eivanju o dohotku i \u017eivotnim  uvjetima (EU-SILC). Od 2020. godine podaci nisu izravno usporedivi s  prethodnim godinama zbog opse\u017enih metodolo\u0161kih revizija i integracije u  mikrocenzus u skladu s Uredbom (EU) 2019/1700.","source_active_1":true,"source_organisation_1":"Eurostat (EU-SILC)","source_url_1":"https://ec.europa.eu/eurostat/databrowser/view/sdg_01_10/default/table","footer_fields":[{"label":"Nacionalni referentni metapodaci","value":"<a href=\"https://ec.europa.eu/eurostat/cache/metadata/en/sdg_01_10_esmsip2.htm\" target=\"_blank\">Eurostat Metadata Report (sdg_01_10)</a>"}],"target_number":"1.1","goal_number":"1","indicator_name":"Osobe u riziku od siroma\u0161tva ili socijalne isklju\u010denosti","graph_title":"Osobe u riziku od siroma\u0161tva ili socijalne isklju\u010denosti"},"1-4-1":{"indicator_number":"1.4.1","reporting_status":"complete","published":true,"sdg_goal":"1","data_non_statistical":false,"graph_type":"line","indicator_sort_order":"01-04-01","indicator_definition":"global_indicators.1-4-1-definition","rationale":"global_indicators.1-4-1-intention","methodology_characteristics":"Podaci se temelje na uskla\u0111enom godi\u0161njem istra\u017eivanju o dohotku i \u017eivotnim  uvjetima (EU-SILC). Od 2020. godine podaci nisu izravno usporedivi s  prethodnim godinama zbog opse\u017enih metodolo\u0161kih revizija i integracije u  mikrocenzus u skladu s Uredbom (EU) 2019/1700.","source_active_1":true,"source_organisation_1":"Agency for Statistics of BiH (BHAS)","source_url_1":"https://ec.europa.eu/eurostat/databrowser/view/sdg_01_40/default/table","footer_fields":[{"label":"Nacionalni referentni metapodaci","value":"<a href=\"https://ec.europa.eu/eurostat/cache/metadata/en/sdg_01_40_esmsip2.htm\" target=\"_blank\">Eurostat Metadata Report (sdg_01_40)</a>"}],"target_number":"1.4","goal_number":"1","indicator_name":"global_indicators.